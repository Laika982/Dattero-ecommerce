# ==============================================================================
# Dattero E-Commerce - Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to '.env':
#    cp .env.example .env
# 2. Replace all placeholder values with your actual configuration.
# 3. NEVER commit your actual '.env' file or production credentials to version control.
# ==============================================================================

# Application Environment & Server Port
# Values for NODE_ENV: development, test, production
PORT=3000
NODE_ENV=development

# Session Configuration
# In production, SESSION_SECRET must be a cryptographically random string (min 32 characters).
# You can generate a secure secret using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_strong_random_session_secret_at_least_32_characters

# JWT Authentication Secret
# In production, JWT_SECRET must be a cryptographically random string (min 32 characters).
# You can generate a secure secret using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_strong_random_jwt_secret_at_least_32_characters

# MongoDB Database Connection URL
# Example local: mongodb://localhost:27017/dattero_ecommerce
# Example Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/dattero_ecommerce?retryWrites=true&w=majority
DATABASE_URL=mongodb://localhost:27017/dattero_ecommerce

# Password Hashing Cost Factor (Salt Rounds)
# Recommended value: 10 or 12
SALT_ROUNDS=10

# Nodemailer / Transactional Email Credentials (SMTP)
# For Gmail, generate an App Password: Google Account -> Security -> 2-Step Verification -> App Passwords
NODEMAILER_EMAIL=your_smtp_email_address@example.com
NODEMAILER_PASSWORD=your_smtp_app_password

# Google OAuth 2.0 Client Credentials (Optional - for Google Login)
# Obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Cloudinary Cloud Storage (For Product & Category Images)
# Obtain from Cloudinary Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Payment Gateway Credentials (Test or Live)
# Obtain from Razorpay Dashboard: https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Winston Application Log Level
# Options: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info

# Rate Limiting Configuration (Shared MongoDB Store)
# Limits are evaluated per window (default: 15 minutes = 900000 ms)
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
OTP_GEN_RATE_LIMIT_MAX=5
OTP_GEN_RATE_LIMIT_WINDOW_MS=900000
OTP_RESEND_RATE_LIMIT_MAX=3
OTP_RESEND_RATE_LIMIT_WINDOW_MS=900000
OTP_VERIFY_RATE_LIMIT_MAX=10
OTP_VERIFY_RATE_LIMIT_WINDOW_MS=900000
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MS=900000


