<!DOCTYPE html>
<html class="light" lang="en">

<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <title>Create Category | Nutri Luxe Admin</title>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&amp;family=Inter:wght@400;500;600&amp;display=swap"
    rel="stylesheet">
  <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
    rel="stylesheet">
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          "colors": {
            "surface-variant": "#e3e2e2",
            "surface": "#fbf9f9",
            "outline": "#747878",
            "background": "#fbf9f9",
            "on-primary-fixed-variant": "#464747",
            "on-tertiary": "#ffffff",
            "primary-fixed-dim": "#c7c6c6",
            "inverse-primary": "#c7c6c6",
            "surface-container-highest": "#e3e2e2",
            "on-secondary-container": "#646464",
            "on-error-container": "#93000a",
            "tertiary-container": "#747474",
            "surface-bright": "#fbf9f9",
            "secondary": "#5e5e5e",
            "secondary-container": "#e3e2e2",
            "on-primary-container": "#fefcfc",
            "on-surface-variant": "#444748",
            "outline-variant": "#c4c7c7",
            "surface-tint": "#5e5e5e",
            "tertiary-fixed-dim": "#c6c6c6",
            "on-primary": "#ffffff",
            "primary": "#5c5c5c",
            "on-primary-fixed": "#1b1c1c",
            "inverse-on-surface": "#f2f0f0",
            "secondary-fixed": "#e3e2e2",
            "on-secondary-fixed": "#1b1c1c",
            "surface-dim": "#dbdad9",
            "primary-fixed": "#e3e2e2",
            "secondary-fixed-dim": "#c7c6c6",
            "error-container": "#ffdad6",
            "on-tertiary-fixed-variant": "#474747",
            "inverse-surface": "#303031",
            "tertiary-fixed": "#e2e2e2",
            "surface-container-lowest": "#ffffff",
            "surface-container": "#efeded",
            "surface-container-high": "#e9e8e7",
            "tertiary": "#5c5c5c",
            "surface-container-low": "#f5f3f3",
            "on-tertiary-fixed": "#1b1b1b",
            "on-surface": "#1b1c1c",
            "on-secondary": "#ffffff",
            "on-background": "#1b1c1c",
            "primary-container": "#747474",
            "on-tertiary-container": "#fcfcfc",
            "on-secondary-fixed-variant": "#464747",
            "on-error": "#ffffff",
            "error": "#ba1a1a"
          },
          "borderRadius": {
            "DEFAULT": "0.25rem",
            "lg": "0.5rem",
            "xl": "0.75rem",
            "full": "9999px"
          },
          "spacing": {
            "stack-lg": "24px",
            "grid-gutter": "24px",
            "container-padding": "32px",
            "stack-sm": "8px",
            "max-width": "1280px",
            "section-gap-mobile": "64px",
            "stack-md": "16px",
            "section-gap": "120px"
          },
          "fontFamily": {
            "body-xl": ["Inter"],
            "body-lg": ["Inter"],
            "body-md": ["Inter"],
            "label-md": ["Inter"],
            "headline-xl": ["Plus Jakarta Sans"],
            "headline-lg": ["Plus Jakarta Sans"],
            "display-lg-mobile": ["Plus Jakarta Sans"],
            "display-lg": ["Plus Jakarta Sans"]
          },
          "fontSize": {
            "body-xl": ["20px", { "lineHeight": "1.5", "fontWeight": "400" }],
            "body-lg": ["17px", { "lineHeight": "1.5", "fontWeight": "400" }],
            "body-md": ["15px", { "lineHeight": "1.5", "fontWeight": "400" }],
            "label-md": ["14px", { "lineHeight": "1.2", "letterSpacing": "0.02em", "fontWeight": "600" }],
            "headline-xl": ["40px", { "lineHeight": "1.2", "letterSpacing": "-0.01em", "fontWeight": "600" }],
            "headline-lg": ["32px", { "lineHeight": "1.25", "fontWeight": "600" }],
            "display-lg-mobile": ["40px", { "lineHeight": "1.1", "letterSpacing": "-0.01em", "fontWeight": "700" }],
            "display-lg": ["56px", { "lineHeight": "1.1", "letterSpacing": "-0.02em", "fontWeight": "700" }]
          }
        },
      },
    }
  </script>
  <style>
    html,
    body {
      background-color: #fbf9f9;
      color: #1b1c1c;
      overflow-x: hidden;
      overflow-y: auto;
      min-height: 100vh;
    }

    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
      display: inline-block;
      line-height: 1;
    }

    .apple-shadow {
      box-shadow: 0 40px 40px -40px rgba(0, 0, 0, 0.04);
    }
  </style>
</head>

<body class="font-body-md text-body-md selection:bg-primary-fixed-dim selection:text-on-primary-fixed">
  {{> user/notification}}
  <!-- SideNavBar Shell -->
  {{> admin/aside}}

  <!-- Main Content Shell -->
  <div class="lg:ml-64 ml-0 min-h-screen flex flex-col">

    <!-- Page Canvas -->
    <main class="flex-grow p-4 sm:p-6 lg:p-8 max-w-7xl mx-auto w-full pb-16">
      <!-- Breadcrumbs & Header -->
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8 pb-6 border-b border-outline-variant/20">
        <div>
          <nav class="flex items-center gap-2 text-on-surface-variant text-sm mb-2 opacity-70">
            <a class="hover:underline hover:text-on-surface transition-colors" href="/admin/">Admin</a>
            <span class="material-symbols-outlined text-[14px]">chevron_right</span>
            <a class="hover:underline hover:text-on-surface transition-colors" href="/admin/category/categories">Categories</a>
            <span class="material-symbols-outlined text-[14px]">chevron_right</span>
            <span class="text-on-surface font-semibold">Create Category</span>
          </nav>
          <h1 class="font-headline-lg text-2xl sm:text-3xl font-bold text-on-surface tracking-tight">Create Category</h1>
          <p class="text-on-surface-variant text-sm mt-1 opacity-70">Define a new collection for your luxury wellness line.</p>
        </div>
        <div class="flex items-center gap-3 shrink-0 self-end sm:self-auto">
          <a href="/admin/category/categories"
            class="inline-flex items-center justify-center px-5 sm:px-6 py-2.5 rounded-full font-label-md text-sm text-on-surface border border-outline-variant/30 hover:bg-surface-container-high transition-all active:scale-95">Discard Changes</a>
          <button type="submit" form="categoryForm"
            class="inline-flex items-center justify-center gap-2 px-6 sm:px-8 py-2.5 bg-black text-white rounded-full font-label-md text-sm hover:opacity-90 transition-all active:scale-95 shadow-sm">
            Save Category
            <span class="material-symbols-outlined text-[18px]">check_circle</span>
          </button>
        </div>
      </div>

      {{#if error}}
      <div class="bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 rounded-2xl mb-6 flex items-center gap-3">
        <span class="material-symbols-outlined text-rose-600 text-[20px]">error</span>
        <span class="text-sm font-medium">{{error}}</span>
      </div>
      {{/if}}

      <!-- Form Bento Layout -->
      <form id="categoryForm" action="/admin/category/addCategory" method="POST" enctype="multipart/form-data"
        class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        
        <!-- Primary Column (Left) -->
        <div class="lg:col-span-8 w-full space-y-6">
          
          <!-- General Details Card -->
          <div class="bg-surface-container-lowest rounded-2xl p-6 sm:p-8 apple-shadow border border-outline-variant/20">
            <div class="flex items-center gap-3 mb-6 pb-4 border-b border-outline-variant/15">
              <span class="material-symbols-outlined text-primary text-[22px]">label</span>
              <h2 class="font-headline-lg text-lg sm:text-xl font-bold text-on-surface tracking-tight">General Information</h2>
            </div>

            <div class="space-y-6">
              <!-- Category Name -->
              <div class="space-y-2">
                <label class="font-label-md text-sm text-on-surface font-medium block">Category Name</label>
                <input required id="categoryNameInput"
                  class="w-full bg-surface-container-low border border-outline-variant/30 rounded-xl px-4 py-3 text-body-md font-medium text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent focus:outline-none transition-all placeholder:text-on-surface-variant/40"
                  placeholder="e.g. Traditional Ajwa Dates" type="text" name="category_name">
              </div>

              <!-- Description -->
              <div class="space-y-2">
                <div class="flex justify-between items-center">
                  <label class="font-label-md text-sm text-on-surface font-medium block">Description</label>
                  <span id="charCount" class="text-xs text-on-surface-variant opacity-70">0/500 characters</span>
                </div>
                <textarea id="descriptionInput" name="description" rows="4" maxlength="500" required
                  class="w-full bg-surface-container-low border border-outline-variant/30 rounded-xl p-4 text-body-md font-medium text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent focus:outline-none transition-all placeholder:text-on-surface-variant/40"
                  placeholder="Describe the collection, nutritional features, and wellness benefits..."></textarea>
              </div>
            </div>
          </div>

          <!-- Visual Identity (Banner Image) -->
          <div class="bg-surface-container-lowest rounded-2xl p-6 sm:p-8 apple-shadow border border-outline-variant/20">
            <div class="flex items-center gap-3 mb-6 pb-4 border-b border-outline-variant/15">
              <span class="material-symbols-outlined text-primary text-[22px]">image</span>
              <h2 class="font-headline-lg text-lg sm:text-xl font-bold text-on-surface tracking-tight">Visual Identity (Banner)</h2>
            </div>

            <div>
              <p class="text-xs text-on-surface-variant mb-4">Upload an optional high-resolution banner image for this category storefront showcase.</p>

              <!-- Upload Container -->
              <div id="dropZoneContainer" class="relative group cursor-pointer">
                <div id="uploadContainer"
                  class="w-full aspect-[21/9] rounded-2xl bg-surface-container-low border-2 border-dashed border-outline-variant/40 flex flex-col items-center justify-center transition-all group-hover:border-primary group-hover:bg-surface-container overflow-hidden relative">
                  
                  <div id="uploadContent" class="text-center p-6 space-y-2">
                    <span class="material-symbols-outlined text-4xl text-outline-variant group-hover:text-primary transition-colors">
                      cloud_upload
                    </span>
                    <p class="font-label-md text-sm text-on-surface font-semibold">Click to upload banner</p>
                    <p class="text-xs text-on-surface-variant opacity-70">Recommended: 1600 x 680px (PNG, JPG, or WebP)</p>
                  </div>

                  <!-- Image Preview -->
                  <img id="imagePreview" class="hidden absolute inset-0 w-full h-full object-cover rounded-2xl" alt="Category banner preview">

                  <!-- Hover overlay -->
                  <div id="imageOverlay" class="hidden absolute inset-0 bg-black/40 rounded-2xl items-center justify-center transition-opacity">
                    <div class="text-center text-white">
                      <span class="material-symbols-outlined text-3xl">cloud_upload</span>
                      <p class="text-sm font-semibold mt-1">Click to change image</p>
                    </div>
                  </div>
                </div>

                <!-- File Input -->
                <input id="imageInput" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" type="file" name="image"
                  accept="image/jpeg,image/png,image/webp">
              </div>

              <!-- Selected File Information -->
              <div id="filePreview" class="mt-4 hidden items-center gap-4 p-3 bg-surface-container-low rounded-xl border border-outline-variant/30">
                <div class="w-16 h-10 bg-surface-container-high rounded-lg overflow-hidden border border-outline-variant/20 shrink-0">
                  <img id="smallPreview" class="w-full h-full object-cover" alt="Selected image">
                </div>
                <div class="flex-1 min-w-0">
                  <p id="fileName" class="text-xs font-semibold text-on-surface truncate"></p>
                  <p id="fileSize" class="text-[11px] text-on-surface-variant uppercase mt-0.5"></p>
                </div>
                <button id="removeImage" class="text-error hover:bg-error-container/30 p-2 rounded-full transition-colors shrink-0" type="button" title="Remove selected image">
                  <span class="material-symbols-outlined text-[18px]">delete</span>
                </button>
              </div>
            </div>

            <!-- Card Footer Submit Actions -->
            <div class="pt-6 mt-8 border-t border-outline-variant/20 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <p class="text-xs text-on-surface-variant opacity-70">
                Verify category title and description before saving.
              </p>
              <div class="flex items-center justify-end gap-3 shrink-0">
                <a href="/admin/category/categories"
                  class="inline-flex items-center justify-center px-6 py-2.5 rounded-full font-label-md text-sm text-on-surface border border-outline-variant/30 hover:bg-surface-container-high transition-all active:scale-95">Cancel</a>
                <button type="submit"
                  class="inline-flex items-center justify-center gap-2 px-8 py-2.5 bg-black text-white rounded-full font-label-md text-sm hover:opacity-90 transition-all active:scale-95 shadow-sm">
                  Save Category
                  <span class="material-symbols-outlined text-[18px]">check_circle</span>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Secondary Column (Sidebar: Visibility & Guidelines) -->
        <div class="lg:col-span-4 w-full space-y-6">
          <div class="sticky top-24 space-y-6">
            <!-- Category Visibility Card -->
            <div class="bg-surface-container-lowest rounded-2xl p-6 sm:p-8 apple-shadow border border-outline-variant/20">
              <div class="flex items-center gap-3 mb-6 pb-4 border-b border-outline-variant/15">
                <span class="material-symbols-outlined text-primary text-[22px]">visibility</span>
                <h2 class="font-headline-lg text-lg sm:text-xl font-bold text-on-surface tracking-tight">Category Visibility</h2>
              </div>
              <div class="flex items-center justify-between gap-4">
                <div>
                  <label class="font-label-md text-sm text-on-surface font-medium block">Storefront Status</label>
                  <p class="text-xs text-on-surface-variant opacity-70 mt-0.5">New categories are automatically listed and visible to customers.</p>
                </div>
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 border border-emerald-300 shrink-0">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                  Active
                </span>
              </div>
            </div>

            <!-- Guidelines Card -->
            <div class="bg-surface-container-lowest rounded-2xl p-6 apple-shadow border border-outline-variant/20 space-y-4">
              <h3 class="font-label-md text-xs text-outline mb-2 uppercase tracking-widest font-bold">Category Guidelines</h3>
              <ul class="space-y-3 text-sm text-on-surface-variant">
                <li class="flex items-start gap-2.5">
                  <span class="material-symbols-outlined text-[18px] text-primary shrink-0 mt-0.5">verified</span>
                  <span><strong>Unique Name:</strong> Category titles must be distinct across the catalog.</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="material-symbols-outlined text-[18px] text-primary shrink-0 mt-0.5">aspect_ratio</span>
                  <span><strong>Aspect Ratio:</strong> Landscape banners (21:9 or 16:9) look best across desktop and mobile headers.</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="material-symbols-outlined text-[18px] text-primary shrink-0 mt-0.5">description</span>
                  <span><strong>SEO Descriptions:</strong> Helpful descriptions improve storefront search ranking and customer discovery.</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </form>
    </main>
  </div>

  <script>
    const dropZoneContainer = document.getElementById("dropZoneContainer");
    const imageInput = document.getElementById("imageInput");
    const uploadContent = document.getElementById("uploadContent");
    const imagePreview = document.getElementById("imagePreview");
    const imageOverlay = document.getElementById("imageOverlay");
    const filePreview = document.getElementById("filePreview");
    const smallPreview = document.getElementById("smallPreview");
    const fileName = document.getElementById("fileName");
    const fileSize = document.getElementById("fileSize");
    const removeImage = document.getElementById("removeImage");
    const descriptionInput = document.getElementById("descriptionInput");
    const charCount = document.getElementById("charCount");

    // Character counter
    if (descriptionInput && charCount) {
      descriptionInput.addEventListener("input", () => {
        charCount.textContent = `${descriptionInput.value.length}/500 characters`;
      });
    }

    // Open file selector
    if (dropZoneContainer && imageInput) {
      dropZoneContainer.addEventListener("click", function () {
        imageInput.click();
      });
    }

    // Remove selected image
    if (removeImage && imageInput) {
      removeImage.addEventListener("click", function (event) {
        event.stopPropagation();
        imageInput.value = "";
        imagePreview.src = "";
        smallPreview.src = "";
        imagePreview.classList.add("hidden");
        imageOverlay.classList.add("hidden");
        imageOverlay.classList.remove("flex");
        uploadContent.classList.remove("hidden");
        filePreview.classList.add("hidden");
        filePreview.classList.remove("flex");
      });
    }

    // Handle image selection
    if (imageInput) {
      imageInput.addEventListener("change", function (event) {
        const file = event.target.files[0];
        if (!file) return;

        if (!file.type.startsWith("image/")) {
          alert("Please select a valid image file (PNG, JPG, or WebP).");
          imageInput.value = "";
          return;
        }

        const imageUrl = URL.createObjectURL(file);
        imagePreview.src = imageUrl;
        imagePreview.classList.remove("hidden");
        uploadContent.classList.add("hidden");
        imageOverlay.classList.remove("hidden");

        smallPreview.src = imageUrl;
        fileName.textContent = file.name;
        const sizeInMB = (file.size / (1024 * 1024)).toFixed(2);
        fileSize.textContent = sizeInMB + " MB";

        filePreview.classList.remove("hidden");
        filePreview.classList.add("flex");
      });
    }

    // Hover overlay effects
    if (dropZoneContainer) {
      dropZoneContainer.addEventListener("mouseenter", function () {
        if (!imagePreview.classList.contains("hidden")) {
          imageOverlay.classList.remove("hidden");
          imageOverlay.classList.add("flex");
        }
      });

      dropZoneContainer.addEventListener("mouseleave", function () {
        if (!imagePreview.classList.contains("hidden")) {
          imageOverlay.classList.remove("flex");
          imageOverlay.classList.add("hidden");
        }
      });
    }
  </script>
</body>

</html>