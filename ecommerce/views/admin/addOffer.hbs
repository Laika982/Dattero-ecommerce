<!DOCTYPE html><html class="light" lang="en"><head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<title>Nutri Luxe Admin - Create Offer</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&amp;family=Inter:wght@400;500;600&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .glass-panel {
            background: rgba(251, 249, 249, 0.8);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(0, 0, 0, 0.08);
        }
        body {
            background-color: #fbf9f9;
            color: #1b1c1c;
        }
    </style>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "surface-variant": "#e3e2e2",
                        "surface": "#fbf9f9",
                        "outline": "#747878",
                        "background": "#fbf9f9",
                        "on-primary-fixed-variant": "#464747",
                        "on-tertiary": "#ffffff",
                        "primary-fixed-dim": "#c7c6c6",
                        "inverse-primary": "#c7c6c6",
                        "surface-container-highest": "#e3e2e2",
                        "on-secondary-container": "#646464",
                        "on-error-container": "#93000a",
                        "tertiary-container": "#747474",
                        "surface-bright": "#fbf9f9",
                        "secondary": "#5e5e5e",
                        "secondary-container": "#e3e2e2",
                        "on-primary-container": "#fefcfc",
                        "on-surface-variant": "#444748",
                        "outline-variant": "#c4c7c7",
                        "surface-tint": "#5e5e5e",
                        "tertiary-fixed-dim": "#c6c6c6",
                        "on-primary": "#ffffff",
                        "primary": "#5c5c5c",
                        "on-primary-fixed": "#1b1c1c",
                        "inverse-on-surface": "#f2f0f0",
                        "secondary-fixed": "#e3e2e2",
                        "on-secondary-fixed": "#1b1c1c",
                        "surface-dim": "#dbdad9",
                        "primary-fixed": "#e3e2e2",
                        "secondary-fixed-dim": "#c7c6c6",
                        "error-container": "#ffdad6",
                        "on-tertiary-fixed-variant": "#474747",
                        "inverse-surface": "#303031",
                        "tertiary-fixed": "#e2e2e2",
                        "surface-container-lowest": "#ffffff",
                        "surface-container": "#efeded",
                        "surface-container-high": "#e9e8e7",
                        "tertiary": "#5c5c5c",
                        "surface-container-low": "#f5f3f3",
                        "on-tertiary-fixed": "#1b1b1b",
                        "on-surface": "#1b1c1c",
                        "on-secondary": "#ffffff",
                        "on-background": "#1b1c1c",
                        "primary-container": "#747474",
                        "on-tertiary-container": "#fcfcfc",
                        "on-secondary-fixed-variant": "#464747",
                        "on-error": "#ffffff",
                        "error": "#ba1a1a"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "stack-lg": "24px",
                        "grid-gutter": "24px",
                        "container-padding": "32px",
                        "stack-sm": "8px",
                        "max-width": "1280px",
                        "section-gap-mobile": "64px",
                        "stack-md": "16px",
                        "section-gap": "120px"
                    },
                    "fontFamily": {
                        "body-xl": ["Inter"],
                        "body-lg": ["Inter"],
                        "body-md": ["Inter"],
                        "label-md": ["Inter"],
                        "headline-xl": ["Plus Jakarta Sans"],
                        "headline-lg": ["Plus Jakarta Sans"],
                        "display-lg-mobile": ["Plus Jakarta Sans"],
                        "display-lg": ["Plus Jakarta Sans"]
                    },
                    "fontSize": {
                        "body-xl": ["20px", {"lineHeight": "1.5", "fontWeight": "400"}],
                        "body-lg": ["17px", {"lineHeight": "1.5", "fontWeight": "400"}],
                        "body-md": ["15px", {"lineHeight": "1.5", "fontWeight": "400"}],
                        "label-md": ["14px", {"lineHeight": "1.2", "letterSpacing": "0.02em", "fontWeight": "600"}],
                        "headline-xl": ["40px", {"lineHeight": "1.2", "letterSpacing": "-0.01em", "fontWeight": "600"}],
                        "headline-lg": ["32px", {"lineHeight": "1.25", "fontWeight": "600"}],
                        "display-lg-mobile": ["40px", {"lineHeight": "1.1", "letterSpacing": "-0.01em", "fontWeight": "700"}],
                        "display-lg": ["56px", {"lineHeight": "1.1", "letterSpacing": "-0.02em", "fontWeight": "700"}]
                    }
                },
            },
        }
    </script>
</head>
<body class="bg-surface font-body-md text-on-surface">
      {{> user/notification}}
{{> admin/aside}}
<div class="lg:ml-64 ml-0 min-h-screen flex flex-col">
<header class="sticky top-0 w-full z-40 bg-surface/80 backdrop-blur-md border-b border-outline-variant/30 flex justify-between items-center h-16 px-4 sm:px-6 md:px-container-padding">
<div class="flex items-center gap-3 sm:gap-4 flex-1">
    <!-- Mobile Sidebar Toggle -->
    <button type="button" class="lg:hidden p-2 rounded-lg text-on-surface-variant hover:text-ink-black hover:bg-surface-variant/50 transition-colors touch-target" onclick="toggleAdminSidebar()" aria-label="Toggle Navigation">
        <span class="material-symbols-outlined text-[22px]">menu</span>
    </button>
<div class="relative w-full max-w-md">
<span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant opacity-60">search</span>
<input class="w-full pl-10 pr-4 py-2 bg-surface-container-low border-none rounded-full text-body-md focus:ring-1 focus:ring-primary" placeholder="Search orders, products, offers..." type="text">
</div>
</div>
<div class="flex items-center gap-6">
<button class="text-on-surface-variant hover:text-primary transition-colors"><span class="material-symbols-outlined">notifications</span></button>
<button class="text-on-surface-variant hover:text-primary transition-colors"><span class="material-symbols-outlined">settings</span></button>
<div class="h-8 w-[1px] bg-outline-variant/30"></div>
<div class="flex items-center gap-3">
<div class="text-right">
<p class="font-label-md text-on-surface">Administrator</p>
<p class="text-[12px] text-on-surface-variant opacity-70">Luxury Admin</p>
</div>
<div class="h-10 w-10 rounded-full overflow-hidden bg-surface-container-high border border-outline-variant/20">
<img class="w-full h-full object-cover" alt="Administrator" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBCnCPqa2ZUl85bXcurNMzd73aXdhAeG8Lqf-_qkYsPtfrN69Iue7akEEfyoeO6Bk1hcKgNaxBPRMZrw9bZT6Ou9l3wD6cowgRjrkbBG-yBDzZBTn2FVyx9wR93qnoYG3qovBE7XqKYswqoyn1-xDZ_Q8c0VRDMcxONM4JYjGBRnzd-i0xC12yyHeGE-kEQmpVxI_6CgfcDNbb4ngowZcbETicOZUhkPO3HBn2or__EgmgeibXHqdujxd_LHUwYapFyhTyQtA_2STk">
</div>
</div>
</div>
</header>
<main class="flex-1 p-container-padding max-w-[1100px] mx-auto w-full pb-20">
<div class="px-container-padding py-10 flex justify-between items-end">
<div>
<nav class="flex items-center gap-2 text-on-surface-variant font-label-md mb-2 opacity-60">
<span>Admin</span>
<span class="material-symbols-outlined text-[14px]">chevron_right</span>
<a href="/admin/offers">Offers</a>
<span class="material-symbols-outlined text-[14px]">chevron_right</span>
<span class="text-on-surface font-semibold">Create Offer</span>
</nav>
<h2 class="font-headline-lg text-headline-lg font-bold">Create Offer</h2>
<p class="text-on-surface-variant font-body-md">Product and category discounts compete; the largest saving is applied. Referral offers apply on a referred customer’s first order.</p>
</div>
<div class="flex items-center gap-4">
<a href="/admin/offers" class="px-6 py-3 font-label-md text-on-surface-variant hover:text-primary transition-colors">Discard Changes</a>
<button type="submit" form="offerForm" class="bg-primary text-on-primary px-8 py-3 rounded-full font-label-md shadow-lg shadow-primary/10 hover:opacity-90 active:scale-95 transition-all">Save Offer</button>
</div>
</div>
<form id="offerForm" action="/admin/offers/add" method="POST" class="grid grid-cols-1 md:grid-cols-12 gap-grid-gutter">
<div class="md:col-span-8 space-y-grid-gutter">
<div class="bg-surface-container-lowest rounded-xl p-8 border border-outline-variant/10 shadow-sm">
<div class="flex items-center gap-3 mb-6"><span class="material-symbols-outlined text-primary">local_offer</span><h3 class="font-headline-lg text-body-xl font-semibold">General Details</h3></div>
<div class="space-y-6">
<div>
<label class="block font-label-md font-semibold mb-2 text-on-surface-variant">Offer Name</label>
<input name="name" required class="w-full bg-surface-container-low border border-transparent rounded-xl px-4 py-3.5 font-headline-lg text-body-xl font-bold focus:ring-1 focus:ring-primary transition-all" type="text" placeholder="Summer Dates Sale">
</div>
<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
<div>
<label class="block font-label-md font-semibold mb-2 text-on-surface-variant">Offer Type</label>
<select id="offerType" name="offer_type" class="w-full bg-surface-container-low border border-transparent rounded-xl px-4 py-3.5 font-body-md focus:ring-1 focus:ring-primary appearance-none cursor-pointer">
<option value="PRODUCT">Product offer</option>
<option value="CATEGORY">Category offer</option>
<option value="REFERRAL">Referral offer</option>
</select>
</div>
<div>
<label class="block font-label-md font-semibold mb-2 text-on-surface-variant">Set Status</label>
<select name="status" class="w-full bg-surface-container-low border border-transparent rounded-xl px-4 py-3.5 font-body-md focus:ring-1 focus:ring-primary appearance-none cursor-pointer">
<option value="active" selected>Active</option>
<option value="inactive">Inactive</option>
</select>
</div>
</div>
<div id="productField">
<label class="block font-label-md font-semibold mb-2 text-on-surface-variant">Product</label>
<select name="product_id" class="w-full bg-surface-container-low border border-transparent rounded-xl px-4 py-3.5 font-body-md focus:ring-1 focus:ring-primary appearance-none cursor-pointer">
<option value="">Select product...</option>
{{#each products}}
<option value="{{this._id}}">{{this.productName}}</option>
{{/each}}
</select>
</div>
<div id="categoryField" class="hidden">
<label class="block font-label-md font-semibold mb-2 text-on-surface-variant">Category</label>
<select name="category_id" class="w-full bg-surface-container-low border border-transparent rounded-xl px-4 py-3.5 font-body-md focus:ring-1 focus:ring-primary appearance-none cursor-pointer">
<option value="">Select category...</option>
{{#each categories}}
<option value="{{this._id}}">{{this.category_name}}</option>
{{/each}}
</select>
</div>
<p id="referralHint" class="hidden text-[13px] text-on-surface-variant">Referral offers apply to a referred customer’s first order. Customers can join with a referral code or an invite token URL.</p>
<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
<div>
<label class="block font-label-md font-semibold mb-2 text-on-surface-variant">Discount Type</label>
<select name="discount_type" class="w-full bg-surface-container-low border border-transparent rounded-xl px-4 py-3.5 font-body-md focus:ring-1 focus:ring-primary appearance-none cursor-pointer">
<option value="PERCENTAGE">Percentage Discount</option>
<option value="FIXED">Fixed Amount Discount</option>
</select>
</div>
<div>
<label class="block font-label-md font-semibold mb-2 text-on-surface-variant">Discount Value</label>
<input name="discount_value" required class="w-full bg-surface-container-low border border-transparent rounded-xl px-4 py-3.5 font-body-md focus:ring-1 focus:ring-primary" placeholder="10" type="number" min="0.01" step="0.01">
</div>
</div>
</div>
</div>
</div>
<div class="md:col-span-4 space-y-grid-gutter">
<div class="sticky top-24">
<div class="glass-panel p-8 rounded-2xl shadow-sm h-fit">
<div class="flex items-center gap-3 mb-6">
<span class="material-symbols-outlined text-primary">calendar_today</span>
<h3 class="font-headline-lg text-body-xl font-semibold">Validity Period</h3>
</div>
<div class="space-y-6">
<div>
<label class="block font-label-md mb-2 text-on-surface-variant">Start Date</label>
<input name="start_date" required class="w-full bg-surface-container-low border border-transparent rounded-xl px-4 py-3.5 font-body-md focus:ring-1 focus:ring-primary" type="date">
</div>
<div>
<label class="block font-label-md mb-2 text-on-surface-variant font-semibold">End Date</label>
<input name="end_date" required class="w-full bg-surface-container-low border border-transparent rounded-xl px-4 py-3.5 font-body-md focus:ring-1 focus:ring-primary" type="date">
</div>
</div>
</div>
</div>
</div>
</form>
</main>
</div>
<script>
    const offerType = document.getElementById("offerType");
    const productField = document.getElementById("productField");
    const categoryField = document.getElementById("categoryField");
    const referralHint = document.getElementById("referralHint");

    function syncOfferType() {
        const type = offerType.value;
        productField.classList.toggle("hidden", type !== "PRODUCT");
        categoryField.classList.toggle("hidden", type !== "CATEGORY");
        referralHint.classList.toggle("hidden", type !== "REFERRAL");
        productField.querySelector("select").required = type === "PRODUCT";
        categoryField.querySelector("select").required = type === "CATEGORY";
    }

    offerType.addEventListener("change", syncOfferType);
    syncOfferType();

    window.onload = () => {
        const today = new Date().toISOString().split("T")[0];
        const nextMonth = new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString().split("T")[0];
        const dateInputs = document.querySelectorAll('input[type="date"]');
        if (dateInputs[0]) dateInputs[0].value = today;
        if (dateInputs[1]) dateInputs[1].value = nextMonth;
    };
</script>
</body></html>
