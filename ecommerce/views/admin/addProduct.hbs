<script>
    // Standardized sidebar and top bar interactions
    const inputs = document.querySelectorAll('input, textarea, select');
    inputs.forEach(input => {
        input.addEventListener('focus', () => {
            if (input.closest('.col-span-8, .col-span-4')) {
                input.closest('div').classList.add('scale-[1.005]');
                input.closest('div').classList.add('transition-transform');
            }
        });
        input.addEventListener('blur', () => {
            if (input.closest('.col-span-8, .col-span-4')) {
                input.closest('div').classList.remove('scale-[1.005]');
            }
        });
    });
</script>
<script>
document.addEventListener("DOMContentLoaded", function () {
// =====================================
// PRODUCT MEDIA CROPPING & UPLOAD ENGINE
// =====================================

const uploadArea = document.getElementById("uploadArea");
const uploadContent = document.getElementById("uploadContent");
const productImages = document.getElementById("productImages");

const mainImage = document.getElementById("mainImage");
const cropMainImage = document.getElementById("cropMainImage");
const removeMainImage = document.getElementById("removeMainImage");

const addImageBtn = document.getElementById("addImageBtn");
const imagePreview = document.getElementById("imagePreview");

let selectedFiles = [];

// Initialize Cropper Engine
const cropper = new ProductCropper({
    onFileProcessed: (processedFile, isRecrop, targetIndex) => {
        if (isRecrop && targetIndex !== null && targetIndex >= 0) {
            selectedFiles[targetIndex] = processedFile;
        } else {
            selectedFiles.push(processedFile);
        }
        updateFileInput();
        displayImages();
    }
});

// Sync selected files to hidden file input
function updateFileInput() {
    const dataTransfer = new DataTransfer();
    selectedFiles.forEach((file) => {
        dataTransfer.items.add(file);
    });
    productImages.files = dataTransfer.files;
}

// Render previews (hero main image + thumbnail gallery)
function displayImages() {
    imagePreview.innerHTML = "";

    // Main image
    if (selectedFiles.length > 0) {
        mainImage.src = URL.createObjectURL(selectedFiles[0]);
        mainImage.classList.remove("hidden");
        uploadContent.classList.add("hidden");
        cropMainImage.classList.remove("hidden");
        cropMainImage.classList.add("flex");
        removeMainImage.classList.remove("hidden");
        removeMainImage.classList.add("flex");
    } else {
        mainImage.src = "";
        mainImage.classList.add("hidden");
        uploadContent.classList.remove("hidden");
        cropMainImage.classList.add("hidden");
        cropMainImage.classList.remove("flex");
        removeMainImage.classList.add("hidden");
        removeMainImage.classList.remove("flex");
    }

    // Other images (index 1 onwards)
    selectedFiles.slice(1).forEach((file, index) => {
        const actualIndex = index + 1;
        const container = document.createElement("div");
        container.className = "relative aspect-square rounded-lg overflow-hidden border border-outline-variant/30 group bg-surface-container";

        const objectUrl = URL.createObjectURL(file);
        container.innerHTML = `
            <img src="${objectUrl}" alt="Product gallery" class="w-full h-full object-cover">
            <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-2">
                <button
                    type="button"
                    class="crop-thumbnail w-8 h-8 rounded-full bg-white text-on-surface flex items-center justify-center hover:scale-110 shadow transition"
                    data-index="${actualIndex}"
                    title="Crop / Resize"
                >
                    <span class="material-symbols-outlined text-[16px]">crop</span>
                </button>
                <button
                    type="button"
                    class="remove-image w-8 h-8 rounded-full bg-red-600 text-white flex items-center justify-center hover:scale-110 shadow transition"
                    data-index="${actualIndex}"
                    title="Remove"
                >
                    ×
                </button>
            </div>
        `;

        imagePreview.appendChild(container);
    });

    // Add button
    const addButton = document.createElement("button");
    addButton.type = "button";
    addButton.id = "addImageBtn";
    addButton.className = "aspect-square rounded-lg border-2 border-dashed border-outline-variant flex flex-col items-center justify-center gap-1 hover:bg-surface-container-low transition-colors group";
    addButton.innerHTML = `
        <span class="material-symbols-outlined text-on-surface-variant text-[20px]">add_a_photo</span>
        <span class="text-[10px] font-label-md text-on-surface-variant">Add</span>
    `;
    addButton.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        productImages.click();
    });
    imagePreview.appendChild(addButton);
}

// Handle file selection
function handleFileSelection(files) {
    const validImageFiles = Array.from(files).filter(file => file.type.startsWith("image/"));
    if (validImageFiles.length === 0) {
        alert("Please select valid image files (JPG, PNG, WEBP).");
        return;
    }

    if (selectedFiles.length + validImageFiles.length > 5) {
        alert("Maximum 5 images are allowed in total.");
        return;
    }

    // Launch cropper queue
    cropper.startQueue(validImageFiles);
}

// File input change
productImages.addEventListener("change", (e) => {
    handleFileSelection(e.target.files);
    e.target.value = ""; // Reset input so same file can be re-selected if removed
});

// Click upload area
uploadArea.addEventListener("click", (e) => {
    if (e.target.closest("#cropMainImage") || e.target.closest("#removeMainImage")) {
        return;
    }
    productImages.click();
});

// Drag and drop support on upload area
["dragenter", "dragover"].forEach(eventName => {
    uploadArea.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        uploadArea.classList.add("border-primary", "bg-surface-container");
    });
});

["dragleave", "drop"].forEach(eventName => {
    uploadArea.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        uploadArea.classList.remove("border-primary", "bg-surface-container");
    });
});

uploadArea.addEventListener("drop", (e) => {
    const dt = e.dataTransfer;
    if (dt && dt.files && dt.files.length > 0) {
        handleFileSelection(dt.files);
    }
});

// Crop Main Image
cropMainImage.addEventListener("click", (e) => {
    e.preventDefault();
    e.stopPropagation();
    if (selectedFiles.length > 0) {
        cropper.startSingleRecrop(selectedFiles[0], 0);
    }
});

// Remove Main Image
removeMainImage.addEventListener("click", (e) => {
    e.preventDefault();
    e.stopPropagation();
    selectedFiles.shift();
    updateFileInput();
    displayImages();
});

// Gallery click: crop thumbnail or remove thumbnail
imagePreview.addEventListener("click", (e) => {
    const cropBtn = e.target.closest(".crop-thumbnail");
    if (cropBtn) {
        e.preventDefault();
        e.stopPropagation();
        const index = Number(cropBtn.dataset.index);
        if (selectedFiles[index]) {
            cropper.startSingleRecrop(selectedFiles[index], index);
        }
        return;
    }

    const removeBtn = e.target.closest(".remove-image");
    if (removeBtn) {
        e.preventDefault();
        e.stopPropagation();
        const index = Number(removeBtn.dataset.index);
        selectedFiles.splice(index, 1);
        updateFileInput();
        displayImages();
        return;
    }
});

// Form Submission Validation
document.getElementById("productForm").addEventListener("submit", (e) => {
    if (!productImages.files || productImages.files.length < 3) {
        e.preventDefault();
        alert("Please upload at least 3 product images.");
        return;
    }

    if (productImages.files.length > 5) {
        e.preventDefault();
        alert("Maximum 5 images are allowed.");
        return;
    }

    const variantRows = document.querySelectorAll("#variantTableBody tr");
    if (variantRows.length === 0) {
        e.preventDefault();
        alert("Please add at least one variant.");
        return;
    }
});
});
</script>

<script>

    const addVariantBtn = document.getElementById("addVariantBtn");
    const variantModal = document.getElementById("add-variant-modal");
    const closeVariantModal = document.getElementById("closeVariantModal");
    const cancelVariantBtn = document.getElementById("cancelVariantBtn");
    const saveVariantBtn = document.getElementById("saveVariantBtn");
    const variantTableBody = document.getElementById("variantTableBody");

    // =========================
    // Open modal
    // =========================

    addVariantBtn.addEventListener("click", () => {
        variantModal.classList.remove("hidden");
        variantModal.classList.add("flex");
        document.getElementById("variantWeight").focus();
    });

    // =========================
    // Close modal
    // =========================

    function closeModal() {
        variantModal.classList.add("hidden");
        variantModal.classList.remove("flex");
    }

    closeVariantModal.addEventListener("click", closeModal);
    cancelVariantBtn.addEventListener("click", closeModal);

    // =========================
    // Add variant to table
    // =========================

    saveVariantBtn.addEventListener("click", () => {

        const weight = document.getElementById("variantWeight").value.trim();
        const price = document.getElementById("variantPrice").value;
        const sku = document.getElementById("variantSku").value.trim();
        const stock = document.getElementById("variantStock").value;

        if (!weight || price === "" || !sku || stock === "") {
            alert("Please fill all variant fields.");
            return;
        }

        if (Number(price) < 0 || Number(stock) < 0) {
            alert("Price and stock cannot be negative.");
            return;
        }

        // Check duplicate SKU
        const existingSkuInputs = variantTableBody.querySelectorAll(
            'input[name*="[sku]"]'
        );

        for (const input of existingSkuInputs) {
            if (
                input.value.trim().toUpperCase() ===
                sku.toUpperCase()
            ) {
                alert("This SKU already exists.");
                return;
            }
        }

        const index = variantTableBody.querySelectorAll("tr").length;

        const row = document.createElement("tr");

        row.innerHTML = `
            <td class="p-4">
                <input
                    name="variants[${index}][weight]"
                    type="text"
                    value="${escapeHtml(weight)}"
                    required
                    class="w-full bg-transparent border-none p-0 text-body-md focus:ring-0"
                >
            </td>

            <td class="p-4">
                <input
                    name="variants[${index}][price]"
                    type="number"
                    value="${escapeHtml(price)}"
                    min="0"
                    step="0.01"
                    required
                    class="w-full bg-transparent border-none p-0 text-body-md focus:ring-0"
                >
            </td>

            <td class="p-4">
                <input
                    name="variants[${index}][sku]"
                    type="text"
                    value="${escapeHtml(sku.toUpperCase())}"
                    required
                    class="w-full bg-transparent border-none p-0 text-body-md focus:ring-0"
                >
            </td>

            <td class="p-4">
                <input
                    name="variants[${index}][stock_quantity]"
                    type="number"
                    value="${escapeHtml(stock)}"
                    min="0"
                    required
                    class="w-full bg-transparent border-none p-0 text-body-md focus:ring-0"
                >
            </td>

            <td class="p-4 text-center">
                <button
                    type="button"
                    class="remove-variant text-red-500 hover:text-red-700 transition"
                    aria-label="Remove variant"
                >
                    <span class="material-symbols-outlined">delete</span>
                </button>
            </td>
        `;

        variantTableBody.appendChild(row);

        // Clear modal
        document.getElementById("variantWeight").value = "";
        document.getElementById("variantPrice").value = "";
        document.getElementById("variantSku").value = "";
        document.getElementById("variantStock").value = "";

        closeModal();
    });

    // =========================
    // Remove variant
    // =========================

    variantTableBody.addEventListener("click", (event) => {

        const removeButton = event.target.closest(".remove-variant");

        if (!removeButton) return;

        const rows = variantTableBody.querySelectorAll("tr");

        if (rows.length <= 1) {
            alert("At least one variant is required.");
            return;
        }

        removeButton.closest("tr").remove();

        updateVariantIndexes();
    });

    // =========================
    // Re-index variant names
    // =========================

    function updateVariantIndexes() {

        const rows = variantTableBody.querySelectorAll("tr");

        rows.forEach((row, index) => {

            const weight = row.querySelector('input[name*="[weight]"]');
            const price = row.querySelector('input[name*="[price]"]');
            const sku = row.querySelector('input[name*="[sku]"]');
            const stock = row.querySelector(
                'input[name*="[stock_quantity]"]'
            );

            if (weight) {
                weight.name = `variants[${index}][weight]`;
            }

            if (price) {
                price.name = `variants[${index}][price]`;
            }

            if (sku) {
                sku.name = `variants[${index}][sku]`;
            }

            if (stock) {
                stock.name = `variants[${index}][stock_quantity]`;
            }
        });
    }

    // =========================
    // Escape user-entered values
    // =========================

    function escapeHtml(value) {
        return String(value)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }

    // =========================
    // Close outside modal
    // =========================

    variantModal.addEventListener("click", (event) => {
        if (event.target === variantModal) {
            closeModal();
        }
    });

    // =========================
    // Escape key
    // =========================

    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
            closeModal();
        }
    });

</script>

