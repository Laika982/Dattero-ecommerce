<script>
    // Standardized sidebar and top bar interactions
    const inputs = document.querySelectorAll('input, textarea, select');
    inputs.forEach(input => {
        input.addEventListener('focus', () => {
            if (input.closest('.col-span-8, .col-span-4')) {
                input.closest('div').classList.add('scale-[1.005]');
                input.closest('div').classList.add('transition-transform');
            }
        });
        input.addEventListener('blur', () => {
            if (input.closest('.col-span-8, .col-span-4')) {
                input.closest('div').classList.remove('scale-[1.005]');
            }
        });
    });
</script>
<script>

const uploadArea = document.getElementById("uploadArea");
const uploadContent = document.getElementById("uploadContent");

const productImages = document.getElementById("productImages");

const mainImage = document.getElementById("mainImage");
const removeMainImage = document.getElementById("removeMainImage");

const addImageBtn = document.getElementById("addImageBtn");
const imagePreview = document.getElementById("imagePreview");

let selectedFiles = [];


// =====================================
// OPEN FILE PICKER
// =====================================

uploadArea.addEventListener("click", function () {

    productImages.click();

});


// =====================================
// ADD IMAGE BUTTON
// =====================================

addImageBtn.addEventListener("click", function (event) {

    event.preventDefault();

    event.stopPropagation();

    productImages.click();

});


// =====================================
// FILE SELECTED
// =====================================

productImages.addEventListener("change", function (event) {

    const files = Array.from(event.target.files);

    console.log("Selected:", files);

    if (files.length === 0) {
        return;
    }


    // Maximum 5 images

    if (selectedFiles.length + files.length > 5) {

        alert("Maximum 5 images are allowed.");

        return;
    }


    selectedFiles = [
        ...selectedFiles,
        ...files
    ];


    updateFileInput();

    displayImages();

});


// =====================================
// UPDATE FILE INPUT
// =====================================

function updateFileInput() {

    const dataTransfer = new DataTransfer();

    selectedFiles.forEach(function (file) {

        dataTransfer.items.add(file);

    });

    productImages.files = dataTransfer.files;


    console.log(
        "Files in input:",
        productImages.files.length
    );

}


// =====================================
// DISPLAY IMAGES
// =====================================

function displayImages() {

    imagePreview.innerHTML = "";


    // MAIN IMAGE

    if (selectedFiles.length > 0) {

        const reader = new FileReader();

        reader.onload = function (event) {

            mainImage.src = event.target.result;

            mainImage.classList.remove("hidden");

            uploadContent.classList.add("hidden");

            removeMainImage.classList.remove("hidden");

        };

        reader.readAsDataURL(
            selectedFiles[0]
        );

    }


    // OTHER IMAGES

    selectedFiles
        .slice(1)
        .forEach(function (file, index) {

            const actualIndex = index + 1;

            const reader = new FileReader();

            reader.onload = function (event) {

                const container =
                    document.createElement("div");

                container.className =
                    "relative aspect-square rounded-lg overflow-hidden border";


                container.innerHTML = `

                    <img
                        src="${event.target.result}"
                        class="w-full h-full object-cover"
                    >

                    <button
                        type="button"
                        class="remove-image absolute top-2 right-2 w-7 h-7 rounded-full bg-black/70 text-white"
                        data-index="${actualIndex}"
                    >
                        ×
                    </button>

                `;

                imagePreview.appendChild(container);

            };

            reader.readAsDataURL(file);

        });


    // ADD BUTTON

    const addButton =
        document.createElement("button");

    addButton.type = "button";

    addButton.className =
        "aspect-square rounded-lg border-2 border-dashed flex items-center justify-center";


    addButton.innerHTML = `

        <span class="material-symbols-outlined">
            add_a_photo
        </span>

    `;


    addButton.addEventListener("click", function (event) {

        event.preventDefault();

        event.stopPropagation();

        productImages.click();

    });


    imagePreview.appendChild(addButton);

}


// =====================================
// REMOVE IMAGE
// =====================================

imagePreview.addEventListener("click", function (event) {

    const button =
        event.target.closest(".remove-image");

    if (!button) {
        return;
    }

    const index =
        Number(button.dataset.index);

    selectedFiles.splice(index, 1);

    updateFileInput();

    displayImages();

});


// =====================================
// REMOVE MAIN IMAGE
// =====================================

removeMainImage.addEventListener(
    "click",
    function (event) {

        event.preventDefault();

        event.stopPropagation();

        selectedFiles.shift();

        updateFileInput();

        displayImages();

    }
);

</script>
<script>

    const uploadArea = document.getElementById("uploadArea");
    const productImages = document.getElementById("productImages");

    // your existing image upload code...


    function updateFileInput() {

        const dataTransfer = new DataTransfer();

        selectedFiles.forEach(file => {
            dataTransfer.items.add(file);
        });

        productImages.files = dataTransfer.files;
    }


    // ==============================
    // FORM SUBMISSION VALIDATION
    // ==============================

    document
        .getElementById("productForm")
        .addEventListener("submit", (event) => {

            console.log(
                "FILES BEFORE SUBMIT:",
                productImages.files
            );

            console.log(
                "FILE COUNT:",
                productImages.files.length
            );

            // Validate images
            if (!productImages.files || productImages.files.length < 3) {
                event.preventDefault();
                alert("Please upload at least 3 product images.");
                return;
            }

            // Validate variants
            const variantRows = document.querySelectorAll("#variantTableBody tr");
            if (variantRows.length === 0) {
                event.preventDefault();
                alert("Please add at least one variant.");
                return;
            }

        });

