<div id="couponDeleteModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/40 backdrop-blur-sm" role="presentation">
    <section class="w-full max-w-md mx-4 bg-white rounded-2xl shadow-xl p-6" role="dialog" aria-modal="true" aria-labelledby="couponDeleteTitle">
        <div class="flex items-center justify-between mb-4">
            <h2 id="couponDeleteTitle" class="text-xl font-semibold text-gray-900">Confirm Delete</h2>
            <button type="button" id="closeCouponDeleteModal" class="text-gray-400 hover:text-gray-700" aria-label="Close confirmation">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <p class="text-gray-600 mb-6">Are you sure you want to delete coupon <strong id="couponDeleteCode"></strong>? This action cannot be undone.</p>
        <div class="flex justify-end gap-3">
            <button type="button" id="cancelCouponDelete" class="px-5 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100">Cancel</button>
            <button type="button" id="confirmCouponDelete" class="px-5 py-2 rounded-lg bg-red-600 text-white hover:bg-red-700">Delete</button>
        </div>
    </section>
</div>
<script>
    const couponDeleteModal = document.getElementById("couponDeleteModal");
    const couponDeleteCode = document.getElementById("couponDeleteCode");
    const confirmCouponDelete = document.getElementById("confirmCouponDelete");
    let selectedCouponId = null;

    function closeCouponDeleteModal() {
        couponDeleteModal.classList.add("hidden");
        couponDeleteModal.classList.remove("flex");
        selectedCouponId = null;
    }

    document.querySelectorAll(".delete-coupon-btn").forEach((button) => {
        button.addEventListener("click", () => {
            selectedCouponId = button.dataset.id;
            couponDeleteCode.textContent = button.dataset.code;
            couponDeleteModal.classList.remove("hidden");
            couponDeleteModal.classList.add("flex");
        });
    });

    document.getElementById("cancelCouponDelete").addEventListener("click", closeCouponDeleteModal);
    document.getElementById("closeCouponDeleteModal").addEventListener("click", closeCouponDeleteModal);
    couponDeleteModal.addEventListener("click", (event) => {
        if (event.target === couponDeleteModal) closeCouponDeleteModal();
    });

    confirmCouponDelete.addEventListener("click", () => {
        if (!selectedCouponId) return;
        const form = document.createElement("form");
        form.method = "POST";
        form.action = `/admin/coupons/${encodeURIComponent(selectedCouponId)}?_method=DELETE`;
        document.body.appendChild(form);
        form.submit();
    });
</script>
<script>
        document.querySelectorAll('tbody tr').forEach(row => {
            row.addEventListener('click', (e) => {
                if (e.target.closest('button')) return;
                // Action for selecting a row
                console.log('Row clicked:', row.querySelector('.font-bold.font-body-md').innerText);
            });
        });

        // Admin Search Input with dynamic close button
        document.querySelectorAll('.admin-search-form').forEach((form) => {
            const input = form.querySelector('.admin-search-input');
            const clearBtn = form.querySelector('.admin-search-clear');
            const baseUrl = form.dataset.baseUrl || form.getAttribute('action');

            if (!input || !clearBtn) return;

            function toggleClearBtn() {
                if (input.value && input.value.trim().length > 0) {
                    clearBtn.classList.remove('hidden');
                    clearBtn.classList.add('flex');
                } else {
                    clearBtn.classList.add('hidden');
                    clearBtn.classList.remove('flex');
                }
            }

            input.addEventListener('input', toggleClearBtn);
            input.addEventListener('keyup', toggleClearBtn);
            input.addEventListener('change', toggleClearBtn);

            clearBtn.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();

                const hadSearch = new URLSearchParams(window.location.search).has('search');
                input.value = '';
                toggleClearBtn();
                input.focus();

                if (hadSearch) {
                    const urlParams = new URLSearchParams(window.location.search);
                    urlParams.delete('search');
                    urlParams.delete('page');
                    const queryStr = urlParams.toString();
                    window.location.href = queryStr ? `${baseUrl}?${queryStr}` : baseUrl;
                }
            });

            toggleClearBtn();
        });
    </script>




