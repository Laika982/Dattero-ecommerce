<style>
        body {
            background-color: #fbf9f9;
            color: #1b1c1c;
            -webkit-font-smoothing: antialiased;
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .glass-effect {
            backdrop-filter: blur(12px);
            background-color: rgba(251, 249, 249, 0.8);
        }
        .bento-card {
            background: #ffffff;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border: 1px solid rgba(0,0,0,0.05);
        }
        .bento-card:hover {
            box-shadow: 0 40px 40px rgba(0, 0, 0, 0.04);
            transform: translateY(-2px);
        }
        /* Custom scrollbar for minimalist look */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #e3e2e2; border-radius: 10px; }
    </style>
</head>
<body class="font-body-md text-body-md overflow-x-hidden">
<!-- SideNavBar Shell -->
 {{> admin/aside}}
<!-- Main Content Area -->
<main class="ml-64 min-h-screen flex flex-col">
<!-- TopNavBar -->
{{> admin/header}}
<!-- Canvas -->
<div class="p-container-padding flex-1">
<!-- Page Header -->
<div class="mb-10 flex justify-between items-end">
<div>
<h2 class="font-headline-xl text-headline-xl text-on-surface mb-2">Customer Management</h2>
<p class="font-body-lg text-on-surface-variant max-w-2xl opacity-70">Oversee your elite customer base, track lifetime value, and manage exclusive luxe tiers.</p>
</div>
<div class="flex gap-4">


</div>
</div>
<!-- Dashboard Stats Bar -->
<div class="grid grid-cols-4 gap-6 mb-10">
<div class="bento-card p-6 rounded-xl flex items-center justify-between">
<div>
<p class="text-[11px] uppercase tracking-widest text-on-surface-variant mb-1">Total Customers</p>
<h3 class="font-headline-lg text-headline-lg">{{this.count}}</h3>
</div>
<div class="p-3 bg-primary/5 rounded-full">
<span class="material-symbols-outlined text-primary">groups</span>
</div>
</div>
<div class="bento-card p-6 rounded-xl flex items-center justify-between">
<div>
<p class="text-[11px] uppercase tracking-widest text-on-surface-variant mb-1">Average LTV</p>
<h3 class="font-headline-lg text-headline-lg">₹4,250</h3>
</div>
<div class="p-3 bg-secondary/5 rounded-full">
<span class="material-symbols-outlined text-secondary">payments</span>
</div>
</div>


</div>
<!-- Detailed Table Container -->
<div class="bento-card rounded-2xl overflow-hidden mb-section-gap">
<!-- Filters & Search Toolbar -->
<div class="p-6 border-b border-outline-variant/30 flex items-center justify-between bg-surface-container-lowest">
<div class="flex items-center gap-4">
<div class="flex bg-surface-container-low p-1 rounded-lg">



</div>
<div class="h-6 w-[1px] bg-outline-variant/50"></div>
<button class="flex items-center gap-2 px-3 py-1.5 font-label-md text-on-surface-variant hover:text-primary">
<span class="material-symbols-outlined text-[20px]">filter_list</span>
                            More Filters
                        </button>
</div>
<div class="text-on-surface-variant font-label-md">
                        Showing {{this.page}}-{{this.totalPages}} of {{this.count}}results
                    </div>
</div>
<!-- Table Content -->
<div class="overflow-x-auto">
    <table class="w-full table-fixed text-left">

        <!-- Column widths -->
        <colgroup>
            <col class="w-[32%]">
            <col class="w-[18%]">
            <col class="w-[18%]">
            <col class="w-[15%]">
            <col class="w-[17%]">
        </colgroup>

        <thead>
            <tr class="bg-surface-container-low/50">

                <!-- Customer -->
                <th class="px-6 py-4 text-left font-label-md text-on-surface-variant border-b border-outline-variant/20">
                    <div class="flex items-center gap-2">
                        Customer
                        <span class="material-symbols-outlined text-[16px]">
                            arrow_drop_down
                        </span>
                    </div>
                </th>

                <!-- Phone -->
                <th class="px-6 py-4 text-left font-label-md text-on-surface-variant border-b border-outline-variant/20">
                    Phone Number
                </th>

                <!-- Join Date -->
                <th class="px-6 py-4 text-left font-label-md text-on-surface-variant border-b border-outline-variant/20">
                    Join Date
                </th>

                <!-- Status -->
                <th class="px-6 py-4 text-left font-label-md text-on-surface-variant border-b border-outline-variant/20">
                    Status
                </th>

                <!-- Actions -->
                <th class="px-6 py-4 text-right font-label-md text-on-surface-variant border-b border-outline-variant/20">
                    Actions
                </th>

            </tr>
        </thead>


        <tbody class="divide-y divide-outline-variant/10">

            {{#each data}}

            <tr class="hover:bg-surface-variant/30 transition-colors cursor-pointer group bg-primary/5">

                <!-- Customer -->
                <td class="px-6 py-5 align-middle">

                    <div class="flex items-center gap-3">

                        <div class="w-10 h-10 flex-shrink-0 rounded-full bg-surface-container-high overflow-hidden">
                            <img
                                class="w-full h-full object-cover"
                                src="https://lh3.googleusercontent.com/aida-public/AB6AXuC11aKUo2hVOMBq1U3n3MluU1uw9WyKh3IejLn5ciRzvQve8r14fSyXvYPiLPdHrJYMyq1Xxn9WO9q6VRQXMuQk53AVpByFGSXv01Gf4jDfTTqUyZzyanX5_VTwmAis8jaqYPL708Cf6aRqybiaPc9ZJ6jTzTTt_EEcSeDGz4_yaBW8YYABnHxCHUPtkelltq5mUWXANRHSFnJZ6AI9oSnFW-9LnJCodHzVrjk2IWqC8-sGNyUyeBn2MbVEAyzvSywRhCWLLiAXEog"
                                alt="Customer"
                            >
                        </div>

                        <div class="min-w-0">
                            <p class="font-label-md text-on-surface truncate">
                                {{this.name}}
                            </p>

                            <p class="text-[12px] text-on-surface-variant truncate">
                                {{this.email}}
                            </p>
                        </div>

                    </div>

                </td>


                <!-- Phone -->
                <td class="px-6 py-5 align-middle text-left text-on-surface-variant font-body-md">
                    {{this.phone}}
                </td>


                <!-- Created Date -->
                <td class="px-6 py-5 align-middle text-left text-on-surface-variant font-body-md">
                    {{this.createdAt}}
                </td>


                <!-- Status -->
                <td class="px-6 py-5 align-middle text-left">

                    {{#if this.isBlocked}}

                        <span class="inline-flex px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-error/10 text-error">
                            Blocked
                        </span>

                    {{else}}

                        <span class="inline-flex px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-surface-container text-on-surface-variant">
                            Active
                        </span>

                    {{/if}}

                </td>


                <!-- Actions -->
<td class="px-6 py-5 align-middle text-right">
{{#if this.isBlocked}}

    <form
        action="/admin/unblockCustomer?id={{this._id}}"
        method="POST"
        class="unblock-customer-form inline"
    >
        <button
            type="button"
            class="unblock-customer-btn inline-flex items-center justify-center bg-green-500 hover:bg-green-600 text-white font-medium px-4 py-2 rounded-lg transition-colors shadow-sm"
        >
            Unblock
        </button>
    </form>

{{else}}

    <form
        action="/admin/blockCustomer?id={{this._id}}"
        method="POST"
        class="block-customer-form inline"
    >
        <button
            type="button"
            class="block-customer-btn inline-flex items-center justify-center bg-red-500 hover:bg-red-600 text-white font-medium px-4 py-2 rounded-lg transition-colors shadow-sm"
        >
            Block
        </button>
    </form>

{{/if}}

</td>

            </tr>

            {{/each}}

        </tbody>

    </table>
</div>
<!-- Pagination -->
<div class="p-6 flex items-center justify-between bg-surface-container-low/30 border-t border-outline-variant/20">
<div class="flex items-center gap-2">
<button class="w-8 h-8 flex items-center justify-center rounded-lg border border-outline-variant/30 text-on-surface-variant hover:bg-white transition-colors">
<span class="material-symbols-outlined text-[18px]">chevron_left</span>
</button>
<button class="w-8 h-8 flex items-center justify-center rounded-lg bg-primary text-on-primary font-label-md">1</button>
<button class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-white transition-colors font-label-md">2</button>
<button class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-white transition-colors font-label-md">3</button>
<span class="px-1 text-on-surface-variant">...</span>
<button class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-white transition-colors font-label-md">856</button>
<button class="w-8 h-8 flex items-center justify-center rounded-lg border border-outline-variant/30 text-on-surface-variant hover:bg-white transition-colors">
<span class="material-symbols-outlined text-[18px]">chevron_right</span>
</button>
</div>
<div class="flex items-center gap-3">
<span class="text-on-surface-variant font-label-md">Go to page:</span>
<input class="w-12 h-8 rounded-lg border border-outline-variant/30 bg-white text-center font-label-md focus:ring-1 focus:ring-primary/20 outline-none" type="text" value="1">
</div>
</div>
</div>
<!-- Contextual Insights Section (Bento Style) -->
<div class="grid grid-cols-12 gap-6 mb-section-gap">


</div>
</div>
<!-- Footer Shell -->
<footer class="mt-auto py-8 px-container-padding bg-surface border-t border-outline-variant/10 text-center">

</footer>

<!-- Block Customer Confirmation Modal -->

<div
    id="blockModal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 backdrop-blur-sm"
>
    <div
        class="bg-white rounded-2xl shadow-xl w-full max-w-md mx-4 p-6"
    >

        <!-- Icon -->
        <div class="flex justify-center mb-4">
            <div class="w-14 h-14 rounded-full bg-red-100 flex items-center justify-center">

                <span class="material-symbols-outlined text-red-500 text-3xl">
                    block
                </span>

            </div>
        </div>


        <!-- Title -->
        <h2 class="text-xl font-bold text-gray-800 text-center">
            Block Customer?
        </h2>


        <!-- Message -->
        <p class="text-sm text-gray-500 text-center mt-2">
            Are you sure you want to block this customer?
            They will not be able to access their account.
        </p>


        <!-- Buttons -->
        <div class="flex justify-center gap-3 mt-6">

            <button
                type="button"
                id="cancelBlock"
                class="px-5 py-2.5 rounded-lg border border-gray-200 text-gray-600 hover:bg-gray-50 transition"
            >
                Cancel
            </button>


            <button
                type="button"
                id="confirmBlock"
                class="px-5 py-2.5 rounded-lg bg-red-500 text-white hover:bg-red-600 transition"
            >
                Block
            </button>

        </div>

    </div>
</div>

<!-- Unblock Customer Confirmation Modal -->

<div
    id="unblockModal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 backdrop-blur-sm"
>
    <div
        class="bg-white rounded-2xl shadow-xl w-full max-w-md mx-4 p-6"
    >

        <!-- Icon -->
        <div class="flex justify-center mb-4">
            <div class="w-14 h-14 rounded-full bg-green-100 flex items-center justify-center">

                <span class="material-symbols-outlined text-green-500 text-3xl">
                    check_circle
                </span>

            </div>
        </div>


        <!-- Title -->
        <h2 class="text-xl font-bold text-gray-800 text-center">
            Unblock Customer?
        </h2>


        <!-- Message -->
        <p class="text-sm text-gray-500 text-center mt-2">
            Are you sure you want to unblock this customer?
            They will be able to access their account again.
        </p>


        <!-- Buttons -->
        <div class="flex justify-center gap-3 mt-6">

            <button
                type="button"
                id="cancelUnblock"
                class="px-5 py-2.5 rounded-lg border border-gray-200 text-gray-600 hover:bg-gray-50 transition"
            >
                Cancel
            </button>

            <button
                type="button"
                id="confirmUnblock"
                class="px-5 py-2.5 rounded-lg bg-green-500 text-white hover:bg-green-600 transition"
            >
                Unblock
            </button>

        </div>

    </div>
</div>
</main>
<!-- Interactions Script -->
<script>
        // Simple row selection toggle
        document.querySelectorAll('tbody tr').forEach(row => {
            row.addEventListener('click', () => {
                // Visual feedback only for demo
                row.classList.toggle('bg-primary/5');
            });
        });

        // Search highlight interaction
        const searchInput = document.querySelector('input[type="text"]');
        searchInput.addEventListener('focus', () => {
            searchInput.parentElement.classList.add('scale-[1.01]');
        });
        searchInput.addEventListener('blur', () => {
            searchInput.parentElement.classList.remove('scale-[1.01]');
        });
    </script>

<script>

    // =========================
    // BLOCK
    // =========================

    const blockModal = document.getElementById("blockModal");
    const cancelBlock = document.getElementById("cancelBlock");
    const confirmBlock = document.getElementById("confirmBlock");

    let selectedBlockForm = null;

    document.querySelectorAll(".block-customer-btn").forEach(button => {

        button.addEventListener("click", function (event) {

            event.stopPropagation();

            selectedBlockForm =
                this.closest(".block-customer-form");

            blockModal.classList.remove("hidden");
            blockModal.classList.add("flex");

        });

    });

    cancelBlock.addEventListener("click", function () {

        blockModal.classList.add("hidden");
        blockModal.classList.remove("flex");

        selectedBlockForm = null;

    });

    confirmBlock.addEventListener("click", function () {

        if (selectedBlockForm) {
            selectedBlockForm.submit();
        }

    });


    // =========================
    // UNBLOCK
    // =========================

    const unblockModal = document.getElementById("unblockModal");
    const cancelUnblock = document.getElementById("cancelUnblock");
    const confirmUnblock = document.getElementById("confirmUnblock");

    let selectedUnblockForm = null;

    document.querySelectorAll(".unblock-customer-btn").forEach(button => {

        button.addEventListener("click", function (event) {

            event.stopPropagation();

            selectedUnblockForm =
                this.closest(".unblock-customer-form");

            unblockModal.classList.remove("hidden");
            unblockModal.classList.add("flex");

        });

    });

    cancelUnblock.addEventListener("click", function () {

        unblockModal.classList.add("hidden");
        unblockModal.classList.remove("flex");

        selectedUnblockForm = null;

    });

    confirmUnblock.addEventListener("click", function () {

        if (selectedUnblockForm) {
            selectedUnblockForm.submit();
        }

    });


    // =========================
    // CLICK OUTSIDE
    // =========================

    if (blockModal) {

        blockModal.addEventListener("click", function (event) {

            if (event.target === blockModal) {

                blockModal.classList.add("hidden");
                blockModal.classList.remove("flex");

                selectedBlockForm = null;
            }

        });

    }


    if (unblockModal) {

        unblockModal.addEventListener("click", function (event) {

            if (event.target === unblockModal) {

                unblockModal.classList.add("hidden");
                unblockModal.classList.remove("flex");

                selectedUnblockForm = null;
            }

        });

    }

</script>




</body></html>