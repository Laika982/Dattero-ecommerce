<!-- Pagination -->
<div class="p-6 flex items-center justify-between bg-surface-container-low/30 border-t border-outline-variant/20">

    <div class="flex items-center gap-2">

        {{#if (gt currentPage 1)}}
            <a
                href="/admin/customer/customers?page={{subtract currentPage 1}}{{#if search}}&search={{search}}{{/if}}"
                class="w-8 h-8 flex items-center justify-center rounded-lg border border-outline-variant/30 text-on-surface-variant hover:bg-white transition-colors"
            >
                <span class="material-symbols-outlined text-[18px]">
                    chevron_left
                </span>
            </a>
        {{/if}}


        {{#each pages}}

            {{#if this.active}}

                <a
                    href="/admin/customer/customers?page={{this.page}}{{#if ../search}}&search={{../search}}{{/if}}"
                    class="w-8 h-8 flex items-center justify-center rounded-lg bg-primary text-on-primary font-label-md"
                >
                    {{this.page}}
                </a>

            {{else}}

                <a
                    href="/admin/customer/customers?page={{this.page}}{{#if ../search}}&search={{../search}}{{/if}}"
                    class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-white transition-colors font-label-md"
                >
                    {{this.page}}
                </a>

            {{/if}}

        {{/each}}


        {{#if (lt currentPage totalPages)}}
            <a
                href="/admin/customer/customers?page={{add currentPage 1}}{{#if search}}&search={{search}}{{/if}}"
                class="w-8 h-8 flex items-center justify-center rounded-lg border border-outline-variant/30 text-on-surface-variant hover:bg-white transition-colors"
            >
                <span class="material-symbols-outlined text-[18px]">
                    chevron_right
                </span>
            </a>
        {{/if}}

    </div>


    <!-- Go to page -->
    <form action="/admin/customer/customers" method="GET" class="flex items-center gap-3">

        <span class="text-on-surface-variant font-label-md">
            Go to page:
        </span>

        <input
            class="w-12 h-8 rounded-lg border border-outline-variant/30 bg-white text-center font-label-md focus:ring-1 focus:ring-primary/20 outline-none"
            type="number"
            name="page"
            min="1"
            max="{{totalPages}}"
            value="{{currentPage}}"
        >

        {{#if search}}
            <input
                type="hidden"
                name="search"
                value="{{search}}"
