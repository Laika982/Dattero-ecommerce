<style>
        body {
            background-color: #fbf9f9;
            color: #1b1c1c;
            -webkit-font-smoothing: antialiased;
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .glass-effect {
            backdrop-filter: blur(12px);
            background-color: rgba(251, 249, 249, 0.8);
        }
        .bento-card {
            background: #ffffff;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border: 1px solid rgba(0,0,0,0.05);
        }
        .bento-card:hover {
            box-shadow: 0 40px 40px rgba(0, 0, 0, 0.04);
            transform: translateY(-2px);
        }
        /* Custom scrollbar for minimalist look */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #e3e2e2; border-radius: 10px; }
    </style>
</head>
<body class="font-body-md text-body-md overflow-x-hidden">
<!-- SideNavBar Shell -->
 {{> admin/aside}}
<!-- Main Content Area -->

<main class="lg:ml-64 ml-0 min-h-screen flex flex-col">
    {{> user/notification}}
<!-- TopNavBar -->
<header class="sticky top-0 z-40 bg-surface/80 backdrop-blur-md border-b border-outline-variant/30 h-16 flex justify-between items-center px-4 sm:px-6 md:px-container-padding">
    <!-- Left: Mobile Sidebar Toggle & Search Form -->
    <div class="flex items-center flex-1 max-w-lg gap-2 sm:gap-3 mr-4">
        <button type="button" class="lg:hidden p-2 rounded-lg text-on-surface-variant hover:text-ink-black hover:bg-surface-variant/50 transition-colors touch-target shrink-0" onclick="toggleAdminSidebar()" aria-label="Toggle Navigation">
            <span class="material-symbols-outlined text-[22px]">menu</span>
        </button>

        <form action="/admin/customer/customers" method="GET" class="relative w-full flex items-center admin-search-form" data-base-url="/admin/customer/customers">
            <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px] pointer-events-none">
                search
            </span>

            <input
                class="admin-search-input w-full bg-surface-container-low border border-outline-variant/30 focus:border-transparent rounded-full pl-10 pr-24 py-2 text-sm sm:text-body-md text-on-surface focus:ring-2 focus:ring-primary focus:outline-none transition-all placeholder:text-on-surface-variant/40"
                placeholder="Search customers, name, email..."
                type="text"
                name="search"
                value="{{search}}"
                autocomplete="off"
            >

            <!-- Close / Clear Button (Visible only when text is inside input) -->
            <button
                type="button"
                class="admin-search-clear absolute right-[84px] top-1/2 -translate-y-1/2 z-10 w-6 h-6 items-center justify-center rounded-full text-on-surface-variant hover:bg-surface-container-high hover:text-error transition-all cursor-pointer {{#if search}}flex{{else}}hidden{{/if}}"
                title="Clear search"
                aria-label="Clear search"
            >
                <span class="material-symbols-outlined text-[16px] pointer-events-none">close</span>
            </button>

            <!-- Search Button -->
            <button
                type="submit"
                class="absolute right-1 top-1/2 -translate-y-1/2 px-4 py-1.5 rounded-full bg-primary text-on-primary text-xs sm:text-sm font-semibold hover:opacity-90 active:scale-95 transition-all shadow-sm"
            >
                Search
            </button>
        </form>
    </div>

    <!-- Right Side: Store link, Notifications, Admin Profile -->
    <div class="flex items-center gap-3 sm:gap-5 shrink-0">
        <a href="/" target="_blank"
            class="hidden sm:inline-flex items-center gap-2 px-3.5 py-1.5 border border-outline-variant/30 rounded-full hover:bg-surface-variant transition-colors active:scale-95 text-on-surface-variant text-xs sm:text-sm font-label-md">
            <span class="material-symbols-outlined text-[18px]">visibility</span>
            <span>View Store</span>
        </a>

        <!-- Notifications -->
        <button class="p-2 text-on-surface-variant hover:text-primary transition-colors active:scale-95 relative" title="Notifications" aria-label="Notifications">
            <span class="material-symbols-outlined text-[20px]">notifications</span>
        </button>

        <div class="h-6 w-[1px] bg-outline-variant/30 hidden sm:block"></div>

        <!-- Admin Profile -->
        <div class="flex items-center gap-2.5 cursor-pointer group">
            <div class="text-right hidden md:block">
                <p class="font-label-md text-xs sm:text-sm text-on-surface font-semibold leading-tight">Admin</p>
                <p class="text-[10px] text-on-surface-variant/70">Nutri Luxe Admin</p>
            </div>
            <div class="w-8 h-8 rounded-full overflow-hidden bg-surface-container-highest border border-outline-variant/30 flex items-center justify-center text-on-surface-variant group-hover:scale-105 transition-transform">
                <span class="material-symbols-outlined text-[20px]">person</span>
            </div>
        </div>
    </div>
</header>
<!-- Canvas -->
<div class="p-container-padding flex-1">
<!-- Page Header -->
<div class="mb-10 flex justify-between items-end">
<div>
<h2 class="font-headline-xl text-headline-xl text-on-surface mb-2">Customer Management</h2>
<p class="font-body-lg text-on-surface-variant max-w-2xl opacity-70">Oversee your elite customer base, track lifetime value, and manage exclusive luxe tiers.</p>
</div>
<div class="flex gap-4">


</div>
</div>
<!-- Dashboard Stats Bar -->
<div class="grid grid-cols-4 gap-6 mb-10">
<div class="bento-card p-6 rounded-xl flex items-center justify-between">
<div>
<p class="text-[11px] uppercase tracking-widest text-on-surface-variant mb-1">Total Customers</p>
<h3 class="font-headline-lg text-headline-lg">{{this.count}}</h3>
</div>
<div class="p-3 bg-primary/5 rounded-full">
<span class="material-symbols-outlined text-primary">groups</span>
</div>
</div>
{{!-- <div class="bento-card p-6 rounded-xl flex items-center justify-between">
<div>
<p class="text-[11px] uppercase tracking-widest text-on-surface-variant mb-1">Average LTV</p>
<h3 class="font-headline-lg text-headline-lg">₹4,250</h3>
</div>
<div class="p-3 bg-secondary/5 rounded-full">
<span class="material-symbols-outlined text-secondary">payments</span>
</div>
</div> --}}


</div>
<!-- Detailed Table Container -->
<div class="bento-card rounded-2xl overflow-hidden mb-section-gap">
<!-- Filters & Search Toolbar -->
<div class="p-6 border-b border-outline-variant/30 flex items-center justify-between bg-surface-container-lowest">
<div class="flex items-center gap-4">
<div class="flex bg-surface-container-low p-1 rounded-lg">



</div>
<div class="h-6 w-[1px] bg-outline-variant/50"></div>
{{!-- <button class="flex items-center gap-2 px-3 py-1.5 font-label-md text-on-surface-variant hover:text-primary">
<span class="material-symbols-outlined text-[20px]">filter_list</span>
                            More Filters
                        </button> --}}
</div>
<div class="text-on-surface-variant font-label-md">
                        Showing {{this.page}}-{{this.totalPages}} of {{this.count}}results
                    </div>
</div>
<!-- Table Content -->
<div class="overflow-x-auto">
    <table class="w-full table-fixed text-left">

        <!-- Column widths -->
        <colgroup>
            <col class="w-[32%]">
            <col class="w-[18%]">
            <col class="w-[18%]">
            <col class="w-[15%]">
            <col class="w-[17%]">
        </colgroup>

        <thead>
            <tr class="bg-surface-container-low/50">

                <!-- Customer -->
                <th class="px-6 py-4 text-left font-label-md text-on-surface-variant border-b border-outline-variant/20">
                    <div class="flex items-center gap-2">
                        Customer
                        <span class="material-symbols-outlined text-[16px]">
                            arrow_drop_down
                        </span>
                    </div>
                </th>

                <!-- Phone -->
                <th class="px-6 py-4 text-left font-label-md text-on-surface-variant border-b border-outline-variant/20">
                    Phone Number
                </th>

                <!-- Join Date -->
                <th class="px-6 py-4 text-left font-label-md text-on-surface-variant border-b border-outline-variant/20">
                    Join Date
                </th>

                <!-- Status -->
                <th class="px-6 py-4 text-left font-label-md text-on-surface-variant border-b border-outline-variant/20">
                    Status
                </th>

                <!-- Actions -->
                <th class="px-6 py-4 text-right font-label-md text-on-surface-variant border-b border-outline-variant/20">
                    Actions
                </th>

            </tr>
        </thead>


        <tbody class="divide-y divide-outline-variant/10">

            {{#each data}}

            <tr class="hover:bg-surface-variant/30 transition-colors cursor-pointer group bg-primary/5">

                <!-- Customer -->
                <td class="px-6 py-5 align-middle">

                    <div class="flex items-center gap-3">

                        <div class="w-10 h-10 flex-shrink-0 rounded-full bg-surface-container-high overflow-hidden">
                            <img
                                class="w-full h-full object-cover"
                                src="{{#if this.profileImage}}{{this.profileImage}}{{else}}/images/avathar.jpg{{/if}}"
                                alt="Customer"
                            >
                        </div>

                        <div class="min-w-0">
                            <p class="font-label-md text-on-surface truncate">
                                {{this.name}}
                            </p>

                            <p class="text-[12px] text-on-surface-variant truncate">
                                {{this.email}}
                            </p>
                        </div>

                    </div>

                </td>


                <!-- Phone -->
                <td class="px-6 py-5 align-middle text-left text-on-surface-variant font-body-md">
                    {{this.phone}}
                </td>

                <!-- Created Date -->
                <td class="px-6 py-5 align-middle text-left text-on-surface-variant font-body-md">
                    {{this.formattedDate}}
                </td>


                <!-- Status -->
                <td class="px-6 py-5 align-middle text-left">

                    {{#if this.isBlocked}}

                        <span class="inline-flex px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-error/10 text-error">
                            Blocked
                        </span>

                    {{else}}

                        <span class="inline-flex px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-surface-container text-on-surface-variant">
                            Active
                        </span>

                    {{/if}}

                </td>

                
                



                <!-- Actions -->
<td class="px-6 py-5 align-middle text-right">
    <a href="/admin/customer/editCustomer/{{this._id}}" class="p-1.5 rounded-lg border border-outline-variant/30 text-on-surface-variant hover:text-primary hover:bg-surface-variant transition-colors" title="Edit Customer"><span class="material-symbols-outlined text-[18px]">edit</span></a>
{{#if this.isBlocked}}

    <form
        action="/admin/customer/unblockCustomer?id={{this._id}}&_method=PATCH"
        method="POST"
        class="unblock-customer-form inline"
    >
        <button
            type="button"
            class="unblock-customer-btn inline-flex items-center justify-center bg-green-500 hover:bg-green-600 text-white font-medium px-4 py-2 rounded-lg transition-colors shadow-sm"
        >
            Unblock
        </button>
    </form>

{{else}}

    <form
        action="/admin/customer/blockCustomer?id={{this._id}}&_method=PATCH"
        method="POST"
        class="block-customer-form inline"
    >
        <button
            type="button"
            class="block-customer-btn inline-flex items-center justify-center bg-red-500 hover:bg-red-600 text-white font-medium px-4 py-2 rounded-lg transition-colors shadow-sm"
        >
            Block
        </button>
    </form>

{{/if}}

</td>

            </tr>

            {{/each}}

        </tbody>

    </table>
</div>
<!-- Pagination -->
<div class="p-6 flex items-center justify-between bg-surface-container-low/30 border-t border-outline-variant/20">

    <div class="flex items-center gap-2">

        {{#if (gt currentPage 1)}}
            <a
                href="/admin/customer/customers?page={{subtract currentPage 1}}{{#if search}}&search={{search}}{{/if}}"
                class="w-8 h-8 flex items-center justify-center rounded-lg border border-outline-variant/30 text-on-surface-variant hover:bg-white transition-colors"
            >
                <span class="material-symbols-outlined text-[18px]">
                    chevron_left
                </span>
            </a>
        {{/if}}


        {{#each pages}}

            {{#if this.active}}

                <a
                    href="/admin/customer/customers?page={{this.page}}{{#if ../search}}&search={{../search}}{{/if}}"
                    class="w-8 h-8 flex items-center justify-center rounded-lg bg-primary text-on-primary font-label-md"
                >
                    {{this.page}}
                </a>

            {{else}}

                <a
                    href="/admin/customer/customers?page={{this.page}}{{#if ../search}}&search={{../search}}{{/if}}"
                    class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-white transition-colors font-label-md"
                >
                    {{this.page}}
                </a>

            {{/if}}

        {{/each}}


        {{#if (lt currentPage totalPages)}}
            <a
                href="/admin/customer/customers?page={{add currentPage 1}}{{#if search}}&search={{search}}{{/if}}"
                class="w-8 h-8 flex items-center justify-center rounded-lg border border-outline-variant/30 text-on-surface-variant hover:bg-white transition-colors"
            >
                <span class="material-symbols-outlined text-[18px]">
                    chevron_right
                </span>
            </a>
        {{/if}}

    </div>


    <!-- Go to page -->
    <form action="/admin/customer/customers" method="GET" class="flex items-center gap-3">

        <span class="text-on-surface-variant font-label-md">
            Go to page:
        </span>

        <input
            class="w-12 h-8 rounded-lg border border-outline-variant/30 bg-white text-center font-label-md focus:ring-1 focus:ring-primary/20 outline-none"
            type="number"
            name="page"
            min="1"
            max="{{totalPages}}"
            value="{{currentPage}}"
        >

        {{#if search}}
            <input
                type="hidden"
                name="search"
                value="{{search}}"
            >
        {{/if}}

    </form>

</div>
<!-- Contextual Insights Section (Bento Style) -->
<div class="grid grid-cols-12 gap-6 mb-section-gap">


</div>
</div>
<!-- Footer Shell -->
<footer class="mt-auto py-8 px-container-padding bg-surface border-t border-outline-variant/10 text-center">

</footer>

<!-- Block Customer Confirmation Modal -->

<div
    id="blockModal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 backdrop-blur-sm"
>
    <div
        class="bg-white rounded-2xl shadow-xl w-full max-w-md mx-4 p-6"
    >

        <!-- Icon -->
        <div class="flex justify-center mb-4">
            <div class="w-14 h-14 rounded-full bg-red-100 flex items-center justify-center">

                <span class="material-symbols-outlined text-red-500 text-3xl">
                    block
                </span>

            </div>
        </div>


        <!-- Title -->
        <h2 class="text-xl font-bold text-gray-800 text-center">
