        dashboard.style.transition = 'opacity 0.6s ease-out, transform 0.6s ease-out';
        
        setTimeout(() => {
            dashboard.style.opacity = '1';
            dashboard.style.transform = 'translateY(0)';
        }, 50);

        // Interactive tooltips mock logic
        const chart = document.querySelector('svg');
