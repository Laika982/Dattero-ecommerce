<!-- Chart Setup and Filter Script -->
<script>
    const initialChartData = {{{chartDataJson}}};
    let salesChartInstance = null;

    function renderSalesChart(data) {
        const ctx = document.getElementById('salesChart');
        if (!ctx) return;

        if (salesChartInstance) {
            salesChartInstance.destroy();
        }

        const gradientRevenue = ctx.getContext('2d').createLinearGradient(0, 0, 0, 350);
        gradientRevenue.addColorStop(0, 'rgba(200, 155, 60, 0.4)');
        gradientRevenue.addColorStop(1, 'rgba(200, 155, 60, 0.0)');

        salesChartInstance = new Chart(ctx, {
            type: 'line',
            data: {
                labels: data.labels,
                datasets: [
                    {
                        label: 'Revenue (₹)',
                        data: data.revenueData,
                        borderColor: '#c89b3c',
                        backgroundColor: gradientRevenue,
                        borderWidth: 3,
                        fill: true,
                        tension: 0.35,
                        pointBackgroundColor: '#c89b3c',
                        pointBorderColor: '#ffffff',
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 6,
                        yAxisID: 'yRevenue'
                    },
                    {
                        label: 'Orders Count',
                        data: data.ordersData,
                        borderColor: '#1f2937',
                        backgroundColor: 'transparent',
                        borderWidth: 2,
                        borderDash: [4, 4],
                        tension: 0.35,
                        pointBackgroundColor: '#1f2937',
                        pointBorderColor: '#ffffff',
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 6,
                        yAxisID: 'yOrders'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    mode: 'index',
                    intersect: false
                },
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        backgroundColor: '#111827',
                        titleFont: { family: 'Plus Jakarta Sans', size: 13, weight: 'bold' },
                        bodyFont: { family: 'Inter', size: 12 },
                        padding: 12,
                        cornerRadius: 8,
                        callbacks: {
                            label: function(context) {
                                if (context.datasetIndex === 0) {
                                    return ' Revenue: ₹' + Number(context.raw).toLocaleString('en-IN');
                                }
                                return ' Orders: ' + context.raw;
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: {
                            display: false
                        },
                        ticks: {
                            font: { family: 'Inter', size: 12 },
                            color: '#6b7280'
                        }
                    },
                    yRevenue: {
                        type: 'linear',
                        display: true,
                        position: 'left',
                        grid: {
                            color: '#f3f4f6'
                        },
                        ticks: {
                            font: { family: 'Inter', size: 11 },
                            color: '#9ca3af',
                            callback: function(val) {
                                return '₹' + val.toLocaleString('en-IN');
                            }
                        }
                    },
                    yOrders: {
                        type: 'linear',
                        display: true,
                        position: 'right',
                        grid: {
                            drawOnChartArea: false
                        },
                        ticks: {
                            font: { family: 'Inter', size: 11 },
                            color: '#9ca3af',
                            precision: 0
                        }
                    }
                }
            }
        });
    }

    // Initialize Chart
    document.addEventListener('DOMContentLoaded', () => {
        renderSalesChart(initialChartData);

        // Filter button listeners
        const filterButtons = document.querySelectorAll('.filter-btn');
        const periodRevenueElem = document.getElementById('chartPeriodRevenue');
        const periodOrdersElem = document.getElementById('chartPeriodOrders');

        filterButtons.forEach(btn => {
            btn.addEventListener('click', async () => {
                const filter = btn.dataset.filter;
                if (btn.classList.contains('active')) return;

                filterButtons.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');

                try {
                    btn.disabled = true;
                    const res = await fetch(`/admin/dashboard/chart-data?filter=${encodeURIComponent(filter)}`);
                    const json = await res.json();
                    if (json && json.success) {
                        renderSalesChart(json);
                        if (periodRevenueElem) {
                            periodRevenueElem.textContent = '₹' + Number(json.totalRevenue).toLocaleString('en-IN');
                        }
                        if (periodOrdersElem) {
                            periodOrdersElem.textContent = json.totalOrders + ' Orders';
                        }
                    }
                } catch (err) {
                    console.error('Failed to load chart data:', err);
                } finally {
                    btn.disabled = false;
                }
            });
        });
    });
</script>
</body></html>