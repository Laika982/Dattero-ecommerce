<!-- Customer Photo Section -->
<div class="flex items-center gap-4">

  <!-- Current / Preview Image -->
  <div class="w-24 h-24">
    <img
      id="photoPreview"
      src="{{customer.profileImage}}"
      alt="Customer Photo"
      class="w-24 h-24 rounded-full object-cover border"
    >
  </div>

  <div class="flex flex-col gap-1 sm:flex-1 text-center sm:text-left">
    <span class="font-headline-lg text-body-sm font-semibold text-on-surface">
      Customer Avatar
    </span>

    <span class="font-body-sm text-body-sm text-on-surface-variant">
      Recommended size 400x400px. High-resolution portrait preferred.
    </span>
  </div>

  <div class="flex items-center gap-2">

    <!-- Change Photo -->
    <button
      id="changePhotoBtn"
      type="button"
      class="px-3.5 py-2 rounded-xl bg-surface text-on-surface font-label-md text-label-md shadow-sm hover:bg-surface-container-high transition-colors"
    >
      Change Photo
    </button>

    <!-- Hidden File Input -->
    <input
      type="file"
      id="photoInput"
      name="profileImage"
      accept="image/jpeg,image/png,image/webp"
      class="hidden"
    >

    <!-- Remove -->
    <button
      id="removePhotoBtn"
      type="button"
      class="px-3.5 py-2 rounded-xl text-error font-label-md text-label-md hover:bg-error-container/40 transition-colors"
    >
      Remove
    </button>

  </div>

</div>


<script>
  const changePhotoBtn = document.getElementById("changePhotoBtn");
  const photoInput = document.getElementById("photoInput");
  const photoPreview = document.getElementById("photoPreview");

  // Open file selector
  changePhotoBtn.addEventListener("click", () => {
    photoInput.click();
  });

  // Preview selected image
  photoInput.addEventListener("change", () => {

    const file = photoInput.files[0];

    if (!file) {
      return;
    }

    // Check if selected file is an image
    if (!file.type.startsWith("image/")) {
      alert("Please select an image file.");
      photoInput.value = "";
      return;
    }

    // Create temporary URL for preview
    const imageURL = URL.createObjectURL(file);

    // Show selected image
    photoPreview.src = imageURL;
  });
</script>


