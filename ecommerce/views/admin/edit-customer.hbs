<!DOCTYPE html>
<html class="light" lang="en">
<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <title>Nutri Luxe Admin - Edit Customer</title>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet">
  <link href="https://fonts.googleapis.com" rel="preconnect">
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=Plus+Jakarta+Sans:wght@700;800&amp;display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
  <style>
    html, body {
      margin: 0;
      padding: 0;
      overflow-x: hidden;
      overflow-y: auto;
      min-height: 100vh;
    }
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }
  </style>
  <script src="https://cdn.tailwindcss.com"></script>
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "on-surface": "#111827",
            "surface-container-low": "#f1f4f4",
            "error-container": "#ffdad6",
            "primary-fixed-dim": "#c8c6c5",
            "on-error": "#ffffff",
            "tertiary": "#000000",
            "on-primary-fixed-variant": "#474746",
            "on-primary-fixed": "#1c1b1b",
            "secondary": "#5e5e5e",
            "on-secondary-fixed-variant": "#464747",
            "on-tertiary-fixed-variant": "#5d4200",
            "tertiary-container": "#261900",
            "background": "#f3f4f6",
            "surface-container-lowest": "#ffffff",
            "outline-variant": "#c4c7c7",
            "surface": "#ffffff",
            "on-tertiary": "#ffffff",
            "on-secondary": "#ffffff",
            "surface-bright": "#f7fafa",
            "on-tertiary-fixed": "#261900",
            "brand-gold": "#c89b3c",
            "error": "#ba1a1a",
            "secondary-fixed": "#e4e2e2",
            "on-tertiary-container": "#a77d1f",
            "surface-tint": "#5f5e5e",
            "secondary-fixed-dim": "#c7c6c6",
            "inverse-surface": "#2d3131",
            "surface-container-highest": "#e0e3e3",
            "outline": "#747878",
            "surface-container-high": "#e5e9e8",
            "on-secondary-fixed": "#1b1c1c",
            "on-surface-variant": "#444748",
            "on-primary": "#ffffff",
            "tertiary-fixed-dim": "#f0bf5c",
            "inverse-primary": "#c8c6c5",
            "on-background": "#181c1d",
            "on-error-container": "#93000a",
            "inverse-on-surface": "#eef1f1",
            "surface-dim": "#d7dbda",
            "primary-container": "#1c1b1b",
            "tertiary-fixed": "#ffdea4",
            "primary": "#000000",
            "primary-fixed": "#e5e2e1",
            "surface-variant": "#e0e3e3",
            "on-secondary-container": "#636262",
            "on-primary-container": "#858383",
            "secondary-container": "#e1dfdf",
            "surface-container": "#ebeeee"
          },
          borderRadius: {
            "DEFAULT": "0.25rem",
            "lg": "0.5rem",
            "xl": "0.75rem",
            "full": "9999px"
          },
          spacing: {
            "stack-sm": "8px",
            "max-width": "1280px",
            "container-padding": "32px",
            "grid-gutter": "24px",
            "stack-lg": "24px",
            "stack-md": "16px",
            "section-gap": "48px"
          },
          fontFamily: {
            "label-sm": ["Inter"],
            "label-md": ["Inter"],
            "headline-lg": ["Plus Jakarta Sans"],
            "body-sm": ["Inter"],
            "body-md": ["Inter"],
            "display-lg": ["Plus Jakarta Sans"]
          },
          fontSize: {
            "label-sm": ["11px", { "lineHeight": "14px", "letterSpacing": "0.1em", "fontWeight": "700" }],
            "label-md": ["12px", { "lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "600" }],
            "headline-lg": ["20px", { "lineHeight": "28px", "fontWeight": "700" }],
            "body-sm": ["13px", { "lineHeight": "18px", "fontWeight": "500" }],
            "body-md": ["14px", { "lineHeight": "20px", "fontWeight": "400" }],
            "display-lg": ["30px", { "lineHeight": "36px", "letterSpacing": "-0.02em", "fontWeight": "800" }]
          }
        }
      }
    };
  </script>
</head>
<body class="bg-background font-body-md text-on-surface antialiased overflow-x-hidden min-h-screen">
  {{> admin/aside}}
  <main class="lg:ml-64 ml-0 min-h-screen flex flex-col">
    {{> user/notification}}
    <div class="p-4 sm:p-6 md:p-container-padding max-w-max-width mx-auto w-full flex-grow">
      <div class="flex flex-col gap-6 w-full">
<div class="flex flex-col gap-3">
<nav class="flex items-center gap-2 font-label-md text-label-md text-on-surface-variant">
<span class="hover:text-on-surface transition-colors cursor-pointer">Admin</span>
<span class="material-symbols-outlined text-[14px]">chevron_right</span>
<a class="hover:text-on-surface transition-colors" data-path="customers" href="#">Customers</a>
<span class="material-symbols-outlined text-[14px]">chevron_right</span>
<span class="text-on-surface font-semibold">Edit Customer</span>
</nav>
<div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
<div class="flex items-start gap-4">
<a class="w-10 h-10 rounded-xl bg-surface shadow-sm hover:shadow-md flex items-center justify-center text-on-surface hover:bg-surface-container-high transition-all shrink-0" data-path="customers" href="#">
<span class="material-symbols-outlined text-[20px]">arrow_back</span>
</a>
<div class="flex flex-col">
<div class="flex items-center gap-3">
<h1 class="font-display-lg text-display-lg text-on-surface tracking-tight">Edit Customer</h1>
<span class="px-2.5 py-0.5 rounded-full bg-surface-container-high text-brand-gold font-label-sm text-label-sm uppercase tracking-wider">ID #{{customer._id}}</span>
</div>
<p class="font-body-md text-body-md text-on-surface-variant mt-1">
              Update profile information, membership tier, contact credentials, and account permissions for <span class="font-semibold text-on-surface">{{customer.name}}</span>.
            </p>
</div>
</div>
<div class="flex items-center gap-3 shrink-0">
<a href="/admin/customer/customers" class="px-4 py-2.5 rounded-xl bg-surface text-on-surface font-label-md text-label-md shadow-sm hover:shadow-md hover:bg-surface-container-low transition-all" type="button">
            Discard Changes
          </a>
<button form="editCustomerForm" class="px-5 py-2.5 rounded-xl bg-primary text-on-primary font-label-md text-label-md shadow-md hover:bg-primary-container hover:text-surface transition-all flex items-center gap-2" type="submit">
<span class="material-symbols-outlined text-[18px] text-brand-gold">check_circle</span>
<span class="">Save Changes</span>
</button>
</div>
</div>
</div>
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 w-full">
<div class="flex flex-col gap-6 col-span-12">
<form id="editCustomerForm" action="/admin/customer/editCustomer/{{customer._id}}?_method=PUT" method="POST" enctype="multipart/form-data" class="bg-surface rounded-2xl p-6 shadow-sm hover:shadow-md transition-shadow">
<div class="flex items-center justify-between pb-5">
<div class="flex items-center gap-3">
<div class="w-9 h-9 rounded-xl bg-surface-container-low flex items-center justify-center text-brand-gold">
<span class="material-symbols-outlined text-[20px]">person</span>
</div>
<div class="flex flex-col">
<h2 class="font-headline-lg text-headline-lg text-on-surface">Basic Profile &amp; Credentials</h2>
<span class="font-label-sm text-label-sm text-on-surface-variant">Primary contact persona and metadata</span>
</div>
</div>
</div>

<!-- Customer Photo Section -->
<div class="flex flex-col sm:flex-row items-center gap-4 pb-6 border-b border-outline-variant/20">

  <!-- Current / Preview Image -->
  <div class="w-24 h-24 shrink-0">
    <img
      id="photoPreview"
      src="{{#if customer.profileImage}}{{customer.profileImage}}{{else}}/images/avathar.jpg{{/if}}"
      alt="Customer Photo"
      class="w-24 h-24 rounded-full object-cover border border-outline-variant/30"
    >
  </div>

  <div class="flex flex-col gap-1 sm:flex-1 text-center sm:text-left">
    <span class="font-headline-lg text-body-sm font-semibold text-on-surface">
      Customer Avatar
    </span>

    <span class="font-body-sm text-body-sm text-on-surface-variant">
      Recommended size 400x400px. High-resolution portrait preferred.
    </span>
  </div>

  <div class="flex items-center gap-2">
    <!-- Change Photo -->
    <button
      id="changePhotoBtn"
      type="button"
      class="px-3.5 py-2 rounded-xl bg-surface text-on-surface font-label-md text-label-md shadow-sm hover:bg-surface-container-high transition-colors"
    >
      Change Photo
    </button>

    <!-- File Input -->
    <input
      type="file"
      id="photoInput"
      name="profileImage"
      accept="image/jpeg,image/png,image/webp"
      class="hidden"
    >

    <!-- Remove Flag -->
    <input
      type="hidden"
      name="removePhoto"
      id="removePhoto"
      value="false"
    >

    <!-- Remove -->
    <button
      id="removePhotoBtn"
      type="button"
      class="px-3.5 py-2 rounded-xl text-error font-label-md text-label-md hover:bg-error-container/40 transition-colors"
    >
      Remove
    </button>
  </div>

</div>

<!-- Remove Confirmation Modal -->
<div
  id="removePhotoModal"
  class="fixed inset-0 z-50 items-center justify-center bg-black/50 hidden"
  style="display: none;"
>
  <div class="bg-surface rounded-2xl p-6 w-full max-w-sm shadow-xl border border-outline-variant/20">
    <h2 class="text-lg font-semibold text-on-surface">
      Remove Profile Photo?
    </h2>
    <p class="mt-2 text-sm text-on-surface-variant">
      Are you sure you want to remove this profile photo?
    </p>
    <div class="flex justify-end gap-3 mt-6">
      <button
        id="cancelRemoveBtn"
        type="button"
        class="px-4 py-2 rounded-xl bg-surface-container-high text-on-surface hover:bg-surface-variant transition-colors"
      >
        Cancel
      </button>
      <button
        id="confirmRemoveBtn"
        type="button"
        class="px-4 py-2 rounded-xl bg-error text-white hover:opacity-90 transition-opacity"
      >
        Remove
      </button>
    </div>
  </div>
</div>


<div class="flex flex-col gap-1.5 sm:col-span-2">
<div class="flex flex-col gap-1.5">
<label class="font-label-md text-label-md text-on-surface-variant">First Name</label>
<input name="name" class="w-full bg-surface-container-low text-on-surface px-3.5 py-2.5 rounded-xl font-body-md text-body-md focus:outline-none focus:ring-1 focus:ring-brand-gold" type="text" value="{{customer.name}}">
</div>
<div class="flex flex-col gap-1.5 sm:col-span-2">
<div class="flex items-center justify-between">
<label class="font-label-md text-label-md text-on-surface-variant">Email Address</label>
<span class="px-2 py-0.5 rounded-full bg-surface-container-high text-on-surface font-label-sm text-label-sm flex items-center gap-1">
<span class="material-symbols-outlined text-[12px] text-brand-gold" style="font-variation-settings: 'FILL' 1;">check_circle</span>
                  Verified
                </span>
</div>
<div class="relative">
<span class="material-symbols-outlined absolute left-3.5 top-3 text-[18px] text-on-surface-variant">mail</span>
<input name="email" class="w-full bg-surface-container-low text-on-surface pl-10 pr-3.5 py-2.5 rounded-xl font-body-md text-body-md focus:outline-none focus:ring-1 focus:ring-brand-gold" type="email" value="{{customer.email}}">
</div>
</div>
<div class="flex flex-col gap-1.5 sm:col-span-2">
<div class="flex items-center justify-between">
<label class="font-label-md text-label-md text-on-surface-variant">Primary Phone</label>


</div>
<div class="relative">
<span class="material-symbols-outlined absolute left-3.5 top-3 text-[18px] text-on-surface-variant">call</span>
<input name="phone" class="w-full bg-surface-container-low text-on-surface pl-10 pr-3.5 py-2.5 rounded-xl font-body-md text-body-md focus:outline-none focus:ring-1 focus:ring-brand-gold" type="tel" value="{{customer.phone}}">
</div>
</div>
<div class="flex flex-col gap-1.5 sm:col-span-2 pt-1">
<label class="font-label-md text-label-md text-on-surface-variant">Registration Date</label>
<div class="flex items-center justify-between p-3 rounded-xl bg-surface-container-low">
<div class="flex items-center gap-2 text-on-surface font-body-sm text-body-sm">
<span class="material-symbols-outlined text-[18px] text-brand-gold">calendar_today</span>
<span class="">{{customer.formattedDate}}</span>
</div>
<span class="font-label-sm text-label-sm text-on-surface-variant">Via Private Concierge Invitation</span>
</div>
</div>
</div>
</form>


</div>

</div>

<section class="bg-surface rounded-2xl p-6 shadow-sm hover:shadow-md transition-shadow w-full">

  <div class="flex items-center justify-between pb-5">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-xl bg-surface-container-low flex items-center justify-center text-brand-gold">
        <span class="material-symbols-outlined text-[20px]">local_shipping</span>
      </div>

      <div class="flex flex-col">
        <h2 class="font-headline-lg text-headline-lg text-on-surface">
          Addresses &amp; Shipping
        </h2>

        <span class="font-label-sm text-label-sm text-on-surface-variant">
          Verified residences and delivery instructions
        </span>
      </div>
    </div>

    {{!-- <button
      class="px-3.5 py-1.5 rounded-xl bg-surface-container-low hover:bg-surface-container-high text-on-surface font-label-md text-label-md flex items-center gap-1.5 transition-colors"
      type="button"
    >
      <span class="material-symbols-outlined text-[16px] text-brand-gold">
        add
      </span>

      <span class="">Add Address</span>
    </button> --}}
  </div>


  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">

    {{#if addresses.length}}

      {{#each addresses}}

        <div class="p-4 rounded-xl bg-surface-container-low flex flex-col justify-between gap-4 border border-outline-variant/20 hover:border-outline-variant/40 transition-colors">

          <div class="flex flex-col gap-2">

            <div class="flex items-center justify-between">

              {{#if this.isDefault}}

                <span class="px-2.5 py-0.5 rounded-full bg-primary text-brand-gold font-label-sm text-label-sm uppercase tracking-wider font-semibold">
                  Primary Address
                </span>

              {{else}}

                <span class="px-2.5 py-0.5 rounded-full bg-surface-container-high text-on-surface font-label-sm text-label-sm uppercase tracking-wider font-semibold">
                  {{this.addressLabel}}
                </span>

              {{/if}}

            </div>


            <div class="flex flex-col mt-1">

              <span class="font-headline-lg text-body-sm font-bold text-on-surface">
                {{this.fullName}}
              </span>

              <span class="font-body-sm text-body-sm text-on-surface-variant">
                {{this.street}}{{#if this.suite}}, {{this.suite}}{{/if}}
              </span>

              <span class="font-body-sm text-body-sm text-on-surface-variant">
                {{this.city}}, {{this.state}} {{this.zip}}
              </span>

              <span class="font-body-sm text-body-sm text-on-surface-variant font-medium">
                {{this.country}}
              </span>

              <span class="font-body-sm text-body-sm text-on-surface font-medium mt-1.5 flex items-center gap-1">
                <span class="material-symbols-outlined text-[15px] text-brand-gold">call</span>
                {{this.phone}}
              </span>

            </div>

          </div>


          <div class="flex items-center gap-2 pt-2 text-on-surface-variant font-label-sm text-label-sm border-t border-outline-variant/20">

            <span class="material-symbols-outlined text-[16px] text-brand-gold">
              verified
            </span>

            <span>
              Verified customer address
            </span>

          </div>

        </div>

      {{/each}}

    {{else}}

      <div class="col-span-full p-8 rounded-xl bg-surface-container-low text-center">
        <span class="material-symbols-outlined text-[36px] text-on-surface-variant/40 mb-2">home_pin</span>
        <p class="font-body-md text-on-surface-variant">
          No addresses saved for this customer yet.
        </p>
      </div>

    {{/if}}

  </div>

</section>


<section class="bg-surface rounded-2xl p-6 shadow-sm hover:shadow-md transition-shadow w-full">
<div class="flex flex-col sm:flex-row sm:items-center justify-between pb-5 gap-3">
<div class="flex items-center gap-3">
<div class="w-9 h-9 rounded-xl bg-surface-container-low flex items-center justify-center text-brand-gold">
<span class="material-symbols-outlined text-[20px]">insights</span>
</div>
<div class="flex flex-col">
<h2 class="font-headline-lg text-headline-lg text-on-surface">Customer Activity &amp; Lifetime Value</h2>
<span class="font-label-sm text-label-sm text-on-surface-variant">Financial overview and order telemetry</span>
</div>
</div>
<div class="flex items-center gap-2 flex-wrap">
  <a id="viewAllOrdersBtn" href="/admin/order/orders?userId={{customer._id}}" class="px-3.5 py-1.5 rounded-xl bg-primary text-on-primary hover:opacity-90 font-label-md text-label-md flex items-center gap-1.5 transition-all shadow-sm">
    <span>View All Orders ({{totalOrders}})</span>
    <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
  </a>
</div>
</div>
<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
<div class="p-4 rounded-xl bg-surface-container-low flex flex-col gap-1">
<span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Total Orders</span>
<span class="font-headline-lg text-headline-lg text-on-surface font-bold">{{totalOrders}}</span>
<span class="font-label-sm text-label-sm text-brand-gold font-medium">{{fulfillmentRate}}% fulfillment</span>
</div>
<div class="p-4 rounded-xl bg-surface-container-low flex flex-col gap-1">
<span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Total Spend</span>
<span class="font-headline-lg text-headline-lg text-on-surface font-bold">₹{{totalSpent}}</span>
<span class="font-label-sm text-label-sm text-brand-gold font-medium">Avg. ₹{{avgOrderValue}} / ord</span>
</div>
<div class="p-4 rounded-xl bg-surface-container-low flex flex-col gap-1">
<span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Wallet Balance</span>
<span class="font-headline-lg text-headline-lg text-on-surface font-bold">₹{{walletBalance}}</span>
<span class="font-label-sm text-label-sm text-on-surface-variant">Store Credit Active</span>
</div>
</div>
<div class="flex flex-col gap-2">
<div class="flex items-center justify-between mb-1">
  <span class="font-label-md text-label-md text-on-surface-variant">Order History (Recent)</span>
  {{#if allOrders.length}}
  <a href="/admin/order/orders?userId={{customer._id}}" class="text-xs text-brand-gold hover:underline flex items-center gap-0.5">
    <span>View all {{totalOrders}} orders</span>
    <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
  </a>
  {{/if}}
</div>
<div class="overflow-x-auto">
<table class="w-full text-left">
<thead>
<tr class="bg-surface-container-low text-on-surface-variant font-label-sm text-label-sm">
<th class="py-2.5 px-4 rounded-l-lg">Order ID</th>
<th class="py-2.5 px-4">Date</th>
<th class="py-2.5 px-4">Products</th>
<th class="py-2.5 px-4">Amount</th>
<th class="py-2.5 px-4 text-right rounded-r-lg">Status</th>
</tr>
</thead>
<tbody class="font-body-sm text-body-sm text-on-surface divide-y divide-outline-variant/10">
{{#if recentOrders.length}}
  {{#each recentOrders}}
  <tr class="hover:bg-surface-container-low/60 transition-colors">
    <td class="py-3 px-4 font-semibold text-on-surface">
      <a href="/admin/orders/{{this.orderId}}" class="hover:text-brand-gold hover:underline">
        #{{this.orderId}}
      </a>
    </td>
    <td class="py-3 px-4 text-on-surface-variant">{{this.formattedDate}}</td>
    <td class="py-3 px-4 max-w-xs truncate" title="{{this.productNames}}">{{this.shortProducts}}</td>
    <td class="py-3 px-4 font-medium">₹{{this.finalAmount}}</td>
    <td class="py-3 px-4 text-right">
      <span class="px-2.5 py-0.5 rounded-full {{this.statusColor}} font-label-sm text-label-sm font-semibold capitalize">
        {{this.statusLabel}}
      </span>
    </td>
  </tr>
  {{/each}}
{{else}}
  <tr>
    <td colspan="5" class="py-8 text-center text-on-surface-variant">
      No orders placed by this customer yet.
    </td>
  </tr>
{{/if}}
</tbody>
</table>
</div>
</div>
</section>

<section class="bg-surface rounded-2xl p-6 shadow-sm hover:shadow-md transition-shadow flex flex-col gap-4 w-full border border-error-container/40">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-xl bg-error-container flex items-center justify-center text-error">
        <span class="material-symbols-outlined text-[20px]">warning</span>
      </div>
      <div class="flex flex-col">
        <h2 class="font-headline-lg text-headline-lg text-on-surface">Danger Zone</h2>
        <span class="font-label-sm text-label-sm text-on-surface-variant">Irreversible administrative actions</span>
      </div>
    </div>
  </div>
  <div class="flex flex-col sm:flex-row items-center justify-between gap-4 p-4 rounded-xl bg-error-container/20 mt-1">
    <div class="flex flex-col gap-1">
      <span class="font-body-sm text-body-sm font-semibold text-error">Delete Customer Account</span>
      <span class="font-label-sm text-label-sm text-error/80">Permanent operation. Will purge all customer data and address records in compliance with privacy mandates.</span>
    </div>
    <button id="openDeleteAccountModalBtn" type="button" class="px-4 py-2 rounded-xl bg-surface text-error hover:bg-error hover:text-white font-label-md text-label-md shadow-sm transition-colors shrink-0 border border-error/30 cursor-pointer">
      Delete Account
    </button>
  </div>
</section>

      </div>
    </div>
  </main>

  <!-- ==============================================
       View All Orders Modal
  =============================================== -->
  <div id="allOrdersModal" class="fixed inset-0 z-50 items-center justify-center bg-black/60 backdrop-blur-sm hidden" style="display: none;">
    <div class="bg-surface rounded-2xl w-full max-w-4xl max-h-[85vh] shadow-2xl border border-outline-variant/30 flex flex-col overflow-hidden m-4">
      <!-- Modal Header -->
      <div class="flex items-center justify-between p-5 border-b border-outline-variant/20 bg-surface-container-low">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-surface flex items-center justify-center text-brand-gold shadow-sm">
            <span class="material-symbols-outlined text-[22px]">shopping_bag</span>
          </div>
          <div>
            <h3 class="font-headline-lg text-lg font-bold text-on-surface">Order History - {{customer.name}}</h3>
            <span class="font-label-sm text-xs text-on-surface-variant">{{totalOrders}} total orders placed</span>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <a href="/admin/order/orders?userId={{customer._id}}" class="px-3 py-1.5 rounded-lg bg-surface hover:bg-surface-container-high text-brand-gold font-label-sm text-xs flex items-center gap-1 border border-outline-variant/30 transition-colors">
            <span>Open in Orders Page</span>
            <span class="material-symbols-outlined text-[14px]">open_in_new</span>
          </a>
          <button id="closeAllOrdersModalBtn" type="button" class="w-8 h-8 rounded-lg hover:bg-surface-variant flex items-center justify-center text-on-surface-variant hover:text-on-surface transition-colors cursor-pointer">
            <span class="material-symbols-outlined text-[20px]">close</span>
          </button>
        </div>
      </div>

      <!-- Modal Content: Scrollable Orders Table -->
      <div class="overflow-y-auto p-5 flex-grow">
        {{#if allOrders.length}}
          <div class="overflow-x-auto">
            <table class="w-full text-left">
              <thead>
                <tr class="bg-surface-container-low text-on-surface-variant font-label-sm text-label-sm">
                  <th class="py-3 px-4 rounded-l-lg">Order ID</th>
                  <th class="py-3 px-4">Date</th>
                  <th class="py-3 px-4">Products</th>
                  <th class="py-3 px-4">Payment</th>
                  <th class="py-3 px-4">Amount</th>
                  <th class="py-3 px-4">Status</th>
                  <th class="py-3 px-4 text-right rounded-r-lg">Action</th>
                </tr>
              </thead>
              <tbody class="font-body-sm text-body-sm text-on-surface divide-y divide-outline-variant/10">
                {{#each allOrders}}
                  <tr class="hover:bg-surface-container-low/60 transition-colors">
                    <td class="py-3.5 px-4 font-semibold text-on-surface whitespace-nowrap">
                      #{{this.orderId}}
                    </td>
                    <td class="py-3.5 px-4 text-on-surface-variant whitespace-nowrap">
                      {{this.formattedDate}}
                    </td>
                    <td class="py-3.5 px-4 max-w-xs truncate" title="{{this.productNames}}">
                      {{this.shortProducts}}
                    </td>
                    <td class="py-3.5 px-4 font-label-sm uppercase text-on-surface-variant">
                      {{this.paymentMethod}}
                    </td>
                    <td class="py-3.5 px-4 font-semibold text-on-surface whitespace-nowrap">
                      ₹{{this.finalAmount}}
                    </td>
                    <td class="py-3.5 px-4">
                      <span class="px-2.5 py-0.5 rounded-full {{this.statusColor}} font-label-sm text-label-sm font-semibold capitalize whitespace-nowrap">
                        {{this.statusLabel}}
                      </span>
                    </td>
                    <td class="py-3.5 px-4 text-right whitespace-nowrap">
                      <a href="/admin/orders/{{this.orderId}}" class="px-2.5 py-1 rounded-lg bg-surface border border-outline-variant/30 hover:border-brand-gold hover:text-brand-gold text-on-surface font-label-sm text-xs transition-colors inline-flex items-center gap-1">
                        <span>Details</span>
                        <span class="material-symbols-outlined text-[13px]">arrow_forward</span>
                      </a>
                    </td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        {{else}}
          <div class="py-12 text-center text-on-surface-variant">
            <span class="material-symbols-outlined text-[40px] text-on-surface-variant/40 mb-2">shopping_cart_off</span>
            <p class="font-body-md">No orders recorded for this customer.</p>
          </div>
        {{/if}}
      </div>

      <!-- Modal Footer -->
      <div class="p-4 border-t border-outline-variant/20 bg-surface-container-low flex justify-between items-center text-xs text-on-surface-variant">
        <span>Total spent: <strong class="text-on-surface">₹{{totalSpent}}</strong> across <strong class="text-on-surface">{{totalOrders}}</strong> orders</span>
        <button id="closeAllOrdersFooterBtn" type="button" class="px-4 py-2 rounded-xl bg-surface text-on-surface hover:bg-surface-container-high transition-colors font-label-md text-label-md shadow-sm cursor-pointer">
          Close
        </button>
      </div>
    </div>
  </div>

  <!-- ==============================================
       Delete Customer Confirmation Modal
  =============================================== -->
  <div id="deleteCustomerModal" class="fixed inset-0 z-50 items-center justify-center bg-black/60 backdrop-blur-sm hidden" style="display: none;">
    <div class="bg-surface rounded-2xl p-6 w-full max-w-md shadow-2xl border border-error/30 m-4">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-12 h-12 rounded-full bg-error-container flex items-center justify-center text-error shrink-0">
          <span class="material-symbols-outlined text-[28px]">delete_forever</span>
        </div>
        <div class="flex flex-col">
          <h3 class="font-headline-lg text-lg font-bold text-on-surface">Delete Customer Account?</h3>
          <span class="font-label-sm text-xs text-error font-semibold">This action cannot be undone</span>
        </div>
      </div>
      
      <p class="text-sm text-on-surface-variant leading-relaxed">
        Are you sure you want to permanently delete the account for <strong class="text-on-surface">{{customer.name}}</strong> (<span class="text-on-surface">{{customer.email}}</span>)? All profile data and saved addresses will be purged.
      </p>

      <div class="flex items-center justify-end gap-3 mt-6 pt-4 border-t border-outline-variant/20">
        <button id="cancelDeleteAccountBtn" type="button" class="px-4 py-2.5 rounded-xl bg-surface-container-high text-on-surface font-label-md text-label-md hover:bg-surface-variant transition-colors cursor-pointer">
          Cancel
        </button>
        <form id="deleteCustomerForm" action="/admin/customer/deleteCustomer/{{customer._id}}?_method=DELETE" method="POST" class="inline">
          <button id="confirmDeleteAccountBtn" type="submit" class="px-5 py-2.5 rounded-xl bg-error text-white font-label-md text-label-md hover:bg-red-700 shadow-md transition-all flex items-center gap-1.5 cursor-pointer">
            <span class="material-symbols-outlined text-[18px]">delete</span>
            <span>Yes, Delete Account</span>
          </button>
        </form>
      </div>
    </div>
  </div>

  <script>
    (function () {
      const changePhotoBtn = document.getElementById("changePhotoBtn");
      const photoInput = document.getElementById("photoInput");
      const photoPreview = document.getElementById("photoPreview");
      const removePhotoBtn = document.getElementById("removePhotoBtn");
      const removePhoto = document.getElementById("removePhoto");
      const removePhotoModal = document.getElementById("removePhotoModal");
      const cancelRemoveBtn = document.getElementById("cancelRemoveBtn");
      const confirmRemoveBtn = document.getElementById("confirmRemoveBtn");

      if (changePhotoBtn && photoInput) {
        changePhotoBtn.addEventListener("click", () => {
          photoInput.click();
        });
      }

      if (photoInput && photoPreview) {
        photoInput.addEventListener("change", () => {
          const file = photoInput.files[0];
          if (!file) return;

          if (!file.type.startsWith("image/")) {
            alert("Please select an image file.");
            photoInput.value = "";
            return;
          }

          if (removePhoto) removePhoto.value = "false";
          const imageURL = URL.createObjectURL(file);
          photoPreview.src = imageURL;
        });
      }

      function closeModal(modal) {
        if (modal) {
          modal.style.display = "none";
          modal.classList.add("hidden");
          modal.classList.remove("flex");
        }
      }

      function openModal(modal) {
        if (modal) {
          modal.style.display = "flex";
          modal.classList.remove("hidden");
          modal.classList.add("flex");
        }
      }

      // Remove photo modal
      if (removePhotoBtn && removePhotoModal) {
        removePhotoBtn.addEventListener("click", () => openModal(removePhotoModal));
      }

      if (cancelRemoveBtn) {
        cancelRemoveBtn.addEventListener("click", () => closeModal(removePhotoModal));
      }

      if (confirmRemoveBtn) {
        confirmRemoveBtn.addEventListener("click", () => {
          if (removePhoto) removePhoto.value = "true";
          if (photoInput) photoInput.value = "";
          if (photoPreview) photoPreview.src = "/images/avathar.jpg";
          closeModal(removePhotoModal);
        });
      }

      if (removePhotoModal) {
        removePhotoModal.addEventListener("click", (e) => {
          if (e.target === removePhotoModal) {
            closeModal(removePhotoModal);
          }
        });
      }

      // View All Orders Modal
      const allOrdersModal = document.getElementById("allOrdersModal");
      const openAllOrdersModalBtn = document.getElementById("openAllOrdersModalBtn");
      const closeAllOrdersModalBtn = document.getElementById("closeAllOrdersModalBtn");
      const closeAllOrdersFooterBtn = document.getElementById("closeAllOrdersFooterBtn");

      if (openAllOrdersModalBtn && allOrdersModal) {
        openAllOrdersModalBtn.addEventListener("click", () => openModal(allOrdersModal));
      }

      if (closeAllOrdersModalBtn) {
        closeAllOrdersModalBtn.addEventListener("click", () => closeModal(allOrdersModal));
      }

      if (closeAllOrdersFooterBtn) {
        closeAllOrdersFooterBtn.addEventListener("click", () => closeModal(allOrdersModal));
      }

      if (allOrdersModal) {
        allOrdersModal.addEventListener("click", (e) => {
          if (e.target === allOrdersModal) {
            closeModal(allOrdersModal);
          }
        });
      }

      // Delete Customer Account Modal
      const deleteCustomerModal = document.getElementById("deleteCustomerModal");
      const openDeleteAccountModalBtn = document.getElementById("openDeleteAccountModalBtn");
      const cancelDeleteAccountBtn = document.getElementById("cancelDeleteAccountBtn");

      if (openDeleteAccountModalBtn && deleteCustomerModal) {
        openDeleteAccountModalBtn.addEventListener("click", () => openModal(deleteCustomerModal));
      }

      if (cancelDeleteAccountBtn) {
        cancelDeleteAccountBtn.addEventListener("click", () => closeModal(deleteCustomerModal));
      }

      if (deleteCustomerModal) {
        deleteCustomerModal.addEventListener("click", (e) => {
          if (e.target === deleteCustomerModal) {
            closeModal(deleteCustomerModal);
          }
        });
      }

      // Close on Escape key
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          closeModal(removePhotoModal);
          closeModal(allOrdersModal);
          closeModal(deleteCustomerModal);
        }
      });
    })();
  </script>
</body>
</html>