<h2 class="font-headline-xl text-headline-xl text-on-surface tracking-tight">
    Edit Category
</h2>

<p class="text-on-surface-variant font-body-lg mt-2 opacity-80">
    Update the details of your category.
</p>
</div>
<!-- Form Bento Layout -->
<form
    action="/admin/editCategory/{{category._id}}"
    method="POST"
    enctype="multipart/form-data"
    class="space-y-grid-gutter"
>
<!-- Section 1: General Info -->
<div class="bg-surface-container-lowest rounded-xl p-8 border border-outline-variant/20 shadow-sm">
<div class="grid grid-cols-1 md:grid-cols-4 gap-grid-gutter">
<div class="md:col-span-1">
<h3 class="font-label-md text-on-surface uppercase tracking-wider">General Information</h3>
<p class="text-sm text-on-surface-variant mt-1">Provide the core identity for this category.</p>
</div>
<div class="md:col-span-3 space-y-6">
<div class="group">
<label class="block font-label-md text-on-surface mb-2">Category Name</label>
<input
    class="w-full bg-surface rounded-lg border border-outline-variant/30 py-3 px-4 text-body-md focus:border-primary focus:ring-1 focus:ring-primary/10 transition-all"
    placeholder="e.g. Traditional Burfis"
    type="text"
    name="category_name"
    value="{{category.category_name}}"
></div>
<div>
<label class="block font-label-md text-on-surface mb-2">Description</label>
<textarea
    name="description"
    maxlength="500"
    class="w-full bg-surface rounded-lg border border-outline-variant/30 py-3 px-4 text-body-md focus:border-primary focus:ring-1 focus:ring-primary/10 transition-all"
    placeholder="Describe the essence of this category..."
    rows="4"
>{{category.description}}</textarea><p class="text-xs text-on-surface-variant mt-2 text-right">0/500 characters</p>
</div>
</div>
</div>
</div>
