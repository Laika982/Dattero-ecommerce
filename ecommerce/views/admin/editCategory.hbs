<!-- Breadcrumbs / Header -->
<div class="mb-12">
<nav class="flex items-center text-on-surface-variant text-sm mb-4">
<a class="hover:text-primary" href="#">Inventory</a>
<span class="mx-2 opacity-30">/</span>
<a class="hover:text-primary" href="#">Categories</a>
