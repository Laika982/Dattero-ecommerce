<!-- Section 2: Category Image -->
<div class="bg-surface-container-lowest rounded-xl p-8 border border-outline-variant/20 shadow-sm">

    <div class="grid grid-cols-1 md:grid-cols-4 gap-grid-gutter">

        <div class="md:col-span-1">
            <h3 class="font-label-md text-on-surface uppercase tracking-wider">
                Visual Identity
            </h3>

            <p class="text-sm text-on-surface-variant mt-1">
                Upload an optional high-resolution banner for this category.
            </p>
        </div>


        <div class="md:col-span-3">

            <!-- Upload Area -->
            <div
                id="dropZoneContainer"
                class="relative group cursor-pointer"
            >

                <div
                    id="uploadContainer"
                    class="w-full aspect-[21/9] rounded-xl bg-surface border-2 border-dashed border-outline-variant/50 overflow-hidden flex items-center justify-center transition-all group-hover:border-primary/50 group-hover:bg-surface-variant/20"
                >

                    {{#if category.image.url}}

                        <!-- Existing Database Image -->
                        <img
                            id="imagePreview"
                            src="{{category.image.url}}"
                            alt="{{category.category_name}}"
                            class="absolute inset-0 w-full h-full object-cover rounded-xl"
                        >

                        <!-- Existing Image Overlay -->
                        <div
                            id="imageOverlay"
                            class="absolute inset-0 bg-black/40 rounded-xl hidden items-center justify-center"
                        >
                            <div class="text-center text-white">

                                <span class="material-symbols-outlined text-3xl">
                                    cloud_upload
                                </span>

                                <p class="text-sm font-semibold mt-2">
                                    Click to change image
                                </p>

                            </div>
                        </div>

                    {{else}}

                        <!-- Upload Placeholder -->
                        <div
                            id="uploadContent"
                            class="text-center p-6"
                        >
                            <span
                                class="material-symbols-outlined text-4xl text-on-surface-variant mb-3 opacity-40 group-hover:opacity-100 group-hover:text-primary"
                            >
                                cloud_upload
                            </span>

                            <p class="font-label-md text-on-surface">
                                Click to upload banner
                            </p>

                            <p class="text-xs text-on-surface-variant mt-1">
                                Recommended: 1600 x 680px (PNG or JPG)
                            </p>
                        </div>

                        <img
                            id="imagePreview"
                            class="hidden absolute inset-0 w-full h-full object-cover rounded-xl"
                            alt="Category banner preview"
                        >

                        <div
                            id="imageOverlay"
                            class="absolute inset-0 bg-black/40 rounded-xl hidden items-center justify-center"
                        >
                            <div class="text-center text-white">

                                <span class="material-symbols-outlined text-3xl">
                                    cloud_upload
                                </span>

                                <p class="text-sm font-semibold mt-2">
                                    Click to change image
                                </p>

                            </div>
                        </div>

                    {{/if}}

                </div>


                <!-- File Input -->
                <input
                    id="imageInput"
                    class="absolute inset-0 w-full h-full opacity-0 cursor-pointer"
                    type="file"
                    name="image"
                    accept="image/jpeg,image/png,image/webp"
                >

            </div>


            <!-- Selected File Information -->
            <div
                id="filePreview"
                class="mt-4 hidden items-center gap-4 p-3 bg-surface rounded-lg border border-outline-variant/30"
            >

                <div class="w-16 h-10 bg-surface-container-high rounded overflow-hidden">
                    <img
                        id="smallPreview"
                        class="w-full h-full object-cover"
                        alt="Selected image"
                    >
                </div>


                <div class="flex-1 min-w-0">

                    <p
                        id="fileName"
                        class="text-xs font-bold truncate"
                    ></p>

                    <p
                        id="fileSize"
                        class="text-[10px] text-on-surface-variant uppercase"
                    ></p>

                </div>


                <!-- Delete Selected Image -->
                <button
                    id="removeImage"
                    class="text-error hover:bg-error-container/20 p-2 rounded-full transition-colors"
                    type="button"
                >
                    <span class="material-symbols-outlined text-sm">
                        delete
                    </span>
                </button>

            </div>


            <!-- Delete Existing Image -->
            {{#if category.image.url}}

            <div
                id="existingImageActions"
                class="mt-3 flex justify-end"
            >
                <button
                    id="deleteExistingImage"
                    type="button"
                    class="text-error hover:bg-error-container/20 px-3 py-2 rounded-lg text-sm flex items-center gap-2 transition-colors"
                >
                    <span class="material-symbols-outlined text-[18px]">
                        delete
                    </span>

                    Remove current image
                </button>
            </div>

            {{/if}}

            <!-- Hidden field -->
            <input
                type="hidden"
                name="removeImage"
                id="removeImageInput"
                value="false"
            >

        </div>

    </div>

</div>



