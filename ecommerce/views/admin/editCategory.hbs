<script>
        // Simple micro-interaction for input hover effects
        const inputs = document.querySelectorAll('input, textarea');
        inputs.forEach(input => {
            input.addEventListener('focus', () => {
                input.parentElement.classList.add('scale-[1.01]');
                input.parentElement.classList.add('transition-transform');
            });
            input.addEventListener('blur', () => {
                input.parentElement.classList.remove('scale-[1.01]');
            });
        });
    </script>

    <script>
    const isListed = document.getElementById("isListed");
    const isListedValue = document.getElementById("isListedValue");

    isListed.addEventListener("change", function () {
        isListedValue.value = this.checked ? "true" : "false";
    });
</script>

<script>

const dropZoneContainer =
    document.getElementById("dropZoneContainer");

const imageInput =
    document.getElementById("imageInput");

const uploadContent =
    document.getElementById("uploadContent");

const imagePreview =
    document.getElementById("imagePreview");

const imageOverlay =
    document.getElementById("imageOverlay");

const filePreview =
    document.getElementById("filePreview");

const smallPreview =
    document.getElementById("smallPreview");

const fileName =
    document.getElementById("fileName");

const fileSize =
    document.getElementById("fileSize");

const removeImage =
    document.getElementById("removeImage");

const deleteExistingImage =
    document.getElementById("deleteExistingImage");

const removeImageInput =
    document.getElementById("removeImageInput");


/*
|--------------------------------------------------------------------------
| Existing image URL
|--------------------------------------------------------------------------
*/

const existingImageUrl =
    "{{category.image.url}}";


/*
|--------------------------------------------------------------------------
| Open file selector
|--------------------------------------------------------------------------
*/

dropZoneContainer.addEventListener("click", function (event) {

    // Don't trigger twice when clicking input
    if (event.target === imageInput) {
        return;
    }

    imageInput.click();

});


/*
|--------------------------------------------------------------------------
| Select new image
|--------------------------------------------------------------------------
*/

imageInput.addEventListener("change", function (event) {

    const file = event.target.files[0];

    if (!file) {
        return;
    }


    // Validate image
    if (!file.type.startsWith("image/")) {

        alert("Please select a valid image.");

        imageInput.value = "";

        return;
    }


    // Create temporary preview URL
    const imageUrl =
        URL.createObjectURL(file);


    /*
    |--------------------------------------------------------------------------
    | Large preview
    |--------------------------------------------------------------------------
    */

    imagePreview.src = imageUrl;

    imagePreview.classList.remove("hidden");


    /*
    |--------------------------------------------------------------------------
    | Hide upload text
    |--------------------------------------------------------------------------
    */

    if (uploadContent) {
        uploadContent.classList.add("hidden");
    }


    /*
    |--------------------------------------------------------------------------
    | Show overlay
    |--------------------------------------------------------------------------
    */

    imageOverlay.classList.remove("hidden");


    /*
    |--------------------------------------------------------------------------
    | Small preview
    |--------------------------------------------------------------------------
    */

    smallPreview.src = imageUrl;


    /*
    |--------------------------------------------------------------------------
    | File name
    |--------------------------------------------------------------------------
    */

    fileName.textContent =
        file.name;


    /*
    |--------------------------------------------------------------------------
    | File size
    |--------------------------------------------------------------------------
    */

    const sizeInMB =
        (file.size / (1024 * 1024)).toFixed(2);

    fileSize.textContent =
        sizeInMB + " MB";


    /*
    |--------------------------------------------------------------------------
    | Show selected file information
    |--------------------------------------------------------------------------
    */

    filePreview.classList.remove("hidden");

    filePreview.classList.add("flex");


    /*
    |--------------------------------------------------------------------------
    | If new image selected, don't remove old image
    |--------------------------------------------------------------------------
    */

    removeImageInput.value = "false";

});


/*
|--------------------------------------------------------------------------
| Delete newly selected image
|--------------------------------------------------------------------------
*/

removeImage.addEventListener("click", function (event) {

    event.stopPropagation();


    // Clear file input
    imageInput.value = "";


    // Clear previews
    smallPreview.src = "";


    fileName.textContent = "";

    fileSize.textContent = "";


    /*
    |--------------------------------------------------------------------------
    | Restore existing database image
    |--------------------------------------------------------------------------
    */

    if (existingImageUrl) {

        imagePreview.src =
            existingImageUrl;

        imagePreview.classList.remove("hidden");

        removeImageInput.value = "false";

    } else {

        // No existing image
        imagePreview.src = "";

        imagePreview.classList.add("hidden");

        if (uploadContent) {
            uploadContent.classList.remove("hidden");
        }

    }


    // Hide selected file information
    filePreview.classList.add("hidden");

    filePreview.classList.remove("flex");

});


/*
|--------------------------------------------------------------------------
| Delete existing database image
|--------------------------------------------------------------------------
*/

if (deleteExistingImage) {

    deleteExistingImage.addEventListener("click", function (event) {

        event.stopPropagation();


        /*
        |--------------------------------------------------------------------------
        | Mark existing image for deletion
        |--------------------------------------------------------------------------
        */

        removeImageInput.value = "true";


        /*
        |--------------------------------------------------------------------------
        | Remove image preview
        |--------------------------------------------------------------------------
        */

        imagePreview.src = "";

        imagePreview.classList.add("hidden");


        /*
        |--------------------------------------------------------------------------
        | Show upload placeholder
        |--------------------------------------------------------------------------
        */

        if (uploadContent) {

            uploadContent.classList.remove("hidden");

        }


        /*
        |--------------------------------------------------------------------------
        | Hide delete current image button
        |--------------------------------------------------------------------------
        */

        deleteExistingImage.parentElement.classList.add("hidden");

    });

}


/*
|--------------------------------------------------------------------------
| Hover overlay
|--------------------------------------------------------------------------
*/

dropZoneContainer.addEventListener("mouseenter", function () {

    if (!imagePreview.classList.contains("hidden")) {

        imageOverlay.classList.remove("hidden");

        imageOverlay.classList.add("flex");

    }

});


dropZoneContainer.addEventListener("mouseleave", function () {

    imageOverlay.classList.remove("flex");

    imageOverlay.classList.add("hidden");

});

</script>






