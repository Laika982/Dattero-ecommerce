<!DOCTYPE html>
<html class="light" lang="en">

<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <title>Edit Coupon | Nutri Luxe Admin</title>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&amp;family=Inter:wght@400;500;600&amp;display=swap"
    rel="stylesheet">
  <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
    rel="stylesheet">
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          "colors": {
            "surface-variant": "#e3e2e2",
            "surface": "#fbf9f9",
            "outline": "#747878",
            "background": "#fbf9f9",
            "on-primary-fixed-variant": "#464747",
            "on-tertiary": "#ffffff",
            "primary-fixed-dim": "#c7c6c6",
            "inverse-primary": "#c7c6c6",
            "surface-container-highest": "#e3e2e2",
            "on-secondary-container": "#646464",
            "on-error-container": "#93000a",
            "tertiary-container": "#747474",
            "surface-bright": "#fbf9f9",
            "secondary": "#5e5e5e",
            "secondary-container": "#e3e2e2",
            "on-primary-container": "#fefcfc",
            "on-surface-variant": "#444748",
            "outline-variant": "#c4c7c7",
            "surface-tint": "#5e5e5e",
            "tertiary-fixed-dim": "#c6c6c6",
            "on-primary": "#ffffff",
            "primary": "#5c5c5c",
            "on-primary-fixed": "#1b1c1c",
            "inverse-on-surface": "#f2f0f0",
            "secondary-fixed": "#e3e2e2",
            "on-secondary-fixed": "#1b1c1c",
            "surface-dim": "#dbdad9",
            "primary-fixed": "#e3e2e2",
            "secondary-fixed-dim": "#c7c6c6",
            "error-container": "#ffdad6",
            "on-tertiary-fixed-variant": "#474747",
            "inverse-surface": "#303031",
            "tertiary-fixed": "#e2e2e2",
            "surface-container-lowest": "#ffffff",
            "surface-container": "#efeded",
            "surface-container-high": "#e9e8e7",
            "tertiary": "#5c5c5c",
            "surface-container-low": "#f5f3f3",
            "on-tertiary-fixed": "#1b1b1b",
            "on-surface": "#1b1c1c",
            "on-secondary": "#ffffff",
            "on-background": "#1b1c1c",
            "primary-container": "#747474",
            "on-tertiary-container": "#fcfcfc",
            "on-secondary-fixed-variant": "#464747",
            "on-error": "#ffffff",
            "error": "#ba1a1a"
          },
          "borderRadius": {
            "DEFAULT": "0.25rem",
            "lg": "0.5rem",
            "xl": "0.75rem",
            "full": "9999px"
          },
          "spacing": {
            "stack-lg": "24px",
            "grid-gutter": "24px",
            "container-padding": "32px",
            "stack-sm": "8px",
            "max-width": "1280px",
            "section-gap-mobile": "64px",
            "stack-md": "16px",
            "section-gap": "120px"
          },
          "fontFamily": {
            "body-xl": ["Inter"],
            "body-lg": ["Inter"],
            "body-md": ["Inter"],
            "label-md": ["Inter"],
            "headline-xl": ["Plus Jakarta Sans"],
            "headline-lg": ["Plus Jakarta Sans"],
            "display-lg-mobile": ["Plus Jakarta Sans"],
            "display-lg": ["Plus Jakarta Sans"]
          },
          "fontSize": {
            "body-xl": ["20px", { "lineHeight": "1.5", "fontWeight": "400" }],
            "body-lg": ["17px", { "lineHeight": "1.5", "fontWeight": "400" }],
            "body-md": ["15px", { "lineHeight": "1.5", "fontWeight": "400" }],
            "label-md": ["14px", { "lineHeight": "1.2", "letterSpacing": "0.02em", "fontWeight": "600" }],
            "headline-xl": ["40px", { "lineHeight": "1.2", "letterSpacing": "-0.01em", "fontWeight": "600" }],
            "headline-lg": ["32px", { "lineHeight": "1.25", "fontWeight": "600" }],
            "display-lg-mobile": ["40px", { "lineHeight": "1.1", "letterSpacing": "-0.01em", "fontWeight": "700" }],
            "display-lg": ["56px", { "lineHeight": "1.1", "letterSpacing": "-0.02em", "fontWeight": "700" }]
          }
        },
      },
    }
  </script>
  <style>
    html,
    body {
      background-color: #fbf9f9;
      color: #1b1c1c;
      overflow-x: hidden;
      overflow-y: auto;
      min-height: 100vh;
    }

    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
      display: inline-block;
      line-height: 1;
    }

    .apple-shadow {
      box-shadow: 0 40px 40px -40px rgba(0, 0, 0, 0.04);
    }
  </style>
</head>

<body class="font-body-md text-body-md selection:bg-primary-fixed-dim selection:text-on-primary-fixed">
  {{> user/notification}}
  <!-- SideNavBar Shell -->
  {{> admin/aside}}

  <!-- Main Content Area -->
  <div class="lg:ml-64 ml-0 min-h-screen flex flex-col">
    <!-- Canvas Content -->
    <main class="flex-grow p-4 sm:p-6 lg:p-8 max-w-7xl mx-auto w-full pb-16">
      <!-- Breadcrumbs & Header -->
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8 pb-6 border-b border-outline-variant/20">
        <div>
          <nav class="flex items-center gap-2 text-on-surface-variant text-sm mb-2 opacity-70">
            <a class="hover:underline hover:text-on-surface transition-colors" href="/admin/">Admin</a>
            <span class="material-symbols-outlined text-[14px]">chevron_right</span>
            <a class="hover:underline hover:text-on-surface transition-colors" href="/admin/coupons">Coupons</a>
            <span class="material-symbols-outlined text-[14px]">chevron_right</span>
            <span class="text-on-surface font-semibold">Edit Coupon</span>
          </nav>
          <h1 class="font-headline-lg text-2xl sm:text-3xl font-bold text-on-surface tracking-tight">Edit Coupon</h1>
          <p class="text-on-surface-variant text-sm mt-1 opacity-70">Modify active promotional parameters, eligibility, and validity period.</p>
        </div>
        <div class="flex items-center gap-3 shrink-0 self-end sm:self-auto">
          <a href="/admin/coupons"
            class="inline-flex items-center justify-center px-5 sm:px-6 py-2.5 rounded-full font-label-md text-sm text-on-surface border border-outline-variant/30 hover:bg-surface-container-high transition-all active:scale-95">Discard Changes</a>
          <button type="submit" form="couponForm"
            class="inline-flex items-center justify-center gap-2 px-6 sm:px-8 py-2.5 bg-black text-white rounded-full font-label-md text-sm hover:opacity-90 transition-all active:scale-95 shadow-sm">
            Update Coupon
            <span class="material-symbols-outlined text-[18px]">check_circle</span>
          </button>
        </div>
      </div>

      <!-- Bento Layout Form -->
      <form id="couponForm" action="/admin/coupons/edit/{{coupon._id}}" method="POST"
        class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <input type="hidden" name="_method" value="PATCH">

        <!-- Primary Settings Column (Left) -->
        <div class="lg:col-span-8 w-full space-y-6">

          <!-- General Details Card -->
          <div class="bg-surface-container-lowest rounded-2xl p-6 sm:p-8 apple-shadow border border-outline-variant/20">
            <div class="flex items-center gap-3 mb-6 pb-4 border-b border-outline-variant/15">
              <span class="material-symbols-outlined text-primary text-[22px]">sell</span>
              <h2 class="font-headline-lg text-lg sm:text-xl font-bold text-on-surface tracking-tight">General Details</h2>
            </div>

            <div class="space-y-6">
              <!-- Coupon Code -->
              <div class="space-y-2">
                <label class="font-label-md text-sm text-on-surface font-medium block">Coupon Code</label>
                <div class="relative">
                  <input name="couponCode" id="couponCodeInput" value="{{coupon.code}}" required
                    class="w-full bg-surface-container-low border border-outline-variant/30 rounded-xl px-4 py-3 font-bold tracking-widest uppercase text-body-lg text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent focus:outline-none transition-all placeholder:text-on-surface-variant/40"
                    type="text" placeholder="e.g. SUMMER50">
                  <span class="material-symbols-outlined absolute right-3.5 top-1/2 -translate-y-1/2 text-outline-variant text-[20px] pointer-events-none">
                    confirmation_number
                  </span>
                </div>
                <p class="text-xs text-on-surface-variant/70">Customers enter this promotional code at checkout to claim the discount.</p>
              </div>

              <!-- Discount Type & Value -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
                <div class="space-y-2">
                  <label class="font-label-md text-sm text-on-surface font-medium block">Discount Type</label>
                  <div class="relative">
                    <select id="discountTypeSelect" name="discountType"
                      class="w-full bg-surface-container-low border border-outline-variant/30 rounded-xl py-3 pl-4 pr-10 text-body-md font-medium text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent focus:outline-none appearance-none cursor-pointer transition-all">
                      <option value="PERCENTAGE" {{#if (eq coupon.discount_type "PERCENTAGE")}}selected{{/if}}>Percentage Discount (%)</option>
                      <option value="FIXED" {{#if (eq coupon.discount_type "FIXED")}}selected{{/if}}>Fixed Amount Discount (₹)</option>
                    </select>
                    <span class="material-symbols-outlined absolute right-3.5 top-1/2 -translate-y-1/2 pointer-events-none text-on-surface-variant text-[20px]">
                      expand_more
                    </span>
                  </div>
                </div>

                <div class="space-y-2">
                  <label class="font-label-md text-sm text-on-surface font-medium block">Discount Value</label>
                  <div class="relative">
                    <input id="discountValueInput" name="discountValue" value="{{coupon.discount_value}}" required min="1" step="0.01"
                      class="w-full bg-surface-container-low border border-outline-variant/30 rounded-xl py-3 pl-4 pr-10 text-body-md font-medium text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent focus:outline-none transition-all placeholder:text-on-surface-variant/40"
                      placeholder="10" type="number">
                    <span id="discountUnitLabel" class="material-symbols-outlined absolute right-3.5 top-1/2 -translate-y-1/2 pointer-events-none text-on-surface-variant text-[18px]">
                      {{#if (eq coupon.discount_type "FIXED")}}currency_rupee{{else}}percent{{/if}}
                    </span>
                  </div>
                </div>
              </div>

              <!-- Status -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
                <div class="space-y-2">
                  <label class="font-label-md text-sm text-on-surface font-medium block">Status</label>
                  <div class="relative">
                    <select name="status"
                      class="w-full bg-surface-container-low border border-outline-variant/30 rounded-xl py-3 pl-4 pr-10 text-body-md font-medium text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent focus:outline-none appearance-none cursor-pointer transition-all">
                      <option value="active" {{#if coupon.is_active}}selected{{/if}}>Active</option>
                      <option value="inactive" {{#unless coupon.is_active}}selected{{/unless}}>Inactive</option>
                    </select>
                    <span class="material-symbols-outlined absolute right-3.5 top-1/2 -translate-y-1/2 pointer-events-none text-on-surface-variant text-[20px]">
                      expand_more
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Usage Conditions Card -->
          <div class="bg-surface-container-lowest rounded-2xl p-6 sm:p-8 apple-shadow border border-outline-variant/20">
            <div class="flex items-center gap-3 mb-6 pb-4 border-b border-outline-variant/15">
              <span class="material-symbols-outlined text-primary text-[22px]">rule</span>
              <h2 class="font-headline-lg text-lg sm:text-xl font-bold text-on-surface tracking-tight">Usage Conditions</h2>
            </div>

            <div class="space-y-6">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
                <!-- Minimum Purchase Amount -->
                <div class="space-y-2">
                  <label class="font-label-md text-sm text-on-surface font-medium block">Minimum Purchase Amount</label>
                  <div class="relative">
                    <span class="absolute left-3.5 top-1/2 -translate-y-1/2 font-bold text-on-surface-variant text-sm pointer-events-none">₹</span>
                    <input name="minAmount" value="{{coupon.minimum_purchase}}" min="0" step="1"
                      class="w-full bg-surface-container-low border border-outline-variant/30 rounded-xl py-3 pl-9 pr-4 text-body-md font-medium text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent focus:outline-none transition-all placeholder:text-on-surface-variant/40"
                      placeholder="0.00" type="number">
                  </div>
                  <p class="text-xs text-on-surface-variant/70">Cart subtotal required before coupon applies.</p>
                </div>

                <!-- Maximum Discount -->
                <div class="space-y-2">
                  <label class="font-label-md text-sm text-on-surface font-medium block">
                    Maximum Discount <span class="text-xs text-on-surface-variant font-normal">(optional)</span>
                  </label>
                  <div class="relative">
                    <span class="absolute left-3.5 top-1/2 -translate-y-1/2 font-bold text-on-surface-variant text-sm pointer-events-none">₹</span>
                    <input name="maxDiscount" value="{{coupon.max_discount}}" min="0" step="1"
                      class="w-full bg-surface-container-low border border-outline-variant/30 rounded-xl py-3 pl-9 pr-4 text-body-md font-medium text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent focus:outline-none transition-all placeholder:text-on-surface-variant/40"
                      placeholder="No limit" type="number">
                  </div>
                  <p class="text-xs text-on-surface-variant/70">Cap on discount amount for percentage coupons.</p>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
                <!-- Usage Limit -->
                <div class="space-y-2">
                  <label class="font-label-md text-sm text-on-surface font-medium block">
                    Usage Limit Per Customer <span class="text-xs text-on-surface-variant font-normal">(optional)</span>
                  </label>
                  <input name="usageLimit" value="{{coupon.usage_limit}}" min="1" step="1"
                    class="w-full bg-surface-container-low border border-outline-variant/30 rounded-xl px-4 py-3 text-body-md font-medium text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent focus:outline-none transition-all placeholder:text-on-surface-variant/40"
                    placeholder="Unlimited" type="number">
                </div>
              </div>
            </div>
          </div>

          <!-- Promo Eligibility Card -->
          <div class="bg-surface-container-lowest rounded-2xl p-6 sm:p-8 apple-shadow border border-outline-variant/20">
            <div class="flex items-center gap-3 mb-6 pb-4 border-b border-outline-variant/15">
              <span class="material-symbols-outlined text-primary text-[22px]">category</span>
              <h2 class="font-headline-lg text-lg sm:text-xl font-bold text-on-surface tracking-tight">Promo Eligibility</h2>
            </div>

            <div class="space-y-6">
              <div class="space-y-2">
                <label class="font-label-md text-sm text-on-surface font-medium block">Applicable Scope</label>
                <div class="relative">
                  <select id="applies_to" name="applies_to"
                    class="w-full bg-surface-container-low border border-outline-variant/30 rounded-xl py-3 pl-4 pr-10 text-body-md font-medium text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent focus:outline-none appearance-none cursor-pointer transition-all">
                    <option value="ALL" {{#if (eq coupon.applies_to "ALL")}}selected{{/if}}>All Products & All Categories (Storewide)</option>
                    <option value="CATEGORY" {{#if (eq coupon.applies_to "CATEGORY")}}selected{{/if}}>Specific Category</option>
                    <option value="PRODUCT" {{#if (eq coupon.applies_to "PRODUCT")}}selected{{/if}}>Specific Product</option>
                  </select>
                  <span class="material-symbols-outlined absolute right-3.5 top-1/2 -translate-y-1/2 pointer-events-none text-on-surface-variant text-[20px]">
                    expand_more
                  </span>
                </div>
              </div>

              <!-- Storewide Info Notice -->
              <div id="storewideNotice"
                class="p-4 rounded-xl bg-surface-container-low border border-outline-variant/20 flex items-start gap-3.5 text-on-surface">
                <span class="material-symbols-outlined text-primary text-[24px] shrink-0 mt-0.5">storefront</span>
                <div>
                  <p class="font-semibold text-sm">Storewide Promo</p>
                  <p class="text-xs text-on-surface-variant leading-relaxed mt-0.5">This coupon will apply to eligible products across all categories storewide.</p>
                </div>
              </div>

              <!-- Category Selection Block -->
              <div id="categoryBlock" class="hidden space-y-2">
                <div class="flex justify-between items-center mb-1">
                  <label for="category_id" class="font-label-md text-sm text-on-surface font-medium block">Target Category</label>
                  <button type="button" id="selectAllCategoriesBtn"
                    class="text-xs font-bold text-primary hover:underline cursor-pointer">Select All Categories</button>
                </div>
                <div class="relative">
                  <select id="category_id" name="category_id"
                    class="w-full bg-surface-container-low border border-outline-variant/30 rounded-xl py-3 pl-4 pr-10 text-body-md font-medium text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent focus:outline-none appearance-none cursor-pointer transition-all">
                    <option value="ALL" {{#if (eq coupon.category_id "ALL")}}selected{{/if}}>All Categories</option>
                    {{#each categories}}
                    <option value="{{this._id}}" {{#if (eq this._id ../coupon.category_id)}}selected{{/if}}>
                      {{this.category_name}}
                    </option>
                    {{/each}}
                  </select>
                  <span class="material-symbols-outlined absolute right-3.5 top-1/2 -translate-y-1/2 pointer-events-none text-on-surface-variant text-[20px]">
                    expand_more
                  </span>
                </div>
              </div>

              <!-- Product Selection Block -->
              <div id="productBlock" class="hidden space-y-2">
                <div class="flex justify-between items-center mb-1">
                  <label for="product_id" class="font-label-md text-sm text-on-surface font-medium block">Target Product</label>
                  <button type="button" id="selectAllProductsBtn"
                    class="text-xs font-bold text-primary hover:underline cursor-pointer">Select All Products</button>
                </div>
                <div class="relative">
                  <select id="product_id" name="product_id"
                    class="w-full bg-surface-container-low border border-outline-variant/30 rounded-xl py-3 pl-4 pr-10 text-body-md font-medium text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent focus:outline-none appearance-none cursor-pointer transition-all">
                    <option value="ALL" {{#if (eq coupon.product_id "ALL")}}selected{{/if}}>All Products</option>
                    {{#each products}}
                    <option value="{{this._id}}" {{#if (eq this._id ../coupon.product_id)}}selected{{/if}}>
                      {{this.productName}}
                    </option>
                    {{/each}}
                  </select>
                  <span class="material-symbols-outlined absolute right-3.5 top-1/2 -translate-y-1/2 pointer-events-none text-on-surface-variant text-[20px]">
                    expand_more
                  </span>
                </div>
              </div>
            </div>

            <!-- Form Card Footer Actions -->
            <div class="pt-6 mt-8 border-t border-outline-variant/20 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <p class="text-xs text-on-surface-variant opacity-70">
                Please verify all coupon criteria before updating.
              </p>
              <div class="flex items-center justify-end gap-3 shrink-0">
                <a href="/admin/coupons"
                  class="inline-flex items-center justify-center px-6 py-2.5 rounded-full font-label-md text-sm text-on-surface border border-outline-variant/30 hover:bg-surface-container-high transition-all active:scale-95">Cancel</a>
                <button type="submit"
                  class="inline-flex items-center justify-center gap-2 px-8 py-2.5 bg-black text-white rounded-full font-label-md text-sm hover:opacity-90 transition-all active:scale-95 shadow-sm">
                  Update Coupon
                  <span class="material-symbols-outlined text-[18px]">check_circle</span>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Secondary Column (Sidebar: Timing & Live Summary) -->
        <div class="lg:col-span-4 w-full space-y-6">
          <div class="sticky top-24 space-y-6">
            <!-- Validity Period Card -->
            <div class="bg-surface-container-lowest rounded-2xl p-6 sm:p-8 apple-shadow border border-outline-variant/20">
              <div class="flex items-center gap-3 mb-6 pb-4 border-b border-outline-variant/15">
                <span class="material-symbols-outlined text-primary text-[22px]">calendar_today</span>
                <h2 class="font-headline-lg text-lg sm:text-xl font-bold text-on-surface tracking-tight">Validity Period</h2>
              </div>
              <div class="space-y-5">
                <div class="space-y-2">
                  <label class="font-label-md text-sm text-on-surface font-medium block">Start Date</label>
                  <input name="startDate" value="{{coupon.startDateValue}}" required
                    class="w-full bg-surface-container-low border border-outline-variant/30 rounded-xl px-4 py-3 text-body-md font-medium text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent focus:outline-none cursor-pointer transition-all"
                    type="date">
                </div>
                <div class="space-y-2">
                  <label class="font-label-md text-sm text-on-surface font-medium block">End Date</label>
                  <input name="endDate" value="{{coupon.expiryDateValue}}" required
                    class="w-full bg-surface-container-low border border-outline-variant/30 rounded-xl px-4 py-3 text-body-md font-medium text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent focus:outline-none cursor-pointer transition-all"
                    type="date">
                </div>
              </div>
            </div>

            <!-- Coupon Live Summary Card -->
            <div class="bg-surface-container-lowest rounded-2xl p-6 apple-shadow border border-outline-variant/20 space-y-4">
              <h3 class="font-label-md text-xs text-outline mb-2 uppercase tracking-widest font-bold">Coupon Summary</h3>
              <div class="space-y-3 divide-y divide-outline-variant/15 text-sm">
                <div class="flex justify-between items-center pt-2">
                  <span class="text-on-surface-variant">Discount:</span>
                  <span class="font-bold text-primary">{{coupon.discount_value}}{{#if (eq coupon.discount_type "PERCENTAGE")}}%{{else}}₹{{/if}} OFF</span>
                </div>
                <div class="flex justify-between items-center pt-3">
                  <span class="text-on-surface-variant">Code:</span>
                  <span class="font-bold uppercase tracking-wider text-on-surface font-mono text-xs bg-surface-container-high px-2 py-0.5 rounded border border-outline-variant/30">{{coupon.code}}</span>
                </div>
                <div class="flex justify-between items-center pt-3">
                  <span class="text-on-surface-variant">Scope:</span>
                  <span class="font-semibold text-right text-xs text-on-surface">
                    {{#if (eq coupon.applies_to "CATEGORY")}}Category{{else if (eq coupon.applies_to "PRODUCT")}}Product{{else}}Storewide{{/if}}
                  </span>
                </div>
                <div class="flex justify-between items-center pt-3">
                  <span class="text-on-surface-variant">Total Uses:</span>
                  <span class="font-bold text-on-surface">{{coupon.used_count}}</span>
                </div>
                <div class="flex justify-between items-center pt-3">
                  <span class="text-on-surface-variant">Status:</span>
                  <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-0.5 rounded-full {{#if coupon.is_active}}bg-emerald-100 text-emerald-800 border border-emerald-300{{else}}bg-surface-variant text-on-surface-variant border border-outline-variant/30{{/if}}">
                    <span class="w-1.5 h-1.5 rounded-full {{#if coupon.is_active}}bg-emerald-500{{else}}bg-slate-400{{/if}}"></span>
                    {{#if coupon.is_active}}Active{{else}}Inactive{{/if}}
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </form>
    </main>
  </div>

  <script>
    // Promo Eligibility Toggles
    const appliesToSelect = document.getElementById('applies_to');
    const storewideNotice = document.getElementById('storewideNotice');
    const categoryBlock = document.getElementById('categoryBlock');
    const productBlock = document.getElementById('productBlock');
    const categorySelect = document.getElementById('category_id');
    const productSelect = document.getElementById('product_id');
    const selectAllCategoriesBtn = document.getElementById('selectAllCategoriesBtn');
    const selectAllProductsBtn = document.getElementById('selectAllProductsBtn');
    const discountTypeSelect = document.getElementById('discountTypeSelect');
    const discountUnitLabel = document.getElementById('discountUnitLabel');
    const couponForm = document.getElementById('couponForm');

    function syncEligibility() {
      if (!appliesToSelect) return;
      const val = appliesToSelect.value;
      if (val === 'ALL') {
        storewideNotice?.classList.remove('hidden');
        categoryBlock?.classList.add('hidden');
        productBlock?.classList.add('hidden');
      } else if (val === 'CATEGORY') {
        storewideNotice?.classList.add('hidden');
        categoryBlock?.classList.remove('hidden');
        productBlock?.classList.add('hidden');
      } else if (val === 'PRODUCT') {
        storewideNotice?.classList.add('hidden');
        categoryBlock?.classList.add('hidden');
        productBlock?.classList.remove('hidden');
      }
    }

    function syncDiscountUnit() {
      if (!discountTypeSelect || !discountUnitLabel) return;
      if (discountTypeSelect.value === 'PERCENTAGE') {
        discountUnitLabel.textContent = 'percent';
      } else {
        discountUnitLabel.textContent = 'currency_rupee';
      }
    }

    if (appliesToSelect) {
      appliesToSelect.addEventListener('change', syncEligibility);
    }
    if (discountTypeSelect) {
      discountTypeSelect.addEventListener('change', syncDiscountUnit);
    }

    if (selectAllCategoriesBtn && categorySelect) {
      selectAllCategoriesBtn.addEventListener('click', () => {
        categorySelect.value = 'ALL';
      });
    }

    if (selectAllProductsBtn && productSelect) {
      selectAllProductsBtn.addEventListener('click', () => {
        productSelect.value = 'ALL';
      });
    }

    syncEligibility();
    syncDiscountUnit();

    if (couponForm) {
      couponForm.addEventListener('submit', (e) => {
        const startDateInput = couponForm.querySelector('input[name="startDate"]');
        const endDateInput = couponForm.querySelector('input[name="endDate"]');
        const discountValInput = couponForm.querySelector('input[name="discountValue"]');

        if (startDateInput && endDateInput && startDateInput.value && endDateInput.value) {
          const start = new Date(startDateInput.value);
          const end = new Date(endDateInput.value);
          if (end < start) {
            e.preventDefault();
            alert('End date cannot be earlier than start date.');
            return;
          }
        }

        if (discountValInput) {
          const val = parseFloat(discountValInput.value);
          if (val <= 0 || isNaN(val)) {
            e.preventDefault();
            alert('Discount value must be greater than zero.');
            return;
          }
          if (discountTypeSelect.value === 'PERCENTAGE' && val > 100) {
            e.preventDefault();
            alert('Percentage discount cannot exceed 100%.');
            return;
          }
        }
      });
    }
  </script>
</body>

</html>