<!DOCTYPE html>
<html class="light" lang="en" style="">

<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <title>Nutri Luxe Admin - Manage Coupons</title>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&amp;family=Inter:wght@400;500;600&amp;display=swap"
    rel="stylesheet">
  <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
    rel="stylesheet">
  <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
    rel="stylesheet">
  <style>
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }

    .glass-panel {
      background: rgba(251, 249, 249, 0.8);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(0, 0, 0, 0.08);
    }

    .input-focus-ring:focus {
      outline: none;
      border-color: #5c5c5c;
      box-shadow: 0 0 0 2px rgba(92, 92, 92, 0.1);
    }

    body {
      background-color: #fbf9f9;
      color: #1b1c1c;
    }
  </style>
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          "colors": {
            "surface-variant": "#e3e2e2",
            "surface": "#fbf9f9",
            "outline": "#747878",
            "background": "#fbf9f9",
            "on-primary-fixed-variant": "#464747",
            "on-tertiary": "#ffffff",
            "primary-fixed-dim": "#c7c6c6",
            "inverse-primary": "#c7c6c6",
            "surface-container-highest": "#e3e2e2",
            "on-secondary-container": "#646464",
            "on-error-container": "#93000a",
            "tertiary-container": "#747474",
            "surface-bright": "#fbf9f9",
            "secondary": "#5e5e5e",
            "secondary-container": "#e3e2e2",
            "on-primary-container": "#fefcfc",
            "on-surface-variant": "#444748",
            "outline-variant": "#c4c7c7",
            "surface-tint": "#5e5e5e",
            "tertiary-fixed-dim": "#c6c6c6",
            "on-primary": "#ffffff",
            "primary": "#5c5c5c",
            "on-primary-fixed": "#1b1c1c",
            "inverse-on-surface": "#f2f0f0",
            "secondary-fixed": "#e3e2e2",
            "on-secondary-fixed": "#1b1c1c",
            "surface-dim": "#dbdad9",
            "primary-fixed": "#e3e2e2",
            "secondary-fixed-dim": "#c7c6c6",
            "error-container": "#ffdad6",
            "on-tertiary-fixed-variant": "#474747",
            "inverse-surface": "#303031",
            "tertiary-fixed": "#e2e2e2",
            "surface-container-lowest": "#ffffff",
            "surface-container": "#efeded",
            "surface-container-high": "#e9e8e7",
            "tertiary": "#5c5c5c",
            "surface-container-low": "#f5f3f3",
            "on-tertiary-fixed": "#1b1b1b",
            "on-surface": "#1b1c1c",
            "on-secondary": "#ffffff",
            "on-background": "#1b1c1c",
            "primary-container": "#747474",
            "on-tertiary-container": "#fcfcfc",
            "on-secondary-fixed-variant": "#464747",
            "on-error": "#ffffff",
            "error": "#ba1a1a"
          },
          "borderRadius": {
            "DEFAULT": "0.25rem",
            "lg": "0.5rem",
            "xl": "0.75rem",
            "full": "9999px"
          },
          "spacing": {
            "stack-lg": "24px",
            "grid-gutter": "24px",
            "container-padding": "32px",
            "stack-sm": "8px",
            "max-width": "1280px",
            "section-gap-mobile": "64px",
            "stack-md": "16px",
            "section-gap": "120px"
          },
          "fontFamily": {
            "body-xl": ["Inter"],
            "body-lg": ["Inter"],
            "body-md": ["Inter"],
            "label-md": ["Inter"],
            "headline-xl": ["Plus Jakarta Sans"],
            "headline-lg": ["Plus Jakarta Sans"],
            "display-lg-mobile": ["Plus Jakarta Sans"],
            "display-lg": ["Plus Jakarta Sans"]
          },
          "fontSize": {
            "body-xl": ["20px", { "lineHeight": "1.5", "fontWeight": "400" }],
            "body-lg": ["17px", { "lineHeight": "1.5", "fontWeight": "400" }],
            "body-md": ["15px", { "lineHeight": "1.5", "fontWeight": "400" }],
            "label-md": ["14px", { "lineHeight": "1.2", "letterSpacing": "0.02em", "fontWeight": "600" }],
            "headline-xl": ["40px", { "lineHeight": "1.2", "letterSpacing": "-0.01em", "fontWeight": "600" }],
            "headline-lg": ["32px", { "lineHeight": "1.25", "fontWeight": "600" }],
            "display-lg-mobile": ["40px", { "lineHeight": "1.1", "letterSpacing": "-0.01em", "fontWeight": "700" }],
            "display-lg": ["56px", { "lineHeight": "1.1", "letterSpacing": "-0.02em", "fontWeight": "700" }]
          }
        },
      },
    }
  </script>
</head>

<body class="bg-surface font-body-md text-on-surface">
  {{> user/notification}}
  <!-- SideNavBar Shell -->
  {{> admin/aside}}
  <!-- Main Content Area -->
  <div class="ml-64 min-h-screen flex flex-col">
    <!-- TopNavBar Shell -->
    <header
      class="sticky top-0 w-full z-40 bg-surface/80 backdrop-blur-md border-b border-outline-variant/30 flex justify-between items-center h-16 px-container-padding">
      <div class="flex items-center gap-4 flex-1">
        <div class="relative w-full max-w-md">
          <span
            class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant opacity-60">search</span>
          <input
            class="w-full pl-10 pr-4 py-2 bg-surface-container-low border-none rounded-full text-body-md focus:ring-1 focus:ring-primary"
            placeholder="Search orders, products, coupons..." type="text">
        </div>
      </div>
      <div class="flex items-center gap-6">
        <div class="flex items-center gap-4">
          <button class="text-on-surface-variant hover:text-primary transition-colors transform active:scale-95">
            <span class="material-symbols-outlined">notifications</span>
          </button>
          <button class="text-on-surface-variant hover:text-primary transition-colors transform active:scale-95">
            <span class="material-symbols-outlined">settings</span>
          </button>
        </div>
        <div class="h-8 w-[1px] bg-outline-variant/30"></div>
        <div class="flex items-center gap-3 group cursor-pointer">
          <div class="text-right">
            <p class="font-label-md text-on-surface">Administrator</p>
            <p class="text-[12px] text-on-surface-variant opacity-70">Luxury Admin</p>
          </div>
          <div
            class="h-10 w-10 rounded-full overflow-hidden bg-surface-container-high border border-outline-variant/20">
            <img class="w-full h-full object-cover"
              data-alt="A clean, professional headshot of a premium brand administrator, minimalist aesthetic with soft lighting, high-end wellness boutique style, neutral gray background, luxury corporate identity."
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuBCnCPqa2ZUl85bXcurNMzd73aXdhAeG8Lqf-_qkYsPtfrN69Iue7akEEfyoeO6Bk1hcKgNaxBPRMZrw9bZT6Ou9l3wD6cowgRjrkbBG-yBDzZBTn2FVyx9wR93qnoYG3qovBE7XqKYswqoyn1-xDZ_Q8c0VRDMcxONM4JYjGBRnzd-i0xC12yyHeGE-kEQmpVxI_6CgfcDNbb4ngowZcbETicOZUhkPO3HBn2or__EgmgeibXHqdujxd_LHUwYapFyhTyQtA_2STk">
          </div>
        </div>
      </div>
    </header>
    <!-- Canvas Content -->
    <main class="flex-1 p-container-padding max-w-[1100px] mx-auto w-full pb-20">
      <!-- Breadcrumbs & Header -->
      <div class="px-container-padding py-10 flex justify-between items-end">
        <div>
          <nav class="flex items-center gap-2 text-on-surface-variant font-label-md mb-2 opacity-60">
            <span class="">Admin</span>
            <span class="material-symbols-outlined text-[14px]">chevron_right</span>
            <span class="">Coupons</span>
            <span class="material-symbols-outlined text-[14px]">chevron_right</span>
            <span class="text-on-surface font-semibold">Edit Coupon</span>
          </nav>
          <h2 class="font-headline-lg text-headline-lg font-bold">Edit Coupon</h2>
          <p class="text-on-surface-variant font-body-md">Modify your active promotional campaign parameters.</p>
        </div>
        <div class="flex items-center gap-4">
          <a href="/admin/coupons"
            class="px-6 py-3 font-label-md text-on-surface-variant hover:text-primary transition-colors">Discard
            Changes</a>
          <button type="submit" form="couponForm"
            class="bg-primary text-on-primary px-8 py-3 rounded-full font-label-md shadow-lg shadow-primary/10 hover:opacity-90 active:scale-95 transition-all">Save
            Coupon</button>
        </div>
      </div>
      <!-- Bento Layout Form -->
      <form id="couponForm" action="/admin/coupons/edit/{{coupon._id}}" method="POST"
        class="grid grid-cols-1 md:grid-cols-12 gap-grid-gutter">
        <input type="hidden" name="_method" value="PATCH">
        <!-- Primary Settings Column -->
        <div class="md:col-span-8 space-y-grid-gutter">
          <!-- General Details Card -->
          <div class="bg-surface-container-lowest rounded-xl p-8 border border-outline-variant/10 shadow-sm">
            <div class="flex items-center gap-3 mb-6"><span class="material-symbols-outlined text-primary">sell</span>
              <h3 class="font-headline-lg text-body-xl font-semibold">General Details</h3>
            </div>
            <div class="space-y-6">
              <div class="group"><label class="block font-label-md font-semibold mb-2 text-on-surface-variant">Coupon
                  Code</label>
                <div class="relative">
                  <input name="couponCode"
                    class="w-full bg-surface-container-low border border-transparent rounded-xl px-4 py-3.5 font-headline-lg text-headline-lg font-bold tracking-widest uppercase focus:ring-1 focus:ring-primary transition-all"
                    type="text" value="{{coupon.code}}" placeholder="Enter Coupon Code">
                </div>
                <p class="mt-2 text-[12px] text-on-surface-variant/70 italic">Customers enter this code at checkout to
                  receive the discount.</p>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label class="block font-label-md font-semibold mb-2 text-on-surface-variant">Discount Type</label>
                  <div class="relative">
                    <select name="discountType"
                      class="w-full bg-surface-container-low border border-transparent rounded-xl px-4 py-3.5 font-body-md focus:ring-1 focus:ring-primary appearance-none cursor-pointer transition-all">
                      <option value="PERCENTAGE" {{#if (eq coupon.discount_type "PERCENTAGE" )}}selected{{/if}}>
                        Percentage Discount</option>
                      <option value="FIXED" {{#if (eq coupon.discount_type "FIXED" )}}selected{{/if}}>Fixed Amount
                        Discount</option>
                    </select>
                  </div>
                </div>
                <div>
                  <label class="block font-label-md font-semibold mb-2 text-on-surface-variant">Discount Value</label>
                  <div class="relative">
                    <input name="discountValue"
                      class="w-full bg-surface-container-low border border-transparent rounded-xl px-4 py-3.5 font-body-md focus:ring-1 focus:ring-primary transition-all"
                      placeholder="0" type="number" value="{{coupon.discount_value}}">
                    <span class="absolute right-4 top-1/2 -translate-y-1/2 font-bold text-on-surface-variant">%</span>
                  </div>
                </div>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {{!-- <div>
                  <label class="block font-label-md font-semibold mb-2 text-on-surface-variant">Total Coupon
                    Count</label>
                  <input name="totalCouponCount"
                    class="w-full bg-surface-container-low border border-transparent rounded-xl px-4 py-3.5 font-body-md focus:ring-1 focus:ring-primary transition-all"
                    placeholder="Unlimited" type="number" value="unlimited">
                </div> --}}
                <div>
                  <label class="block font-label-md font-semibold mb-2 text-on-surface-variant">Set Status</label>
                  <div class="relative">
                    <select name="status"
                      class="w-full bg-surface-container-low border border-transparent rounded-xl px-4 py-3.5 font-body-md focus:ring-1 focus:ring-primary appearance-none cursor-pointer transition-all">
                      <option value="active" {{#if coupon.is_active}}selected{{/if}}>Active</option>
                      <option value="inactive" {{#unless coupon.is_active}}selected{{/unless}}>Inactive</option>
                    </select>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <!-- Usage Conditions Card -->
          <div class="space-y-stack-lg">
            <div class="bg-surface-container-lowest rounded-xl p-8 border border-outline-variant/10 shadow-sm">
              <div class="flex items-center gap-3 mb-6">
                <span class="material-symbols-outlined text-primary">rule</span>
                <h3 class="font-headline-lg text-body-xl font-semibold">Usage Conditions</h3>
              </div>
              <div class="space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div>
                    <label class="block font-label-md font-semibold mb-2 text-on-surface-variant">Minimum Purchase
                      Amount</label>
                    <div class="relative">
                      <span class="absolute left-4 top-1/2 -translate-y-1/2 font-bold text-on-surface-variant">₹</span>
                      <input name="minAmount"
                        class="w-full bg-surface-container-low border border-transparent rounded-xl pl-8 pr-4 py-3.5 font-body-md focus:ring-1 focus:ring-primary transition-all"
                        placeholder="0.00" type="number" value="{{coupon.minimum_purchase}}">
                    </div>
                  </div>
                  <div>
                    <label class="block font-label-md font-semibold mb-2 text-on-surface-variant">Maximum Discount <span
                        class="font-normal">(optional)</span></label>
                    <div class="relative">
                      <span class="absolute left-4 top-1/2 -translate-y-1/2 font-bold text-on-surface-variant">₹</span>
                      <input name="maxDiscount"
                        class="w-full bg-surface-container-low border border-transparent rounded-xl pl-8 pr-4 py-3.5 font-body-md focus:ring-1 focus:ring-primary transition-all"
                        placeholder="No limit" type="number" value="{{coupon.max_discount}}">
                    </div>
                  </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div>
                    <label class="block font-label-md font-semibold mb-2 text-on-surface-variant">Usage Limit Per
                      Customer</label>
                    <input name="usageLimit"
                      class="w-full bg-surface-container-low border border-transparent rounded-xl px-4 py-3.5 font-body-md focus:ring-1 focus:ring-primary transition-all"
                      placeholder="Unlimited" type="number" value="{{coupon.usage_limit}}">
                  </div>
                </div>
              </div>
            </div>

            <div class="bg-surface-container-lowest rounded-xl p-8 border border-outline-variant/10 shadow-sm">
              <div class="flex items-center gap-3 mb-6">
                <span class="material-symbols-outlined text-primary">category</span>
                <h3 class="font-headline-lg text-body-xl font-semibold">Promo Eligibility</h3>
              </div>
              <div class="space-y-6">
                <div>
                  <label class="block font-label-md font-semibold mb-2 text-on-surface-variant">Applicable To</label>
                  <div class="relative">
                    <select id="applies_to" name="applies_to"
                      class="w-full bg-surface-container-low border border-transparent rounded-xl px-4 py-3.5 font-body-md focus:ring-1 focus:ring-primary appearance-none cursor-pointer transition-all pr-10 text-on-surface">
                      <option value="ALL" {{#if (eq coupon.applies_to "ALL" )}}selected{{/if}}>All Products & All
                        Categories (Storewide)</option>
                      <option value="CATEGORY" {{#if (eq coupon.applies_to "CATEGORY" )}}selected{{/if}}>Specific
                        Category</option>
                      <option value="PRODUCT" {{#if (eq coupon.applies_to "PRODUCT" )}}selected{{/if}}>Specific Product
                      </option>
                    </select>
                  </div>
                  <p class="mt-2 text-[12px] text-on-surface-variant/70 italic">Select whether this coupon applies
                    storewide, to a specific category, or to a specific product.</p>
                </div>

                <!-- Storewide Info Notice -->
                <div id="storewideNotice"
                  class="p-4 rounded-xl bg-surface-container-low border border-outline-variant/20 flex items-center gap-3 text-on-surface">
                  <span class="material-symbols-outlined text-primary text-[28px]">storefront</span>
                  <div>
                    <p class="font-semibold text-sm">Storewide Promo</p>
                    <p class="text-xs text-on-surface-variant">This coupon applies to all products and all categories
                      across the entire store.</p>
                  </div>
                </div>

                <!-- Category Selection Block -->
                <div id="categoryBlock" class="hidden space-y-2">
                  <div class="flex justify-between items-center mb-1">
                    <label for="category_id"
                      class="block font-label-md font-semibold text-on-surface-variant">Category</label>
                    <button type="button" id="selectAllCategoriesBtn"
                      class="text-[12px] font-bold text-primary hover:underline cursor-pointer">Select All
                      Categories</button>
                  </div>
                  <div class="relative">
                    <select id="category_id" name="category_id"
                      class="w-full bg-surface-container-low border border-transparent rounded-xl px-4 py-3.5 font-body-md focus:ring-1 focus:ring-primary appearance-none cursor-pointer transition-all pr-10 text-on-surface">
                      <option value="ALL" {{#if (eq coupon.category_id "ALL" )}}selected{{/if}}>All Categories</option>
                      {{#each categories}}
                      <option value="{{this._id}}" {{#if (eq this._id ../coupon.category_id)}}selected{{/if}}>
                        {{this.category_name}}</option>
                      {{/each}}
                    </select>
                  </div>
                  <p class="text-[12px] text-on-surface-variant/70 italic">Choose a specific category or click "Select
                    All Categories".</p>
                </div>

                <!-- Product Selection Block -->
                <div id="productBlock" class="hidden space-y-2">
                  <div class="flex justify-between items-center mb-1">
                    <label for="product_id"
                      class="block font-label-md font-semibold text-on-surface-variant">Product</label>
                    <button type="button" id="selectAllProductsBtn"
                      class="text-[12px] font-bold text-primary hover:underline cursor-pointer">Select All
                      Products</button>
                  </div>
                  <div class="relative">
                    <select id="product_id" name="product_id"
                      class="w-full bg-surface-container-low border border-transparent rounded-xl px-4 py-3.5 font-body-md focus:ring-1 focus:ring-primary appearance-none cursor-pointer transition-all pr-10 text-on-surface">
                      <option value="ALL" {{#if (eq coupon.product_id "ALL" )}}selected{{/if}}>All Products</option>
                      {{#each products}}
                      <option value="{{this._id}}" {{#if (eq this._id ../coupon.product_id)}}selected{{/if}}>
                        {{this.productName}}</option>
                      {{/each}}
                    </select>
                  </div>
                  <p class="text-[12px] text-on-surface-variant/70 italic">Choose an individual product or click "Select
                    All Products".</p>
                </div>
              </div>
            </div>
          </div>
        </div>
        <!-- Secondary Column (Timing & Status) -->
        <div class="md:col-span-4 space-y-grid-gutter">
          <div class="sticky top-24">
            <div class="glass-panel p-8 rounded-2xl shadow-sm h-fit mb-stack-lg">
              <div class="flex items-center gap-3 mb-6">
                <span class="material-symbols-outlined text-primary">calendar_today</span>
                <h3 class="font-headline-lg text-body-xl font-semibold">Validity Period</h3>
              </div>
              <div class="space-y-6">
                <div>
                  <label class="block font-label-md mb-2 text-on-surface-variant">Start Date</label>
                  <div class="relative">
                    <input name="startDate" required
                      class="w-full bg-surface-container-low border border-transparent rounded-xl px-4 py-3.5 font-body-md focus:ring-1 focus:ring-primary transition-all"
                      type="date" value="{{coupon.startDateValue}}">
                  </div>
                </div>
                <div>
                  <label class="block font-label-md mb-2 text-on-surface-variant font-semibold">End Date</label>
                  <div class="relative">
                    <input name="endDate" required
                      class="w-full bg-surface-container-low border border-transparent rounded-xl px-4 py-3.5 font-body-md focus:ring-1 focus:ring-primary transition-all"
                      type="date" value="{{coupon.expiryDateValue}}">
                  </div>
                </div>
              </div>
            </div>

            <div
              class="bg-primary-container text-on-primary-container p-8 rounded-2xl h-fit overflow-hidden relative shadow-lg">
              <div class="absolute inset-0 opacity-10 pointer-events-none">
                <svg class="w-full h-full" preserveAspectRatio="none" viewBox="0 0 100 100">
                  <circle cx="10%" cy="10%" fill="white" r="40"></circle>
                  <circle cx="90%" cy="80%" fill="white" r="30"></circle>
                </svg>
              </div>
              <div class="relative z-10">
                <h4 class="font-label-md uppercase tracking-widest opacity-80 mb-6">COUPON SUMMARY</h4>
                <div class="space-y-4">
                  <div class="flex justify-between items-baseline border-b border-white/20 pb-4">
                    <span class="text-body-md opacity-80">Discount</span>
                    <span class="font-headline-lg text-[24px]">{{coupon.discount_value}}{{#if (eq coupon.discount_type
                      "PERCENTAGE")}}%{{else}}₹{{/if}} OFF</span>
                  </div>
                  <div class="flex justify-between items-baseline border-b border-white/20 pb-4">
                    <span class="text-body-md opacity-80">Code</span>
                    <span class="font-bold tracking-wider">{{coupon.code}}</span>
                  </div>
                  <div class="flex justify-between items-baseline border-b border-white/20 pb-4">
                    <span class="text-body-md opacity-80">Scope</span>
                    <span class="font-semibold text-right text-xs">
                      {{#if (eq coupon.applies_to "CATEGORY")}}Specific Category{{else if (eq coupon.applies_to
                      "PRODUCT")}}Specific Product{{else}}All Products & Categories{{/if}}
                    </span>
                  </div>
                  <div class="flex justify-between items-baseline border-b border-white/20 pb-4">
                    <span class="text-body-md opacity-80">Total Redemptions</span>
                    <span class="font-bold">{{coupon.used_count}}</span>
                  </div>
                  <div class="flex justify-between items-baseline pt-2">
                    <span class="text-body-md opacity-80">Status</span>
                    <span class="flex items-center gap-1.5 font-semibold">
                      <span
                        class="w-2 h-2 {{#if coupon.is_active}}bg-green-400{{else}}bg-slate-400{{/if}} rounded-full"></span>
                      {{#if coupon.is_active}}Active{{else}}Inactive{{/if}}
                    </span>
                  </div>
                </div>
              </div>
            </div>


          </div>
        </div>
      </form>
    </main>
  </div>
  <!-- Visual Polish: Smooth interactions -->
  <script>
    // Micro-interaction for form focus
    const inputs = document.querySelectorAll('input, select');
    inputs.forEach(input => {
      input.addEventListener('focus', () => {
        input.closest('.glass-panel')?.classList.add('ring-1', 'ring-outline-variant/30');
      });
      input.addEventListener('blur', () => {
        input.closest('.glass-panel')?.classList.remove('ring-1', 'ring-outline-variant/30');
      });
    });

    // Promo Eligibility Toggles
    const appliesToSelect = document.getElementById('applies_to');
    const storewideNotice = document.getElementById('storewideNotice');
    const categoryBlock = document.getElementById('categoryBlock');
    const productBlock = document.getElementById('productBlock');
    const categorySelect = document.getElementById('category_id');
    const productSelect = document.getElementById('product_id');
    const selectAllCategoriesBtn = document.getElementById('selectAllCategoriesBtn');
    const selectAllProductsBtn = document.getElementById('selectAllProductsBtn');

    function syncEligibility() {
      if (!appliesToSelect) return;
      const val = appliesToSelect.value;
      if (val === 'ALL') {
        storewideNotice?.classList.remove('hidden');
        categoryBlock?.classList.add('hidden');
        productBlock?.classList.add('hidden');
      } else if (val === 'CATEGORY') {
        storewideNotice?.classList.add('hidden');
        categoryBlock?.classList.remove('hidden');
        productBlock?.classList.add('hidden');
      } else if (val === 'PRODUCT') {
        storewideNotice?.classList.add('hidden');
        categoryBlock?.classList.add('hidden');
        productBlock?.classList.remove('hidden');
      }
    }

    if (appliesToSelect) {
      appliesToSelect.addEventListener('change', syncEligibility);
    }

    if (selectAllCategoriesBtn && categorySelect) {
      selectAllCategoriesBtn.addEventListener('click', () => {
        categorySelect.value = 'ALL';
      });
    }

    if (selectAllProductsBtn && productSelect) {
      selectAllProductsBtn.addEventListener('click', () => {
        productSelect.value = 'ALL';
      });
    }

    syncEligibility();
  </script>
  <style>
    @keyframes fade-in {
      from {
        opacity: 0;
        transform: translateY(10px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .animate-fade-in {
      animation: fade-in 0.6s ease-out forwards;
    }
  </style>












</body>

</html>