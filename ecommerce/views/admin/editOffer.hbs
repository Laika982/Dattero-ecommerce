<!DOCTYPE html>
<html class="light" lang="en">

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>Edit Offer | Nutri Luxe Admin</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&amp;family=Inter:wght@400;500;600&amp;display=swap"
        rel="stylesheet">
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet">
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "surface-variant": "#e3e2e2",
                        "surface": "#fbf9f9",
                        "outline": "#747878",
                        "background": "#fbf9f9",
                        "on-primary-fixed-variant": "#464747",
                        "on-tertiary": "#ffffff",
                        "primary-fixed-dim": "#c7c6c6",
                        "inverse-primary": "#c7c6c6",
                        "surface-container-highest": "#e3e2e2",
                        "on-secondary-container": "#646464",
                        "on-error-container": "#93000a",
                        "tertiary-container": "#747474",
                        "surface-bright": "#fbf9f9",
                        "secondary": "#5e5e5e",
                        "secondary-container": "#e3e2e2",
                        "on-primary-container": "#fefcfc",
                        "on-surface-variant": "#444748",
                        "outline-variant": "#c4c7c7",
                        "surface-tint": "#5e5e5e",
                        "tertiary-fixed-dim": "#c6c6c6",
                        "on-primary": "#ffffff",
                        "primary": "#5c5c5c",
                        "on-primary-fixed": "#1b1c1c",
                        "inverse-on-surface": "#f2f0f0",
                        "secondary-fixed": "#e3e2e2",
                        "on-secondary-fixed": "#1b1c1c",
                        "surface-dim": "#dbdad9",
                        "primary-fixed": "#e3e2e2",
                        "secondary-fixed-dim": "#c7c6c6",
                        "error-container": "#ffdad6",
                        "on-tertiary-fixed-variant": "#474747",
                        "inverse-surface": "#303031",
                        "tertiary-fixed": "#e2e2e2",
                        "surface-container-lowest": "#ffffff",
                        "surface-container": "#efeded",
                        "surface-container-high": "#e9e8e7",
                        "tertiary": "#5c5c5c",
                        "surface-container-low": "#f5f3f3",
                        "on-tertiary-fixed": "#1b1b1b",
                        "on-surface": "#1b1c1c",
                        "on-secondary": "#ffffff",
                        "on-background": "#1b1c1c",
                        "primary-container": "#747474",
                        "on-tertiary-container": "#fcfcfc",
                        "on-secondary-fixed-variant": "#464747",
                        "on-error": "#ffffff",
                        "error": "#ba1a1a"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "stack-lg": "24px",
                        "grid-gutter": "24px",
                        "container-padding": "32px",
                        "stack-sm": "8px",
                        "max-width": "1280px",
                        "section-gap-mobile": "64px",
                        "stack-md": "16px",
                        "section-gap": "120px"
                    },
                    "fontFamily": {
                        "body-xl": ["Inter"],
                        "body-lg": ["Inter"],
                        "body-md": ["Inter"],
                        "label-md": ["Inter"],
                        "headline-xl": ["Plus Jakarta Sans"],
                        "headline-lg": ["Plus Jakarta Sans"],
                        "display-lg-mobile": ["Plus Jakarta Sans"],
                        "display-lg": ["Plus Jakarta Sans"]
                    },
                    "fontSize": {
                        "body-xl": ["20px", { "lineHeight": "1.5", "fontWeight": "400" }],
                        "body-lg": ["17px", { "lineHeight": "1.5", "fontWeight": "400" }],
                        "body-md": ["15px", { "lineHeight": "1.5", "fontWeight": "400" }],
                        "label-md": ["14px", { "lineHeight": "1.2", "letterSpacing": "0.02em", "fontWeight": "600" }],
                        "headline-xl": ["40px", { "lineHeight": "1.2", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                        "headline-lg": ["32px", { "lineHeight": "1.25", "fontWeight": "600" }],
                        "display-lg-mobile": ["40px", { "lineHeight": "1.1", "letterSpacing": "-0.01em", "fontWeight": "700" }],
                        "display-lg": ["56px", { "lineHeight": "1.1", "letterSpacing": "-0.02em", "fontWeight": "700" }]
                    }
                },
            },
        }
    </script>
    <style>
        html,
        body {
            background-color: #fbf9f9;
            color: #1b1c1c;
            overflow-x: hidden;
            overflow-y: auto;
            min-height: 100vh;
        }

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            display: inline-block;
            line-height: 1;
        }

        .apple-shadow {
            box-shadow: 0 40px 40px -40px rgba(0, 0, 0, 0.04);
        }
    </style>
</head>

<body class="font-body-md text-body-md selection:bg-primary-fixed-dim selection:text-on-primary-fixed">
    {{> user/notification}}
    <!-- SideNavBar -->
    {{> admin/aside}}

    <!-- Main Wrapper -->
    <div class="lg:ml-64 ml-0 min-h-screen flex flex-col">
        <!-- TopNavBar -->
        <header
            class="sticky top-0 w-full z-40 bg-surface/80 backdrop-blur-md border-b border-outline-variant/30 flex justify-between items-center h-16 px-4 sm:px-6 md:px-container-padding">
            <div class="flex items-center gap-3 sm:gap-4 flex-grow max-w-xl">
                <!-- Mobile Sidebar Toggle -->
                <button type="button"
                    class="lg:hidden p-2 rounded-lg text-on-surface-variant hover:text-ink-black hover:bg-surface-variant/50 transition-colors touch-target"
                    onclick="toggleAdminSidebar()" aria-label="Toggle Navigation">
                    <span class="material-symbols-outlined text-[22px]">menu</span>
                </button>
                <div class="relative w-full max-w-md">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline-variant text-[20px]">search</span>
                    <input
                        class="w-full bg-surface-container-low border border-transparent focus:border-outline-variant/30 rounded-full py-2 pl-10 pr-4 text-body-md focus:ring-1 focus:ring-primary focus:outline-none transition-all placeholder:text-on-surface-variant/40"
                        placeholder="Search offers..." type="text">
                </div>
            </div>
            <div class="flex items-center gap-4 sm:gap-6">
                <a href="/" target="_blank"
                    class="hidden sm:inline-flex items-center gap-2 px-4 py-2 border border-outline-variant/30 rounded-full hover:bg-surface-variant transition-colors active:scale-95 text-on-surface-variant text-sm font-label-md">
                    <span class="material-symbols-outlined text-[18px]">visibility</span>
                    <span>View Store</span>
                </a>
                <div class="flex items-center gap-3 cursor-pointer group">
                    <div class="w-8 h-8 rounded-full bg-surface-variant overflow-hidden border border-outline-variant/30 flex items-center justify-center">
                        <span class="material-symbols-outlined text-outline text-[20px]">person</span>
                    </div>
                    <span class="font-label-md text-sm text-on-surface group-hover:text-primary transition-colors hidden sm:inline">Admin</span>
                </div>
            </div>
        </header>

        <!-- Content Canvas -->
        <main class="flex-grow p-4 sm:p-6 lg:p-8 max-w-7xl mx-auto w-full pb-16">
            <!-- Breadcrumbs & Page Header -->
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8 pb-6 border-b border-outline-variant/20">
                <div>
                    <nav class="flex items-center gap-2 text-on-surface-variant text-sm mb-2 opacity-70">
                        <a class="hover:underline hover:text-on-surface transition-colors" href="/admin/">Admin</a>
                        <span class="material-symbols-outlined text-[14px]">chevron_right</span>
                        <a class="hover:underline hover:text-on-surface transition-colors" href="/admin/offers">Offers</a>
                        <span class="material-symbols-outlined text-[14px]">chevron_right</span>
                        <span class="text-on-surface font-semibold">Edit Offer</span>
                    </nav>
                    <h1 class="font-headline-lg text-2xl sm:text-3xl font-bold text-on-surface tracking-tight">Edit Offer</h1>
                    <p class="text-on-surface-variant text-sm mt-1 opacity-70">Modify product, category, or referral offer settings. Storefront pricing applies the largest saving.</p>
                </div>
                <div class="flex items-center gap-3 shrink-0 self-end sm:self-auto">
                    <a href="/admin/offers"
                        class="inline-flex items-center justify-center px-5 sm:px-6 py-2.5 rounded-full font-label-md text-sm text-on-surface border border-outline-variant/30 hover:bg-surface-container-high transition-all active:scale-95">Discard Changes</a>
                    <button type="submit" form="offerForm"
                        class="inline-flex items-center justify-center gap-2 px-6 sm:px-8 py-2.5 bg-black text-white rounded-full font-label-md text-sm hover:opacity-90 transition-all active:scale-95 shadow-sm">
                        Update Offer
                        <span class="material-symbols-outlined text-[18px]">check_circle</span>
                    </button>
                </div>
            </div>

            <!-- Form Grid -->
            <form id="offerForm" action="/admin/offers/edit/{{offer._id}}" method="POST"
                class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
                <input type="hidden" name="_method" value="PUT">

                <!-- Main Form (Left Column) -->
                <div class="lg:col-span-8 w-full space-y-6">
                    <div class="bg-surface-container-lowest rounded-2xl p-6 sm:p-8 apple-shadow border border-outline-variant/20">
                        <div class="flex items-center gap-3 mb-6 pb-4 border-b border-outline-variant/15">
                            <span class="material-symbols-outlined text-primary text-[22px]">local_offer</span>
                            <h2 class="font-headline-lg text-lg sm:text-xl font-bold text-on-surface tracking-tight">General Details</h2>
                        </div>

                        <div class="space-y-6">
                            <!-- Offer Name -->
                            <div class="space-y-2">
                                <label class="font-label-md text-sm text-on-surface font-medium block">Offer Name</label>
                                <input name="name" value="{{offer.name}}" required
                                    class="w-full bg-surface-container-low border border-outline-variant/30 rounded-xl px-4 py-3 text-body-md font-medium text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent focus:outline-none transition-all placeholder:text-on-surface-variant/40"
                                    type="text" placeholder="e.g. Summer Ajwa Date Fest">
                            </div>

                            <!-- Offer Type & Status -->
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
                                <div class="space-y-2">
                                    <label class="font-label-md text-sm text-on-surface font-medium block">Offer Type</label>
                                    <div class="relative">
                                        <select id="offerType" name="offer_type"
                                            class="w-full bg-surface-container-low border border-outline-variant/30 rounded-xl py-3 pl-4 pr-10 text-body-md font-medium text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent focus:outline-none appearance-none cursor-pointer transition-all">
                                            <option value="PRODUCT" {{#if (eq offer.offer_type "PRODUCT")}}selected{{/if}}>Product Offer</option>
                                            <option value="CATEGORY" {{#if (eq offer.offer_type "CATEGORY")}}selected{{/if}}>Category Offer</option>
                                            <option value="REFERRAL" {{#if (eq offer.offer_type "REFERRAL")}}selected{{/if}}>Referral Offer</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="space-y-2">
                                    <label class="font-label-md text-sm text-on-surface font-medium block">Status</label>
                                    <div class="relative">
                                        <select name="status"
                                            class="w-full bg-surface-container-low border border-outline-variant/30 rounded-xl py-3 pl-4 pr-10 text-body-md font-medium text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent focus:outline-none appearance-none cursor-pointer transition-all">
                                            <option value="active" {{#if offer.is_active}}selected{{/if}}>Active</option>
                                            <option value="inactive" {{#unless offer.is_active}}selected{{/unless}}>Inactive</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <!-- Product Field -->
                            <div id="productField" class="space-y-2">
                                <label class="font-label-md text-sm text-on-surface font-medium block">Target Product</label>
                                <div class="relative">
                                    <select name="product_id"
                                        class="w-full bg-surface-container-low border border-outline-variant/30 rounded-xl py-3 pl-4 pr-10 text-body-md font-medium text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent focus:outline-none appearance-none cursor-pointer transition-all">
                                        <option value="">Select a product...</option>
                                        {{#each products}}
                                        <option value="{{this._id}}" {{#if (eq ../offer.product_id this._id)}}selected{{/if}}>{{this.productName}}</option>
                                        {{/each}}
                                    </select>
                                </div>
                            </div>

                            <!-- Category Field -->
                            <div id="categoryField" class="space-y-2 hidden">
                                <label class="font-label-md text-sm text-on-surface font-medium block">Target Category</label>
                                <div class="relative">
                                    <select name="category_id"
                                        class="w-full bg-surface-container-low border border-outline-variant/30 rounded-xl py-3 pl-4 pr-10 text-body-md font-medium text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent focus:outline-none appearance-none cursor-pointer transition-all">
                                        <option value="">Select a category...</option>
                                        {{#each categories}}
                                        <option value="{{this._id}}" {{#if (eq ../offer.category_id this._id)}}selected{{/if}}>{{this.category_name}}</option>
                                        {{/each}}
                                    </select>
                                </div>
                            </div>

                            <!-- Referral Offer Hint -->
                            <div id="referralHint" class="hidden p-4 rounded-xl bg-surface-container border border-outline-variant/30 flex items-start gap-3">
                                <span class="material-symbols-outlined text-primary text-[20px] shrink-0 mt-0.5">info</span>
                                <p class="text-sm text-on-surface-variant leading-relaxed">
                                    Referral offers apply automatically to a referred customer’s first order when they join with an invitation link or referral code.
                                </p>
                            </div>

                            <!-- Discount Type & Value -->
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
                                <div class="space-y-2">
                                    <label class="font-label-md text-sm text-on-surface font-medium block">Discount Type</label>
                                    <div class="relative">
                                        <select id="discountTypeSelect" name="discount_type"
                                            class="w-full bg-surface-container-low border border-outline-variant/30 rounded-xl py-3 pl-4 pr-10 text-body-md font-medium text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent focus:outline-none appearance-none cursor-pointer transition-all">
                                            <option value="PERCENTAGE" {{#if (eq offer.discount_type "PERCENTAGE")}}selected{{/if}}>Percentage (%)</option>
                                            <option value="FIXED" {{#if (eq offer.discount_type "FIXED")}}selected{{/if}}>Fixed Amount (₹)</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="space-y-2">
                                    <label class="font-label-md text-sm text-on-surface font-medium block">Discount Value</label>
                                    <div class="relative">
                                        <input name="discount_value" value="{{offer.discount_value}}" required
                                            class="w-full bg-surface-container-low border border-outline-variant/30 rounded-xl py-3 pl-4 pr-10 text-body-md font-medium text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent focus:outline-none transition-all placeholder:text-on-surface-variant/40"
                                            placeholder="10" type="number" min="0.01" step="0.01">
                                        <span id="discountUnitLabel"
                                            class="material-symbols-outlined absolute right-3.5 top-1/2 -translate-y-1/2 pointer-events-none text-on-surface-variant text-[18px]">
                                            {{#if (eq offer.discount_type "FIXED")}}currency_rupee{{else}}percent{{/if}}
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Form Actions inside Card Footer -->
                        <div class="pt-6 mt-8 border-t border-outline-variant/20 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                            <p class="text-xs text-on-surface-variant opacity-70">
                                Verify start and end dates before saving changes to this offer.
                            </p>
                            <div class="flex items-center justify-end gap-3 shrink-0">
                                <a href="/admin/offers"
                                    class="inline-flex items-center justify-center px-6 py-2.5 rounded-full font-label-md text-sm text-on-surface border border-outline-variant/30 hover:bg-surface-container-high transition-all active:scale-95">Cancel</a>
                                <button type="submit"
                                    class="inline-flex items-center justify-center gap-2 px-8 py-2.5 bg-black text-white rounded-full font-label-md text-sm hover:opacity-90 transition-all active:scale-95 shadow-sm">
                                    Update Offer
                                    <span class="material-symbols-outlined text-[18px]">check_circle</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Sidebar (Right Column) -->
                <div class="lg:col-span-4 w-full space-y-6">
                    <!-- Validity Period Card -->
                    <div class="bg-surface-container-lowest rounded-2xl p-6 sm:p-8 apple-shadow border border-outline-variant/20">
                        <div class="flex items-center gap-3 mb-6 pb-4 border-b border-outline-variant/15">
                            <span class="material-symbols-outlined text-primary text-[22px]">calendar_today</span>
                            <h2 class="font-headline-lg text-lg sm:text-xl font-bold text-on-surface tracking-tight">Validity Period</h2>
                        </div>
                        <div class="space-y-5">
                            <div class="space-y-2">
                                <label class="font-label-md text-sm text-on-surface font-medium block">Start Date</label>
                                <input name="start_date" value="{{offer.startDateValue}}" required
                                    class="w-full bg-surface-container-low border border-outline-variant/30 rounded-xl px-4 py-3 text-body-md font-medium text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent focus:outline-none cursor-pointer transition-all"
                                    type="date">
                            </div>
                            <div class="space-y-2">
                                <label class="font-label-md text-sm text-on-surface font-medium block">End Date</label>
                                <input name="end_date" value="{{offer.endDateValue}}" required
                                    class="w-full bg-surface-container-low border border-outline-variant/30 rounded-xl px-4 py-3 text-body-md font-medium text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent focus:outline-none cursor-pointer transition-all"
                                    type="date">
                            </div>
                        </div>
                    </div>

                    <!-- Offer Guidelines Card -->
                    <div class="bg-surface-container-lowest rounded-2xl p-6 apple-shadow border border-outline-variant/20">
                        <h3 class="font-label-md text-xs text-outline mb-4 uppercase tracking-widest font-bold">Guidelines & Rules</h3>
                        <ul class="space-y-3 text-sm text-on-surface-variant">
                            <li class="flex items-start gap-2.5">
                                <span class="material-symbols-outlined text-[18px] text-primary shrink-0 mt-0.5">verified</span>
                                <span><strong>Best Discount Rule:</strong> If a product has both a product and category offer, the higher savings will automatically apply.</span>
                            </li>
                            <li class="flex items-start gap-2.5">
                                <span class="material-symbols-outlined text-[18px] text-primary shrink-0 mt-0.5">percent</span>
                                <span><strong>Percentage Limit:</strong> Percentage discounts cannot exceed 100%.</span>
                            </li>
                            <li class="flex items-start gap-2.5">
                                <span class="material-symbols-outlined text-[18px] text-primary shrink-0 mt-0.5">schedule</span>
                                <span><strong>Date Ordering:</strong> End date must be on or after the start date.</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </form>
        </main>
    </div>

    <script>
        const offerType = document.getElementById("offerType");
        const productField = document.getElementById("productField");
        const categoryField = document.getElementById("categoryField");
        const referralHint = document.getElementById("referralHint");
        const discountTypeSelect = document.getElementById("discountTypeSelect");
        const discountUnitLabel = document.getElementById("discountUnitLabel");
        const offerForm = document.getElementById("offerForm");

        function syncOfferType() {
            const type = offerType.value;
            productField.classList.toggle("hidden", type !== "PRODUCT");
            categoryField.classList.toggle("hidden", type !== "CATEGORY");
            referralHint.classList.toggle("hidden", type !== "REFERRAL");
            const productSelect = productField.querySelector("select");
            const categorySelect = categoryField.querySelector("select");
            if (productSelect) productSelect.required = type === "PRODUCT";
            if (categorySelect) categorySelect.required = type === "CATEGORY";
        }

        function syncDiscountUnit() {
            if (!discountTypeSelect || !discountUnitLabel) return;
            if (discountTypeSelect.value === "PERCENTAGE") {
                discountUnitLabel.textContent = "percent";
            } else {
                discountUnitLabel.textContent = "currency_rupee";
            }
        }

        offerType.addEventListener("change", syncOfferType);
        discountTypeSelect.addEventListener("change", syncDiscountUnit);
        syncOfferType();
        syncDiscountUnit();

        if (offerForm) {
            offerForm.addEventListener("submit", (e) => {
                const startDateInput = offerForm.querySelector('input[name="start_date"]');
                const endDateInput = offerForm.querySelector('input[name="end_date"]');
                const discountValInput = offerForm.querySelector('input[name="discount_value"]');

                if (startDateInput && endDateInput && startDateInput.value && endDateInput.value) {
                    const start = new Date(startDateInput.value);
                    const end = new Date(endDateInput.value);
                    if (end < start) {
                        e.preventDefault();
                        alert("End date cannot be earlier than start date.");
                        return;
                    }
                }

                if (discountValInput) {
                    const val = parseFloat(discountValInput.value);
                    if (val <= 0 || isNaN(val)) {
                        e.preventDefault();
                        alert("Discount value must be greater than zero.");
                        return;
                    }
                    if (discountTypeSelect.value === "PERCENTAGE" && val > 100) {
                        e.preventDefault();
                        alert("Percentage discount cannot exceed 100%.");
                        return;
                    }
                }
            });
        }
    </script>
</body>

</html>