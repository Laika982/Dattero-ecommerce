<div class="flex flex-col lg:flex-row gap-grid-gutter items-start">
<!-- Main Form Section -->
<div class="w-full lg:w-2/3 space-y-8">
<div class="bg-surface-container-lowest rounded-xl p-8 apple-shadow border border-outline-variant/10">
<div class="flex justify-between items-center mb-10">
<div>
<h2 class="font-headline-lg text-headline-lg text-on-surface mb-1">Edit Order Details</h2>
<p class="text-on-surface-variant opacity-70">Update the fulfillment and delivery information for this transaction.</p>
</div>
<span class="px-4 py-1.5 bg-surface-container-high text-on-surface-variant font-label-md rounded-full">Status: {{formatStatus order.order_status}}</span>
</div>
<form id="editOrderForm" data-order-id="{{order.order_id}}" class="space-y-10">
<!-- Fulfillment Section -->
<section>
<h3 class="font-label-md text-label-md text-outline mb-6 uppercase tracking-widest">Fulfillment Information</h3>
<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
<div class="space-y-2">
