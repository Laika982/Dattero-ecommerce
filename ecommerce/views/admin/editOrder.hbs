<p class="text-body-md text-on-surface-variant opacity-60">Qty: {{this.quantity}} × ₹{{this.price}}</p>
</div>
<p class="font-label-md text-on-surface">₹{{this.item_total}}</p>
</div>
{{else}}
<p class="text-sm text-on-surface-variant">No items in this order.</p>
{{/each}}
