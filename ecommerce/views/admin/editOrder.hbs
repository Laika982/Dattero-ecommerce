<span class="text-body-md">{{order.user_id.email}}</span>
</div>
<div class="flex items-center gap-3 text-on-surface-variant">
<span class="material-symbols-outlined text-[20px]" data-icon="call">call</span>
<span class="text-body-md">{{order.user_id.phone}}</span>
</div>
</div>
</div>
<!-- Delivery Map Hint -->

</div>
</div>
</main>
<!-- Subtle Footer -->

</div>
<!-- Micro-interaction for inputs -->
<script>
        const editOrderForm = document.getElementById('editOrderForm');
        const orderUpdateFeedback = document.getElementById('orderUpdateFeedback');

        editOrderForm.addEventListener('submit', async (event) => {
            event.preventDefault();
            const submitButton = editOrderForm.querySelector('button[type="submit"]');
            submitButton.disabled = true;
            orderUpdateFeedback.textContent = 'Saving order status...';

            try {
                const response = await fetch(`/admin/order/orders/${encodeURIComponent(editOrderForm.dataset.orderId)}/status`, {
                    method: 'PATCH',
                    headers: {
                        Accept: 'application/json',
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ status: document.getElementById('orderStatus').value }),
                });
                const data = await response.json();

                if (!response.ok || !data.success) {
                    orderUpdateFeedback.textContent = data.message || 'Unable to update order status.';
                    orderUpdateFeedback.classList.add('text-error');
                    return;
                }

                window.location.href = `/admin/order/orders/${encodeURIComponent(editOrderForm.dataset.orderId)}`;
            } catch (error) {
                console.error('Update order status error:', error);
                orderUpdateFeedback.textContent = 'Unable to update order status. Please try again.';
                orderUpdateFeedback.classList.add('text-error');
            } finally {
                submitButton.disabled = false;
            }
        });

        document.querySelectorAll('input, select').forEach(el => {
            el.addEventListener('focus', () => {
                el.parentElement.querySelector('label')?.classList.add('text-primary');
            });
            el.addEventListener('blur', () => {
                el.parentElement.querySelector('label')?.classList.remove('text-primary');
            });
        });
        
        // Simple scale effect on CTA
        const btn = document.querySelector('button[type="submit"]');
        btn.addEventListener('mousedown', () => btn.classList.add('scale-95'));
        btn.addEventListener('mouseup', () => btn.classList.remove('scale-95'));
        btn.addEventListener('mouseleave', () => btn.classList.remove('scale-95'));
    </script>








