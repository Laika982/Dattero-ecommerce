<div class="flex items-center gap-4 mb-6">
<div class="w-12 h-12 rounded-full bg-surface-variant flex items-center justify-center">
<span class="font-bold text-primary">{{order.user_id.name}}</span>
</div>
<div>
<p class="font-label-md text-on-surface">{{order.user_id.name}}</p>
<p class="text-body-md text-on-surface-variant opacity-60">Order #{{order.order_id}}</p>
</div>
</div>
