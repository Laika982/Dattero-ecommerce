<select id="orderStatus" name="status" class="w-full bg-surface-container-low border-none rounded-lg py-3 px-4 focus:ring-1 focus:ring-primary text-body-md appearance-none">
<option value="pending" {{#if (eq order.order_status "pending")}}selected{{/if}}>Pending</option>
<option value="shipped" {{#if (eq order.order_status "shipped")}}selected{{/if}}>Shipped</option>
<option value="out_for_delivery" {{#if (eq order.order_status "out_for_delivery")}}selected{{/if}}>Out for delivery</option>
<option value="delivered" {{#if (eq order.order_status "delivered")}}selected{{/if}}>Delivered</option>
<option value="cancelled" {{#if (eq order.order_status "cancelled")}}selected{{/if}}>Cancelled</option>
<option value="returned" {{#if (eq order.order_status "returned")}}selected{{/if}} disabled>Returned</option>
</select>
</div>
