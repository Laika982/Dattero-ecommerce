<div class="mt-6 pt-6 border-t border-outline-variant/30 space-y-3">
<div class="flex justify-between text-body-md text-on-surface-variant">
<span class="">Subtotal</span>
<span class="">₹{{order.subtotal}}</span>
</div>
<div class="flex justify-between text-body-md text-on-surface-variant">
<span class="">Shipping</span>
<span class="">₹{{order.shipping_charge}}</span>
</div>
<div class="flex justify-between font-label-md text-on-surface text-lg pt-2">
