<script>

document.addEventListener("DOMContentLoaded", function () {

    const uploadArea = document.getElementById("uploadArea");
    const uploadContent = document.getElementById("uploadContent");
    const productImages = document.getElementById("productImages");

    const mainImage = document.getElementById("mainImage");
    const removeMainImage = document.getElementById("removeMainImage");

    const addImageBtn = document.getElementById("addImageBtn");
    const imagePreview = document.getElementById("imagePreview");

    const productForm = document.getElementById("productForm");


    // ==========================================
    // NEWLY SELECTED FILES
    // ==========================================

    let selectedFiles = [];


    // ==========================================
    // EXISTING DATABASE IMAGES TO DELETE
    // ==========================================

    let deletedImages = [];


    // ==========================================
    // OPEN FILE PICKER
    // ==========================================

    uploadArea.addEventListener("click", function (event) {

        // Don't open picker when clicking remove
        if (event.target.closest("#removeMainImage")) {
            return;
        }

        productImages.click();

    });


    // ==========================================
    // ADD IMAGE BUTTON
    // ==========================================

    addImageBtn.addEventListener("click", function (event) {

        event.preventDefault();
        event.stopPropagation();

        productImages.click();

    });


    // ==========================================
    // FILE SELECTED
    // ==========================================

    productImages.addEventListener("change", function (event) {

        const files = Array.from(event.target.files);

        if (files.length === 0) {
            return;
        }


        // ======================================
        // MAXIMUM 5 NEW IMAGES
        // ======================================

        if (selectedFiles.length + files.length > 5) {

            alert("Maximum 5 images are allowed.");

            return;
        }


        selectedFiles = [
            ...selectedFiles,
            ...files
        ];


        updateFileInput();

        displayNewImages();

    });


    // ==========================================
    // UPDATE FILE INPUT
    // ==========================================

    function updateFileInput() {

        const dataTransfer = new DataTransfer();


        selectedFiles.forEach(function (file) {

            dataTransfer.items.add(file);

        });


        productImages.files = dataTransfer.files;


        console.log(
            "Files in input:",
            productImages.files.length
        );

    }


    // ==========================================
    // DISPLAY NEW IMAGES
    // ==========================================

    function displayNewImages() {


        // Remove previously generated previews

        imagePreview
            .querySelectorAll(".new-image")
            .forEach(function (element) {

                element.remove();

            });


        // ======================================
        // NO NEW FILES
        // ======================================

        if (selectedFiles.length === 0) {

            /*
             * If there are no newly selected files,
             * don't destroy the existing database image.
             */

            return;

        }


        // ======================================
        // MAIN NEW IMAGE
        // ======================================

        const reader = new FileReader();


        reader.onload = function (event) {

            mainImage.src = event.target.result;

            mainImage.classList.remove("hidden");


            if (uploadContent) {

                uploadContent.classList.add("hidden");

            }


            removeMainImage.classList.remove("hidden");

        };


        reader.readAsDataURL(selectedFiles[0]);


        // ======================================
        // OTHER NEW IMAGES
        // ======================================

        selectedFiles
            .slice(1)
            .forEach(function (file, index) {

                const actualIndex = index + 1;

                const reader = new FileReader();


                reader.onload = function (event) {

                    const container =
                        document.createElement("div");


                    container.className =
                        "new-image aspect-square rounded-lg overflow-hidden relative group bg-surface-container";


                    container.innerHTML = `

                        <img
                            src="${event.target.result}"
                            class="w-full h-full object-cover"
                            alt="New product image"
                        >

                        <button
                            type="button"
                            class="remove-new-image absolute top-2 right-2 w-7 h-7 rounded-full bg-black/70 text-white flex items-center justify-center hover:bg-black"
                            data-index="${actualIndex}"
                        >
                            ×
                        </button>

                    `;


                    imagePreview.insertBefore(
                        container,
                        addImageBtn
                    );

                };


                reader.readAsDataURL(file);

            });

    }


    // ==========================================
    // DELETE NEW IMAGE
    // ==========================================

    imagePreview.addEventListener("click", function (event) {

        const button =
            event.target.closest(".remove-new-image");


        if (!button) {
            return;
        }


        const index =
            Number(button.dataset.index);


        selectedFiles.splice(index, 1);


        updateFileInput();

        displayNewImages();

    });


    // ==========================================
    // DELETE EXISTING DATABASE IMAGE
    // ==========================================

    imagePreview.addEventListener("click", function (event) {

        const button =
            event.target.closest(".remove-existing-image");


        if (!button) {
            return;
        }


        const container =
            button.closest(".existing-image");


        if (!container) {
            return;
        }


        const publicId =
            container.dataset.publicId;


        if (!publicId) {
            return;
        }


        // Add Cloudinary public_id

        deletedImages.push(publicId);


        console.log(
            "Deleted images:",
            deletedImages
        );


        // Remove from screen

        container.remove();

    });


    // ==========================================
    // REMOVE MAIN IMAGE
    // ==========================================

    removeMainImage.addEventListener(
        "click",
        function (event) {

            event.preventDefault();
            event.stopPropagation();


            // ==================================
            // CASE 1:
            // MAIN IMAGE IS A NEW FILE
            // ==================================

            if (selectedFiles.length > 0) {

                selectedFiles.shift();

                updateFileInput();

                displayNewImages();

                return;

            }


            // ==================================
            // CASE 2:
            // MAIN IMAGE IS FROM DATABASE
            // ==================================

            const publicId =
                mainImage.dataset.publicId;


            if (publicId) {

                deletedImages.push(publicId);

            }


            // Hide image

            mainImage.src = "";

            mainImage.classList.add("hidden");


            // Hide remove button

            removeMainImage.classList.add("hidden");


            // Show upload content

            if (uploadContent) {

                uploadContent.classList.remove("hidden");

            }


            console.log(
                "Deleted database images:",
                deletedImages
            );

        }
    );


    // ==========================================
    // FORM SUBMIT
    // ==========================================

    if (productForm) {

        productForm.addEventListener(
            "submit",
            function () {


                // ==================================
                // DELETED IMAGES
                // ==================================

                const deletedInput =
                    document.createElement("input");


                deletedInput.type = "hidden";

                deletedInput.name = "deletedImages";

                deletedInput.value =
                    JSON.stringify(deletedImages);


                productForm.appendChild(
                    deletedInput
                );


                // ==================================
                // DEBUG
                // ==================================

                console.log(
                    "FILES BEFORE SUBMIT:",
                    productImages.files
                );


                console.log(
                    "FILE COUNT:",
                    productImages.files.length
                );


                console.log(
                    "DELETED IMAGES:",
                    deletedImages
                );

            }
        );

    }

});

</script>









