<span class="material-symbols-outlined text-[18px]" data-icon="open_in_new">open_in_new</span>
                View Store
            </button>
</div>
</aside>
<!-- Main Content Area -->
<main class="ml-64 min-h-screen">
<!-- TopNavBar Shell -->
<header class="sticky top-0 w-full z-40 bg-surface/80 dark:bg-surface-dim/80 backdrop-blur-md flex justify-between items-center h-16 px-container-padding border-b border-outline-variant/30">
<div class="flex items-center gap-6 flex-1">
<div class="relative w-full max-w-md">
<span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant" data-icon="search">search</span>
<input class="w-full pl-10 pr-4 py-2 bg-surface-container-low border-none rounded-lg focus:ring-1 focus:ring-primary font-body-md text-body-md" placeholder="Search inventory..." type="text">
</div>
</div>
<div class="flex items-center gap-4">
<button class="p-2 text-on-surface-variant hover:text-primary transition-colors hover:scale-95">
<span class="material-symbols-outlined" data-icon="notifications">notifications</span>
</button>
<button class="p-2 text-on-surface-variant hover:text-primary transition-colors hover:scale-95">
<span class="material-symbols-outlined" data-icon="settings">settings</span>
</button>
<div class="h-8 w-[1px] bg-outline-variant/30 mx-2"></div>
<button class="flex items-center gap-2 group">
<div class="w-8 h-8 rounded-full bg-surface-container-highest overflow-hidden">
<img class="w-full h-full object-cover" data-alt="A professional studio portrait of a high-end wellness administrator with a friendly and composed expression. The lighting is soft and flattering, reminiscent of a luxury lifestyle magazine profile. The background is a clean, minimalist off-white aesthetic consistent with a premium brand identity." src="https://lh3.googleusercontent.com/aida-public/AB6AXuDgQSH6IKUpenA4XtRvw9YfoxgqQEXc4ZeQKz8WaBrvNR9to1pCmg7xDAyLO4no_P5o3UMVxdUp8Mx5FemBvVKZ-8qo66cMIV-bO8J210NHaVzE6_O-xBI4K67ex4YQ9l46w2jZ7NrPKm8DCBQrTNOHfUIE8_F6WFcoNQcUFs512b2y4F2J4Ma1izPZJJgNbPxKLC0WbOnH8aist6pBBSP73OIVtNeShQMOn1VhU5rBvvuBLb3_5P1thyo9l3nkoV6s-G4mXr2Ddz8">
</div>
<span class="font-label-md text-label-md text-on-surface group-hover:text-primary transition-colors">Profile</span>
</button>
</div>
</header>
<!-- Page Content -->
<div class="max-w-max-width mx-auto px-container-padding py-stack-lg">
<!-- Breadcrumbs -->
<nav class="flex items-center gap-2 text-on-surface-variant font-label-md mb-8">
<a class="hover:text-primary transition-colors" href="#">Inventory</a>
<span class="material-symbols-outlined text-[16px]" data-icon="chevron_right">chevron_right</span>
<span class="text-primary font-bold">Edit Product</span>
</nav>
<!-- Header Section -->
<div class="flex justify-between items-end mb-12">
<div>
<h2 class="font-headline-xl text-headline-xl text-on-surface mb-2">Edit Product</h2>
<p class="text-on-surface-variant max-w-2xl font-body-lg text-body-lg">Update the details, pricing, and visual assets for the Signature Dates Burfi. Changes will reflect across the boutique storefront immediately upon saving.</p>
</div>
<div class="flex gap-4">
<button class="px-6 py-3 border border-outline-variant rounded-lg font-label-md hover:bg-surface-container transition-colors">Discard</button>
<button
    type="submit"
    form="productForm"
    class="px-8 py-3 bg-[#000000] text-[#ffffff] rounded-lg font-label-md"
>
    <span class="material-symbols-outlined">
        save
    </span>
    Save Changes
</button>
</div>
</div>
<!-- Bento Layout Form -->
<form
    id="productForm"
    action="/admin/editProduct/{{product._id}}"
    method="POST"
    enctype="multipart/form-data"
    class="grid grid-cols-12 gap-grid-gutter"
>
<!-- Primary Information Column (8 cols) -->
<div class="col-span-8 space-y-grid-gutter">
<!-- Basic Details Card -->
<section class="bg-surface-container-lowest p-8 rounded-xl premium-shadow border border-black/[0.04]">
<h3 class="font-headline-lg text-headline-lg text-on-surface mb-6">Product Details</h3>
<div class="space-y-6">
<div>
<label class="block font-label-md text-label-md text-on-surface-variant mb-2">Product Name</label>
<input
    class="w-full bg-surface-container-low border-none rounded-lg p-4 font-body-md text-body-md form-input-focus transition-all"
    placeholder="e.g., Artisan Nutri Burfi - Gold Edition"
    type="text"
    name="product_name"
    value="{{product.productName}}"
    required
></div>
<div>
<label class="block font-label-md text-label-md text-on-surface-variant mb-2">Description</label>
<textarea
    class="w-full bg-surface-container-low border-none rounded-lg p-4 font-body-md text-body-md form-input-focus transition-all leading-relaxed"
    placeholder="Describe the luxury experience, nutritional value, and artisanal craftsmanship..."
    rows="8"
    name="description"
    required
>{{product.productDescription}}</textarea></div>
</div>
</section>
<!-- Pricing & Inventory Card -->
<section class="bg-surface-container-lowest p-8 rounded-xl premium-shadow border border-black/[0.04]">
<div class="flex items-center justify-between mb-6">
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-primary" data-icon="layers">layers</span>
<h3 class="font-headline-lg text-headline-lg text-on-surface">Product Variants</h3>
</div>
<div class="flex items-center gap-3">
<span class="font-label-md text-on-surface-variant">Enable Variants</span>
<label class="relative inline-flex items-center cursor-pointer">
<input class="sr-only peer" type="checkbox" value="">
<div class="w-11 h-6 bg-surface-container-highest peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-on-surface"></div>
</label>
</div>
</div>
<div class="space-y-4">
<div class="overflow-hidden rounded-lg border border-outline-variant/20">
<table class="w-full text-left border-collapse">

    <thead class="bg-surface-container-low">
        <tr>
            <th class="p-3 font-label-md text-[12px] text-on-surface-variant uppercase tracking-wider">
                WEIGHT (KG)
            </th>

            <th class="p-3 font-label-md text-[12px] text-on-surface-variant uppercase tracking-wider">
                PRICE +/-
            </th>

            <th class="p-3 font-label-md text-[12px] text-on-surface-variant uppercase tracking-wider">
                SKU
            </th>

            <th class="p-3 font-label-md text-[12px] text-on-surface-variant uppercase tracking-wider">
                STOCK
            </th>
        </tr>
    </thead>

    <tbody class="divide-y divide-outline-variant/10">

        {{#each product.variants}}

        <tr>

            <!-- Weight -->
            <td class="p-3">
                <input
                    class="w-full bg-transparent border-none p-0 text-body-md focus:ring-0 placeholder:text-on-surface-variant/30"
                    type="text"
                    name="variants[{{@index}}][weight]"
                    value="{{this.weight}}"
                    required
                >

                <!-- Existing Variant ID -->
                <input
                    type="hidden"
                    name="variants[{{@index}}][_id]"
                    value="{{this._id}}"
                >
            </td>

            <!-- Price -->
            <td class="p-3">
                <input
                    class="w-full bg-transparent border-none p-0 text-body-md focus:ring-0 placeholder:text-on-surface-variant/30"
                    type="number"
                    name="variants[{{@index}}][price]"
                    value="{{this.regular_price}}"
                    min="0"
                    step="0.01"
                    required
                >
            </td>

            <!-- SKU -->
            <td class="p-3">
                <input
                    class="w-full bg-transparent border-none p-0 text-body-md focus:ring-0 placeholder:text-on-surface-variant/30"
                    type="text"
                    name="variants[{{@index}}][sku]"
                    value="{{this.sku}}"
                    required
                >
            </td>

            <!-- Stock -->
            <td class="p-3">
                <input
                    class="w-full bg-transparent border-none p-0 text-body-md focus:ring-0 placeholder:text-on-surface-variant/30"
                    type="number"
                    name="variants[{{@index}}][stock_quantity]"
                    value="{{this.stock_quantity}}"
                    min="0"
                    required
                >
            </td>

        </tr>

        {{else}}

        <tr>
            <td
                colspan="4"
                class="p-6 text-center text-on-surface-variant"
            >
                No variants found for this product.
            </td>
        </tr>

        {{/each}}

    </tbody>

</table>
</div>
<button class="w-full flex items-center justify-center gap-2 py-3 border border-dashed border-outline-variant rounded-lg text-on-surface-variant hover:border-primary hover:text-primary transition-all group" type="button">
<span class="material-symbols-outlined text-[20px]" data-icon="add_circle">add_circle</span>
<span class="font-label-md">Add Variant</span>
</button>
</div>
</section>
</div>
<!-- Secondary Info & Media (4 cols) -->
<div class="col-span-4 space-y-grid-gutter">
<!-- Media Gallery Card -->
<section class="bg-surface-container-lowest p-8 rounded-xl premium-shadow border border-black/[0.04]">

    <h3 class="font-headline-lg text-[24px] text-on-surface mb-8">
        Product Media
    </h3>

    <div class="space-y-4">

        <!-- Hidden file input -->
        <input
            type="file"
            id="productImages"
            name="images"
            accept="image/*"
            multiple
            class="hidden"
        >

        <!-- ============================= -->
        <!-- MAIN IMAGE -->
        <!-- ============================= -->

        <div
            id="uploadArea"
            class="relative border-2 border-dashed border-outline-variant rounded-xl aspect-square overflow-hidden flex flex-col items-center justify-center text-center p-6 bg-surface-container-low group cursor-pointer hover:bg-surface-container transition-colors"
        >

            {{#if product.images.length}}

                <!-- First image from database -->
                <img
                    id="mainImage"
                    src="{{product.images.[0].url}}"
                    alt="{{product.productName}}"
                    data-public-id="{{product.images.[0].public_id}}"
                    class="absolute inset-0 w-full h-full object-cover"
                >

                <!-- Remove button -->
                <button
                    id="removeMainImage"
                    type="button"
                    class="absolute top-3 right-3 w-8 h-8 rounded-full bg-black/70 text-white flex items-center justify-center hover:bg-black transition z-10"
                >
                    ×
                </button>

            {{else}}

                <!-- Upload content -->
                <div id="uploadContent">

                    <span class="material-symbols-outlined text-on-surface-variant text-[48px] mb-4 group-hover:scale-110 transition-transform">
                        cloud_upload
                    </span>

                    <p class="font-label-md text-on-surface">
                        Drag and drop images
                    </p>

                    <p class="text-[11px] text-on-surface-variant mt-1">
                        or click to browse
                    </p>

                </div>

                <img
                    id="mainImage"
                    class="hidden absolute inset-0 w-full h-full object-cover"
                    alt="Main product image"
                >

                <button
                    id="removeMainImage"
                    type="button"
                    class="hidden absolute top-3 right-3 w-8 h-8 rounded-full bg-black/70 text-white items-center justify-center hover:bg-black transition z-10"
                >
                    ×
                </button>

            {{/if}}

        </div>


        <!-- ============================= -->
        <!-- OTHER DATABASE IMAGES -->
        <!-- ============================= -->

        <div
            id="imagePreview"
            class="grid grid-cols-3 gap-3"
        >

            {{#each product.images}}

                {{#unless @first}}

                    <div
                        class="existing-image aspect-square rounded-lg overflow-hidden relative group bg-surface-container"
                        data-public-id="{{this.public_id}}"
                        data-image-url="{{this.url}}"
                    >

                        <!-- Database image -->
                        <img
                            src="{{this.url}}"
                            alt="{{../product.productName}}"
                            class="w-full h-full object-cover"
                        >

                        <!-- Hover overlay -->
                        <div
                            class="absolute inset-0 bg-black/30 opacity-0 group-hover:opacity-100 transition-all flex items-center justify-center"
                        >

                            <button
                                type="button"
                                class="remove-existing-image w-8 h-8 bg-white rounded-full text-error flex items-center justify-center hover:scale-110 transition"
                            >
                                ×
                            </button>

                        </div>

                    </div>

                {{/unless}}

            {{/each}}


            <!-- ============================= -->
            <!-- ADD IMAGE -->
            <!-- ============================= -->

            <button
                id="addImageBtn"
                type="button"
                class="aspect-square rounded-lg border-2 border-dashed border-outline-variant flex flex-col items-center justify-center gap-1 hover:bg-surface-container-low transition-colors group"
            >

                <span class="material-symbols-outlined text-on-surface-variant text-[20px]">
                    add_a_photo
                </span>

                <span class="text-[10px] font-label-md text-on-surface-variant">
                    Add
                </span>

            </button>

        </div>

    </div>

</section>
<!-- Status & Categorization -->
<section class="bg-surface-container-lowest p-8 rounded-xl premium-shadow border border-black/[0.04]">

    <h3 class="font-headline-lg text-headline-lg text-on-surface mb-6">
        Organization
    </h3>

    <div class="space-y-6">

        <!-- Product Status -->
        <div>
            <label class="block font-label-md text-label-md text-on-surface-variant mb-2">
                Product Status
            </label>

 <select
    name="status"
    class="w-full bg-surface-container-low border-none rounded-lg p-4 font-body-md text-body-md form-input-focus transition-all"
>
    <option
        value="Active"
        {{#if product.is_listed}}selected{{/if}}
    >
        Active
    </option>

    <option
        value="Delete"
        {{#unless product.is_listed}}selected{{/unless}}
    >
        Delete
    </option>
</select>
        </div>

        <!-- Category -->
        <div>
