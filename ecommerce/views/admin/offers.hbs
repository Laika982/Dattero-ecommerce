<!DOCTYPE html><html class="light" lang="en"><head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<title>Offers Management | Nutri Luxe Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&amp;family=Plus+Jakarta+Sans:wght@600;700&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "surface-variant": "#e3e2e2",
                        "surface": "#fbf9f9",
                        "outline": "#747878",
                        "background": "#fbf9f9",
                        "on-primary-fixed-variant": "#464747",
                        "on-tertiary": "#ffffff",
                        "primary-fixed-dim": "#c7c6c6",
                        "inverse-primary": "#c7c6c6",
                        "surface-container-highest": "#e3e2e2",
                        "on-secondary-container": "#646464",
                        "on-error-container": "#93000a",
                        "tertiary-container": "#747474",
                        "surface-bright": "#fbf9f9",
                        "secondary": "#5e5e5e",
                        "secondary-container": "#e3e2e2",
                        "on-primary-container": "#fefcfc",
                        "on-surface-variant": "#444748",
                        "outline-variant": "#c4c7c7",
                        "surface-tint": "#5e5e5e",
                        "tertiary-fixed-dim": "#c6c6c6",
                        "on-primary": "#ffffff",
                        "primary": "#5c5c5c",
                        "on-primary-fixed": "#1b1c1c",
                        "inverse-on-surface": "#f2f0f0",
                        "secondary-fixed": "#e3e2e2",
                        "on-secondary-fixed": "#1b1c1c",
                        "surface-dim": "#dbdad9",
                        "primary-fixed": "#e3e2e2",
                        "secondary-fixed-dim": "#c7c6c6",
                        "error-container": "#ffdad6",
                        "on-tertiary-fixed-variant": "#474747",
                        "inverse-surface": "#303031",
                        "tertiary-fixed": "#e2e2e2",
                        "surface-container-lowest": "#ffffff",
                        "surface-container": "#efeded",
                        "surface-container-high": "#e9e8e7",
                        "tertiary": "#5c5c5c",
                        "surface-container-low": "#f5f3f3",
                        "on-tertiary-fixed": "#1b1b1b",
                        "on-surface": "#1b1c1c",
                        "on-secondary": "#ffffff",
                        "on-background": "#1b1c1c",
                        "primary-container": "#747474",
                        "on-tertiary-container": "#fcfcfc",
                        "on-secondary-fixed-variant": "#464747",
                        "on-error": "#ffffff",
                        "error": "#ba1a1a"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "stack-lg": "24px",
                        "grid-gutter": "24px",
                        "container-padding": "32px",
                        "stack-sm": "8px",
                        "max-width": "1280px",
                        "section-gap-mobile": "64px",
                        "stack-md": "16px",
                        "section-gap": "120px"
                    },
                    "fontFamily": {
                        "body-xl": ["Inter"],
                        "body-lg": ["Inter"],
                        "body-md": ["Inter"],
                        "label-md": ["Inter"],
                        "headline-xl": ["Plus Jakarta Sans"],
                        "headline-lg": ["Plus Jakarta Sans"],
                        "display-lg-mobile": ["Plus Jakarta Sans"],
                        "display-lg": ["Plus Jakarta Sans"]
                    },
                    "fontSize": {
                        "body-xl": ["20px", {"lineHeight": "1.5", "fontWeight": "400"}],
                        "body-lg": ["17px", {"lineHeight": "1.5", "fontWeight": "400"}],
                        "body-md": ["15px", {"lineHeight": "1.5", "fontWeight": "400"}],
                        "label-md": ["14px", {"lineHeight": "1.2", "letterSpacing": "0.02em", "fontWeight": "600"}],
                        "headline-xl": ["40px", {"lineHeight": "1.2", "letterSpacing": "-0.01em", "fontWeight": "600"}],
                        "headline-lg": ["32px", {"lineHeight": "1.25", "fontWeight": "600"}],
                        "display-lg-mobile": ["40px", {"lineHeight": "1.1", "letterSpacing": "-0.01em", "fontWeight": "700"}],
                        "display-lg": ["56px", {"lineHeight": "1.1", "letterSpacing": "-0.02em", "fontWeight": "700"}]
                    }
                },
            },
        }
    </script>
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(0, 0, 0, 0.08);
        }
        body { background-color: #fbf9f9; }
    </style>
</head>
<body class="font-body-md text-on-surface">
    {{> user/notification}}
{{> admin/aside}}
<header class="sticky top-0 lg:ml-64 ml-0 z-40 bg-surface/80 backdrop-blur-md border-b border-outline-variant/30 h-16 flex justify-between items-center px-4 sm:px-6 md:px-container-padding">
    <!-- Left: Mobile Sidebar Toggle & Search Form -->
    <div class="flex items-center flex-1 max-w-lg gap-2 sm:gap-3 mr-4">
        <button type="button" class="lg:hidden p-2 rounded-lg text-on-surface-variant hover:text-ink-black hover:bg-surface-variant/50 transition-colors touch-target shrink-0" onclick="toggleAdminSidebar()" aria-label="Toggle Navigation">
            <span class="material-symbols-outlined text-[22px]">menu</span>
        </button>

        <form action="/admin/offers" method="GET" class="relative w-full flex items-center admin-search-form" data-base-url="/admin/offers">
            {{#if filter}}<input type="hidden" name="filter" value="{{filter}}">{{/if}}

            <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px] pointer-events-none">
                search
            </span>

            <input
                class="admin-search-input w-full bg-surface-container-low border border-outline-variant/30 focus:border-transparent rounded-full pl-10 pr-24 py-2 text-sm sm:text-body-md text-on-surface focus:ring-2 focus:ring-primary focus:outline-none transition-all placeholder:text-on-surface-variant/40"
                placeholder="Search offers..."
                type="text"
                name="search"
                value="{{search}}"
                autocomplete="off"
            >

            <!-- Close / Clear Button (Visible only when text is inside input) -->
            <button
                type="button"
                class="admin-search-clear absolute right-[84px] top-1/2 -translate-y-1/2 z-10 w-6 h-6 items-center justify-center rounded-full text-on-surface-variant hover:bg-surface-container-high hover:text-error transition-all cursor-pointer {{#if search}}flex{{else}}hidden{{/if}}"
                title="Clear search"
                aria-label="Clear search"
            >
                <span class="material-symbols-outlined text-[16px] pointer-events-none">close</span>
            </button>

            <!-- Search Button -->
            <button
                type="submit"
                class="absolute right-1 top-1/2 -translate-y-1/2 px-4 py-1.5 rounded-full bg-primary text-on-primary text-xs sm:text-sm font-semibold hover:opacity-90 active:scale-95 transition-all shadow-sm"
            >
                Search
            </button>
        </form>
    </div>

    <!-- Right Side: Store link, Notifications, Admin Profile -->
    <div class="flex items-center gap-3 sm:gap-5 shrink-0">
        <a href="/" target="_blank"
            class="hidden sm:inline-flex items-center gap-2 px-3.5 py-1.5 border border-outline-variant/30 rounded-full hover:bg-surface-variant transition-colors active:scale-95 text-on-surface-variant text-xs sm:text-sm font-label-md">
            <span class="material-symbols-outlined text-[18px]">visibility</span>
            <span>View Store</span>
        </a>

        <!-- Notifications -->
        <button class="p-2 text-on-surface-variant hover:text-primary transition-colors active:scale-95 relative" title="Notifications" aria-label="Notifications">
            <span class="material-symbols-outlined text-[20px]">notifications</span>
        </button>

        <div class="h-6 w-[1px] bg-outline-variant/30 hidden sm:block"></div>

        <!-- Admin Profile -->
        <div class="flex items-center gap-2.5 cursor-pointer group">
            <div class="text-right hidden md:block">
                <p class="font-label-md text-xs sm:text-sm text-on-surface font-semibold leading-tight">Admin</p>
                <p class="text-[10px] text-on-surface-variant/70">Nutri Luxe Admin</p>
            </div>
            <div class="w-8 h-8 rounded-full overflow-hidden bg-surface-container-highest border border-outline-variant/30 flex items-center justify-center text-on-surface-variant group-hover:scale-105 transition-transform">
                <span class="material-symbols-outlined text-[20px]">person</span>
            </div>
        </div>
    </div>
</header>
<main class="lg:ml-64 ml-0 p-4 sm:p-6 md:p-container-padding min-h-screen">
<div class="max-w-max-width mx-auto">
<div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4 mb-6 sm:mb-10">
<div>
<h2 class="font-headline-xl text-on-surface mb-2">Offers Management</h2>
<p class="text-body-lg text-on-surface-variant">Create product, category, and referral offers. Storefront pricing always uses the largest applicable discount.</p>
</div>
<a href="/admin/offers/add" class="bg-on-surface text-surface py-3 px-8 rounded-lg font-label-md flex items-center gap-2 hover:opacity-90 active:scale-95 transition-all shadow-lg shadow-on-surface/10">
<span class="material-symbols-outlined">add</span>
                    Create Offer
                </a>
</div>
<div class="grid grid-cols-1 md:grid-cols-4 gap-grid-gutter mb-section-gap-mobile">
<div class="glass-card p-6 rounded-xl">
<p class="text-on-surface-variant font-label-md mb-2">Listed Offers</p>
<h3 class="text-headline-lg font-bold">{{totalOffers}}</h3>
<p class="text-[12px] text-on-surface-variant mt-2">In the current filter</p>
</div>
<div class="glass-card p-6 rounded-xl">
<p class="text-on-surface-variant font-label-md mb-2">Product Offers</p>
<h3 class="text-headline-lg font-bold">{{productCount}}</h3>
<p class="text-[12px] text-on-surface-variant mt-2">Target a single product</p>
</div>
<div class="glass-card p-6 rounded-xl">
<p class="text-on-surface-variant font-label-md mb-2">Category Offers</p>
<h3 class="text-headline-lg font-bold">{{categoryCount}}</h3>
<p class="text-[12px] text-on-surface-variant mt-2">Largest of product vs category wins</p>
</div>
<div class="glass-card p-6 rounded-xl">
<p class="text-on-surface-variant font-label-md mb-2">Referral Offers</p>
<h3 class="text-headline-lg font-bold">{{referralCount}}</h3>
<p class="text-[12px] text-on-surface-variant mt-2">First order for referred customers</p>
</div>
</div>
<div class="bg-surface-container-lowest rounded-xl border border-outline-variant/30 overflow-hidden shadow-sm">
<div class="px-6 py-5 border-b border-outline-variant/30 flex justify-between items-center">
<div class="flex flex-wrap gap-2">
<a href="/admin/offers" class="font-label-md px-4 py-1 {{#if (eq filter "all")}}bg-on-surface text-surface{{else}}text-on-surface-variant hover:bg-surface-variant{{/if}} rounded-full transition-colors">All</a>
<a href="/admin/offers?filter=active" class="font-label-md px-4 py-1 {{#if (eq filter "active")}}bg-on-surface text-surface{{else}}text-on-surface-variant hover:bg-surface-variant{{/if}} rounded-full transition-colors">Active</a>
<a href="/admin/offers?filter=product" class="font-label-md px-4 py-1 {{#if (eq filter "product")}}bg-on-surface text-surface{{else}}text-on-surface-variant hover:bg-surface-variant{{/if}} rounded-full transition-colors">Product</a>
<a href="/admin/offers?filter=category" class="font-label-md px-4 py-1 {{#if (eq filter "category")}}bg-on-surface text-surface{{else}}text-on-surface-variant hover:bg-surface-variant{{/if}} rounded-full transition-colors">Category</a>
<a href="/admin/offers?filter=referral" class="font-label-md px-4 py-1 {{#if (eq filter "referral")}}bg-on-surface text-surface{{else}}text-on-surface-variant hover:bg-surface-variant{{/if}} rounded-full transition-colors">Referral</a>
<a href="/admin/offers?filter=inactive" class="font-label-md px-4 py-1 {{#if (eq filter "inactive")}}bg-on-surface text-surface{{else}}text-on-surface-variant hover:bg-surface-variant{{/if}} rounded-full transition-colors">Inactive</a>
</div>
</div>
<div class="overflow-x-auto">
<table class="w-full text-left border-collapse">
<thead>
<tr class="bg-surface-container-low border-b border-outline-variant/20">
<th class="px-6 py-4 font-label-md text-on-surface-variant tracking-wider">OFFER</th>
<th class="px-6 py-4 font-label-md text-on-surface-variant tracking-wider">TYPE</th>
<th class="px-6 py-4 font-label-md text-on-surface-variant tracking-wider">TARGET</th>
<th class="px-6 py-4 font-label-md text-on-surface-variant tracking-wider">DISCOUNT</th>
<th class="px-6 py-4 font-label-md text-on-surface-variant tracking-wider">PERIOD</th>
<th class="px-6 py-4 font-label-md text-on-surface-variant tracking-wider">STATUS</th>
<th class="px-6 py-4 font-label-md text-on-surface-variant tracking-wider text-right">ACTIONS</th>
</tr>
</thead>
<tbody class="divide-y divide-outline-variant/10">
{{#each offers}}
<tr class="hover:bg-surface-container-low/50 transition-colors group">
<td class="px-6 py-6">
<div class="flex items-center gap-3">
<div class="w-10 h-10 rounded bg-primary/10 flex items-center justify-center text-primary">
<span class="material-symbols-outlined">local_offer</span>
</div>
<div>
<p class="font-bold font-body-md text-on-surface">{{name}}</p>
<p class="text-[12px] text-on-surface-variant">{{discountLabel}}</p>
</div>
</div>
</td>
<td class="px-6 py-6">
<span class="px-3 py-1 bg-surface-variant text-[12px] font-bold rounded-full text-on-surface-variant uppercase tracking-widest">{{offer_type}}</span>
</td>
<td class="px-6 py-6">
<p class="font-body-md text-on-surface">{{targetLabel}}</p>
</td>
<td class="px-6 py-6">
<p class="font-body-md text-on-surface">{{discountLabel}}</p>
</td>
<td class="px-6 py-6">
<p class="font-body-md text-on-surface">{{startLabel}}</p>
<p class="text-[12px] text-on-surface-variant">to {{endLabel}}</p>
</td>
<td class="px-6 py-6">
{{#if currentlyActive}}
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-700">Active</span>
    {{else}}
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-red-100 text-red-700">Inactive</span>
    {{/if}}
</td>
<td class="px-6 py-6 text-right">
    <div class="flex justify-end gap-2">
        <a href="/admin/offers/edit/{{this._id}}" class="text-on-surface-variant hover:text-primary transition-colors p-2 hover:bg-surface-variant rounded-full" title="Edit {{name}}" aria-label="Edit {{name}}">
            <span class="material-symbols-outlined">edit</span>
        </a>
        <button type="button" class="delete-offer-btn text-on-surface-variant hover:text-error transition-colors p-2 hover:bg-surface-variant rounded-full" data-id="{{this._id}}" data-name="{{name}}" title="Delete {{name}}" aria-label="Delete {{name}}">
            <span class="material-symbols-outlined">delete</span>
        </button>
    </div>
</td>
</tr>
{{else}}
<tr><td colspan="7" class="px-6 py-12 text-center text-on-surface-variant">No offers have been created yet.</td></tr>
{{/each}}
</tbody>
</table>
</div>
<div class="px-6 py-4 bg-surface-container-low border-t border-outline-variant/30 flex justify-between items-center">
<p class="text-[12px] text-on-surface-variant font-label-md">Showing {{startItem}} to {{endItem}} of {{totalOffers}} offers</p>
<div class="flex gap-2">
{{#if hasPreviousPage}}
<a href="/admin/offers?filter={{filter}}&amp;page={{subtract currentPage 1}}" class="w-8 h-8 flex items-center justify-center rounded-lg border border-outline-variant/30 text-on-surface-variant hover:bg-surface-variant transition-colors" aria-label="Previous page">
<span class="material-symbols-outlined text-[18px]">chevron_left</span>
</a>
{{else}}
<button class="w-8 h-8 flex items-center justify-center rounded-lg border border-outline-variant/30 text-on-surface-variant disabled:opacity-30" disabled>
<span class="material-symbols-outlined text-[18px]">chevron_left</span>
</button>
{{/if}}
{{#each pages}}
<a href="/admin/offers?filter={{../filter}}&amp;page={{this}}" class="w-8 h-8 flex items-center justify-center rounded-lg {{#if (eq ../currentPage this)}}bg-on-surface text-surface{{else}}border border-outline-variant/30 text-on-surface-variant hover:bg-surface-variant{{/if}} font-label-md">{{this}}</a>
{{/each}}
{{#if hasNextPage}}
<a href="/admin/offers?filter={{filter}}&amp;page={{add currentPage 1}}" class="w-8 h-8 flex items-center justify-center rounded-lg border border-outline-variant/30 text-on-surface-variant hover:bg-surface-variant transition-colors" aria-label="Next page">
<span class="material-symbols-outlined text-[18px]">chevron_right</span>
</a>
{{else}}
<button class="w-8 h-8 flex items-center justify-center rounded-lg border border-outline-variant/30 text-on-surface-variant disabled:opacity-30" disabled>
<span class="material-symbols-outlined text-[18px]">chevron_right</span>
</button>
{{/if}}
</div>
</div>
</div>
</div>
</main>
<div id="offerDeleteModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/40 backdrop-blur-sm" role="presentation">
    <section class="w-full max-w-md mx-4 bg-white rounded-2xl shadow-xl p-6" role="dialog" aria-modal="true" aria-labelledby="offerDeleteTitle">
        <div class="flex items-center justify-between mb-4">
            <h2 id="offerDeleteTitle" class="text-xl font-semibold text-gray-900">Confirm Delete</h2>
            <button type="button" id="closeOfferDeleteModal" class="text-gray-400 hover:text-gray-700" aria-label="Close confirmation">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <p class="text-gray-600 mb-6">Are you sure you want to delete offer <strong id="offerDeleteName"></strong>? This action cannot be undone.</p>
        <div class="flex justify-end gap-3">
            <button type="button" id="cancelOfferDelete" class="px-5 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100">Cancel</button>
            <button type="button" id="confirmOfferDelete" class="px-5 py-2 rounded-lg bg-red-600 text-white hover:bg-red-700">Delete</button>
        </div>
    </section>
</div>
<script>
    const offerDeleteModal = document.getElementById("offerDeleteModal");
    const offerDeleteName = document.getElementById("offerDeleteName");
    let selectedOfferId = null;

    function closeOfferDeleteModal() {
        offerDeleteModal.classList.add("hidden");
        offerDeleteModal.classList.remove("flex");
        selectedOfferId = null;
    }

    document.querySelectorAll(".delete-offer-btn").forEach((button) => {
        button.addEventListener("click", () => {
            selectedOfferId = button.dataset.id;
            offerDeleteName.textContent = button.dataset.name;
            offerDeleteModal.classList.remove("hidden");
            offerDeleteModal.classList.add("flex");
        });
    });

    document.getElementById("cancelOfferDelete").addEventListener("click", closeOfferDeleteModal);
    document.getElementById("closeOfferDeleteModal").addEventListener("click", closeOfferDeleteModal);
    offerDeleteModal.addEventListener("click", (event) => {
        if (event.target === offerDeleteModal) closeOfferDeleteModal();
    });

    document.getElementById("confirmOfferDelete").addEventListener("click", () => {
        if (!selectedOfferId) return;
        const form = document.createElement("form");
        form.method = "POST";
        form.action = `/admin/offers/${encodeURIComponent(selectedOfferId)}?_method=DELETE`;
        document.body.appendChild(form);
        form.submit();
    });

    // Admin Search Input with dynamic close button
    document.querySelectorAll('.admin-search-form').forEach((form) => {
        const input = form.querySelector('.admin-search-input');
        const clearBtn = form.querySelector('.admin-search-clear');
        const baseUrl = form.dataset.baseUrl || form.getAttribute('action');

        if (!input || !clearBtn) return;

        function toggleClearBtn() {
            if (input.value && input.value.trim().length > 0) {
                clearBtn.classList.remove('hidden');
                clearBtn.classList.add('flex');
            } else {
                clearBtn.classList.add('hidden');
                clearBtn.classList.remove('flex');
            }
        }

        input.addEventListener('input', toggleClearBtn);
        input.addEventListener('keyup', toggleClearBtn);
        input.addEventListener('change', toggleClearBtn);

        clearBtn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();

            const hadSearch = new URLSearchParams(window.location.search).has('search');
            input.value = '';
            toggleClearBtn();
            input.focus();

            if (hadSearch) {
                const urlParams = new URLSearchParams(window.location.search);
                urlParams.delete('search');
                urlParams.delete('page');
                const queryStr = urlParams.toString();
                window.location.href = queryStr ? `${baseUrl}?${queryStr}` : baseUrl;
            }
        });

        toggleClearBtn();
    });
</script>
</body></html>
