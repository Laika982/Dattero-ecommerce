<!DOCTYPE html><html class="light" lang="en"><head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<title>Order Details | Nutri Luxe Admin</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&amp;family=Inter:wght@400;500;600&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "surface-variant": "#e3e2e2",
                        "surface": "#fbf9f9",
                        "outline": "#747878",
                        "background": "#fbf9f9",
                        "on-primary-fixed-variant": "#464747",
                        "on-tertiary": "#ffffff",
                        "primary-fixed-dim": "#c7c6c6",
                        "inverse-primary": "#c7c6c6",
                        "surface-container-highest": "#e3e2e2",
                        "on-secondary-container": "#646464",
                        "on-error-container": "#93000a",
                        "tertiary-container": "#747474",
                        "surface-bright": "#fbf9f9",
                        "secondary": "#5e5e5e",
                        "secondary-container": "#e3e2e2",
                        "on-primary-container": "#fefcfc",
                        "on-surface-variant": "#444748",
                        "outline-variant": "#c4c7c7",
                        "surface-tint": "#5e5e5e",
                        "tertiary-fixed-dim": "#c6c6c6",
                        "on-primary": "#ffffff",
                        "primary": "#5c5c5c",
                        "on-primary-fixed": "#1b1c1c",
                        "inverse-on-surface": "#f2f0f0",
                        "secondary-fixed": "#e3e2e2",
                        "on-secondary-fixed": "#1b1c1c",
                        "surface-dim": "#dbdad9",
                        "primary-fixed": "#e3e2e2",
                        "secondary-fixed-dim": "#c7c6c6",
                        "error-container": "#ffdad6",
                        "on-tertiary-fixed-variant": "#474747",
                        "inverse-surface": "#303031",
                        "tertiary-fixed": "#e2e2e2",
                        "surface-container-lowest": "#ffffff",
                        "surface-container": "#efeded",
                        "surface-container-high": "#e9e8e7",
                        "tertiary": "#5c5c5c",
                        "surface-container-low": "#f5f3f3",
                        "on-tertiary-fixed": "#1b1b1b",
                        "on-surface": "#1b1c1c",
                        "on-secondary": "#ffffff",
                        "on-background": "#1b1c1c",
                        "primary-container": "#747474",
                        "on-tertiary-container": "#fcfcfc",
                        "on-secondary-fixed-variant": "#464747",
                        "on-error": "#ffffff",
                        "error": "#ba1a1a"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "stack-lg": "24px",
                        "grid-gutter": "24px",
                        "container-padding": "32px",
                        "stack-sm": "8px",
                        "max-width": "1280px",
                        "section-gap-mobile": "64px",
                        "stack-md": "16px",
                        "section-gap": "120px"
                    },
                    "fontFamily": {
                        "body-xl": ["Inter"],
                        "body-lg": ["Inter"],
                        "body-md": ["Inter"],
                        "label-md": ["Inter"],
                        "headline-xl": ["Plus Jakarta Sans"],
                        "headline-lg": ["Plus Jakarta Sans"],
                        "display-lg-mobile": ["Plus Jakarta Sans"],
                        "display-lg": ["Plus Jakarta Sans"]
                    },
                    "fontSize": {
                        "body-xl": ["20px", { "lineHeight": "1.5", "fontWeight": "400" }],
                        "body-lg": ["17px", { "lineHeight": "1.5", "fontWeight": "400" }],
                        "body-md": ["15px", { "lineHeight": "1.5", "fontWeight": "400" }],
                        "label-md": ["14px", { "lineHeight": "1.2", "letterSpacing": "0.02em", "fontWeight": "600" }],
                        "headline-xl": ["40px", { "lineHeight": "1.2", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                        "headline-lg": ["32px", { "lineHeight": "1.25", "fontWeight": "600" }],
                        "display-lg-mobile": ["40px", { "lineHeight": "1.1", "letterSpacing": "-0.01em", "fontWeight": "700" }],
                        "display-lg": ["56px", { "lineHeight": "1.1", "letterSpacing": "-0.02em", "fontWeight": "700" }]
                    }
                },
            },
        }
    </script>
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .order-timeline-dot::after {
            content: '';
            position: absolute;
            left: 50%;
            top: 24px;
            bottom: -24px;
            width: 1px;
            background-color: #c4c7c7;
            transform: translateX(-50%);
        }
        .order-timeline-item:last-child .order-timeline-dot::after {
            display: none;
        }
        body {
            background-color: #fbf9f9;
        }
    </style>
</head>
<body class="font-body-md text-on-surface">
<!-- SideNavBar -->
 {{> admin/aside}}
<!-- TopNavBar -->
<header class="sticky top-0 w-full z-40 bg-surface/80 dark:bg-surface-dim/80 backdrop-blur-md border-b border-outline-variant/30 flex justify-between items-center h-16 px-container-padding ml-64">
<div class="flex items-center bg-surface-container-high rounded-full px-4 py-1.5 w-96 max-w-md">
<span class="material-symbols-outlined text-outline mr-2">search</span>
<input class="bg-transparent border-none focus:ring-0 text-body-md w-full placeholder-on-surface-variant/50" placeholder="Search orders, customers..." type="text">
</div>
<div class="flex items-center space-x-6">
<button class="text-on-surface-variant hover:text-primary transition-colors active:scale-95">
<span class="material-symbols-outlined">notifications</span>
</button>
<button class="text-on-surface-variant hover:text-primary transition-colors active:scale-95">
<span class="material-symbols-outlined">settings</span>
</button>
<div class="flex items-center space-x-3 cursor-pointer group">
<div class="w-8 h-8 rounded-full overflow-hidden">
<img class="w-full h-auto" data-alt="A professional headshot of a luxury brand administrator, high-end studio lighting, clean minimalist aesthetic, neutral background, sharp focus, 8k resolution, elegant professional attire." src="https://lh3.googleusercontent.com/aida-public/AB6AXuDEPzAjRT6RsZVkY2mPvUCdQxSOdcfpfIc8qDqfcrICVimyWf-3d4PZ69MFmS8dSYhu6axYOO_WZQF5rynqRyfeR-lvoQJBbuDE2kZXFuF_agE2ehrnm6s1Zg6GnLDQrizMqzPH0rbZhYV86HPQnt6a6Oca1M6y8zZASdGGxoHNF823osiAXkIAqw5__qMvjF99L-R746sEzYZNkchlXRtcXFVo5cD2n5dbqWlsM6h__PruDG4PdtfEpjP0zfgOzg7Hw0S2_0KDt6Q">
</div>
<span class="font-label-md text-label-md group-hover:text-primary transition-colors">Profile</span>
</div>
</div>
</header>
<!-- Main Content Area -->
<main class="ml-64 p-container-padding max-w-[1280px]">
<!-- Order Header -->
<div class="flex justify-between items-end mb-stack-lg">
<div>
<nav class="flex items-center space-x-2 text-on-surface-variant/60 font-label-md mb-2">
<a class="hover:text-primary" href="/admin/order/orders">Orders</a>
<span class="material-symbols-outlined text-sm">chevron_right</span>
<span class="text-on-surface">#{{order.order_id}}</span>
</nav>
<h2 class="font-headline-xl text-headline-xl">Order #{{order.order_id}}</h2>
<div class="flex items-center mt-2 space-x-3">
<span class="bg-secondary-container text-secondary px-3 py-1 rounded-full font-label-md text-xs uppercase tracking-widest">{{formatStatus order.order_status}}</span>
<span class="text-on-surface-variant font-body-md">{{formatDate order.createdAt}}</span>
</div>
</div>
            {{!-- <button class="bg-on-surface text-surface px-6 py-3 rounded-lg font-label-md flex items-center hover:opacity-90 transition-opacity active:scale-95">
            <span class="material-symbols-outlined mr-2">print</span> 
                Print Invoice
            </button> --}}
             <a href="/admin/order/orders/{{order.order_id}}/edit" class="border bg-primary border-outline-variant/30 text-surface px-6 py-3 rounded-lg font-label-md flex items-center hover:opacity-90 transition-colors active:scale-95 mr-4">
            <span class="material-symbols-outlined mr-2">edit</span>
                Edit Order
            </a>
</div>
<!-- Bento Grid Layout -->
<div class="grid grid-cols-12 gap-grid-gutter">
<!-- Left Column: Items and Details -->
<div class="col-span-8 space-y-grid-gutter">
<!-- Items Table -->
<div class="bg-surface-container-lowest rounded-xl p-8 shadow-sm ring-1 ring-black/5">
<h3 class="font-headline-lg text-headline-lg mb-6">Ordered Items</h3>
<div class="overflow-x-auto">
<table class="w-full">
<thead>
<tr class="border-b border-outline-variant/30 text-left font-label-md text-on-surface-variant">
<th class="pb-4 font-semibold">Product</th>
<th class="pb-4 font-semibold text-center">Quantity</th>
<th class="pb-4 font-semibold text-right">Price</th>
<th class="pb-4 font-semibold text-right">Total</th>
</tr>
</thead>
<tbody class="divide-y divide-outline-variant/20">
{{#each order.items}}
<tr>
<td class="py-6">
<div class="flex items-center">
<div class="w-16 h-16 rounded-lg bg-surface-container-high overflow-hidden mr-4">
{{#if this.product_image}}<img class="w-full h-full object-cover" src="{{this.product_image}}" alt="{{this.product_name}}">{{/if}}
</div>
<div>
<p class="font-body-md font-semibold">{{this.product_name}}</p>
<p class="text-sm text-on-surface-variant">{{this.weight}} · SKU {{this.sku}}</p>
<p class="text-xs text-on-surface-variant">{{formatStatus this.status}}</p>
</div>
</div>
</td>
<td class="py-6 text-center font-body-md">{{this.quantity}}</td>
<td class="py-6 text-right font-body-md">₹{{this.price}}</td>
<td class="py-6 text-right font-body-md font-semibold">₹{{this.item_total}}</td>
</tr>
{{else}}
<tr><td colspan="4" class="py-8 text-center text-on-surface-variant">This order has no items.</td></tr>
{{/each}}
</tbody>
</table>
</div>
<!-- Summary -->
<div class="mt-8 flex justify-end">
<div class="w-64 space-y-3">
<div class="flex justify-between text-on-surface-variant font-body-md">
<span class="">Subtotal</span>
<span class="">₹{{order.subtotal}}</span>
</div>
<div class="flex justify-between text-on-surface-variant font-body-md">
<span class="">Shipping</span>
<span class="">₹{{order.shipping_charge}}</span>
</div>
<div class="flex justify-between text-on-surface-variant font-body-md">
<span class="">Tax (8%)</span>
<span class="">₹{{order.tax}}</span>
</div>
<div class="pt-3 border-t border-outline-variant/30 flex justify-between font-headline-lg text-headline-lg">
<span class="">Total</span>
<span class="">₹{{order.final_amount}}</span>
</div>
</div>
</div>
</div>
<!-- Shipping & Payment Bento -->
<div class="grid grid-cols-2 gap-grid-gutter">
<!-- Shipping Address -->
<div class="bg-surface-container-lowest rounded-xl p-8 shadow-sm ring-1 ring-black/5">
<div class="flex items-center mb-6">
<span class="material-symbols-outlined text-primary mr-2">local_shipping</span>
<h3 class="font-headline-lg text-xl font-bold">Shipping Address</h3>
</div>
<p class="font-body-md font-semibold">{{order.shipping_address.full_name}}</p>
<p class="font-body-md text-on-surface-variant leading-relaxed mt-1">
                            {{order.shipping_address.address}}<br>
                            {{order.shipping_address.city}}, {{order.shipping_address.state}} {{order.shipping_address.zip_code}}<br>
                            {{order.shipping_address.country}}
                        </p>
{{#if order.shipping_address.phone_number}}
<p class="mt-4 font-body-md">
<span class="text-on-surface-variant">Phone:</span> {{order.shipping_address.phone_number}}
                        </p>
{{/if}}
</div>
<!-- Payment Method -->
<div class="bg-surface-container-lowest rounded-xl p-8 shadow-sm ring-1 ring-black/5">
<div class="flex items-center mb-6">
<span class="material-symbols-outlined text-primary mr-2">payments</span>
<h3 class="font-headline-lg text-xl font-bold">Payment Method</h3>
</div>
<div class="flex items-center p-4 bg-surface-container rounded-lg">
<div>
<p class="font-body-md font-semibold">{{formatStatus order.payment_method}}</p>
<p class="text-sm text-on-surface-variant">Payment status: {{formatStatus order.payment_status}}</p>
</div>
</div>
<div class="mt-6">
<p class="font-label-md text-on-surface-variant uppercase tracking-widest text-xs mb-2">Order Total</p>
<p class="font-body-md text-on-surface-variant">₹{{order.final_amount}}</p>
</div>
</div>
</div>
</div>
<!-- Right Column: Timeline and Customer -->
<div class="col-span-4 space-y-grid-gutter">
<!-- Customer Profile -->
<div class="bg-surface-container-lowest rounded-xl p-8 shadow-sm ring-1 ring-black/5">
<h3 class="font-headline-lg text-xl font-bold mb-6">Customer</h3>
<div class="flex items-center mb-6">
<div class="w-14 h-14 rounded-full bg-primary-fixed overflow-hidden mr-4">
<div class="w-full h-full flex items-center justify-center text-primary font-bold">{{order.user_id.name}}</div>
</div>
<div>
{{#if order.user_id}}
<p class="font-body-md font-bold">{{order.user_id.name}}</p>
<p class="text-sm text-on-surface-variant">{{order.user_id.email}}</p>
{{else}}
<p class="font-body-md font-bold">Customer unavailable</p>
{{/if}}
</div>
</div>
<div class="space-y-4 pt-4 border-t border-outline-variant/20">
<div class="flex justify-between items-center">
<span class="text-on-surface-variant font-body-md">Phone</span>
<span class="font-semibold">{{order.user_id.phone}}</span>
</div>
<div class="flex justify-between items-center">
<span class="text-on-surface-variant font-body-md">Order ID</span>
<span class="font-semibold">#{{order.order_id}}</span>
</div>
</div>
</div>
<!-- Order Timeline -->
<div class="bg-surface-container-lowest rounded-xl p-8 shadow-sm ring-1 ring-black/5">
<h3 class="font-headline-lg text-xl font-bold mb-8">Order Timeline</h3>
<div class="space-y-6">
<div class="order-timeline-item relative flex">
<div class="order-timeline-dot relative z-10 w-6 h-6 flex-shrink-0 flex items-center justify-center bg-green-100 rounded-full mr-4"><div class="w-2 h-2 bg-green-600 rounded-full"></div></div>
<div><p class="font-body-md font-bold">Order received</p><p class="text-sm text-on-surface-variant">{{formatDate order.createdAt}}</p></div>
</div>
<div class="order-timeline-item relative flex">
<div class="order-timeline-dot relative z-10 w-6 h-6 flex-shrink-0 flex items-center justify-center bg-primary-fixed rounded-full mr-4"><div class="w-2 h-2 bg-primary rounded-full"></div></div>
<div><p class="font-body-md font-bold">Current status</p><p class="text-sm text-on-surface-variant">{{formatStatus order.order_status}}</p></div>
</div>
<div class="order-timeline-item relative flex">
<div class="order-timeline-dot relative z-10 w-6 h-6 flex-shrink-0 flex items-center justify-center bg-surface-container-high rounded-full mr-4"><div class="w-2 h-2 bg-on-surface-variant rounded-full"></div></div>
<div><p class="font-body-md font-bold">Last updated</p><p class="text-sm text-on-surface-variant">{{formatDate order.updatedAt}}</p></div>
</div>
</div>
</div>
</div>
</div>
</main>
<script>
        // Simple micro-interaction for active scaling
        document.querySelectorAll('button, a').forEach(el => {
            el.addEventListener('mousedown', () => el.classList.add('scale-95'));
            el.addEventListener('mouseup', () => el.classList.remove('scale-95'));
            el.addEventListener('mouseleave', () => el.classList.remove('scale-95'));
        });
    </script>




</body></html>