<!DOCTYPE html>
<html class="light" lang="en">

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>Return Order #{{order.order_id}} | Nutri Luxe Admin</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&amp;family=Inter:wght@400;500;600&amp;display=swap"
        rel="stylesheet">
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet">
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "surface-variant": "#e3e2e2",
                        "surface": "#fbf9f9",
                        "outline": "#747878",
                        "background": "#fbf9f9",
                        "on-primary-fixed-variant": "#464747",
                        "on-tertiary": "#ffffff",
                        "primary-fixed-dim": "#c7c6c6",
                        "inverse-primary": "#c7c6c6",
                        "surface-container-highest": "#e3e2e2",
                        "on-secondary-container": "#646464",
                        "on-error-container": "#93000a",
                        "tertiary-container": "#747474",
                        "surface-bright": "#fbf9f9",
                        "secondary": "#5e5e5e",
                        "secondary-container": "#e3e2e2",
                        "on-primary-container": "#fefcfc",
                        "on-surface-variant": "#444748",
                        "outline-variant": "#c4c7c7",
                        "surface-tint": "#5e5e5e",
                        "tertiary-fixed-dim": "#c6c6c6",
                        "on-primary": "#ffffff",
                        "primary": "#5c5c5c",
                        "on-primary-fixed": "#1b1c1c",
                        "inverse-on-surface": "#f2f0f0",
                        "secondary-fixed": "#e3e2e2",
                        "on-secondary-fixed": "#1b1c1c",
                        "surface-dim": "#dbdad9",
                        "primary-fixed": "#e3e2e2",
                        "secondary-fixed-dim": "#c7c6c6",
                        "error-container": "#ffdad6",
                        "on-tertiary-fixed-variant": "#474747",
                        "inverse-surface": "#303031",
                        "tertiary-fixed": "#e2e2e2",
                        "surface-container-lowest": "#ffffff",
                        "surface-container": "#efeded",
                        "surface-container-high": "#e9e8e7",
                        "tertiary": "#5c5c5c",
                        "surface-container-low": "#f5f3f3",
                        "on-tertiary-fixed": "#1b1b1b",
                        "on-surface": "#1b1c1c",
                        "on-secondary": "#ffffff",
                        "on-background": "#1b1c1c",
                        "primary-container": "#747474",
                        "on-tertiary-container": "#fcfcfc",
                        "on-secondary-fixed-variant": "#464747",
                        "on-error": "#ffffff",
                        "error": "#ba1a1a"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "stack-lg": "24px",
                        "grid-gutter": "24px",
                        "container-padding": "32px",
                        "stack-sm": "8px",
                        "max-width": "1280px",
                        "section-gap-mobile": "64px",
                        "stack-md": "16px",
                        "section-gap": "120px"
                    },
                    "fontFamily": {
                        "body-xl": ["Inter"],
                        "body-lg": ["Inter"],
                        "body-md": ["Inter"],
                        "label-md": ["Inter"],
                        "headline-xl": ["Plus Jakarta Sans"],
                        "headline-lg": ["Plus Jakarta Sans"],
                        "display-lg-mobile": ["Plus Jakarta Sans"],
                        "display-lg": ["Plus Jakarta Sans"]
                    },
                    "fontSize": {
                        "body-xl": ["20px", { "lineHeight": "1.5", "fontWeight": "400" }],
                        "body-lg": ["17px", { "lineHeight": "1.5", "fontWeight": "400" }],
                        "body-md": ["15px", { "lineHeight": "1.5", "fontWeight": "400" }],
                        "label-md": ["14px", { "lineHeight": "1.2", "letterSpacing": "0.02em", "fontWeight": "600" }],
                        "headline-xl": ["40px", { "lineHeight": "1.2", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                        "headline-lg": ["32px", { "lineHeight": "1.25", "fontWeight": "600" }],
                        "display-lg-mobile": ["40px", { "lineHeight": "1.1", "letterSpacing": "-0.01em", "fontWeight": "700" }],
                        "display-lg": ["56px", { "lineHeight": "1.1", "letterSpacing": "-0.02em", "fontWeight": "700" }]
                    }
                },
            },
        }
    </script>
    <style>
        html,
        body {
            background-color: #fbf9f9;
            color: #1b1c1c;
            overflow-x: hidden;
            overflow-y: auto;
            min-height: 100vh;
        }

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            display: inline-block;
            line-height: 1;
        }

        .apple-shadow {
            box-shadow: 0 40px 40px -40px rgba(0, 0, 0, 0.04);
        }
    </style>
</head>

<body class="font-body-md text-body-md selection:bg-primary-fixed-dim selection:text-on-primary-fixed">
    {{> user/notification}}
    <!-- SideNavBar Shell -->
    {{> admin/aside}}

    <!-- Main Wrapper -->
    <div class="lg:ml-64 ml-0 min-h-screen flex flex-col">
        <!-- TopNavBar -->
        <header
            class="sticky top-0 w-full z-40 bg-surface/80 backdrop-blur-md border-b border-outline-variant/30 flex justify-between items-center h-16 px-4 sm:px-6 md:px-container-padding">
            <div class="flex items-center gap-3 sm:gap-4 flex-grow max-w-xl">
                <!-- Mobile Sidebar Toggle -->
                <button type="button"
                    class="lg:hidden p-2 rounded-lg text-on-surface-variant hover:text-ink-black hover:bg-surface-variant/50 transition-colors touch-target"
                    onclick="toggleAdminSidebar()" aria-label="Toggle Navigation">
                    <span class="material-symbols-outlined text-[22px]">menu</span>
                </button>
                <div class="relative w-full max-w-md">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline-variant text-[20px]">search</span>
                    <input
                        class="w-full bg-surface-container-low border border-transparent focus:border-outline-variant/30 rounded-full py-2 pl-10 pr-4 text-body-md focus:ring-1 focus:ring-primary focus:outline-none transition-all placeholder:text-on-surface-variant/40"
                        placeholder="Search orders, returns..." type="text">
                </div>
            </div>
            <div class="flex items-center gap-4 sm:gap-6">
                <a href="/" target="_blank"
                    class="hidden sm:inline-flex items-center gap-2 px-4 py-2 border border-outline-variant/30 rounded-full hover:bg-surface-variant transition-colors active:scale-95 text-on-surface-variant text-sm font-label-md">
                    <span class="material-symbols-outlined text-[18px]">visibility</span>
                    <span>View Store</span>
                </a>
                <div class="flex items-center gap-3 cursor-pointer group">
                    <div class="w-8 h-8 rounded-full bg-surface-variant overflow-hidden border border-outline-variant/30 flex items-center justify-center">
                        <span class="material-symbols-outlined text-outline text-[20px]">person</span>
                    </div>
                    <span class="font-label-md text-sm text-on-surface group-hover:text-primary transition-colors hidden sm:inline">Admin</span>
                </div>
            </div>
        </header>

        <!-- Main Content Canvas -->
        <main class="flex-grow p-4 sm:p-6 lg:p-8 max-w-7xl mx-auto w-full pb-16">
            <!-- Breadcrumbs & Page Header -->
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8 pb-6 border-b border-outline-variant/20">
                <div>
                    <nav class="flex items-center gap-2 text-on-surface-variant text-sm mb-2 opacity-70">
                        <a class="hover:underline hover:text-on-surface transition-colors" href="/admin/">Admin</a>
                        <span class="material-symbols-outlined text-[14px]">chevron_right</span>
                        <a class="hover:underline hover:text-on-surface transition-colors" href="/admin/order/orders">Orders</a>
                        <span class="material-symbols-outlined text-[14px]">chevron_right</span>
                        <a class="hover:underline hover:text-on-surface transition-colors" href="/admin/order/orders/{{order.order_id}}">Order #{{order.order_id}}</a>
                        <span class="material-symbols-outlined text-[14px]">chevron_right</span>
                        <span class="text-on-surface font-semibold">Process Return</span>
                    </nav>
                    <h1 class="font-headline-lg text-2xl sm:text-3xl font-bold text-on-surface tracking-tight">Return Order #{{order.order_id}}</h1>
                    <p class="text-on-surface-variant text-sm mt-1 opacity-70">Initiate product returns and credit customer refunds.</p>
                </div>
                <div class="flex items-center gap-3 shrink-0 self-end sm:self-auto">
                    <a href="/admin/order/orders/{{order.order_id}}"
                        class="inline-flex items-center gap-2 px-5 sm:px-6 py-2.5 rounded-full font-label-md text-sm text-on-surface border border-outline-variant/30 hover:bg-surface-container-high transition-all active:scale-95">
                        <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                        Back to Order
                    </a>
                </div>
            </div>

            <!-- 1. Order Summary Card -->
            <section class="mb-6">
                <div class="bg-surface-container-lowest rounded-2xl p-6 sm:p-8 apple-shadow border border-outline-variant/20">
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 items-center">
                        <!-- Customer -->
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 rounded-full bg-surface-container-high border border-outline-variant/30 overflow-hidden shrink-0 flex items-center justify-center">
                                <img class="w-full h-full object-cover"
                                     src="{{#if order.user_id.profileImage}}{{order.user_id.profileImage}}{{else}}/images/avathar.jpg{{/if}}"
                                     alt="{{order.user_id.name}}"
                                     onerror="this.onerror=null; this.src='/images/avathar.jpg';">
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-xs uppercase tracking-wider text-on-surface-variant/70 font-semibold mb-0.5">Customer</p>
                                <p class="font-semibold text-on-surface text-sm truncate">{{order.user_id.name}}</p>
                                <p class="text-xs text-on-surface-variant truncate opacity-80">{{order.user_id.email}}</p>
                            </div>
                        </div>

                        <!-- Order Information -->
                        <div class="sm:border-l sm:border-outline-variant/20 sm:pl-6">
                            <p class="text-xs uppercase tracking-wider text-on-surface-variant/70 font-semibold mb-0.5">Order Placed</p>
                            <p class="font-semibold text-on-surface text-sm">{{formatDate order.createdAt}}</p>
                            <div class="mt-1">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-surface-container-high text-on-surface border border-outline-variant/30">
                                    Status: {{formatStatus order.order_status}}
                                </span>
                            </div>
                        </div>

                        <!-- Payment & Amount -->
                        <div class="lg:border-l lg:border-outline-variant/20 lg:pl-6 flex items-center justify-between sm:col-span-2 lg:col-span-1">
                            <div>
                                <p class="text-xs uppercase tracking-wider text-on-surface-variant/70 font-semibold mb-0.5">Total Amount</p>
                                <p class="font-headline-lg text-xl sm:text-2xl font-bold text-on-surface">₹{{order.final_amount}}</p>
                                <span class="inline-block mt-0.5 text-xs bg-surface-container-high text-on-surface-variant px-2.5 py-0.5 rounded-full font-bold uppercase tracking-tight border border-outline-variant/30">
                                    {{formatStatus order.payment_status}}
                                </span>
                            </div>
                            <span class="material-symbols-outlined text-outline-variant/40 text-[40px] shrink-0">receipt_long</span>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Customer Return Request Banner (if present) -->
            {{#if order.return_request.status}}
            <section class="mb-6 rounded-2xl border border-amber-500/30 bg-amber-500/5 p-6 apple-shadow"
                aria-label="Customer return request">
                <div class="flex flex-col sm:flex-row items-start justify-between gap-4">
                    <div class="space-y-1">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-amber-600 text-[20px]">assignment_return</span>
                            <h3 class="font-headline-lg text-base sm:text-lg font-bold text-on-surface">Customer Return Request</h3>
                        </div>
                        <p id="customerReturnReason" class="text-sm text-on-surface font-medium mt-1">
                            "{{order.return_request.reason}}"
                        </p>
                        <p class="text-xs text-on-surface-variant opacity-70">
                            Submitted on {{formatDate order.return_request.requested_at}}
                        </p>
                    </div>
                    <span class="rounded-full bg-amber-100 text-amber-800 border border-amber-300 px-3 py-1 text-xs font-bold uppercase tracking-wider shrink-0">
                        {{formatStatus order.return_request.status}}
                    </span>
                </div>
            </section>
            {{/if}}

            <!-- 12-Column Layout -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
                <!-- 2. Item Selection (Table) -->
                <div class="lg:col-span-8 w-full space-y-6">
                    <div class="bg-surface-container-lowest rounded-2xl apple-shadow border border-outline-variant/20 overflow-hidden">
                        <div class="px-6 py-5 border-b border-outline-variant/15 flex items-center justify-between">
                            <h2 class="font-headline-lg text-lg sm:text-xl font-bold text-on-surface">Select Items for Return</h2>
                            <span class="font-label-md text-xs text-on-surface-variant bg-surface-container-high px-3 py-1 rounded-full border border-outline-variant/30">
                                {{order.items.length}} items in order
                            </span>
                        </div>

                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="bg-surface-container-low/70 border-b border-outline-variant/15 text-xs text-on-surface-variant uppercase tracking-wider font-semibold">
                                        <th class="px-5 py-3.5 text-center w-14">
                                            <input data-select-all-returns
                                                class="rounded border-outline-variant/50 text-on-surface focus:ring-primary cursor-pointer w-4 h-4"
                                                type="checkbox" aria-label="Select all returnable items">
                                        </th>
                                        <th class="px-4 py-3.5">Product</th>
                                        <th class="px-4 py-3.5 text-center w-28">Quantity</th>
                                        <th class="px-6 py-3.5 text-right w-36">Total Price</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-outline-variant/15">
                                    {{#each order.items}}
                                    <tr class="hover:bg-surface-container-low/40 transition-colors {{#if this.is_cancelled}}opacity-60 bg-surface-variant/10{{/if}}">
                                        <td class="px-5 py-4 text-center align-middle">
                                            <input data-return-item data-unit-price="{{this.price}}"
                                                data-return-quantity="{{this.returnable_quantity}}"
                                                class="rounded border-outline-variant/50 text-on-surface focus:ring-primary cursor-pointer w-4 h-4 disabled:opacity-40 disabled:cursor-not-allowed"
                                                type="checkbox" value="{{this._id}}" {{#unless this.is_returnable}}disabled{{/unless}}>
                                        </td>
                                        <td class="px-4 py-4 align-middle">
                                            <div class="flex items-center gap-3.5">
                                                <div class="w-14 h-14 rounded-xl overflow-hidden bg-surface-container border border-outline-variant/20 shrink-0 flex items-center justify-center {{#if this.is_cancelled}}grayscale-[40%]{{/if}}">
                                                    {{#if this.product_image}}
                                                    <img class="w-full h-full object-cover" src="{{this.product_image}}" alt="{{this.product_name}}">
                                                    {{else}}
                                                    <span class="material-symbols-outlined text-outline-variant text-[22px]">inventory_2</span>
                                                    {{/if}}
                                                </div>
                                                <div class="min-w-0 flex-1">
                                                    <p class="font-semibold text-on-surface text-sm leading-snug truncate">{{this.product_name}}</p>
                                                    {{#if this.weight}}
                                                    <p class="text-xs text-on-surface-variant opacity-70 mt-0.5">{{this.weight}}{{#if this.sku}} · {{this.sku}}{{/if}}</p>
                                                    {{/if}}
                                                    <div class="mt-1.5">
                                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold border {{#if this.is_returnable}}bg-emerald-100 text-emerald-800 border-emerald-300{{else}}{{#if (eq this.status 'delivered')}}bg-emerald-100 text-emerald-800 border-emerald-300{{else}}{{#if (eq this.status 'cancelled')}}bg-rose-100 text-rose-800 border-rose-300{{else}}{{#if (eq this.status 'returned')}}bg-purple-100 text-purple-800 border-purple-300{{else}}{{#if (eq this.status 'pending')}}bg-amber-100 text-amber-800 border-amber-300{{else}}{{#if (eq this.status 'out_for_delivery')}}bg-indigo-100 text-indigo-800 border-indigo-300{{else}}bg-blue-100 text-blue-800 border-blue-300{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}">
                                                            <span class="w-1.5 h-1.5 rounded-full {{#if this.is_returnable}}bg-emerald-500{{else}}{{#if (eq this.status 'delivered')}}bg-emerald-500{{else}}{{#if (eq this.status 'cancelled')}}bg-rose-500{{else}}{{#if (eq this.status 'returned')}}bg-purple-500{{else}}{{#if (eq this.status 'pending')}}bg-amber-500{{else}}bg-blue-500{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}"></span>
                                                            {{#if this.is_returnable}}Eligible (Delivered){{else}}{{formatStatus this.status}}{{/if}}
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="px-4 py-4 font-medium text-on-surface text-center align-middle text-sm">
                                            {{this.quantity}}
                                        </td>
                                        <td class="px-6 py-4 font-semibold text-on-surface text-right align-middle text-sm">
                                            {{#if this.is_cancelled}}
                                            <span class="line-through text-on-surface-variant/50">₹{{this.item_total}}</span>
                                            {{#if (gt this.quantity 1)}}
                                            <span class="block text-xs font-normal text-on-surface-variant/60">₹{{this.price}} × {{this.quantity}}</span>
                                            {{/if}}
                                            {{else}}
                                            <span>₹{{this.item_total}}</span>
                                            {{#if (gt this.quantity 1)}}
                                            <span class="block text-xs font-normal text-on-surface-variant/60">₹{{this.price}} × {{this.quantity}}</span>
                                            {{/if}}
                                            {{/if}}
                                        </td>
                                    </tr>
                                    {{else}}
                                    <tr>
                                        <td colspan="4" class="px-8 py-8 text-center text-on-surface-variant text-sm">
                                            This order has no items.
                                        </td>
                                    </tr>
                                    {{/each}}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- 3. Return Details (Sidebar) -->
                <div class="lg:col-span-4 w-full space-y-6">
                    <div class="bg-surface-container-lowest rounded-2xl p-6 sm:p-8 apple-shadow border border-outline-variant/20 sticky top-24">
                        <div class="flex items-center gap-3 mb-6 pb-4 border-b border-outline-variant/15">
                            <span class="material-symbols-outlined text-primary text-[22px]">assignment_return</span>
                            <h2 class="font-headline-lg text-lg sm:text-xl font-bold text-on-surface tracking-tight">Return Processing</h2>
                        </div>

                        <div class="space-y-6">
                            <!-- Refund Method -->
                            <div>
                                <label class="font-label-md text-xs text-outline mb-2.5 uppercase tracking-widest font-bold block">Refund Method</label>
                                <label class="flex items-center gap-3.5 p-4 rounded-xl border border-primary bg-primary/5 cursor-pointer transition-all">
                                    <input checked type="radio" name="refund" class="text-on-surface focus:ring-primary w-4 h-4 cursor-pointer">
                                    <div>
                                        <p class="font-semibold text-on-surface text-sm">Credit to Wallet</p>
                                        <p class="text-xs text-on-surface-variant opacity-70">Instant refund credited directly to customer wallet</p>
                                    </div>
                                </label>
                            </div>

                            <!-- Pickup Address -->
                            <div>
                                <label class="font-label-md text-xs text-outline mb-2.5 uppercase tracking-widest font-bold block">Pickup Address</label>
                                <div class="p-4 rounded-xl bg-surface-container-low border border-outline-variant/20 space-y-1">
                                    <p class="font-semibold text-on-surface text-sm">{{order.shipping_address.full_name}}</p>
                                    <p class="text-xs text-on-surface-variant leading-relaxed">{{order.shipping_address.address}}</p>
                                    <p class="text-xs text-on-surface-variant opacity-80">
                                        {{order.shipping_address.city}}, {{order.shipping_address.state}} {{order.shipping_address.zip_code}}
                                    </p>
                                </div>
                            </div>

                            <!-- Return Summary Box -->
                            <div class="pt-6 border-t border-outline-variant/20 space-y-3">
                                {{#unless hasReturnableItems}}
                                <div class="p-4 rounded-xl bg-amber-500/10 border border-amber-500/20 text-on-surface text-xs space-y-1 mb-4" role="status">
                                    <p class="font-bold text-amber-900">No items are currently eligible for return.</p>
                                    <p class="text-amber-800/80">Order status: {{formatStatus order.order_status}}. Returns can only be processed on delivered items.</p>
                                </div>
                                {{/unless}}

                                <div class="flex justify-between items-center text-sm text-on-surface-variant">
                                    <span>Selected Items:</span>
                                    <span id="selectedReturnCount" class="font-semibold text-on-surface">0</span>
                                </div>

                                <div class="flex justify-between items-center pt-2 border-t border-outline-variant/20 font-label-md">
                                    <span class="text-base font-bold text-on-surface">Estimated Refund:</span>
                                    <span id="estimatedReturnRefund" class="text-xl font-bold text-primary">₹0.00</span>
                                </div>

                                <p id="returnFeedback" class="text-sm font-medium pt-1 text-center" role="status" aria-live="polite"></p>

                                <button id="processReturnButton" data-order-id="{{order.order_id}}" type="button"
                                    class="w-full inline-flex items-center justify-center gap-2 bg-black text-white py-3 px-6 rounded-full font-label-md text-sm font-semibold hover:opacity-90 active:scale-95 transition-all disabled:opacity-40 disabled:cursor-not-allowed shadow-sm mt-3"
                                    {{#unless hasReturnableItems}}disabled{{/unless}}>
                                    <span class="material-symbols-outlined text-[18px]">check_circle</span>
                                    Process Return
                                </button>

                                <p class="text-[11px] text-center text-on-surface-variant opacity-70">
                                    Refund will be automatically processed into the user's wallet.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Script Logic -->
    <script>
        const returnItems = [...document.querySelectorAll('[data-return-item]')];
        const returnFeedback = document.getElementById('returnFeedback');
        const selectedReturnCount = document.getElementById('selectedReturnCount');
        const estimatedReturnRefund = document.getElementById('estimatedReturnRefund');
        const processReturnButton = document.getElementById('processReturnButton');

        function getSelectedReturnItems() {
            const customerReason = (document.getElementById('customerReturnReason')?.textContent || "").trim().replace(/^"|"$/g, '') || "Return approved by admin";
            return returnItems.filter((checkbox) => checkbox.checked).map((checkbox) => {
                const quantity = Number(checkbox.dataset.returnQuantity) || 1;
                const unitPrice = Number(checkbox.dataset.unitPrice) || 0;
                return {
                    itemId: checkbox.value,
                    quantity: quantity,
                    reason: customerReason,
                    unitPrice: unitPrice,
                };
            });
        }

        function updateReturnEstimate() {
            const selectedItems = getSelectedReturnItems();
            const quantity = selectedItems.reduce((sum, item) => sum + item.quantity, 0);
            const amount = selectedItems.reduce((sum, item) => sum + item.quantity * item.unitPrice, 0);
            if (selectedReturnCount) selectedReturnCount.textContent = String(quantity);
            if (estimatedReturnRefund) estimatedReturnRefund.textContent = `₹${amount.toFixed(2)}`;
        }

        returnItems.forEach((checkbox) => {
            checkbox.addEventListener('change', () => {
                checkbox.closest('tr')?.classList.toggle('bg-surface-container-low/60', checkbox.checked);
                updateReturnEstimate();
            });
        });

        document.querySelector('[data-select-all-returns]')?.addEventListener('change', (event) => {
            returnItems.filter((checkbox) => !checkbox.disabled).forEach((checkbox) => {
                checkbox.checked = event.target.checked;
                checkbox.closest('tr')?.classList.toggle('bg-surface-container-low/60', checkbox.checked);
            });
            updateReturnEstimate();
        });

        if (processReturnButton) {
            processReturnButton.addEventListener('click', async () => {
                const selectedItems = getSelectedReturnItems();
                if (!selectedItems.length) {
                    returnFeedback.textContent = 'Select at least one delivered item to return.';
                    returnFeedback.className = 'text-sm font-medium pt-1 text-center text-error';
                    return;
                }

                processReturnButton.disabled = true;
                returnFeedback.textContent = 'Processing return...';
                returnFeedback.className = 'text-sm font-medium pt-1 text-center text-on-surface-variant';

                try {
                    const response = await fetch(`/admin/order/orders/${encodeURIComponent(processReturnButton.dataset.orderId)}/return`, {
                        method: 'PATCH',
                        headers: {
                            Accept: 'application/json',
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({
                            items: selectedItems.map(({ itemId, quantity, reason }) => ({ itemId, quantity, reason })),
                        }),
                    });
                    const data = await response.json();

                    if (!response.ok || !data.success) {
                        returnFeedback.textContent = data.message || 'Unable to process return.';
                        returnFeedback.className = 'text-sm font-medium pt-1 text-center text-error';
                        return;
                    }

                    returnFeedback.textContent = data.message || 'Return processed successfully!';
                    returnFeedback.className = 'text-sm font-medium pt-1 text-center text-emerald-700';
                    setTimeout(() => {
                        window.location.href = `/admin/order/orders/${encodeURIComponent(processReturnButton.dataset.orderId)}`;
                    }, 700);
                } catch (error) {
                    console.error('Process return error:', error);
                    returnFeedback.textContent = 'Unable to process return. Please try again.';
                    returnFeedback.className = 'text-sm font-medium pt-1 text-center text-error';
                } finally {
                    processReturnButton.disabled = false;
                }
            });
        }
    </script>
</body>

</html>