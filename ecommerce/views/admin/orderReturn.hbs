<div class="flex gap-3">

</div>
</div>
</div>
<!-- 1. Order Summary Card -->
<section class="mb-stack-lg">
<div class="bg-surface-container-lowest rounded-xl p-8 apple-shadow border border-outline-variant/10 flex items-center justify-between">
<div class="flex gap-12">
<div>
<p class="text-on-surface-variant/60 font-label-md uppercase tracking-wider mb-2">Customer</p>
<div class="flex items-center gap-3">
<div class="w-10 h-10 rounded-full bg-primary-fixed-dim flex items-center justify-center text-on-primary-fixed"><span class="material-symbols-outlined">person</span></div>
