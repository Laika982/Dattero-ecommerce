<div class="grid grid-cols-12 gap-grid-gutter items-start">
<!-- 2. Item Selection (Table) -->
<div class="col-span-12 lg:col-span-8 space-y-stack-lg">
<div class="bg-surface-container-lowest rounded-xl apple-shadow border border-outline-variant/10 overflow-hidden">
<div class="px-8 py-6 border-b border-outline-variant/10 flex items-center justify-between">
<h3 class="font-headline-lg text-[22px] text-on-surface">Select Items for Return</h3>
<span class="text-label-md text-on-surface-variant/60">{{order.items.length}} items in order</span>
</div>
<table class="w-full text-left">
<thead>
<tr class="bg-surface-container-low/50">
<th class="px-8 py-4 font-label-md text-on-surface-variant/60 uppercase tracking-wider w-12">
<input data-select-all-returns class="rounded border-outline-variant/50 text-on-surface focus:ring-on-surface/20" type="checkbox" aria-label="Select all returnable items">
</th>
<th class="px-4 py-4 font-label-md text-on-surface-variant/60 uppercase tracking-wider">Product</th>
<th class="px-4 py-4 font-label-md text-on-surface-variant/60 uppercase tracking-wider">Price</th>
<th class="px-4 py-4 font-label-md text-on-surface-variant/60 uppercase tracking-wider">Qty to Return</th>
<th class="px-8 py-4 font-label-md text-on-surface-variant/60 uppercase tracking-wider">Reason for Return</th>
</tr>
</thead>
<tbody class="divide-y divide-outline-variant/10">
{{#each order.items}}
<tr class="hover:bg-surface-container-low/30 transition-colors group">
<td class="px-8 py-6"><input data-return-item data-unit-price="{{this.price}}" class="rounded border-outline-variant/50 text-on-surface focus:ring-on-surface/20" type="checkbox" value="{{this._id}}" {{#unless this.is_returnable}}disabled{{/unless}}></td>
<td class="px-4 py-6"><div class="flex items-center gap-4"><div class="w-16 h-16 rounded-lg overflow-hidden bg-surface-container border border-outline-variant/10 shrink-0">{{#if this.product_image}}<img class="w-full h-full object-cover" src="{{this.product_image}}" alt="{{this.product_name}}">{{/if}}</div><div><p class="font-semibold text-on-surface leading-tight">{{this.product_name}}</p><p class="text-body-md text-on-surface-variant/60">{{this.weight}} · {{this.sku}}</p><p class="text-xs text-on-surface-variant">{{#if this.is_returnable}}Delivered{{else}}{{formatStatus this.status}}{{/if}}</p></div></div></td>
<td class="px-4 py-6 font-semibold text-on-surface">₹{{this.price}}</td>
<td class="px-4 py-6"><select data-return-quantity class="bg-surface-container-low border-none rounded-lg text-body-md py-1.5 focus:ring-1 focus:ring-on-surface/10" {{#unless this.is_returnable}}disabled{{/unless}}>{{#each (range 1 this.returnable_quantity)}}<option value="{{this}}">{{this}}</option>{{/each}}</select></td>
<td class="px-8 py-6"><select data-return-reason class="w-full bg-surface-container-low border-none rounded-lg text-body-md py-1.5 focus:ring-1 focus:ring-on-surface/10" {{#unless this.is_returnable}}disabled{{/unless}}><option>Damaged on arrival</option><option>Wrong item sent</option><option>Quality not as expected</option><option>Changed mind</option></select></td>
</tr>
{{else}}
<tr><td colspan="5" class="px-8 py-8 text-center text-on-surface-variant">This order has no items.</td></tr>
{{/each}}
