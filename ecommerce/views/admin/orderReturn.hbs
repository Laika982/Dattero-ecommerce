<main class="ml-64 pt-16 min-h-screen">
<div class="max-w-[1280px] mx-auto px-container-padding py-10">
<!-- -->
<div class="mb-10">
<nav class="flex items-center gap-2 text-label-md text-on-surface-variant/60 mb-4">
