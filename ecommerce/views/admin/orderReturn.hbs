<!-- 3. Return Details (Form) -->
<div class="col-span-12 lg:col-span-4 space-y-stack-lg">
<div class="bg-surface-container-lowest rounded-xl p-8 apple-shadow border border-outline-variant/10">
<h3 class="font-headline-lg text-[22px] text-on-surface mb-6">Return Processing</h3>
<div class="space-y-6">
<div>
<label class="block font-label-md text-on-surface-variant mb-2">Refund Method</label>
<div class="space-y-3">

<label class="flex items-center gap-3 p-4 rounded-lg border border-primary bg-surface-variant/30 cursor-pointer"><input checked="" class="text-on-surface focus:ring-on-surface/20" name="refund" type="radio"><div><p class="font-semibold text-on-surface">Credit to Wallet</p><p class="text-[12px] text-on-surface-variant/60">Instant credit to customer account</p></div></label>
</div><div class="mt-6"><label class="block font-label-md text-on-surface-variant mb-2">Return Address</label><div class="p-4 rounded-lg bg-surface-container-low/50 border border-outline-variant/10"><p class="font-semibold text-on-surface">{{order.shipping_address.full_name}}</p><p class="text-body-md text-on-surface-variant/80">{{order.shipping_address.address}}</p><p class="text-body-md text-on-surface-variant/80">{{order.shipping_address.city}}, {{order.shipping_address.state}} {{order.shipping_address.zip_code}}, {{order.shipping_address.country}}</p></div></div>
</div>
<div class="pt-6 border-t border-outline-variant/10">
{{#unless hasReturnableItems}}
<div class="mb-5 p-4 rounded-lg bg-surface-container-low border border-outline-variant/20" role="status">
    <p class="font-semibold text-on-surface">No products are currently eligible for return.</p>
    <p class="mt-1 text-sm text-on-surface-variant">Current order status: {{formatStatus order.order_status}}. Returns can be processed after delivery.</p>
    <a href="/admin/order/orders/{{order.order_id}}/edit" class="mt-3 inline-flex text-sm font-semibold text-primary hover:underline">Review fulfillment status</a>
</div>
{{/unless}}
<p id="returnFeedback" class="text-sm text-on-surface-variant mb-4" role="status" aria-live="polite"></p>
<div class="flex justify-between mb-2">
<span class="text-on-surface-variant">Items to Return</span>
<span id="selectedReturnCount" class="font-semibold text-on-surface">0</span>
</div>
<div class="flex justify-between mb-6">
<span class="text-on-surface-variant">Estimated Refund</span>
<span id="estimatedReturnRefund" class="font-headline-lg text-on-surface">₹0</span>
</div>
<button id="processReturnButton" data-order-id="{{order.order_id}}" type="button" class="w-full bg-on-surface text-surface py-4 rounded-lg font-bold hover:opacity-90 active:scale-[0.98] transition-all mb-3" {{#unless hasReturnableItems}}disabled{{/unless}}>Process Return</button>
<p class="text-[12px] text-center text-on-surface-variant/60">A return shipping label will be generated automatically.</p>
</div>
</div>
</div>
</div></div>
</div>
</main>
<!-- Contextual micro-interaction script -->
<script>
        const returnItems = [...document.querySelectorAll('[data-return-item]')];
        const returnFeedback = document.getElementById('returnFeedback');
        const selectedReturnCount = document.getElementById('selectedReturnCount');
        const estimatedReturnRefund = document.getElementById('estimatedReturnRefund');
        const processReturnButton = document.getElementById('processReturnButton');

        function getSelectedReturnItems() {
            return returnItems.filter((checkbox) => checkbox.checked).map((checkbox) => {
                const row = checkbox.closest('tr');
                return {
                    itemId: checkbox.value,
                    quantity: Number(row.querySelector('[data-return-quantity]').value),
                    reason: row.querySelector('[data-return-reason]').value,
                    unitPrice: Number(checkbox.dataset.unitPrice),
                };
            });
        }

        function updateReturnEstimate() {
            const selectedItems = getSelectedReturnItems();
            const quantity = selectedItems.reduce((sum, item) => sum + item.quantity, 0);
            const amount = selectedItems.reduce((sum, item) => sum + item.quantity * item.unitPrice, 0);
            selectedReturnCount.textContent = String(quantity);
            estimatedReturnRefund.textContent = `₹${amount.toFixed(2)}`;
        }

        returnItems.forEach((checkbox) => {
            checkbox.addEventListener('change', () => {
                checkbox.closest('tr').classList.toggle('bg-surface-container-low/50', checkbox.checked);
                updateReturnEstimate();
            });
        });

        document.querySelectorAll('[data-return-quantity], [data-return-reason]').forEach((control) => {
            control.addEventListener('change', updateReturnEstimate);
        });

        document.querySelector('[data-select-all-returns]').addEventListener('change', (event) => {
            returnItems.filter((checkbox) => !checkbox.disabled).forEach((checkbox) => {
                checkbox.checked = event.target.checked;
                checkbox.closest('tr').classList.toggle('bg-surface-container-low/50', checkbox.checked);
            });
            updateReturnEstimate();
        });

        processReturnButton.addEventListener('click', async () => {
            const selectedItems = getSelectedReturnItems();
            if (!selectedItems.length) {
                returnFeedback.textContent = 'Select at least one delivered item to return.';
                returnFeedback.classList.add('text-error');
                return;
            }

            processReturnButton.disabled = true;
            returnFeedback.textContent = 'Processing return...';
            returnFeedback.classList.remove('text-error');

            try {
                const response = await fetch(`/admin/order/orders/${encodeURIComponent(processReturnButton.dataset.orderId)}/return`, {
                    method: 'PATCH',
                    headers: {
                        Accept: 'application/json',
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        items: selectedItems.map(({ itemId, quantity, reason }) => ({ itemId, quantity, reason })),
                    }),
                });
                const data = await response.json();

                if (!response.ok || !data.success) {
                    returnFeedback.textContent = data.message || 'Unable to process return.';
                    returnFeedback.classList.add('text-error');
                    return;
                }

                returnFeedback.textContent = data.message;
                setTimeout(() => {
                    window.location.href = `/admin/order/orders/${encodeURIComponent(processReturnButton.dataset.orderId)}`;
                }, 700);
            } catch (error) {
                console.error('Process return error:', error);
                returnFeedback.textContent = 'Unable to process return. Please try again.';
                returnFeedback.classList.add('text-error');
            } finally {
                processReturnButton.disabled = false;
            }
        });

        // Hover effect for navigation
        const navItems = document.querySelectorAll('nav a');
        navItems.forEach(item => {
            item.addEventListener('mouseenter', () => {
                if (!item.classList.contains('font-bold')) {
                    item.style.transform = 'translateX(4px)';
                }
            });
            item.addEventListener('mouseleave', () => {
                item.style.transform = 'translateX(0px)';
            });
        });
    </script>




</body></html>