<!DOCTYPE html><html class="light" lang="en"><head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<title>Nutri Luxe Admin - All Products</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&amp;family=Inter:wght@400;500;600&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "surface-variant": "#e3e2e2",
                        "surface": "#fbf9f9",
                        "outline": "#747878",
                        "background": "#fbf9f9",
                        "on-primary-fixed-variant": "#464747",
                        "on-tertiary": "#ffffff",
                        "primary-fixed-dim": "#c7c6c6",
                        "inverse-primary": "#c7c6c6",
                        "surface-container-highest": "#e3e2e2",
                        "on-secondary-container": "#646464",
                        "on-error-container": "#93000a",
                        "tertiary-container": "#747474",
                        "surface-bright": "#fbf9f9",
                        "secondary": "#5e5e5e",
                        "secondary-container": "#e3e2e2",
                        "on-primary-container": "#fefcfc",
                        "on-surface-variant": "#444748",
                        "outline-variant": "#c4c7c7",
                        "surface-tint": "#5e5e5e",
                        "tertiary-fixed-dim": "#c6c6c6",
                        "on-primary": "#ffffff",
                        "primary": "#5c5c5c",
                        "on-primary-fixed": "#1b1c1c",
                        "inverse-on-surface": "#f2f0f0",
                        "secondary-fixed": "#e3e2e2",
                        "on-secondary-fixed": "#1b1c1c",
                        "surface-dim": "#dbdad9",
                        "primary-fixed": "#e3e2e2",
                        "secondary-fixed-dim": "#c7c6c6",
                        "error-container": "#ffdad6",
                        "on-tertiary-fixed-variant": "#474747",
                        "inverse-surface": "#303031",
                        "tertiary-fixed": "#e2e2e2",
                        "surface-container-lowest": "#ffffff",
                        "surface-container": "#efeded",
                        "surface-container-high": "#e9e8e7",
                        "tertiary": "#5c5c5c",
                        "surface-container-low": "#f5f3f3",
                        "on-tertiary-fixed": "#1b1b1b",
                        "on-surface": "#1b1c1c",
                        "on-background": "#1b1c1c",
                        "primary-container": "#747474",
                        "on-tertiary-container": "#fcfcfc",
                        "on-secondary-fixed-variant": "#464747",
                        "on-error": "#ffffff",
                        "error": "#ba1a1a"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "stack-lg": "24px",
                        "grid-gutter": "24px",
                        "container-padding": "32px",
                        "stack-sm": "8px",
                        "max-width": "1280px",
                        "section-gap-mobile": "64px",
                        "stack-md": "16px",
                        "section-gap": "120px"
                    },
                    "fontFamily": {
                        "body-xl": ["Inter"],
                        "body-lg": ["Inter"],
                        "body-md": ["Inter"],
                        "label-md": ["Inter"],
                        "headline-xl": ["Plus Jakarta Sans"],
                        "headline-lg": ["Plus Jakarta Sans"],
                        "display-lg-mobile": ["Plus Jakarta Sans"],
                        "display-lg": ["Plus Jakarta Sans"]
                    },
                    "fontSize": {
                        "body-xl": ["20px", {"lineHeight": "1.5", "fontWeight": "400"}],
                        "body-lg": ["17px", {"lineHeight": "1.5", "fontWeight": "400"}],
                        "body-md": ["15px", {"lineHeight": "1.5", "fontWeight": "400"}],
                        "label-md": ["14px", {"lineHeight": "1.2", "letterSpacing": "0.02em", "fontWeight": "600"}],
                        "headline-xl": ["40px", {"lineHeight": "1.2", "letterSpacing": "-0.01em", "fontWeight": "600"}],
                        "headline-lg": ["32px", {"lineHeight": "1.25", "fontWeight": "600"}],
                        "display-lg-mobile": ["40px", {"lineHeight": "1.1", "letterSpacing": "-0.01em", "fontWeight": "700"}],
                        "display-lg": ["56px", {"lineHeight": "1.1", "letterSpacing": "-0.02em", "fontWeight": "700"}]
                    }
                },
            },
        }
    </script>
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            display: inline-block;
            vertical-align: middle;
        }
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #e3e2e2; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #747878; }
        
        .glass-effect {
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }
    </style>
</head>
<body class="bg-surface text-on-surface font-body-md overflow-x-hidden">
<!-- SideNavBar -->
{{> admin/aside}}
<!-- TopNavBar -->
<header
    class="sticky top-0 ml-64 z-40 bg-surface/80 backdrop-blur-md border-b border-outline-variant/30 h-16 flex justify-between items-center px-container-padding"
>

    <!-- Search -->
    <div class="flex items-center flex-1">

        <div class="relative w-full max-w-md">

            <form
                action="/admin/products"
                method="GET"
                class="relative"
            >

                <!-- Search Icon -->
                <span
                    class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant"
                >
                    search
                </span>

                <!-- Search Input -->
                <input
                    class="w-full bg-surface-container-low border-none rounded-full pl-10 pr-24 py-2 text-body-md focus:ring-1 focus:ring-primary transition-all"
                    placeholder="Search customers..."
                    type="text"
                    name="search"
                    value="{{search}}"
                >

                {{#if search}}

                    <!-- X Clear Button -->
                    <a
                        href="/admin/products"
                        class="absolute right-20 top-1/2 -translate-y-1/2 w-7 h-7 flex items-center justify-center rounded-full text-on-surface-variant hover:bg-surface-container-high hover:text-error transition-colors"
                        title="Clear search"
                    >
                        <span class="material-symbols-outlined text-[18px]">
                            close
                        </span>
                    </a>

                {{/if}}

                <!-- Search Button -->
                <button
                    type="submit"
                    class="absolute right-1 top-1/2 -translate-y-1/2 px-4 py-1.5 rounded-full bg-primary text-on-primary text-sm font-semibold hover:opacity-90 transition"
                >
                    Search
                </button>

            </form>

        </div>

    </div>


    <!-- Right Side -->
    <div class="flex items-center gap-6">

        <!-- Notifications -->
        <button
            class="text-on-surface-variant hover:text-primary transition-colors scale-95 active:scale-90"
        >
            <span class="material-symbols-outlined">
                notifications
            </span>
        </button>

        <!-- Settings -->
        <button
            class="text-on-surface-variant hover:text-primary transition-colors scale-95 active:scale-90"
        >
            <span class="material-symbols-outlined">
                settings
            </span>
        </button>

        <div class="h-8 w-[1px] bg-outline-variant/30 mx-2"></div>

        <!-- Admin -->
        <div class="flex items-center gap-3 group cursor-pointer">

            <div class="text-right">
                <p class="font-label-md text-label-md text-on-surface leading-tight">
                    Admin User
                </p>

                <p class="text-[10px] text-on-surface-variant uppercase tracking-widest">
                    Administrator
                </p>
            </div>

            <div
                class="w-10 h-10 rounded-full bg-surface-container-highest overflow-hidden border border-outline-variant/20"
            >
                <img
                    class="w-full h-full object-cover"
                    alt="Admin User"
                    src="YOUR_ADMIN_IMAGE"
                >
            </div>

        </div>

    </div>

</header>
<!-- Main Content -->
<main class="ml-64 pt-16 min-h-screen">
<div class="max-w-[1280px] mx-auto p-container-padding">
<!-- Page Header Actions -->
<div class="flex justify-between items-end mb-10">

    <div>
        <h2 class="font-headline-lg text-headline-lg text-on-surface mb-2">
            Products
        </h2>

        <p class="text-body-md text-on-surface-variant">
            Manage your premium Nutri Burfi collection and inventory status.
        </p>
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-3">

        <!-- Filter Button -->
        <button
            type="button"
            id="openFilter"
            class="px-6 py-3 rounded-full border border-outline-variant/40
                   bg-surface-container-lowest
                   text-on-surface
                   flex items-center gap-2
                   font-label-md
                   hover:bg-surface-container-high
                   transition-all
                   active:scale-95"
        >
            <span class="material-symbols-outlined text-[20px]">
                filter_list
            </span>

            <span>Filter</span>
        </button>

        <!-- Add Product -->
        <a
            href="/admin/product/addProduct"
            class="bg-primary text-on-primary px-8 py-3 rounded-full
                   flex items-center gap-2
                   transition-all
                   hover:bg-on-surface
                   active:scale-95
                   shadow-lg shadow-primary/10"
        >
            <span class="material-symbols-outlined">
                add
            </span>

            <span class="font-label-md">
                Add Product
            </span>
        </a>

    </div>

</div>
<!-- Dashboard Stats Brief (Contextual) -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-grid-gutter mb-section-gap-mobile">
<div class="bg-surface-container-low rounded-xl p-6 border border-outline-variant/10">
    <p class="text-label-md text-outline mb-1">
        Total Products
    </p>

    <h3 class="text-headline-lg font-bold">
        {{totalProducts}}
    </h3>
</div>


<div class="bg-surface-container-low rounded-xl p-6 border border-outline-variant/10">
    <p class="text-label-md text-outline mb-1">
        Out of Stock
    </p>

    <h3 class="text-headline-lg font-bold text-error">
        {{outOfStockProducts}}
    </h3>
</div>


<div class="bg-surface-container-low rounded-xl p-6 border border-outline-variant/10">
    <p class="text-label-md text-outline mb-1">
        Active Categories
    </p>

    <h3 class="text-headline-lg font-bold">
        {{activeCategories}}
    </h3>
</div>
</div>
<!-- Products Table Container -->
<div class="bg-surface-container-lowest rounded-2xl shadow-sm overflow-hidden border border-outline-variant/10">
<table class="w-full text-left border-collapse">
<thead>
<tr class="bg-surface-container/50 border-b border-outline-variant/20">
<th class="px-6 py-4 font-label-md text-outline uppercase tracking-wider text-[11px]">Product</th>
<th class="px-6 py-4 font-label-md text-outline uppercase tracking-wider text-[11px]">Category</th>
<th class="px-6 py-4 font-label-md text-outline uppercase tracking-wider text-[11px]">Price</th>
<th class="px-6 py-4 font-label-md text-outline uppercase tracking-wider text-[11px]">Stock Status</th>
<th class="px-6 py-4 font-label-md text-outline uppercase tracking-wider text-[11px]">
    Product Status
</th>
<th class="px-6 py-4 font-label-md text-outline uppercase tracking-wider text-[11px] text-right">Actions</th>
</tr>
</thead>
<tbody class="divide-y divide-outline-variant/10">
<!-- Product Row 1 -->
{{#each products}}
{{#each variants}}
<tr class="group hover:bg-surface-container-low transition-colors">
<td class="px-6 py-5">
<div class="flex items-center gap-4">
<div class="w-16 h-16 rounded-lg bg-surface-variant overflow-hidden border border-outline-variant/20 flex-shrink-0">
<img class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" data-alt="A high-resolution product shot of a premium Almond Nutri Burfi set on a minimalist ceramic plate. The lighting is crisp and dramatic with soft shadows, highlighting the artisanal texture of the wellness snack. The color palette is composed of warm nutty browns and creamy whites against a clean, technical grey background, embodying a luxurious and healthy lifestyle choice." src="{{../images.[0].url}}"
                        alt="{{../productName}}">
</div>
<div>
 <p class="font-label-md text-on-surface">
                        {{../productName}}
                    </p>
<p class="text-[12px] text-outline">{{this.sku}}</p>
</div>
</div>
</td>
<!--category -->
<td class="px-6 py-5">
    <span class="bg-surface-variant text-on-surface-variant px-3 py-1 rounded-full text-[12px] font-label-md tracking-wider uppercase">
        {{../category_id.category_name}}
    </span>
</td>
        <!-- Price -->
        <td class="px-6 py-5">

            <p class="font-label-md text-on-surface">
                ₹{{this.regular_price}}
            </p>

        </td>
          <!-- Stock -->
<td class="px-6 py-5">

    {{#if (gt this.stock_quantity 10)}}

        <!-- In Stock -->
        <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-green-500"></span>

            <p class="text-body-md text-on-surface">
                In Stock ({{this.stock_quantity}})
            </p>
        </div>

    {{else if (gt this.stock_quantity 0)}}

        <!-- Low Stock -->
        <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-yellow-500"></span>

            <p class="text-body-md text-yellow-600">
                Low Stock ({{this.stock_quantity}})
            </p>
        </div>

    {{else}}

        <!-- Out of Stock -->
        <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-red-500"></span>

            <p class="text-body-md text-red-600">
                Out of Stock ({{this.stock_quantity}})
            </p>
        </div>

    {{/if}}

</td>
<!-- Product Status -->
<td class="px-6 py-5">

    {{#if ../is_listed}}

        <!-- Active -->
        <div class="flex items-center gap-2">

            <span class="w-2 h-2 rounded-full bg-green-500"></span>

            <p class="text-body-md text-green-600">
                Active
            </p>

        </div>

    {{else}}

        <!-- Deleted / Unlisted -->
        <div class="flex items-center gap-2">

            <span class="w-2 h-2 rounded-full bg-red-500"></span>

            <p class="text-body-md text-red-600">
                Deleted
            </p>

        </div>

    {{/if}}

</td>
<td class="px-6 py-5 text-right">
    <div class="flex justify-end gap-2">

        <!-- Edit -->
        <a
            href="/admin/product/editProduct/{{../_id}}"
            class="p-2 text-on-surface-variant hover:text-primary transition-colors"
        >
            <span class="material-symbols-outlined">
                edit
            </span>
        </a>

        <!-- Delete -->
        <button
            type="button"
            class="delete-btn p-2 text-on-surface-variant hover:text-error transition-colors"
            data-id="{{../_id}}"
        >
            <span class="material-symbols-outlined">
                delete
            </span>
        </button>

    </div>
</td>
</tr>
{{/each}}
{{/each}}
</tbody>
</table>
<!-- Pagination -->
<div
    class="px-6 py-4 flex items-center justify-between
           bg-surface-container-low/30
           border-t border-outline-variant/10"
>

    <!-- RESULTS COUNT -->

    <p class="text-[13px] text-outline">

        {{#if totalProducts}}

            Showing

            {{add (multiply (subtract currentPage 1) 10) 1}}

            to

            {{#if (lt (multiply currentPage 10) totalProducts)}}

                {{multiply currentPage 10}}

            {{else}}

                {{totalProducts}}

            {{/if}}

            of {{totalProducts}} results

        {{else}}

            Showing 0 to 0 of 0 results

        {{/if}}

    </p>


    <!-- PAGINATION -->

    <div class="flex gap-2">


        <!-- PREVIOUS BUTTON -->

        {{#if (gt currentPage 1)}}

            <a
                href="/admin/products?page={{subtract currentPage 1}}{{#if search}}&search={{search}}{{/if}}{{#if filter}}&filter={{filter}}{{/if}}"
                class="px-3 py-1 rounded
                       border border-outline-variant/30
                       text-label-md
                       hover:bg-surface-variant
                       transition-colors"
            >

                <span class="material-symbols-outlined text-[18px]">
                    chevron_left
                </span>

            </a>

        {{else}}

            <button
                disabled
                class="px-3 py-1 rounded
                       border border-outline-variant/30
                       text-label-md
                       opacity-50"
            >

                <span class="material-symbols-outlined text-[18px]">
                    chevron_left
                </span>

            </button>

        {{/if}}


        <!-- PAGE NUMBERS -->

        {{#each pages}}

            {{#if (eq this ../currentPage)}}

                <!-- CURRENT PAGE -->

                <a
                    href="#"
                    class="px-3 py-1 rounded
                           bg-primary
                           text-on-primary
                           text-label-md"
                >
                    {{this}}
                </a>

            {{else}}

                <!-- OTHER PAGE -->

                <a
                    href="/admin/products?page={{this}}{{#if ../search}}&search={{../search}}{{/if}}{{#if ../filter}}&filter={{../filter}}{{/if}}"
                    class="px-3 py-1 rounded
                           border border-outline-variant/30
                           text-label-md
                           hover:bg-surface-variant
                           transition-colors"
                >
                    {{this}}
                </a>

            {{/if}}

        {{/each}}


        <!-- NEXT BUTTON -->

        {{#if (lt currentPage totalPages)}}

            <a
                href="/admin/products?page={{add currentPage 1}}{{#if search}}&search={{search}}{{/if}}{{#if filter}}&filter={{filter}}{{/if}}"
                class="px-3 py-1 rounded
                       border border-outline-variant/30
                       text-label-md
                       hover:bg-surface-variant
                       transition-colors"
            >

                <span class="material-symbols-outlined text-[18px]">
                    chevron_right
                </span>

            </a>

        {{else}}

            <button
                disabled
                class="px-3 py-1 rounded
                       border border-outline-variant/30
                       text-label-md
                       opacity-50"
            >

                <span class="material-symbols-outlined text-[18px]">
                    chevron_right
                </span>

            </button>

        {{/if}}

    </div>

</div>
</div>
</div>
</main>

<!-- Filter Modal -->
<div
    id="filterModal"
    class="fixed inset-0 z-50 hidden items-center justify-center
           bg-black/30 backdrop-blur-sm px-4"
>

    <div
        class="w-full max-w-md
               bg-surface-container-lowest
               rounded-2xl
               shadow-xl
               border border-outline-variant/20
               overflow-hidden"
    >

        <!-- Header -->
        <div
            class="flex items-center justify-between
                   px-6 py-5
                   border-b border-outline-variant/20"
        >

            <div>
                <h2 class="text-lg font-bold text-on-surface">
                    Filter Products
                </h2>

                <p class="text-sm text-on-surface-variant mt-1">
                    Choose product visibility
                </p>
            </div>

            <button
                type="button"
                id="closeFilter"
                class="w-9 h-9 rounded-full
                       flex items-center justify-center
                       text-on-surface-variant
                       hover:bg-surface-container-high
                       hover:text-on-surface
                       transition"
            >
                <span class="material-symbols-outlined">
                    close
                </span>
            </button>

        </div>


        <!-- Filter Options -->
        <div class="p-6 space-y-3">

            <!-- All -->
            <label
                class="flex items-center justify-between
                       p-4 rounded-xl
                       border border-outline-variant/30
                       hover:bg-surface-container-low
                       cursor-pointer transition"
            >

                <div class="flex items-center gap-3">

                    <div
                        class="w-10 h-10 rounded-full
                               bg-surface-container-high
                               flex items-center justify-center"
                    >
                        <span class="material-symbols-outlined text-primary">
                            inventory_2
                        </span>
                    </div>

                    <div>
                        <p class="font-semibold text-on-surface">
                            All Products
                        </p>

                        <p class="text-xs text-on-surface-variant">
                            Show all products
                        </p>
                    </div>

                </div>

                <input
                    type="radio"
                    name="productFilter"
                    value=""
                    class="w-4 h-4 accent-primary"
                    checked
                >

            </label>


            <!-- In Stock -->
            <label
                class="flex items-center justify-between
                       p-4 rounded-xl
                       border border-outline-variant/30
                       hover:bg-green-50
                       cursor-pointer transition"
            >

                <div class="flex items-center gap-3">

                    <div
                        class="w-10 h-10 rounded-full
                               bg-green-100
                               flex items-center justify-center"
                    >
                        <span class="material-symbols-outlined text-green-600">
                            check_circle
                        </span>
                    </div>

                    <div>
                        <p class="font-semibold text-on-surface">
                            In Stock
                        </p>

                        <p class="text-xs text-on-surface-variant">
                            Show products currently in stock
                        </p>
                    </div>

                </div>

                <input
                    type="radio"
                    name="productFilter"
                    value="in-stock"
                    class="w-4 h-4 accent-primary"
                >

            </label>

            <!-- Low Stock -->
<label
    class="flex items-center justify-between
           p-4 rounded-xl
           border border-outline-variant/30
           hover:bg-orange-50
           cursor-pointer transition"
>

    <div class="flex items-center gap-3">

        <div
            class="w-10 h-10 rounded-full
                   bg-orange-100
                   flex items-center justify-center"
        >
            <span class="material-symbols-outlined text-orange-500">
                warning
            </span>
        </div>

        <div>
            <p class="font-semibold text-on-surface">
                Low Stock
            </p>

            <p class="text-xs text-on-surface-variant">
                Show products with low stock
            </p>
        </div>

    </div>

    <input
        type="radio"
        name="productFilter"
        value="low-stock"
        class="w-4 h-4 accent-primary"
    >

</label>


            <!-- Out of Stock -->
            <label
                class="flex items-center justify-between
                       p-4 rounded-xl
                       border border-outline-variant/30
                       hover:bg-red-50
                       cursor-pointer transition"
            >

                <div class="flex items-center gap-3">

                    <div
                        class="w-10 h-10 rounded-full
                               bg-red-100
                               flex items-center justify-center"
                    >
                        <span class="material-symbols-outlined text-red-500">
                            block
                        </span>
                    </div>

                    <div>
                        <p class="font-semibold text-on-surface">
                            Out of Stock
                        </p>

                        <p class="text-xs text-on-surface-variant">
                            Show unavailable products
                        </p>
                    </div>

                </div>

                <input
                    type="radio"
                    name="productFilter"
                    value="out-of-stock"
                    class="w-4 h-4 accent-primary"
                >

            </label>

            <!-- Listed Products -->
<label
    class="flex items-center justify-between
           p-4 rounded-xl
           border border-outline-variant/30
           hover:bg-green-50
           cursor-pointer transition"
>

    <div class="flex items-center gap-3">

        <div
            class="w-10 h-10 rounded-full
                   bg-green-100
                   flex items-center justify-center"
        >
            <span class="material-symbols-outlined text-green-600">
                visibility
            </span>
        </div>

        <div>
            <p class="font-semibold text-on-surface">
                Listed Products
            </p>

            <p class="text-xs text-on-surface-variant">
