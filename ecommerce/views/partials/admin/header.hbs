<header
    class="sticky top-0 w-full z-40
           bg-white/90 backdrop-blur-xl
           flex justify-between items-center
           h-16 px-container-padding
           border-b border-outline-variant/30"
>

    <!-- Search -->

<div class="flex items-center gap-4 flex-1">

    <form
        action="/admin/customers"
        method="GET"
        class="flex items-center gap-2 w-full max-w-lg"
    >

        <!-- Search Input -->
        <div class="relative flex-1">

            <span
                class="material-symbols-outlined
                       absolute left-3 top-1/2
                       -translate-y-1/2
                       text-outline text-[20px]"
            >
                search
            </span>

            <input
                type="text"
                name="search"
                value="{{search}}"
                placeholder="Search customers..."
                class="w-full pl-10 pr-4 py-2
                       bg-surface-container-low
                       border border-outline-variant/20
                       rounded-brand
                       focus:ring-1
                       focus:ring-brand-gold
                       focus:border-brand-gold
                       outline-none"
            >

        </div>

        <!-- Submit Button -->
        <button
            type="submit"
            class="px-5 py-2
                   bg-primary
                   text-on-primary
                   rounded-brand
                   font-medium
                   hover:opacity-90
                   transition-colors"
        >
            Search
        </button>

    </form>

</div>

    <!-- Right side -->

    <div class="flex items-center gap-5">

        <!-- Notifications -->

        <button
            class="p-2 text-on-surface-variant
                   hover:text-brand-gold
                   transition-colors
                   relative"
        >

            <span class="material-symbols-outlined">
                notifications
            </span>

            <span
                class="absolute top-2 right-2
                       w-2 h-2
                       bg-brand-gold
                       rounded-full
                       border-2 border-white"
            ></span>

        </button>


        <!-- Messages -->

        <button
            class="p-2 text-on-surface-variant
                   hover:text-brand-gold"
        >

            <span class="material-symbols-outlined">
                chat_bubble
            </span>

        </button>


        <div class="h-6 w-[1px] bg-outline-variant/40"></div>


        <!-- Admin -->

        <div class="flex items-center gap-3">

            <div class="text-right hidden sm:block">

                <p class="text-[13px] font-bold text-on-surface">
                    Admin Panel
                </p>

                <p
                    class="text-[11px]
                           text-brand-gold
                           font-medium
                           uppercase"
                >
                    Superuser
                </p>

            </div>


            <div
                class="w-9 h-9
                       rounded-brand
                       overflow-hidden
                       border border-brand-gold/30"
            >

                <img
                    src="/images/admin/default-avatar.jpg"
                    class="w-full h-full object-cover"
                    alt="Admin"
                >

            </div>

        </div>

    </div>

</header>