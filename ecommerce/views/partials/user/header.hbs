<body
  class="bg-surface text-on-surface antialiased overflow-x-hidden selection:bg-secondary/30 selection:text-primary safe-bottom-padding">
  <!-- TopNavBar Component -->
  <nav
    class="fixed top-0 w-full z-40 bg-surface/95 backdrop-blur-md border-b border-secondary/10 shadow-sm transition-all duration-300"
