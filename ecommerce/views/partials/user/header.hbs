  <script>
      // Mobile Menu Drawer Control
      (function () {
        const mobileMenuBtn = document.getElementById("mobile-menu-btn");
        const closeMobileMenuBtn = document.getElementById("close-mobile-menu-btn");
        const mobileMenu = document.getElementById("mobile-menu");
        const mobileMenuBackdrop = document.getElementById("mobile-menu-backdrop");

        function openMobileMenu() {
          if (!mobileMenu || !mobileMenuBackdrop) return;
          mobileMenuBackdrop.classList.remove("hidden");
          requestAnimationFrame(() => {
            mobileMenuBackdrop.classList.remove("opacity-0");
            mobileMenu.classList.remove("translate-x-full");
          });
          document.body.style.overflow = "hidden";
        }

        function closeMobileMenu() {
          if (!mobileMenu || !mobileMenuBackdrop) return;
          mobileMenu.classList.add("translate-x-full");
          mobileMenuBackdrop.classList.add("opacity-0");
          setTimeout(() => {
            mobileMenuBackdrop.classList.add("hidden");
            document.body.style.overflow = "";
          }, 300);
        }

        if (mobileMenuBtn) mobileMenuBtn.addEventListener("click", openMobileMenu);
        if (closeMobileMenuBtn) closeMobileMenuBtn.addEventListener("click", closeMobileMenu);
        if (mobileMenuBackdrop) mobileMenuBackdrop.addEventListener("click", closeMobileMenu);

        // Login Popup Control
        const loginPopupBtn = document.getElementById("login-popup-btn");
        const mobileLoginPopupBtn = document.getElementById("mobile-login-popup-btn");
        const mobileBottomLoginBtn = document.getElementById("mobile-bottom-login-btn");
        const loginPopup = document.getElementById("login-popup");
        const closeLoginPopup = document.getElementById("close-login-popup");

        function showLoginModal() {
          if (!loginPopup) return;
          loginPopup.classList.remove("hidden");
          loginPopup.classList.add("flex");
          closeMobileMenu();
        }

        function hideLoginModal() {
          if (!loginPopup) return;
          loginPopup.classList.add("hidden");
          loginPopup.classList.remove("flex");
        }

        if (loginPopupBtn) loginPopupBtn.addEventListener("click", showLoginModal);
        if (mobileLoginPopupBtn) mobileLoginPopupBtn.addEventListener("click", showLoginModal);
        if (mobileBottomLoginBtn) mobileBottomLoginBtn.addEventListener("click", showLoginModal);
        if (closeLoginPopup) closeLoginPopup.addEventListener("click", hideLoginModal);
        if (loginPopup) {
          loginPopup.addEventListener("click", (e) => {
            if (e.target === loginPopup) hideLoginModal();
          });
        }

        // Dynamic Active Navigation Highlighting
        function highlightActiveNav() {
          const path = (window.location.pathname || "/").toLowerCase();
          let activeKey = "";

          if (path === "/" || path === "") {
            activeKey = "home";
          } else if (path.startsWith("/product")) {
            activeKey = "products";
          } else if (path.startsWith("/about")) {
            activeKey = "about";
          } else if (path.startsWith("/contact")) {
            activeKey = "contact";
          } else if (path.startsWith("/wishlist")) {
            activeKey = "wishlist";
          } else if (path.startsWith("/cart")) {
            activeKey = "cart";
          } else if (path.startsWith("/profile") || path.startsWith("/order") || path.startsWith("/wallet")) {
            activeKey = "account";
          }

          // Desktop nav links
          const desktopLinks = document.querySelectorAll("#nav-links-desktop a[data-nav]");
          desktopLinks.forEach(function (link) {
            const nav = link.getAttribute("data-nav");
            if (nav === activeKey) {
              link.className = "nav-link font-label-md text-label-md text-on-surface border-b-2 border-on-surface pb-1 font-semibold transition-colors";
            } else {
              link.className = "nav-link font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-colors";
            }
          });

          // Bottom nav links
          const bottomLinks = document.querySelectorAll("#mobile-bottom-nav [data-bottom-nav]");
          bottomLinks.forEach(function (link) {
            const nav = link.getAttribute("data-bottom-nav");
            if (nav === activeKey) {
              link.classList.remove("text-on-surface-variant");
              link.classList.add("text-primary", "font-bold");
            } else {
              link.classList.remove("text-primary", "font-bold");
              link.classList.add("text-on-surface-variant");
            }
          });
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", highlightActiveNav);
        } else {
          highlightActiveNav();
        }
      })();

    function togglePasswordVisibility(id) {
      const input = document.getElementById(id);
      if (!input) return;
      const container = input.closest('.relative') || input.parentElement;
      const btn = (input.nextElementSibling && input.nextElementSibling.tagName === 'BUTTON')
        ? input.nextElementSibling
        : (container ? container.querySelector('button[type="button"]') : null);
      const icon = btn
        ? btn.querySelector('.material-symbols-outlined')
        : (container ? container.querySelector('.material-symbols-outlined') : null);

      if (input.type === 'password') {
        input.type = 'text';
        if (icon) {
          icon.textContent = 'visibility_off';
          if (icon.dataset) icon.dataset.icon = 'visibility_off';
        }
      } else {
        input.type = 'password';
        if (icon) {
          icon.textContent = 'visibility';
          if (icon.dataset) icon.dataset.icon = 'visibility';
        }
      }
    }
    window.togglePasswordVisibility = togglePasswordVisibility;

    function updateCartBadge(count) {
      const num = Number(count) || 0;
      const badges = document.querySelectorAll('.cart-badge');
      badges.forEach(badge => {
        if (num > 0) {
          badge.textContent = num > 99 ? '99+' : num;
          badge.classList.remove('hidden');
        } else {
          badge.textContent = '';
          badge.classList.add('hidden');
        }
      });
    }
    window.updateCartBadge = updateCartBadge;

    // Global response interceptor for blocked account handling & cart badge sync
    (function () {
      const originalFetch = window.fetch;
      if (!originalFetch) return;
      window.fetch = async function (...args) {
        const response = await originalFetch.apply(this, args);
        if (response.status === 403) {
          try {
            const clone = response.clone();
            const data = await clone.json();
            if (data && (data.isBlocked || data.redirectTo)) {
              window.location.href = data.redirectTo || "/login?blocked=true";
            }
          } catch (_) { }
        } else if (response.ok) {
          try {
            const clone = response.clone();
            const data = await clone.json();
            if (data && typeof data === 'object') {
              if (typeof data.cartCount === 'number') {
                updateCartBadge(data.cartCount);
              } else if (data.cart && Array.isArray(data.cart.items)) {
                const total = data.cart.items.reduce((sum, item) => sum + (Number(item.quantity) || 0), 0);
                updateCartBadge(total);
              }
            }
          } catch (_) { }
        }
        return response;
      };
    })();
  </script>