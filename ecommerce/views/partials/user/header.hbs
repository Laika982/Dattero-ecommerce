        <a class="nav-link font-label-md text-label-md transition-colors {{#if (eq currentNav 'about')}}text-on-surface border-b-2 border-on-surface pb-1 font-semibold{{else}}text-on-surface-variant hover:text-on-surface{{/if}}"
          href="/about" data-nav="about">About Us</a>
        <a class="nav-link font-label-md text-label-md transition-colors {{#if (eq currentNav 'contact')}}text-on-surface border-b-2 border-on-surface pb-1 font-semibold{{else}}text-on-surface-variant hover:text-on-surface{{/if}}"
