<body class="bg-surface text-on-surface antialiased overflow-x-hidden selection:bg-secondary/30 selection:text-primary">
<!-- TopNavBar Component -->
<nav class="fixed top-0 w-full z-50 bg-surface/95 dark:bg-surface/90 backdrop-blur-md border-b border-secondary/10 dark:border-secondary-fixed-dim/10 shadow-sm transition-all duration-300 shadow-md" id="main-nav">
<div class="flex justify-between items-center w-full px-container-padding max-w-max-width mx-auto h-20">
<!-- Brand Logo -->
<a class="font-headline-lg text-headline-lg font-bold text-on-surface tracking-tight z-10 flex-shrink-0" href="#">
                Nutri Burfi
            </a>
<!-- Navigation Links (Desktop) -->
<div class="hidden md:flex items-center gap-8 absolute left-1/2 -translate-x-1/2">
<a class="text-on-surface font-label-md text-label-md border-b-2 border-on-surface pb-1" href="/">Home</a>
<a class="text-on-surface-variant font-label-md text-label-md hover:text-on-surface transition-colors" href="products">Products</a>
<a class="text-on-surface-variant font-label-md text-label-md hover:text-on-surface transition-colors" href="about">About Us</a>
<a class="text-on-surface-variant font-label-md text-label-md hover:text-on-surface transition-colors" href="contact">Contact</a>
</div>
<!-- Trailing Icon Actions -->
<div class="flex items-center gap-4 text-on-surface z-10 flex-shrink-0">
<button class="hover:opacity-80 transition-opacity active:scale-95 duration-150 ease-in-out p-2 rounded-full hover:bg-surface-variant/50">
<span class="material-symbols-outlined" data-icon="search">search</span>
</button>
<button class="hover:opacity-80 transition-opacity active:scale-95 duration-150 ease-in-out p-2 rounded-full hover:bg-surface-variant/50">
<span class="material-symbols-outlined" data-icon="favorite">favorite</span>
</button>
<button class="hover:opacity-80 transition-opacity active:scale-95 duration-150 ease-in-out p-2 rounded-full hover:bg-surface-variant/50 relative">
<span class="material-symbols-outlined" data-icon="shopping_cart">shopping_cart</span>
<span class="absolute top-1 right-1 w-2 h-2 bg-accent-blue rounded-full"></span>
</button>
<div class="relative hidden md:block">

  {{#if user}}

    <!-- USER HAS TOKEN -->

    <a
      href="/profile"
      class="hover:opacity-80 transition-opacity active:scale-95 duration-150 ease-in-out p-2 rounded-full hover:bg-surface-variant/50">

      <span class="material-symbols-outlined">
        person
      </span>

    </a>

  {{else}}

    <!-- USER DOES NOT HAVE TOKEN -->

    <button
      type="button"
      id="login-popup-btn"
      class="hover:opacity-80 transition-opacity active:scale-95 duration-150 ease-in-out p-2 rounded-full hover:bg-surface-variant/50">

      <span class="material-symbols-outlined">
        person
      </span>

    </button>

  {{/if}}

</div>
<!-- Mobile Menu Toggle -->
<button class="md:hidden hover:opacity-80 transition-opacity active:scale-95 duration-150 ease-in-out p-2 rounded-full hover:bg-surface-variant/50 ml-2" id="mobile-menu-btn">
<span class="material-symbols-outlined" data-icon="menu">menu</span>
</button>
</div>
</div>
</nav>
<!-- Mobile Menu Overlay (Hidden by default) -->
<div class="fixed inset-0 bg-surface z-40 hidden flex-col pt-24 px-container-padding" id="mobile-menu">
<a class="font-headline-lg text-headline-lg py-4 border-b border-secondary/10 text-on-surface" href="#">Home</a>
<a class="font-headline-lg text-headline-lg py-4 border-b border-secondary/10" href="#">Products</a>
<a class="font-headline-lg text-headline-lg py-4 border-b border-secondary/10" href="#">About Us</a>
<a class="font-headline-lg text-headline-lg py-4 border-b border-secondary/10" href="#">Contact</a>

{{#if user}}

  <a
    class="font-headline-lg text-headline-lg py-4 border-b border-secondary/10 flex items-center justify-between"
    href="/profile">

    Account

    <span class="material-symbols-outlined">
      person
    </span>

  </a>

{{else}}

  <button
    class="font-headline-lg text-headline-lg py-4 border-b border-secondary/10 flex items-center justify-between w-full text-left"
    id="mobile-login-popup-btn">

    Account

    <span class="material-symbols-outlined">
      person
    </span>

  </button>

{{/if}}
</div>

<div
  id="login-popup"
  class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/40 backdrop-blur-sm">

  <div
    class="w-[90%] max-w-md rounded-2xl bg-white p-8 shadow-2xl">

    <div class="text-center">

      <span class="material-symbols-outlined text-5xl text-primary">
        person
      </span>

      <h2 class="mt-4 text-2xl font-semibold">
        Login Required
      </h2>

      <p class="mt-2 text-on-surface-variant">
        Please login to access your profile.
      </p>

      <div class="mt-6 flex gap-3">

        <button
          id="close-login-popup"
          type="button"
          class="flex-1 rounded-xl border border-outline-variant px-4 py-3">

          Cancel

        </button>

        <a
          href="/login"
          class="flex-1 rounded-xl bg-primary px-4 py-3 text-center text-white">

          Login

        </a>

      </div>

    </div>

  </div>

</div>


<script>

  const loginPopupBtn =
    document.getElementById("login-popup-btn");

  const mobileLoginPopupBtn =
    document.getElementById("mobile-login-popup-btn");

  const loginPopup =
    document.getElementById("login-popup");

  const closeLoginPopup =
    document.getElementById("close-login-popup");


  // Desktop login popup
  if (loginPopupBtn) {

    loginPopupBtn.addEventListener("click", () => {

      loginPopup.classList.remove("hidden");

      loginPopup.classList.add("flex");

    });

  }


  // Mobile login popup
  if (mobileLoginPopupBtn) {

    mobileLoginPopupBtn.addEventListener("click", () => {

      loginPopup.classList.remove("hidden");

      loginPopup.classList.add("flex");

      const mobileMenu =
        document.getElementById("mobile-menu");

      if (mobileMenu) {
        mobileMenu.classList.add("hidden");
      }

    });

  }


  // Close button
  if (closeLoginPopup) {

    closeLoginPopup.addEventListener("click", () => {

      loginPopup.classList.add("hidden");

      loginPopup.classList.remove("flex");

    });

  }


  // Click outside popup
  if (loginPopup) {

    loginPopup.addEventListener("click", (event) => {

      if (event.target === loginPopup) {

        loginPopup.classList.add("hidden");

        loginPopup.classList.remove("flex");

      }

    });

  }

</script>