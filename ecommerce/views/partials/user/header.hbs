        <span class="w-2.5 h-2.5 rounded-full bg-primary inline-block"></span>
        Nutri Burfi
      </a>
      <!-- Navigation Links (Desktop) -->
      <div class="hidden md:flex items-center gap-8 absolute left-1/2 -translate-x-1/2" id="nav-links-desktop">
