        <a class="nav-link font-label-md text-label-md transition-colors {{#if (eq currentNav 'products')}}text-on-surface border-b-2 border-on-surface pb-1 font-semibold{{else}}text-on-surface-variant hover:text-on-surface{{/if}}"
