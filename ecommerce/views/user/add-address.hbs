<script>
        function toggleSwitch(container) {
            const dot = container.querySelector('#switch-dot') || container.nextElementSibling.querySelector('#switch-dot');
            const bg = container.querySelector('#switch-bg') || container.nextElementSibling.querySelector('#switch-bg');
            const hiddenInput = document.getElementById('isDefault');
            
            const isChecked = dot.classList.contains('translate-x-5');
            
            if (isChecked) {
                dot.classList.remove('translate-x-5');
                dot.classList.add('translate-x-0');
                bg.classList.remove('bg-on-surface');
                bg.classList.add('bg-surface-container-highest');
                hiddenInput.value = "false";
            } else {
                dot.classList.remove('translate-x-0');
                dot.classList.add('translate-x-5');
                bg.classList.remove('bg-surface-container-highest');
                bg.classList.add('bg-on-surface');
                hiddenInput.value = "true";
            }
        }
    </script>
