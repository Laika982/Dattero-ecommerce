    }catch(_e){}</script><meta charset="utf-8"></head><body class="bg-background text-on-surface font-body-md selection:bg-primary-container selection:text-on-primary-container">
<!-- Top Navigation -->
<header class="sticky top-0 w-full bg-surface/80 backdrop-blur-md z-50 border-b border-on-surface/5 shadow-sm">
<nav class="flex justify-between items-center px-container-padding py-4 max-w-max-width mx-auto">
<a href="/" class="font-headline-lg text-headline-lg tracking-tighter text-on-surface">Nutri Luxe</a>
<div class="hidden md:flex items-center gap-stack-lg">
<a href="#" class="text-on-surface font-medium hover:text-primary transition-colors duration-200">Shop</a>
<a href="#" class="text-on-surface font-medium hover:text-primary transition-colors duration-200">Journal</a>
<a href="#" class="text-on-surface font-medium hover:text-primary transition-colors duration-200">Our Story</a>
</div>
<div class="flex items-center gap-4 text-primary">
<span class="material-symbols-outlined cursor-pointer hover:text-on-surface transition-colors">search</span>
<span class="material-symbols-outlined cursor-pointer hover:text-on-surface transition-colors">favorite</span>
<div class="relative group cursor-pointer">
<span class="material-symbols-outlined hover:text-on-surface transition-colors">shopping_cart</span>
<span class="absolute -top-1 -right-1 bg-on-surface text-white text-[10px] w-4 h-4 flex items-center justify-center rounded-full">2</span>
</div>
<a href="/profile" class="material-symbols-outlined cursor-pointer text-on-surface">person</a>
</div>
</nav>
</header>
<div class="max-w-max-width mx-auto flex min-h-screen">
<!-- Sidebar Navigation -->

<!-- Main Content -->
<main class="flex-1 p-container-padding lg:p-12 overflow-y-auto w-full">
<header class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
<div>
<h1 class="font-headline-xl text-headline-xl text-on-surface mb-2">Saved Addresses</h1>
<p class="font-body-lg text-body-lg text-on-surface-variant max-w-xl">Manage your delivery locations for a seamless checkout experience. Set your default shipping and billing preferences below.</p>
</div>
<a href="/profile/address/add" class="flex items-center gap-2 px-6 py-3 bg-on-surface text-white rounded-full font-label-md text-label-md hover:opacity-90 active:scale-95 transition-all shadow-md">
<span class="material-symbols-outlined !text-white !text-lg">add</span>
                    Add New Address
                </a>
</header>
<!-- Address Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-grid-gutter">
{{#each userData.addresses}}
<!-- Address Card -->
<div class="bg-surface-container-lowest border border-on-surface/5 rounded-xl p-8 address-card-hover flex flex-col relative overflow-hidden group">
{{#if this.isDefault}}
<div class="absolute top-0 left-0 w-full h-1 bg-on-surface"></div>
{{/if}}
<div class="flex justify-between items-start mb-6">
<div class="flex flex-col">
<span class="text-[10px] tracking-widest uppercase font-bold text-on-surface/50 mb-1">
  {{#if this.isDefault}}Default Shipping{{else}}Secondary Location{{/if}}
</span>
<h3 class="font-headline-lg text-[20px] text-on-surface">{{this.addressLabel}}</h3>
</div>
<div class="w-8 h-8 rounded-full bg-secondary-container flex items-center justify-center">
<span class="material-symbols-outlined text-primary text-lg" style="font-variation-settings: 'FILL' 1;">
  {{#if (eq this.addressLabel "Home")}}home{{else if (eq this.addressLabel "Work")}}work{{else}}location_on{{/if}}
</span>
</div>
</div>
<div class="space-y-1 mb-8 flex-1">
<p class="font-semibold text-on-surface">{{this.fullName}}</p>
<p class="text-on-surface-variant leading-relaxed">
  {{this.street}}{{#if this.suite}}<br>{{this.suite}}{{/if}}<br>{{this.city}}, {{this.state}} {{this.zip}}<br>{{this.country}}
</p>
<p class="text-on-surface-variant mt-2 text-sm flex items-center gap-2">
<span class="material-symbols-outlined text-sm">phone</span>
    {{this.phone}}
</p>
</div>
<div class="flex items-center justify-between pt-6 border-t border-on-surface/5">
{{#if this.isDefault}}
<div class="flex items-center gap-1 text-primary font-bold text-label-md">
  <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">check_circle</span>
  Primary
</div>
{{else}}
<form action="/profile/address/make-primary/{{this._id}}" method="POST" class="inline">
  <button type="submit" class="text-label-md font-medium text-on-surface-variant hover:text-primary transition-colors flex items-center gap-1 group/btn">
    <span class="material-symbols-outlined text-sm group-hover/btn:scale-110 transition-transform">star</span>
    Set as Primary
  </button>
</form>
{{/if}}

<a href="/profile/address/edit/{{this._id}}" class="text-label-md font-medium text-on-surface hover:text-primary transition-colors flex items-center gap-1 group/btn inline-flex">
  <span class="material-symbols-outlined text-sm group-hover/btn:scale-110 transition-transform">edit</span>
  Edit
</a>

<form action="/profile/address/delete/{{this._id}}" method="POST" class="inline delete-address-form">
  <button type="submit" class="text-label-md font-medium text-error/80 hover:text-error transition-colors flex items-center gap-1 group/btn">
    <span class="material-symbols-outlined text-sm group-hover/btn:rotate-12 transition-transform">delete</span>
    Remove
  </button>
</form>
</div>
</div>
{{/each}}

<!-- Empty State / Placeholder Card -->
<a href="/profile/address/add" class="border-2 border-dashed border-on-surface/10 rounded-xl p-8 flex flex-col items-center justify-center text-on-surface-variant hover:border-on-surface/30 hover:bg-surface-container-low/50 transition-all group min-h-[320px]">
<div class="w-12 h-12 rounded-full bg-surface-container flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
<span class="material-symbols-outlined text-on-surface-variant">add_location</span>
</div>
<p class="font-medium text-on-surface">Add another address</p>
<p class="text-xs mt-1">Gifts or secondary locations</p>
</a>
</div>
<!-- Helpful Information Section -->
<section class="mt-20 p-8 rounded-2xl bg-surface-container-low/50 border border-on-surface/5">
<div class="flex items-start gap-6">
<div class="hidden sm:flex shrink-0 w-12 h-12 rounded-full bg-on-surface text-white items-center justify-center">
<span class="material-symbols-outlined">info</span>
</div>
<div class="space-y-4">
<h4 class="font-headline-lg text-lg text-on-surface">About your saved addresses</h4>
<div class="grid md:grid-cols-2 gap-8">
<div>
<p class="font-bold text-sm mb-2 text-on-surface">Security &amp; Privacy</p>
<p class="text-sm text-on-surface-variant leading-relaxed">Your address information is encrypted and stored securely to ensure your privacy. We never share your shipping details with third-party marketers.</p>
</div>
<div>
<p class="font-bold text-sm mb-2 text-on-surface">Default Shipping</p>
<p class="text-sm text-on-surface-variant leading-relaxed">Your primary address is automatically selected for new orders. You can change your primary address at any time by editing the address card.</p>
</div>
</div>
</div>
</div>
</section>
</main>
</div>
<!-- Mobile Navigation (visible only on small screens) -->
<div class="md:hidden fixed bottom-0 left-0 w-full bg-surface/95 backdrop-blur-md border-t border-on-surface/5 z-50 flex justify-around items-center py-4 px-6">
<a class="flex flex-col items-center gap-1 text-on-surface-variant" href="#">
<span class="material-symbols-outlined">dashboard</span>
<span class="text-[10px] font-medium">Overview</span>
</a>
<a class="flex flex-col items-center gap-1 text-on-surface font-bold" href="/profile/address">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">location_on</span>
<span class="text-[10px]">Addresses</span>
</a>
<a class="flex flex-col items-center gap-1 text-on-surface-variant" href="#">
<span class="material-symbols-outlined">shopping_bag</span>
<span class="text-[10px] font-medium">Cart</span>
</a>
<a class="flex flex-col items-center gap-1 text-on-surface-variant" href="/profile">
<span class="material-symbols-outlined">person</span>
<span class="text-[10px] font-medium">Profile</span>
</a>
</div>
<!-- Footer -->
{{> user/footer}}
<script>
        function showConfirmModal({ title, message, confirmText = 'Confirm', cancelText = 'Cancel', icon = 'logout', confirmColorClass = 'bg-primary text-on-primary', iconContainerColor = 'bg-error-container/30', iconColor = 'text-error' }) {
            return new Promise((resolve) => {
                const container = document.createElement('div');
                container.className = 'fixed inset-0 z-50 flex items-center justify-center bg-on-surface/40 backdrop-blur-md opacity-0 animate-[fadeIn_0.3s_ease-out_forwards]';
                
                if (!document.getElementById('modal-animation-style')) {
                    const style = document.createElement('style');
                    style.id = 'modal-animation-style';
                    style.innerHTML = `
                        @keyframes fadeIn {
                            from { opacity: 0; }
                            to { opacity: 1; }
                        }
                        @keyframes modalSlideUp {
                            from {
                                opacity: 0;
                                transform: scale(0.95) translateY(20px);
                            }
                            to {
                                opacity: 1;
                                transform: scale(1) translateY(0);
                            }
                        }
                    `;
                    document.head.appendChild(style);
                }

                container.innerHTML = `
                    <div class="relative w-full max-w-md mx-auto p-8 bg-surface-container-lowest rounded-3xl shadow-[0_8px_30px_rgb(0,0,0,0.08)] transform scale-95 opacity-0 animate-[modalSlideUp_0.4s_ease-out_0.1s_forwards] border border-outline-variant/10">
                        <div class="flex flex-col items-center text-center">
                            <div class="w-16 h-16 ${iconContainerColor} rounded-full flex items-center justify-center mb-6">
                                <span class="material-symbols-outlined ${iconColor} text-[32px] font-light">${icon}</span>
                            </div>
                            <h2 class="font-headline-xl text-headline-xl text-on-surface mb-4 tracking-tight">${title}</h2>
                            <p class="font-body-xl text-body-xl text-on-surface-variant mb-10 max-w-[280px]">
                                ${message}
                            </p>
                            <div class="flex flex-col w-full gap-3">
                                <button class="w-full py-4 ${confirmColorClass} rounded-full font-label-md text-label-md hover:-translate-y-[1px] hover:shadow-lg transition-all duration-200 flex items-center justify-center" id="modal-confirm-btn">
                                    ${confirmText}
                                </button>
                                <button class="w-full py-4 text-on-surface-variant font-label-md text-label-md hover:text-on-surface transition-colors duration-200" id="modal-cancel-btn">
                                    ${cancelText}
                                </button>
                            </div>
                        </div>
                    </div>
                `;

                document.body.appendChild(container);

                const closeModal = (result) => {
                    container.style.opacity = '0';
                    container.style.transition = 'opacity 0.2s ease-out';
                    setTimeout(() => {
                        container.remove();
                        resolve(result);
                    }, 200);
                };

                container.querySelector('#modal-cancel-btn').addEventListener('click', () => closeModal(false));
                
                container.addEventListener('click', (e) => {
                    if (e.target === container) {
                        closeModal(false);
                    }
                });

                const confirmBtn = container.querySelector('#modal-confirm-btn');
                confirmBtn.addEventListener('click', () => {
                    confirmBtn.innerHTML = '<span class="material-symbols-outlined animate-spin text-[20px]">progress_activity</span>';
                    confirmBtn.classList.add('opacity-80', 'cursor-not-allowed');
                    setTimeout(() => {
                        closeModal(true);
                    }, 800);
                });
            });
        }

        // Address deletion confirmation
        document.querySelectorAll('.delete-address-form').forEach(form => {
            form.addEventListener('submit', function(e) {
                e.preventDefault();
                showConfirmModal({
                    title: 'Delete Address',
                    message: 'Are you sure you want to delete this address?',
                    confirmText: 'Delete',
                    cancelText: 'Cancel',
                    icon: 'delete',
                    iconContainerColor: 'bg-error-container/30',
                    iconColor: 'text-error'
                }).then((confirmed) => {
                    if (confirmed) {
                        form.submit();
                    }
                });
            });
        });

        // Simple micro-interactions
        document.querySelectorAll('.address-card-hover').forEach(card => {
            card.addEventListener('mouseenter', () => {
                // Potential for more complex JS animations
            });
        });

        // Add to Cart / Interaction simulation
        const buttons = document.querySelectorAll('button');
        buttons.forEach(btn => {
            btn.addEventListener('mousedown', () => {
                btn.style.transform = 'scale(0.96)';
            });
            btn.addEventListener('mouseup', () => {
                btn.style.transform = 'scale(1)';
            });
            btn.addEventListener('mouseleave', () => {
                btn.style.transform = 'scale(1)';
            });
        });
    </script>
</body></html>
