{{>user/header}}

<!-- Main Content -->
<main class="flex-grow w-full max-w-max-width mx-auto px-4 sm:px-6 md:px-8 pt-20 sm:pt-24 md:pt-28 pb-12 sm:pb-16 safe-bottom-padding">

    <!-- Notification -->
    <div class="max-w-max-width mx-auto px-2 sm:px-4 mt-2 mb-4">
        {{> user/notification}}
    </div>

    <!-- Page Header -->
    <header class="mb-6 sm:mb-stack-lg text-left">
        <h1 class="text-2xl md:text-3xl font-bold text-on-surface tracking-tight mb-1 sm:mb-3">
            Your Cart
        </h1>

        <p class="font-body-lg text-xs sm:text-sm md:text-base text-ink-black/60">
            Review your premium selections before checkout.
        </p>
    </header>


    {{#if cartItems.length}}

    <div class="flex flex-col lg:flex-row gap-6 md:gap-8 items-start">

        <!-- ===================================================== -->
        <!-- CART ITEMS -->
        <!-- ===================================================== -->

        <div class="w-full lg:w-2/3 flex flex-col gap-4 sm:gap-6">

            {{#each cartItems}}

            <!-- Cart Item -->
            <div
                data-cart-item
                data-variant-id="{{variantId}}"
                class="bg-surface-container-lowest rounded-2xl sm:rounded-[24px] p-3.5 sm:p-6 md:p-8 flex flex-row items-center gap-3.5 sm:gap-6 md:gap-8 relative border border-outline-variant/20 shadow-sm
                {{#unless canCheckout}}
                    opacity-80
                {{/unless}}"
            >

                <!-- Product Image -->
                <div
                    class="w-20 h-20 sm:w-28 sm:h-28 md:w-32 md:h-32 bg-surface-gray rounded-xl sm:rounded-[16px] overflow-hidden relative shrink-0"
                >
                    {{#if image}}

                        <img
                            src="{{image}}"
                            alt="{{productName}}"
                            class="object-cover w-full h-full mix-blend-multiply"
                        >

                    {{else}}

                        <div class="w-full h-full flex items-center justify-center text-ink-black/40">
                            <span class="material-symbols-outlined text-[32px] sm:text-[40px]">
                                image
                            </span>
                        </div>

                    {{/if}}
                </div>


                <!-- Product Information -->
                <div class="flex-grow flex flex-col justify-between min-w-0 w-full">

                    <!-- Top Information -->
                    <div>

                        <div class="flex justify-between items-start gap-2 mb-1">

                            <h3
                                class="font-headline-lg text-sm sm:text-lg md:text-[22px] text-ink-black leading-snug line-clamp-1 font-semibold"
                            >
                                {{productName}}
                            </h3>

                            <!-- Remove Button -->
                            <button
                                type="button"
                                data-cart-action="remove"
                                aria-label="Remove item"
                                class="text-ink-black/40 hover:text-ink-black transition-colors p-1 shrink-0"
                            >
                                <span
                                    class="material-symbols-outlined text-[18px] sm:text-[20px]"
                                    data-icon="close"
                                >
                                    close
                                </span>
                            </button>

                        </div>


                        <!-- Variant Information & Selector -->
                        <div class="flex items-center flex-wrap gap-2 mb-2">
                            <label class="sr-only" for="cart-variant-select-{{cartItemId}}">Change Variant</label>
                            <div class="relative inline-flex items-center">
                                <select
                                    id="cart-variant-select-{{cartItemId}}"
                                    data-change-variant
                                    data-current-variant-id="{{variantId}}"
                                    class="appearance-none bg-surface-gray hover:bg-surface-variant text-ink-black font-label-md text-[11px] sm:text-xs font-semibold py-1 sm:py-1.5 pl-2.5 sm:pl-3 pr-7 sm:pr-8 rounded-lg border border-outline-variant/30 focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary transition-all cursor-pointer"
                                    aria-label="Change variant"
                                >
                                    {{#each availableVariants}}
                                        <option value="{{this.variantId}}" {{#if this.isCurrent}}selected{{/if}} {{#if this.isOutOfStock}}disabled{{/if}}>
                                            {{this.weight}} - ₹{{this.price}}{{#if this.isOutOfStock}} (Out of stock){{/if}}
                                        </option>
                                    {{/each}}
                                </select>
                            </div>

                            {{#if sku}}
                                <span class="font-label-md text-[11px] sm:text-xs text-ink-black/50">
                                    SKU: {{sku}}
                                </span>
                            {{/if}}
                        </div>


                        <!-- Price -->
                        <p class="font-body-md text-ink-black/60 mb-4">
                            Price: ₹{{price}}
                        </p>


                        <!-- Availability -->
                        {{#if canCheckout}}

                            <span
                                class="inline-flex items-center text-green-700 text-sm font-medium mb-4"
                            >
                                <span class="material-symbols-outlined text-[18px] mr-1">
                                    check_circle
                                </span>

                                Available
                            </span>

                        {{else}}

                            <div class="mb-4">

                                {{#if (eq availability "out_of_stock")}}

                                    <span
                                        class="inline-flex items-center text-red-600 text-sm font-medium"
                                    >
                                        <span class="material-symbols-outlined text-[18px] mr-1">
                                            error
                                        </span>

                                        Out of stock
                                    </span>

                                {{else if (eq availability "insufficient_stock")}}

                                    <span
                                        class="inline-flex items-center text-orange-600 text-sm font-medium"
                                    >
                                        <span class="material-symbols-outlined text-[18px] mr-1">
                                            warning
                                        </span>

                                        Only {{stock}} available
                                    </span>

                                {{else if (eq availability "blocked")}}

                                    <span
                                        class="inline-flex items-center text-red-600 text-sm font-medium"
                                    >
                                        <span class="material-symbols-outlined text-[18px] mr-1">
                                            block
                                        </span>

                                        Product unavailable
                                    </span>

                                {{else if (eq availability "unlisted")}}

                                    <span
                                        class="inline-flex items-center text-red-600 text-sm font-medium"
                                    >
                                        <span class="material-symbols-outlined text-[18px] mr-1">
                                            visibility_off
                                        </span>

                                        Product unavailable
                                    </span>

                                {{/if}}

                            </div>

                        {{/if}}

                    </div>


                    <!-- Bottom Section -->
                    <div class="flex justify-between items-center mt-auto">

                        <!-- Quantity Controls -->
                        <div
                            class="flex items-center gap-4 bg-surface-gray rounded-full px-2 py-1
                            {{#unless canCheckout}}
                                opacity-50
                            {{/unless}}"
                        >

                            <!-- Decrease -->
                            <button
                                type="button"
                                data-cart-action="decrease"
                                class="w-8 h-8 flex items-center justify-center
                                text-ink-black/60 hover:text-ink-black
                                transition-colors rounded-full font-label-md"
                                {{#unless canCheckout}}disabled{{/unless}}
                            >
                                −
                            </button>


                            <!-- Quantity -->
                            <span
                                class="w-6 text-center font-label-md text-ink-black"
                            >
                                {{quantity}}
                            </span>


                            <!-- Increase -->
                            <button
                                type="button"
                                data-cart-action="increase"
                                class="w-8 h-8 flex items-center justify-center
                                text-ink-black/60 hover:text-ink-black
                                transition-colors rounded-full font-label-md"
                                {{#unless canCheckout}}disabled{{/unless}}
                            >
                                +
                            </button>

                        </div>


                        <!-- Item Total -->
                        <span
                            class="font-headline-lg text-[24px] text-ink-black"
                        >
                            ₹{{itemTotal}}
                        </span>

                    </div>

                </div>

            </div>

            {{/each}}


            <!-- ================================================= -->
            <!-- CONTINUE SHOPPING -->
            <!-- ================================================= -->

            <div class="mt-4">

                <a
                    class="inline-flex items-center text-ink-black font-label-md
                    hover:text-accent-blue transition-colors group"
                    href="/products"
                >

                    <span
                        class="material-symbols-outlined mr-2 text-[18px]
                        group-hover:-translate-x-1 transition-transform"
                        data-icon="arrow_back"
                    >
                        arrow_back
                    </span>

                    Continue Shopping

                </a>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- ORDER SUMMARY -->
        <!-- ===================================================== -->

        <div class="w-full lg:w-1/3">

            <div
                class="bg-surface-container-lowest rounded-2xl sm:rounded-[24px] p-5 sm:p-8 border border-outline-variant/20 shadow-sm lg:sticky lg:top-28"
            >

                <h2
                    class="font-headline-lg text-xl sm:text-[24px] text-ink-black mb-6 font-bold"
                >
                    Order Summary
                </h2>


                <!-- Summary -->
                <div class="flex flex-col gap-4 mb-8">

                    <!-- Subtotal -->
                    <div class="flex justify-between items-center">

                        <span class="font-body-md text-ink-black/60">
                            Subtotal
                        </span>

                        <span class="font-body-lg text-ink-black">
                            ₹{{totals.subtotal}}
                        </span>

                    </div>


                    <!-- Discount -->
                    <div class="flex justify-between items-center">

                        <span class="font-body-md text-ink-black/60">
                            Discount
                        </span>

                        <span class="font-body-lg text-green-600">
                            - ₹{{totals.discount}}
                        </span>

                    </div>


                    <!-- Shipping -->
                    <div class="flex justify-between items-center">

                        <span class="font-body-md text-ink-black/60">
                            Shipping
                        </span>

                        <span class="font-body-lg text-ink-black">

                            {{#if totals.shipping}}

                                ₹{{totals.shipping}}

                            {{else}}

                                Free

                            {{/if}}

                        </span>

                    </div>


                    <!-- Tax -->
                    <div class="flex justify-between items-center">

                        <span class="font-body-md text-ink-black/60">
                            Tax
                        </span>

                        <span class="font-body-lg text-ink-black">
                            ₹{{totals.tax}}
                        </span>

                    </div>

                </div>


                <!-- Divider -->
                <div class="w-full h-px bg-surface-gray mb-8"></div>


                <!-- ================================================= -->
                <!-- COUPON -->
                <!-- ================================================= -->

                {{!-- <div class="mb-8">

                    <label
                        class="block font-label-md text-ink-black/60 mb-3"
                        for="coupon"
                    >
                        Gift Card or Discount Code
                    </label>

                    <div class="flex gap-3">

                        <input
                            class="w-full bg-surface-gray border-none rounded-[12px]
                            px-4 py-3 font-body-md text-ink-black
                            focus:outline-none focus:ring-2
                            focus:ring-accent-blue/50 transition-shadow
                            placeholder:text-ink-black/40"
                            id="coupon"
                            name="coupon"
                            placeholder="Enter code"
                            type="text"
                        >

                        <button
                            type="button"
                            class="bg-ink-black/5 text-ink-black font-label-md
                            px-6 py-3 rounded-[12px]
                            hover:bg-ink-black/10 transition-colors
                            whitespace-nowrap"
                        >
                            Apply
                        </button>

                    </div>

                </div> --}}


                <!-- Divider -->
                <div class="w-full h-px bg-surface-gray mb-8"></div>


                <!-- ================================================= -->
                <!-- GRAND TOTAL -->
                <!-- ================================================= -->

                <div class="flex justify-between items-center mb-8">

                    <span
                        class="font-headline-lg text-[24px] text-ink-black"
                    >
                        Grand Total
                    </span>

                    <span
                        class="font-headline-xl text-ink-black"
                    >
                        ₹{{totals.finalAmount}}
                    </span>

                </div>


                <!-- ================================================= -->
                <!-- CHECKOUT BUTTON -->
                <!-- ================================================= -->

                {{#if hasUnavailableItems}}

                    <button
                        type="button"
                        disabled
                        class="w-full bg-gray-300 text-gray-500
                        font-label-md py-4 rounded-[16px]
                        flex items-center justify-center cursor-not-allowed"
                    >

                        Remove unavailable items

                        <span
                            class="material-symbols-outlined ml-2 text-[20px]"
                        >
                            block
                        </span>

                    </button>

                    <p
                        class="text-center font-body-md text-[13px]
                        text-red-500 mt-4"
                    >
                        Some items in your cart are unavailable.
                        Please remove them before checkout.
                    </p>

                {{else}}

                    <a
                        href="/checkout"
                        class="w-full bg-ink-black text-white
                        font-label-md py-4 rounded-[16px]
                        hover:opacity-90 transition-opacity
                        flex items-center justify-center group"
                    >

                        Proceed to Checkout

                        <span
                            class="material-symbols-outlined ml-2
                            group-hover:translate-x-1 transition-transform"
                            data-icon="arrow_forward"
                        >
                            arrow_forward
                        </span>

                    </a>

                    <p
                        class="text-center font-body-md text-[13px]
                        text-ink-black/40 mt-4"
                    >
                        Taxes and shipping calculated at checkout.
                    </p>

                {{/if}}

            </div>

        </div>

    </div>


    {{else}}

    <!-- ========================================================= -->
    <!-- EMPTY CART -->
    <!-- ========================================================= -->

    <div
        class="bg-surface-container-lowest rounded-[24px]
        p-12 text-center"
    >

        <div
            class="w-20 h-20 bg-surface-gray rounded-full
            flex items-center justify-center mx-auto mb-6"
        >

            <span
                class="material-symbols-outlined text-[40px]
                text-ink-black/50"
            >
                shopping_bag
            </span>

        </div>


        <h2
            class="font-headline-lg text-[28px] text-ink-black mb-3"
        >
            Your cart is empty
        </h2>


        <p
            class="font-body-lg text-ink-black/60 mb-8"
        >
            Looks like you haven't added anything to your cart yet.
        </p>


        <a
            href="/products"
            class="inline-flex items-center justify-center
            bg-ink-black text-white font-label-md
            px-8 py-4 rounded-[16px]
            hover:opacity-90 transition-opacity"
        >

            Continue Shopping

            <span
                class="material-symbols-outlined ml-2"
            >
                arrow_forward
            </span>

        </a>

    </div>

    {{/if}}

</main>

<script>
    document.addEventListener("click", async function (event) {
        const button = event.target.closest("[data-cart-action]");

        if (!button || button.disabled) {
            return;
        }

        const cartItem = button.closest("[data-cart-item]");
        const variantId = cartItem?.dataset.variantId;
        const action = button.dataset.cartAction;

        if (!variantId) {
            showNotification("error", "Unable to identify this cart item.");
            return;
        }

        const method = action === "remove" ? "DELETE" : "PATCH";
        const endpoint = action === "remove"
            ? `/cart/${encodeURIComponent(variantId)}`
            : `/cart/${encodeURIComponent(variantId)}/${action}`;

        button.disabled = true;

        try {
            const response = await fetch(endpoint, {
                method,
                headers: {
                    Accept: "application/json",
                },
            });
            const data = await response.json();

            if (!response.ok || !data.success) {
                showNotification("error", data.message || "Unable to update cart.");
                return;
            }

            window.location.reload();
        } catch (error) {
            console.error("Cart update error:", error);
            showNotification("error", "Unable to update cart.");
        } finally {
            if (button.isConnected) {
                button.disabled = false;
            }
        }
    });

    document.addEventListener("change", async function (event) {
        const select = event.target.closest("[data-change-variant]");
        if (!select) return;

        const cartItem = select.closest("[data-cart-item]");
        const oldVariantId = select.dataset.currentVariantId || cartItem?.dataset.variantId;
        const newVariantId = select.value;

        if (!oldVariantId || !newVariantId) return;
        if (oldVariantId === newVariantId) return;

        select.disabled = true;

        try {
            const response = await fetch(`/cart/${encodeURIComponent(oldVariantId)}/change-variant`, {
                method: "PATCH",
                headers: {
                    "Content-Type": "application/json",
                    Accept: "application/json",
                },
                body: JSON.stringify({
                    oldVariantId,
                    newVariantId,
                }),
            });
            const data = await response.json();

            if (!response.ok || !data.success) {
                showNotification("error", data.message || "Unable to change variant.");
                select.value = oldVariantId;
                return;
            }

            window.location.reload();
        } catch (error) {
            console.error("Cart change variant error:", error);
            showNotification("error", "Unable to change variant.");
            select.value = oldVariantId;
        } finally {
            if (select.isConnected) {
                select.disabled = false;
            }
        }
    });
</script>

{{>user/footer}}