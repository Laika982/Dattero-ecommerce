{{>user/header}}
<main class="max-w-max-width mx-auto px-3 sm:px-6 md:px-8 pt-20 sm:pt-24 md:pt-28 pb-12 sm:pb-16 safe-bottom-padding">

        <div class="max-w-max-width mx-auto px-2 sm:px-4 mt-2 sm:mt-4">
        {{> user/notification}}
    </div>
    {{#if retryOrderId}}
    <div class="max-w-max-width mx-auto px-2 sm:px-4 mb-4">
      <div class="flex items-center gap-3 px-4 py-3 rounded-xl bg-amber-50 border border-amber-200 text-amber-900 text-sm shadow-xs">
        <span class="material-symbols-outlined text-[20px] text-amber-600">refresh</span>
        <span>Retrying payment for <strong>Order #{{retryOrderId}}</strong>. You can review your address, apply coupons, and choose a payment method to complete this order.</span>
      </div>
    </div>
    {{/if}}
<div class="flex flex-col lg:flex-row gap-8 relative items-start">
<!-- Left Column: Checkout Forms -->
<div class="w-full lg:w-2/3 flex flex-col gap-8">
<!-- Contact / Delivery Address Section -->
<section class="bg-surface-container-lowest p-6 rounded-2xl border border-outline-variant/30 apple-shadow relative transition-all duration-300" id="deliveryAddressSection">
  <input type="hidden" name="selectedAddressId" id="selectedAddressId" value="{{#if selectedAddress}}{{selectedAddress._id}}{{/if}}">
  <input type="hidden" id="checkoutRetryOrderId" value="{{#if retryOrderId}}{{retryOrderId}}{{/if}}">
  
  <div class="flex items-center justify-between pb-3 border-b border-outline-variant/20">
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-[18px] text-on-surface-variant">location_on</span>
      <span class="font-label-md text-xs font-semibold text-on-surface-variant uppercase tracking-wider">Deliver to:</span>
    </div>
    <button type="button" id="openAddressModalBtn" class="text-xs md:text-sm font-semibold text-accent-blue hover:underline hover:opacity-80 transition-opacity cursor-pointer flex items-center gap-1 group">
      <span>Change</span>
      <span class="material-symbols-outlined text-[15px] group-hover:translate-x-0.5 transition-transform">chevron_right</span>
    </button>
  </div>

  <!-- Active Selected Address Content -->
  <div id="selectedAddressContent" class="pt-4 {{#unless selectedAddress}}hidden{{/unless}}">
    <div class="flex items-center flex-wrap gap-2">
      <span id="displayFullName" class="font-headline-lg text-[16px] md:text-[18px] font-bold text-ink-black">{{selectedAddress.fullName}}</span>
      <span id="displayLabel" class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold tracking-wide uppercase bg-secondary-container text-on-secondary-container">
        {{#if selectedAddress.addressLabel}}{{selectedAddress.addressLabel}}{{else}}HOME{{/if}}
      </span>
      <span id="displayDefaultBadge" class="{{#unless selectedAddress.isDefault}}hidden{{/unless}} inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold tracking-wider uppercase bg-[#EBF3FE] text-accent-blue border border-accent-blue/20">
        DEFAULT
      </span>
    </div>
    <p id="displayAddress" class="font-body-md text-sm text-on-surface-variant leading-relaxed mt-1.5">
      {{selectedAddress.street}}{{#if selectedAddress.suite}}, {{selectedAddress.suite}}{{/if}}, {{selectedAddress.city}}, {{selectedAddress.state}} {{selectedAddress.zip}}, {{selectedAddress.country}}
    </p>
    <div class="flex items-center gap-1.5 text-sm font-medium text-ink-black mt-2.5">
      <span class="material-symbols-outlined text-[16px] text-on-surface-variant">call</span>
      <span id="displayPhone">{{selectedAddress.phone}}</span>
    </div>
  </div>

  <!-- Empty State when no address exists -->
  <div id="noAddressContent" class="pt-4 {{#if selectedAddress}}hidden{{/if}}">
    <div class="p-4 rounded-xl bg-surface-gray/60 border border-dashed border-outline-variant/40 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-secondary-container/40 flex items-center justify-center text-primary shrink-0">
          <span class="material-symbols-outlined text-[20px]">add_location</span>
        </div>
        <div>
          <p class="text-sm font-bold text-ink-black">No Delivery Address</p>

          <p class="text-xs text-on-surface-variant">Please choose or add an address to continue checkout.</p>
        </div>
      </div>
      <button type="button" id="selectAddressEmptyBtn" class="px-4 py-2 bg-ink-black text-white text-xs font-semibold rounded-lg hover:bg-ink-black/90 active:scale-95 transition-all shadow-sm cursor-pointer">
        Select Address
      </button>
    </div>
  </div>
</section>
<!-- Shipping Address -->
<section class="bg-surface-container-lowest p-6 md:p-8 rounded-2xl border border-outline-variant/30 apple-shadow relative flex flex-col gap-6">
  <div class="flex items-center justify-between border-b border-outline-variant/20 pb-4">
    <div class="flex items-center gap-3">
      <h2 class="font-headline-lg text-[22px] text-ink-black font-bold tracking-tight">Your Items in Order</h2>
      <span class="px-2.5 py-0.5 rounded-full bg-surface-gray border border-outline-variant/30 text-on-surface-variant font-label-md text-[11px] font-semibold tracking-wide">2 Items</span>
    </div>
    <span class="text-xs text-on-surface-variant hidden sm:inline">Review &amp; Edit</span>
  </div>

  <div class="flex flex-col gap-6">
    {{#each checkoutItems}}
    <!-- Product  -->
    <div class="flex flex-col sm:flex-row gap-4 sm:gap-5 pb-6 border-b border-outline-variant/20" data-cart-item data-variant-id="{{this.variantId}}" data-product-id="{{this.productId}}" data-category-id="{{this.categoryId}}" data-price="{{this.price}}" data-has-offer="{{this.hasOffer}}">
      <!-- Product Image -->
      <div class="w-20 h-20 md:w-24 md:h-24 rounded-lg overflow-hidden bg-white border border-outline-variant/20 flex-shrink-0 relative">
        <img class="w-full h-full object-cover" data-alt="{{this.product_name}}" src="{{this.image}}" alt="{{this.product_name}}">
      </div>
      <!-- Product Details & Controls -->
      <div class="flex-1 flex flex-col justify-between min-w-0 gap-2">
        <div>
          <div class="flex items-start justify-between gap-2">
            <h3 class="font-headline-lg text-[16px] font-semibold text-ink-black leading-snug">{{this.product_name}}</h3>
            <span class="font-headline-lg text-[16px] font-bold text-ink-black whitespace-nowrap">₹{{this.price}}</span>
          </div>
          <!-- Variant Selector Dropdown -->
          <div class="flex items-center flex-wrap gap-2 mt-1">
            <label class="sr-only" for="checkout-variant-select-{{this.variantId}}">Change Variant</label>
            <div class="relative inline-flex items-center">
              <select
                id="checkout-variant-select-{{this.variantId}}"
                data-change-variant
                data-current-variant-id="{{this.variantId}}"
                class="appearance-none bg-surface-gray hover:bg-surface-variant text-ink-black font-label-md text-[11px] sm:text-xs font-semibold py-1 pl-2.5 pr-6 rounded-lg border border-outline-variant/40 focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary transition-all cursor-pointer"
                aria-label="Change variant"
              >
                {{#each this.availableVariants}}
                  <option value="{{this.variantId}}" {{#if this.isCurrent}}selected{{/if}} {{#if this.isOutOfStock}}disabled{{/if}}>
                    {{this.weight}} - ₹{{this.price}}{{#if this.isOutOfStock}} (Out of stock){{/if}}
                  </option>
                {{/each}}
              </select>
            </div>
            <span class="text-[11px] text-on-surface-variant">SKU: {{this.sku}}</span>
          </div>
          <!-- Rating Row -->
          <div class="flex items-center gap-1.5 mt-1.5">
            <div class="flex items-center text-[#c89b3c] text-[13px]">
              <span class="material-symbols-outlined text-[15px] leading-none" style="font-variation-settings: 'FILL' 1;">star</span>
              <span class="font-label-md text-[12px] font-bold ml-1">4.9</span>
            </div>
            <span class="text-[11px] text-on-surface-variant">(128 reviews)</span>
          </div>
          <!-- Price & Discount -->
          <div class="flex items-center gap-2 mt-1.5">
            <span class="text-xs text-on-surface-variant">Item total: ₹{{this.item_total}}</span>
            {{!-- <span class="text-[10px] font-bold px-2 py-0.5 bg-[#fbd9c4] text-[#775d4d] rounded-full uppercase tracking-wider">-11% OFF</span> --}}
          </div>
        </div>
        <!-- Quantity Selector & Actions -->
          <div class="flex items-center justify-between pt-2">

            <div class="flex items-center border border-outline-variant/40 rounded-lg overflow-hidden bg-surface-gray/50">

              <button type="button" data-cart-action="decrease" aria-label="Decrease quantity" class="w-7 h-7 flex items-center justify-center hover:bg-surface-variant text-ink-black transition-colors text-sm font-semibold">-</button>

              <span data-cart-quantity class="w-8 text-center text-xs font-semibold text-ink-black">
                {{this.quantity}}
              </span>

              <button type="button" data-cart-action="increase" aria-label="Increase quantity" class="w-7 h-7 flex items-center justify-center hover:bg-surface-variant text-ink-black transition-colors text-sm font-semibold">+</button>

            </div>

            <button type="button" data-cart-action="remove" class="flex items-center gap-1 text-xs text-on-surface-variant hover:text-[#ba1a1a] transition-colors py-1 px-2">

              <span class="material-symbols-outlined text-[16px]">delete</span>

              <span class="">Remove</span>

            </button>

          </div>
        <!-- Delivery Info -->
        <div class="flex items-center gap-1.5 text-[11px] text-[#0071E3] font-medium pt-1 border-t border-outline-variant/10 mt-1">
          <span class="material-symbols-outlined text-[14px]">bolt</span>
          <span class="">Standard Delivery: Arrives in 2-4 business days | Free Shipping eligible</span>
        </div>
      </div>
    </div>
    {{/each}}
  </div>
</section>

<!-- Payment -->
<section class="bg-surface-container-lowest p-6 sm:p-8 rounded-2xl border border-outline-variant/30 apple-shadow relative">
  <div class="flex items-center justify-between mb-5">
    <div>
      <h2 class="font-headline-lg text-[22px] sm:text-[24px] font-bold text-ink-black tracking-tight">Payment Method</h2>
      <p class="text-xs text-on-surface-variant mt-0.5">Select how you want to pay for this order</p>
    </div>
    <div class="flex items-center gap-1.5 text-xs text-on-surface-variant bg-surface-gray/80 px-3 py-1.5 rounded-full border border-outline-variant/20 shadow-xs">
      <span class="material-symbols-outlined text-[16px] text-primary">verified_user</span>
      <span class="font-medium">100% Secure</span>
    </div>
  </div>

  <div class="flex flex-col gap-3">
    <!-- Wallet Option -->
    <label id="paymentCardWallet" class="payment-option-card flex flex-col p-4 sm:p-5 border-2 border-outline-variant/40 rounded-2xl cursor-pointer hover:border-primary/60 transition-all relative group bg-surface-container-lowest">
      <div class="flex items-start sm:items-center justify-between gap-3">
        <div class="flex items-start sm:items-center gap-3.5">
          <div class="mt-0.5 sm:mt-0 flex items-center justify-center">
            <input class="w-5 h-5 text-primary focus:ring-primary border-outline-variant/60 cursor-pointer" name="payment" type="radio" value="wallet" id="payment-wallet">
          </div>
          <div class="flex flex-col">
            <div class="flex items-center flex-wrap gap-2">
              <span class="font-headline-lg text-[16px] font-bold text-ink-black">Wallet</span>
              <span id="walletBadge" class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                ₹{{wallet.balance}} available
              </span>
            </div>
            <p class="text-xs text-on-surface-variant mt-0.5">Instant checkout using your Dattero wallet balance</p>
          </div>
        </div>
        <div class="flex items-center gap-2.5 shrink-0">
          <button type="button" id="headerAddFundsBtn" onclick="event.stopPropagation();" class="text-xs font-semibold text-accent-blue hover:underline hidden sm:inline-flex items-center gap-0.5 py-1 px-2 rounded-md hover:bg-surface-gray transition-colors cursor-pointer">
            <span class="material-symbols-outlined text-[15px]">add_circle</span> Add Funds
          </button>
          <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center text-primary">
            <span class="material-symbols-outlined text-[22px]">account_balance_wallet</span>
          </div>
        </div>
      </div>

      <!-- Dynamic Wallet Breakdown / Warning -->
      <div id="walletDetailsBox" class="mt-3.5 pt-3.5 border-t border-outline-variant/20 hidden">
        <div id="walletSufficientMsg" class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 text-xs text-on-surface-variant bg-surface-gray/60 p-3 rounded-xl border border-outline-variant/20">
          <span class="flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[16px] text-emerald-600">check_circle</span>
            Sufficient balance to complete this order
          </span>
          <span class="font-medium text-ink-black">Remaining balance: <strong class="text-emerald-700 font-bold" id="walletRemainingBalance">₹0.00</strong></span>
        </div>
        <div id="walletInsufficientMsg" class="hidden flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 p-3.5 rounded-xl bg-amber-50/90 border border-amber-200/80 text-amber-900 text-xs shadow-xs">
          <div class="flex items-start sm:items-center gap-2 min-w-0">
            <span class="material-symbols-outlined text-[18px] text-amber-600 shrink-0 mt-0.5 sm:mt-0">warning</span>
            <span>Insufficient balance. You need <strong id="walletDeficitAmount" class="font-bold">₹0.00</strong> more to pay using wallet.</span>
          </div>
          <div class="flex items-center gap-2 shrink-0 w-full sm:w-auto justify-end">
            <button type="button" id="payWalletDeficitBtn" onclick="event.stopPropagation();" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-700 hover:bg-emerald-800 active:scale-95 text-white font-semibold text-xs transition-all shadow-xs cursor-pointer">
              <span class="material-symbols-outlined text-[15px]">bolt</span> Pay Balance (<span id="payDeficitBtnAmount">₹0.00</span>)
            </button>
            <button type="button" id="openWalletTopupBtn" onclick="event.stopPropagation();" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-ink-black text-white font-semibold text-xs hover:bg-ink-black/90 active:scale-95 transition-all shadow-xs cursor-pointer">
              <span class="material-symbols-outlined text-[14px]">payments</span> Top up Wallet
            </button>
          </div>
        </div>
      </div>
    </label>

    <!-- UPI Option -->
    <label id="paymentCardUpi" class="payment-option-card flex items-center justify-between p-4 sm:p-5 border-2 border-outline-variant/40 rounded-2xl cursor-pointer hover:border-primary/60 transition-all relative group bg-surface-container-lowest">
      <div class="flex items-center gap-3.5">
        <div class="flex items-center justify-center">
          <input class="w-5 h-5 text-primary focus:ring-primary border-outline-variant/60 cursor-pointer" name="payment" type="radio" value="upi" id="payment-upi">
        </div>
        <div class="flex flex-col">
          <div class="flex items-center gap-2">
            <span class="font-headline-lg text-[16px] font-bold text-ink-black">UPI / Cards / Net Banking</span>
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold tracking-wider uppercase bg-[#EBF3FE] text-accent-blue border border-accent-blue/20">Popular</span>
          </div>
          <p class="text-xs text-on-surface-variant mt-0.5">Pay via Razorpay, Google Pay, PhonePe, Paytm, or Credit/Debit Cards</p>
        </div>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <div class="w-10 h-10 rounded-xl bg-surface-gray flex items-center justify-center text-on-surface-variant">
          <span class="material-symbols-outlined text-[22px]">qr_code_scanner</span>
        </div>
      </div>
    </label>

    <!-- COD Option -->
    <label id="paymentCardCod" class="payment-option-card flex items-center justify-between p-4 sm:p-5 border-2 border-outline-variant/40 rounded-2xl cursor-pointer hover:border-primary/60 transition-all relative group bg-surface-container-lowest">
      <div class="flex items-center gap-3.5">
        <div class="flex items-center justify-center">
          <input class="w-5 h-5 text-primary focus:ring-primary border-outline-variant/60 cursor-pointer" name="payment" type="radio" value="cod" id="payment-cod">
        </div>
        <div class="flex flex-col">
          <span class="font-headline-lg text-[16px] font-bold text-ink-black">Cash on Delivery (COD)</span>
          <p class="text-xs text-on-surface-variant mt-0.5">Pay with cash upon delivery of your order</p>
        </div>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <div class="w-10 h-10 rounded-xl bg-surface-gray flex items-center justify-center text-on-surface-variant">
          <span class="material-symbols-outlined text-[22px]">payments</span>
        </div>
      </div>
    </label>
  </div>
</section>
<div class="flex items-center justify-center gap-2 text-on-surface-variant font-body-md text-body-md mt-6 mb-8">
<span class="material-symbols-outlined" style="font-size: 18px;">lock</span>
                    All transactions are secure and encrypted.
                </div>
</div>
<!-- Right Column: Order Summary (Sticky on Desktop) -->
<div class="w-full lg:w-1/3">
<div class="bg-surface-container-lowest p-5 sm:p-7 rounded-2xl border border-outline-variant/30 apple-shadow flex flex-col gap-5 sm:gap-6 lg:sticky lg:top-24"><div class="flex items-center justify-between border-b border-outline-variant/20 pb-4"><h2 class="font-headline-lg text-[18px] sm:text-[20px] font-bold text-ink-black tracking-tight">Order Summary</h2><span class="px-2.5 py-0.5 rounded-full bg-surface-gray border border-outline-variant/30 text-on-surface-variant font-label-md text-[11px] font-semibold tracking-wide">{{checkoutItems.length}} Items</span></div>
<div class="flex flex-col gap-3 py-2 border-b border-outline-variant/20"><button type="button" class="inline-flex items-center gap-2 text-accent-blue hover:opacity-80 transition-opacity text-left group"><span class="material-symbols-outlined text-[18px]">sell</span><span class="font-label-md text-xs font-semibold tracking-wide">View Available Offers</span></button><div class="flex gap-2 items-center w-full mt-1"><input class="form-input-premium flex-1 rounded-lg px-3.5 py-2 font-body-md text-sm text-on-surface min-w-0" placeholder="Gift card or discount code" type="text" value="{{#if appliedCoupon}}{{appliedCoupon.code}}{{/if}}"><button type="button" class="bg-surface-gray text-ink-black border border-outline-variant/40 px-3 sm:px-4 py-2 rounded-lg font-label-md text-xs font-semibold hover:bg-surface-variant transition-colors flex-shrink-0 touch-target">Apply</button></div></div><div class="flex flex-col gap-2 py-1"><div class="flex justify-between items-center py-1 text-sm text-on-surface-variant"><span class="font-body-md">Subtotal</span><span class="font-medium text-ink-black">₹{{totals.subtotal}}</span></div>
<div class="flex justify-between items-center py-1 text-sm text-on-surface-variant"><span class="font-body-md">Shipping</span><span class="font-medium text-ink-black">₹{{totals.shipping}}</span></div>
<div class="flex justify-between items-center py-1 text-sm text-on-surface-variant"><span class="font-body-md">Estimated Taxes</span><span class="font-medium text-ink-black">₹{{totals.tax}}</span></div>
<div class="flex justify-between items-baseline pt-4 mt-2 border-t border-outline-variant/20"><span class="font-headline-lg text-[18px] font-bold text-ink-black">Total</span><span class="font-headline-lg text-[22px] sm:text-[24px] font-bold text-ink-black">₹{{totals.finalAmount}}</span></div></div><div class="flex flex-col gap-2 mt-1">
<button type="button" id="placeOrderBtn" class="w-full bg-ink-black text-white font-label-md text-[15px] font-semibold py-3.5 px-6 rounded-xl hover:bg-ink-black/90 transition-all flex items-center justify-center gap-2 active:scale-95 shadow-sm touch-target">Place Order <span class="material-symbols-outlined text-[18px]">arrow_forward</span></button>
</div></div>

</div>
</div>
</main>

<dialog id="couponOffersDialog" class="w-[calc(100%-2rem)] max-w-xl rounded-2xl border-0 p-0 shadow-2xl backdrop:bg-black/50 m-auto">
  <div class="bg-surface-container-lowest rounded-2xl overflow-hidden">
    <div class="flex items-center justify-between gap-4 p-5 sm:p-6 border-b border-outline-variant/20">
      <div>
        <h2 class="font-headline-lg text-xl font-bold text-ink-black">Available offers</h2>
        <p class="text-sm text-on-surface-variant mt-1">Coupons available for your account.</p>
      </div>
      <button type="button" id="closeCouponOffers" class="w-9 h-9 rounded-full hover:bg-surface-gray text-on-surface-variant flex items-center justify-center transition-colors" aria-label="Close offers">
        <span class="material-symbols-outlined">close</span>
      </button>
    </div>
    <div class="max-h-[65vh] overflow-y-auto p-4 sm:p-6 space-y-3" id="couponOffersList">
      {{#each availableCoupons}}
      <article class="border border-outline-variant/30 rounded-xl p-4 flex gap-3 items-start transition-all {{#unless this.eligible}}opacity-75 bg-surface-gray/30{{/unless}}" data-coupon-card data-code="{{this.code}}">
        <span class="material-symbols-outlined text-primary mt-0.5">sell</span>
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div class="flex flex-wrap items-center gap-2">
              <span class="font-bold text-ink-black">{{this.code}}</span>
              <span class="text-sm font-semibold text-green-700">{{this.discountLabel}}</span>
            </div>
            {{#if this.eligible}}
            <button type="button" data-apply-coupon="{{this.code}}" class="bg-ink-black text-white hover:bg-ink-black/90 px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-colors shadow-xs active:scale-95 touch-target">Apply</button>
            {{else}}
            <button type="button" disabled class="bg-surface-gray text-on-surface-variant/50 border border-outline-variant/30 px-3.5 py-1.5 rounded-lg text-xs font-semibold cursor-not-allowed">Apply</button>
            {{/if}}
          </div>
          {{#if this.restrictionLabel}}
          <p class="text-xs text-accent-blue font-medium mt-1">{{this.restrictionLabel}}</p>
          {{/if}}
          <p class="text-sm text-on-surface-variant mt-1">Minimum purchase: ₹{{this.minimumPurchase}}</p>
          <p class="text-xs text-on-surface-variant mt-1">Expires {{this.expiryLabel}}</p>
          {{#if this.eligible}}
          <div class="flex items-center gap-1.5 mt-2 text-xs font-semibold text-green-700">
            <span class="material-symbols-outlined text-[15px]">check_circle</span>
            <span>Available for this order</span>
          </div>
          {{else}}
          <div class="flex items-center gap-1.5 mt-2 text-xs font-medium text-amber-700">
            <span class="material-symbols-outlined text-[15px]">info</span>
            <span>{{this.reason}}</span>
          </div>
          {{/if}}
        </div>
      </article>
      {{else}}
      <div class="py-10 text-center">
        <span class="material-symbols-outlined text-3xl text-on-surface-variant">confirmation_number</span>
        <p class="font-semibold text-ink-black mt-2">No available coupons</p>
        <p class="text-sm text-on-surface-variant mt-1">Check back later for new offers.</p>
      </div>
      {{/each}}
    </div>
  </div>
</dialog>

<!-- Checkout Wallet Top-up Modal Dialog -->
<dialog id="checkoutTopupDialog" class="w-[calc(100%-2rem)] max-w-md rounded-3xl border-0 p-0 shadow-2xl backdrop:bg-black/60 m-auto overflow-hidden">
  <div class="bg-surface-container-lowest rounded-3xl overflow-hidden border border-outline-variant/30 flex flex-col">
