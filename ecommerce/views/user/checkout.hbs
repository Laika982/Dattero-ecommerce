          <button type="button" class="preset-chip px-3 py-1.5 text-xs font-medium rounded-lg bg-surface-gray hover:bg-surface-variant text-ink-black border border-outline-variant/30 transition-colors cursor-pointer" data-amount="1000">₹1,000</button>
