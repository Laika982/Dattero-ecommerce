{{>user/header}}
<main class="max-w-max-width mx-auto px-container-padding py-section-gap-mobile md:py-[80px]">

        <div class="max-w-max-width mx-auto px-container-padding mt-6">
        {{> user/notification}}
    </div>
<div class="flex flex-col lg:flex-row gap-8 relative items-start">
<!-- Left Column: Checkout Forms -->
<div class="w-full lg:w-2/3 flex flex-col gap-8">
<!-- Contact / Delivery Address Section -->
<section class="bg-surface-container-lowest p-6 rounded-2xl border border-outline-variant/30 apple-shadow relative transition-all duration-300" id="deliveryAddressSection">
  <input type="hidden" name="selectedAddressId" id="selectedAddressId" value="{{#if selectedAddress}}{{selectedAddress._id}}{{/if}}">
  
  <div class="flex items-center justify-between pb-3 border-b border-outline-variant/20">
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-[18px] text-on-surface-variant">location_on</span>
      <span class="font-label-md text-xs font-semibold text-on-surface-variant uppercase tracking-wider">Deliver to:</span>
    </div>
    <button type="button" id="openAddressModalBtn" class="text-xs md:text-sm font-semibold text-accent-blue hover:underline hover:opacity-80 transition-opacity cursor-pointer flex items-center gap-1 group">
      <span>Change</span>
      <span class="material-symbols-outlined text-[15px] group-hover:translate-x-0.5 transition-transform">chevron_right</span>
    </button>
  </div>

  <!-- Active Selected Address Content -->
  <div id="selectedAddressContent" class="pt-4 {{#unless selectedAddress}}hidden{{/unless}}">
    <div class="flex items-center flex-wrap gap-2">
      <span id="displayFullName" class="font-headline-lg text-[16px] md:text-[18px] font-bold text-ink-black">{{selectedAddress.fullName}}</span>
      <span id="displayLabel" class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold tracking-wide uppercase bg-secondary-container text-on-secondary-container">
        {{#if selectedAddress.addressLabel}}{{selectedAddress.addressLabel}}{{else}}HOME{{/if}}
      </span>
      <span id="displayDefaultBadge" class="{{#unless selectedAddress.isDefault}}hidden{{/unless}} inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold tracking-wider uppercase bg-[#EBF3FE] text-accent-blue border border-accent-blue/20">
        DEFAULT
      </span>
    </div>
    <p id="displayAddress" class="font-body-md text-sm text-on-surface-variant leading-relaxed mt-1.5">
      {{selectedAddress.street}}{{#if selectedAddress.suite}}, {{selectedAddress.suite}}{{/if}}, {{selectedAddress.city}}, {{selectedAddress.state}} {{selectedAddress.zip}}, {{selectedAddress.country}}
    </p>
    <div class="flex items-center gap-1.5 text-sm font-medium text-ink-black mt-2.5">
      <span class="material-symbols-outlined text-[16px] text-on-surface-variant">call</span>
      <span id="displayPhone">{{selectedAddress.phone}}</span>
    </div>
  </div>

  <!-- Empty State when no address exists -->
  <div id="noAddressContent" class="pt-4 {{#if selectedAddress}}hidden{{/if}}">
    <div class="p-4 rounded-xl bg-surface-gray/60 border border-dashed border-outline-variant/40 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-secondary-container/40 flex items-center justify-center text-primary shrink-0">
          <span class="material-symbols-outlined text-[20px]">add_location</span>
        </div>
        <div>
          <p class="text-sm font-bold text-ink-black">No Delivery Address</p>
          <p class="text-xs text-on-surface-variant">Please choose or add an address to continue checkout.</p>
        </div>
      </div>
      <button type="button" id="selectAddressEmptyBtn" class="px-4 py-2 bg-ink-black text-white text-xs font-semibold rounded-lg hover:bg-ink-black/90 active:scale-95 transition-all shadow-sm cursor-pointer">
        Select Address
      </button>
    </div>
  </div>
</section>
<!-- Shipping Address -->
<section class="bg-surface-container-lowest p-6 md:p-8 rounded-2xl border border-outline-variant/30 apple-shadow relative flex flex-col gap-6">
  <div class="flex items-center justify-between border-b border-outline-variant/20 pb-4">
    <div class="flex items-center gap-3">
      <h2 class="font-headline-lg text-[22px] text-ink-black font-bold tracking-tight">Your Items in Order</h2>
      <span class="px-2.5 py-0.5 rounded-full bg-surface-gray border border-outline-variant/30 text-on-surface-variant font-label-md text-[11px] font-semibold tracking-wide">2 Items</span>
    </div>
    <span class="text-xs text-on-surface-variant hidden sm:inline">Review &amp; Edit</span>
  </div>

  <div class="flex flex-col gap-6">
    {{#each checkoutItems}}
    <!-- Product  -->
    <div class="flex flex-col sm:flex-row gap-4 sm:gap-5 pb-6 border-b border-outline-variant/20" data-cart-item data-variant-id="{{this.variantId}}">
      <!-- Product Image -->
      <div class="w-20 h-20 md:w-24 md:h-24 rounded-lg overflow-hidden bg-white border border-outline-variant/20 flex-shrink-0 relative">
        <img class="w-full h-full object-cover" data-alt="{{this.product_name}}" src="{{this.image}}" alt="{{this.product_name}}">
      </div>
      <!-- Product Details & Controls -->
      <div class="flex-1 flex flex-col justify-between min-w-0 gap-2">
        <div>
          <div class="flex items-start justify-between gap-2">
            <h3 class="font-headline-lg text-[16px] font-semibold text-ink-black leading-snug">{{this.product_name}}</h3>
            <span class="font-headline-lg text-[16px] font-bold text-ink-black whitespace-nowrap">₹{{this.price}}</span>
          </div>
          <p class="font-body-md text-[12px] text-on-surface-variant mt-0.5">{{this.weight}} • SKU: {{this.sku}}</p>
          <!-- Rating Row -->
          <div class="flex items-center gap-1.5 mt-1.5">
            <div class="flex items-center text-[#c89b3c] text-[13px]">
              <span class="material-symbols-outlined text-[15px] leading-none" style="font-variation-settings: 'FILL' 1;">star</span>
              <span class="font-label-md text-[12px] font-bold ml-1">4.9</span>
            </div>
            <span class="text-[11px] text-on-surface-variant">(128 reviews)</span>
          </div>
          <!-- Price & Discount -->
          <div class="flex items-center gap-2 mt-1.5">
            <span class="text-xs text-on-surface-variant">Item total: ₹{{this.item_total}}</span>
            {{!-- <span class="text-[10px] font-bold px-2 py-0.5 bg-[#fbd9c4] text-[#775d4d] rounded-full uppercase tracking-wider">-11% OFF</span> --}}
          </div>
        </div>
        <!-- Quantity Selector & Actions -->
          <div class="flex items-center justify-between pt-2">

            <div class="flex items-center border border-outline-variant/40 rounded-lg overflow-hidden bg-surface-gray/50">

              <button type="button" data-cart-action="decrease" aria-label="Decrease quantity" class="w-7 h-7 flex items-center justify-center hover:bg-surface-variant text-ink-black transition-colors text-sm font-semibold">-</button>

              <span data-cart-quantity class="w-8 text-center text-xs font-semibold text-ink-black">
                {{this.quantity}}
              </span>

              <button type="button" data-cart-action="increase" aria-label="Increase quantity" class="w-7 h-7 flex items-center justify-center hover:bg-surface-variant text-ink-black transition-colors text-sm font-semibold">+</button>

            </div>

            <button type="button" data-cart-action="remove" class="flex items-center gap-1 text-xs text-on-surface-variant hover:text-[#ba1a1a] transition-colors py-1 px-2">

              <span class="material-symbols-outlined text-[16px]">delete</span>

              <span class="">Remove</span>

            </button>

          </div>
        <!-- Delivery Info -->
        <div class="flex items-center gap-1.5 text-[11px] text-[#0071E3] font-medium pt-1 border-t border-outline-variant/10 mt-1">
          <span class="material-symbols-outlined text-[14px]">bolt</span>
          <span class="">Standard Delivery: Arrives in 2-4 business days | Free Shipping eligible</span>
        </div>
      </div>
    </div>
    {{/each}}
  </div>
</section>

