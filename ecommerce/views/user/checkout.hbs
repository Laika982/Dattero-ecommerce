<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
document.addEventListener('DOMContentLoaded', () => {
  const placeOrderButton = document.getElementById('placeOrderBtn');
  const couponOffersDialog = document.getElementById('couponOffersDialog');
  const viewOffersButton = [...document.querySelectorAll('button')]
    .find((button) => button.textContent.includes('View Available Offers'));
  const couponInput = document.querySelector('input[placeholder="Gift card or discount code"]');
  const couponApplyButton = couponInput?.parentElement.querySelector('button');
  const totalLabel = [...document.querySelectorAll('span')]
    .find((element) => element.textContent.trim() === 'Total');
  const totalValue = totalLabel?.nextElementSibling;
  const totalRow = totalLabel?.parentElement;
  const couponRow = couponInput?.parentElement;
  const baseFinalAmount = Number('{{totals.baseFinalAmount}}') || Number((totalValue?.textContent || '').replace(/[^\d.]/g, ''));
  let appliedCouponCode = '{{#if appliedCoupon}}{{appliedCoupon.code}}{{/if}}';
  const initialCouponDiscount = Number('{{#if couponDiscount}}{{couponDiscount}}{{else}}0{{/if}}');
  const retryOrderId = document.getElementById('checkoutRetryOrderId')?.value || undefined;

  let rawWalletBalance = Number('{{wallet.rawBalance}}' || '{{wallet.balance}}' || 0);
  const walletBadge = document.getElementById('walletBadge');
  const walletDetailsBox = document.getElementById('walletDetailsBox');
  const walletSufficientMsg = document.getElementById('walletSufficientMsg');
  const walletInsufficientMsg = document.getElementById('walletInsufficientMsg');
  const walletRemainingBalance = document.getElementById('walletRemainingBalance');
  const walletDeficitAmount = document.getElementById('walletDeficitAmount');
  const payDeficitBtnAmount = document.getElementById('payDeficitBtnAmount');
  const paymentCards = document.querySelectorAll('.payment-option-card');
  const paymentRadios = document.querySelectorAll('input[name="payment"]');

  const ensureRazorpay = () => new Promise((resolve, reject) => {
    if (window.Razorpay) return resolve(window.Razorpay);
    const existingScript = document.querySelector('script[src*="checkout.razorpay.com"]');
    if (existingScript) {
      existingScript.addEventListener('load', () => resolve(window.Razorpay));
      existingScript.addEventListener('error', () => reject(new Error('Failed to load Razorpay payment gateway.')));
      return;
    }
    const script = document.createElement('script');
    script.src = 'https://checkout.razorpay.com/v1/checkout.js';
    script.async = true;
    script.onload = () => resolve(window.Razorpay);
    script.onerror = () => reject(new Error('Failed to load Razorpay payment gateway. Please check your connection.'));
    document.head.appendChild(script);
  });

  const getCurrentFinalAmount = () => {
    return Number((totalValue?.textContent || '').replace(/[^\d.]/g, '')) || 0;
  };

  window.handleSimulatePaymentFailure = async function() {
    const addressRadio = document.querySelector('input[name="address"]:checked');
    const addressId = addressRadio ? addressRadio.value : (savedSelectedAddressId || null);
    if (!addressId) {
      showNotification('error', 'Please select a delivery address first.');
      return;
    }
    const btn = document.getElementById('simulateFailBtn');
    if (btn) {
      btn.classList.add('animate-pulse');
      btn.innerText = 'Recording failed order...';
      btn.disabled = true;
    }
    try {
      const response = await fetch('/order/place', {
        method: 'POST',
        headers: {
          Accept: 'application/json',
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          addressId,
          paymentMethod: 'upi',
          couponCode: appliedCouponCode,
          paymentStatus: 'failed',
          failureReason: 'Payment simulated failure',
          retryOrderId: document.getElementById('checkoutRetryOrderId')?.value || undefined,
        }),
      });
      const data = await response.json();
      if (data.success && data.orderId) {
        window.location.href = `/payment/failed?orderId=${encodeURIComponent(data.orderId)}`;
        return;
      }
    } catch (e) {
      console.error('Simulation failure error:', e);
    }
    window.location.href = '/payment/failed';
  };

  const updatePaymentUI = () => {
    const currentTotal = getCurrentFinalAmount();
    const hasEnoughBalance = rawWalletBalance >= currentTotal;

    if (walletBadge) {
      if (hasEnoughBalance) {
        walletBadge.className = 'inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200';
        walletBadge.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>₹${rawWalletBalance.toFixed(2)} available`;
        walletSufficientMsg?.classList.remove('hidden');
        walletInsufficientMsg?.classList.add('hidden');
        if (walletRemainingBalance) {
          walletRemainingBalance.textContent = `₹${Math.max(0, rawWalletBalance - currentTotal).toFixed(2)}`;
        }
      } else {
        const deficit = currentTotal - rawWalletBalance;
        walletBadge.className = 'inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-amber-50 text-amber-700 border border-amber-200';
        walletBadge.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>₹${rawWalletBalance.toFixed(2)} available`;
        walletSufficientMsg?.classList.add('hidden');
        walletInsufficientMsg?.classList.remove('hidden');
        if (walletDeficitAmount) {
          walletDeficitAmount.textContent = `₹${deficit.toFixed(2)}`;
        }
        if (payDeficitBtnAmount) {
          payDeficitBtnAmount.textContent = `₹${deficit.toFixed(2)}`;
        }
      }
    }

    paymentCards.forEach((card) => {
      const radio = card.querySelector('input[name="payment"]');
      if (radio && radio.checked) {
        card.classList.add('border-primary', 'bg-primary-fixed/15', 'ring-2', 'ring-primary/20');
        card.classList.remove('border-outline-variant/40');
      } else {
        card.classList.remove('border-primary', 'bg-primary-fixed/15', 'ring-2', 'ring-primary/20');
        card.classList.add('border-outline-variant/40');
      }
    });

    const selectedPayment = document.querySelector('input[name="payment"]:checked')?.value;
    if (selectedPayment === 'wallet') {
      walletDetailsBox?.classList.remove('hidden');
    } else {
      walletDetailsBox?.classList.add('hidden');
    }
  };

  paymentRadios.forEach((radio) => {
    radio.addEventListener('change', updatePaymentUI);
  });

  paymentCards.forEach((card) => {
    card.addEventListener('click', (e) => {
      if (e.target.closest('a') || e.target.closest('button')) return;
      const radio = card.querySelector('input[name="payment"]');
      if (radio && !radio.checked) {
        radio.checked = true;
        updatePaymentUI();
      }
    });
  });

  updatePaymentUI();

  // Top Up Wallet Modal & Balance Payment Logic (In-Checkout)
  const topupDialog = document.getElementById('checkoutTopupDialog');
  const topupAmountInput = document.getElementById('checkoutTopupAmount');
  const submitTopupBtn = document.getElementById('submitCheckoutTopup');
  const submitTopupText = document.getElementById('submitCheckoutTopupText');
  const topupError = document.getElementById('checkoutTopupError');
  const presetExactDeficitBtn = document.getElementById('presetExactDeficitBtn');
  const presetExactDeficitAmount = document.getElementById('presetExactDeficitAmount');

  const openCheckoutTopupModal = (defaultAmt = null) => {
    const currentTotal = getCurrentFinalAmount();
    const deficit = Math.max(0, currentTotal - rawWalletBalance);
    const orderTotalEl = document.getElementById('topupModalOrderTotal');
    const currentBalanceEl = document.getElementById('topupModalCurrentBalance');
    const deficitEl = document.getElementById('topupModalDeficit');

    if (orderTotalEl) orderTotalEl.textContent = `₹${currentTotal.toFixed(2)}`;
    if (currentBalanceEl) currentBalanceEl.textContent = `₹${rawWalletBalance.toFixed(2)}`;
    if (deficitEl) deficitEl.textContent = `₹${deficit.toFixed(2)}`;
    if (presetExactDeficitAmount) presetExactDeficitAmount.textContent = `₹${deficit.toFixed(2)}`;

    if (presetExactDeficitBtn) {
      if (deficit > 0) {
        presetExactDeficitBtn.classList.remove('hidden');
      } else {
        presetExactDeficitBtn.classList.add('hidden');
      }
    }

    let initialAmt = defaultAmt;
    if (initialAmt === null || initialAmt === undefined) {
      initialAmt = deficit > 0 ? Math.max(1, Math.round(deficit * 100) / 100) : 500;
    }

    if (topupAmountInput) {
      topupAmountInput.value = initialAmt.toFixed(2);
    }
    if (submitTopupText) {
      submitTopupText.textContent = `Pay ₹${initialAmt.toFixed(2)} & Top Up`;
    }
    if (topupError) {
      topupError.textContent = '';
      topupError.classList.add('hidden');
    }

    if (topupDialog && typeof topupDialog.showModal === 'function') {
      topupDialog.showModal();
      topupAmountInput?.focus();
    }
  };

  topupAmountInput?.addEventListener('input', () => {
    const val = Number(topupAmountInput.value);
    if (submitTopupText) {
      submitTopupText.textContent = Number.isFinite(val) && val > 0
        ? `Pay ₹${val.toFixed(2)} & Top Up`
        : 'Pay & Top Up';
    }
  });

  topupAmountInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      submitTopupBtn?.click();
    }
  });

  presetExactDeficitBtn?.addEventListener('click', () => {
    const currentTotal = getCurrentFinalAmount();
    const deficit = Math.max(0, currentTotal - rawWalletBalance);
    const exactAmt = Math.max(1, Math.round(deficit * 100) / 100);
    if (topupAmountInput) {
      topupAmountInput.value = exactAmt.toFixed(2);
      topupAmountInput.dispatchEvent(new Event('input'));
    }
  });

  document.querySelectorAll('#checkoutTopupPresets .preset-chip').forEach((btn) => {
    btn.addEventListener('click', () => {
      const amt = Number(btn.dataset.amount || 0);
      if (amt > 0 && topupAmountInput) {
        topupAmountInput.value = amt.toFixed(2);
        topupAmountInput.dispatchEvent(new Event('input'));
      }
    });
  });

  document.getElementById('closeCheckoutTopup')?.addEventListener('click', () => topupDialog?.close());
  document.getElementById('cancelCheckoutTopup')?.addEventListener('click', () => topupDialog?.close());
  topupDialog?.addEventListener('click', (e) => {
    if (e.target === topupDialog) topupDialog.close();
  });

  document.getElementById('headerAddFundsBtn')?.addEventListener('click', (e) => {
    e.stopPropagation();
    openCheckoutTopupModal();
  });

  document.getElementById('openWalletTopupBtn')?.addEventListener('click', (e) => {
    e.stopPropagation();
    openCheckoutTopupModal();
  });

  let isWalletTopUpProcessing = false;
  const processWalletTopUp = async (amount, triggerBtn) => {
    if (isWalletTopUpProcessing) return;

    const numAmount = Math.round(Number(amount) * 100) / 100;
    if (!Number.isFinite(numAmount) || numAmount < 1 || numAmount > 50000) {
      showNotification('error', 'Please enter an amount between ₹1 and ₹50,000.');
      return;
    }

    isWalletTopUpProcessing = true;
    const originalBtnHtml = triggerBtn ? triggerBtn.innerHTML : null;
    if (triggerBtn) {
      triggerBtn.disabled = true;
      triggerBtn.innerHTML = `
        <span class="inline-block w-3.5 h-3.5 border-2 border-current border-t-transparent rounded-full animate-spin"></span>
        <span>Processing...</span>
      `;
    }

    const resetBtnState = () => {
      isWalletTopUpProcessing = false;
      if (triggerBtn) {
        triggerBtn.disabled = false;
        if (originalBtnHtml) triggerBtn.innerHTML = originalBtnHtml;
      }
    };

    try {
      const RazorpayClass = await ensureRazorpay();
      if (!RazorpayClass) {
        throw new Error('Payment gateway failed to load. Please check your internet connection.');
      }

      const orderResponse = await fetch('/wallet/top-up/create-order', {
        method: 'POST',
        headers: {
          Accept: 'application/json',
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ amount: numAmount }),
      });
      const orderResult = await orderResponse.json();

      if (!orderResponse.ok || !orderResult.success) {
        throw new Error(orderResult.message || 'Unable to start wallet top-up.');
      }

      topupDialog?.close();

      let topupFailed = false;

      const checkout = new RazorpayClass({
        key: orderResult.key,
        amount: orderResult.order.amount,
        currency: orderResult.order.currency,
        name: 'Nutri Burfi',
        description: 'Wallet top-up for checkout',
        order_id: orderResult.order.id,
        retry: { enabled: false },
        prefill: orderResult.prefill,
        theme: { color: '#7b5900' },
        modal: {
          confirm_close: false,
          ondismiss: () => {
            resetBtnState();
            if (!topupFailed) {
              showNotification('info', 'Wallet top-up checkout closed.');
            }
          },
        },
        handler: async (payment) => {
          try {
            showNotification('info', 'Verifying wallet payment...');
            const verifyResponse = await fetch('/wallet/top-up/verify', {
              method: 'POST',
              headers: {
                Accept: 'application/json',
                'Content-Type': 'application/json',
              },
              body: JSON.stringify(payment),
            });
            const verifyResult = await verifyResponse.json();

            if (!verifyResponse.ok || !verifyResult.success) {
              throw new Error(verifyResult.message || 'Wallet payment verification failed.');
            }

            rawWalletBalance = typeof verifyResult.balance === 'number'
              ? verifyResult.balance
              : (rawWalletBalance + numAmount);

            const walletRadio = document.getElementById('payment-wallet');
            if (walletRadio) {
              walletRadio.checked = true;
            }

            updatePaymentUI();
            showNotification('success', `₹${numAmount.toFixed(2)} added to your wallet! You can now place your order.`);
          } catch (verifyErr) {
            console.error('Wallet verification error:', verifyErr);
            showNotification('error', verifyErr.message || 'Unable to verify wallet payment.');
          } finally {
            resetBtnState();
          }
        },
      });

      checkout.on('payment.failed', (event) => {
        topupFailed = true;
        const failReason = event.error?.description || event.error?.reason || 'Wallet top-up payment failed';
        try {
          fetch('/wallet/failed', {
            method: 'POST',
            headers: {
              Accept: 'application/json',
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              razorpay_order_id: event.error?.metadata?.order_id || orderResult.order.id,
              reason: failReason,
            }),
            keepalive: true,
          }).catch(() => {});
        } catch (e) {}

        showNotification('error', `Wallet top-up failed: ${failReason}`);
        resetBtnState();
      });

      checkout.open();
    } catch (err) {
      console.error('Top-up error:', err);
      showNotification('error', err.message || 'Unable to initiate wallet top-up.');
      resetBtnState();
    }
  };

  document.getElementById('payWalletDeficitBtn')?.addEventListener('click', (e) => {
    e.stopPropagation();
    const currentTotal = getCurrentFinalAmount();
    const deficit = Math.max(0, currentTotal - rawWalletBalance);
    const amountToPay = Math.max(1, Math.round(deficit * 100) / 100);
    processWalletTopUp(amountToPay, document.getElementById('payWalletDeficitBtn'));
  });

  submitTopupBtn?.addEventListener('click', () => {
    const val = Number(topupAmountInput?.value);
    if (!Number.isFinite(val) || val < 1 || val > 50000) {
      if (topupError) {
        topupError.textContent = 'Please enter an amount between ₹1 and ₹50,000.';
        topupError.classList.remove('hidden');
      }
      return;
    }
    if (topupError) {
      topupError.textContent = '';
      topupError.classList.add('hidden');
    }
    processWalletTopUp(val, submitTopupBtn);
  });

  const couponStatus = document.createElement('p');
  couponStatus.className = 'mt-2 min-h-4 text-xs';
  couponRow?.after(couponStatus);

  const discountRow = document.createElement('div');
  discountRow.className = 'hidden flex justify-between items-center py-1 text-sm text-green-700';
  const discountLabel = document.createElement('span');
  discountLabel.textContent = 'Coupon discount';
  const discountValue = document.createElement('span');
  discountValue.className = 'font-medium';
  discountRow.append(discountLabel, discountValue);
  totalRow?.before(discountRow);

  const setCouponStatus = (message, isError = false, allowRemove = false) => {
    couponStatus.replaceChildren();
    couponStatus.className = `mt-2 min-h-4 text-xs ${isError ? 'text-error' : 'text-green-700'}`;
    couponStatus.append(document.createTextNode(message));

    if (allowRemove) {
      const removeButton = document.createElement('button');
      removeButton.type = 'button';
      removeButton.className = 'ml-2 font-semibold underline';
      removeButton.textContent = 'Remove';
      removeButton.addEventListener('click', async () => {
        try {
          await fetch('/coupon/remove', {
            method: 'POST',
            headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
          });
        } catch (e) {
          console.error('Failed to remove coupon from session:', e);
        }
        localStorage.removeItem('checkout_coupon_code');
        appliedCouponCode = '';
        couponInput.value = '';
        totalValue.textContent = `₹${baseFinalAmount.toFixed(2)}`;
        discountRow.classList.add('hidden');
        setCouponStatus('Coupon removed.');
        updatePaymentUI();
      });
      couponStatus.append(removeButton);
    }
  };

  const applyCoupon = async (code) => {
    const normalizedCode = String(code || '').trim();
    if (!normalizedCode) {
      setCouponStatus('Enter a coupon code.', true);
      return;
    }

    couponApplyButton.disabled = true;
    try {
      const response = await fetch('/coupon/apply', {
        method: 'POST',
        headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
        body: JSON.stringify({ code: normalizedCode, retryOrderId: retryOrderId || null }),
      });
      const data = await response.json();
      if (!response.ok || !data.success) throw new Error(data.message || 'Unable to apply coupon.');

      const discount = Math.min(baseFinalAmount, Number(data.discount));
      if (!Number.isFinite(discount) || discount <= 0) throw new Error('This coupon has no applicable discount.');

      appliedCouponCode = data.coupon.code;
      localStorage.setItem('checkout_coupon_code', appliedCouponCode);
      couponInput.value = appliedCouponCode;
      discountValue.textContent = `-₹${discount.toFixed(2)}`;
      discountRow.classList.remove('hidden');
      totalValue.textContent = `₹${Math.max(0, baseFinalAmount - discount).toFixed(2)}`;
      setCouponStatus(`${appliedCouponCode} applied. You save ₹${discount.toFixed(2)}.`, false, true);
      couponOffersDialog.close();
      updatePaymentUI();
    } catch (error) {
      localStorage.removeItem('checkout_coupon_code');
      appliedCouponCode = '';
      setCouponStatus(error.message, true);
    } finally {
      couponApplyButton.disabled = false;
    }
  };

  if (appliedCouponCode && initialCouponDiscount > 0) {
    localStorage.setItem('checkout_coupon_code', appliedCouponCode);
    couponInput.value = appliedCouponCode;
    discountValue.textContent = `-₹${initialCouponDiscount.toFixed(2)}`;
    discountRow.classList.remove('hidden');
    totalValue.textContent = `₹${Math.max(0, baseFinalAmount - initialCouponDiscount).toFixed(2)}`;
    setCouponStatus(`${appliedCouponCode} applied. You save ₹${initialCouponDiscount.toFixed(2)}.`, false, true);
    updatePaymentUI();
  } else {
    localStorage.removeItem('checkout_coupon_code');
    appliedCouponCode = '';
    couponInput.value = '';
    discountRow.classList.add('hidden');
    couponStatus.replaceChildren();
  }


  let initialCoupons = [];
  try {
    initialCoupons = JSON.parse(document.getElementById('couponsData')?.textContent || '[]');
  } catch (err) {
    initialCoupons = [];
  }

  const getDOMCartItems = () => {
    const itemElements = document.querySelectorAll('[data-cart-item]');
    const items = [];
    itemElements.forEach((el) => {
      const productId = el.dataset.productId;
      const categoryId = el.dataset.categoryId;
      const price = Number(el.dataset.price || 0);
      const qty = Number(el.querySelector('[data-cart-quantity]')?.textContent || 1);
      if (qty > 0) {
        items.push({
          productId,
          categoryId,
          price,
          quantity: qty,
          itemTotal: price * qty,
          hasOffer: el.dataset.hasOffer === 'true',
        });
      }
    });
    return items;
  };

  const getDOMSubtotal = () => {
    const subtotalLabel = [...document.querySelectorAll('span')]
      .find((el) => el.textContent.trim() === 'Subtotal');
    if (subtotalLabel && subtotalLabel.nextElementSibling) {
      return Number(subtotalLabel.nextElementSibling.textContent.replace(/[^\d.]/g, '')) || 0;
    }
    return getDOMCartItems().reduce((sum, item) => sum + item.itemTotal, 0);
  };

  const recalculateCouponsEligibility = () => {
    const listContainer = document.getElementById('couponOffersList');
    if (!listContainer || !initialCoupons.length) return;

    const currentCartItems = getDOMCartItems();
    const eligibleCartItems = currentCartItems.filter((item) => !item.hasOffer);
    const currentSubtotal = eligibleCartItems.reduce((sum, item) => sum + item.itemTotal, 0);

    initialCoupons.forEach((coupon) => {
      let eligible = true;
      let reason = null;

      if (currentCartItems.length > 0 && eligibleCartItems.length === 0) {
        eligible = false;
        reason = 'Coupons cannot be applied to products that already have offers.';
      }

      if (eligible && coupon.applies_to === 'PRODUCT' && coupon.target_product_id) {
        const hasProduct = currentCartItems.some(
          (item) => !item.hasOffer && String(item.productId) === String(coupon.target_product_id)
        );
        if (!hasProduct) {
          eligible = false;
          reason = 'Add an eligible product to your cart.';
        }
      } else if (eligible && coupon.applies_to === 'CATEGORY' && coupon.target_category_id) {
        const hasCategory = currentCartItems.some(
          (item) => !item.hasOffer && String(item.categoryId) === String(coupon.target_category_id)
        );
        if (!hasCategory) {
          eligible = false;
          reason = 'Add products from the selected category to use this coupon.';
        }
      }

      if (eligible && currentSubtotal < Number(coupon.rawMinimumPurchase || 0)) {
        eligible = false;
        reason = 'Minimum purchase amount not reached.';
      }

      const couponSubtotal = coupon.applies_to === 'PRODUCT' && coupon.target_product_id
        ? eligibleCartItems
            .filter((item) => String(item.productId) === String(coupon.target_product_id))
            .reduce((sum, item) => sum + item.itemTotal, 0)
        : coupon.applies_to === 'CATEGORY' && coupon.target_category_id
          ? eligibleCartItems
              .filter((item) => String(item.categoryId) === String(coupon.target_category_id))
              .reduce((sum, item) => sum + item.itemTotal, 0)
          : currentSubtotal;

      if (eligible && couponSubtotal < Number(coupon.rawMinimumPurchase || 0)) {
        eligible = false;
        reason = 'Minimum purchase amount not reached.';
      }

      coupon.eligible = eligible;
      coupon.reason = reason;
      coupon.amountNeeded = Math.max(0, Number(coupon.rawMinimumPurchase || 0) - couponSubtotal).toFixed(2);
    });

    initialCoupons.sort((a, b) => {
      if (a.eligible && !b.eligible) return -1;
      if (!a.eligible && b.eligible) return 1;
      if (b.discount_value !== a.discount_value) {
        return b.discount_value - a.discount_value;
      }
      return (a.rawMinimumPurchase || 0) - (b.rawMinimumPurchase || 0);
    });

    if (appliedCouponCode) {
      const activeCoupon = initialCoupons.find((c) => c.code === appliedCouponCode);
      if (activeCoupon && !activeCoupon.eligible) {
        appliedCouponCode = '';
        couponInput.value = '';
        localStorage.removeItem('checkout_coupon_code');
        discountRow.classList.add('hidden');
        setCouponStatus(`${activeCoupon.code} was removed: ${activeCoupon.reason}`, true);
        totalValue.textContent = `₹${baseFinalAmount.toFixed(2)}`;
        updatePaymentUI();
        fetch('/coupon/remove', {
          method: 'POST',
          headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
        }).catch(() => {});
      }
    }

    listContainer.innerHTML = initialCoupons.map((coupon) => `
      <article class="border border-outline-variant/30 rounded-xl p-4 flex gap-3 items-start transition-all ${!coupon.eligible ? 'opacity-75 bg-surface-gray/30' : ''}" data-coupon-card data-code="${coupon.code}">
        <span class="material-symbols-outlined text-primary mt-0.5">sell</span>
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div class="flex flex-wrap items-center gap-2">
              <span class="font-bold text-ink-black">${coupon.code}</span>
              <span class="text-sm font-semibold text-green-700">${coupon.discountLabel}</span>
            </div>
            ${coupon.eligible
              ? `<button type="button" data-apply-coupon="${coupon.code}" class="bg-ink-black text-white hover:bg-ink-black/90 px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-colors shadow-xs active:scale-95 touch-target">Apply</button>`
              : `<button type="button" disabled class="bg-surface-gray text-on-surface-variant/50 border border-outline-variant/30 px-3.5 py-1.5 rounded-lg text-xs font-semibold cursor-not-allowed">Apply</button>`
            }
          </div>
          ${coupon.restrictionLabel ? `<p class="text-xs text-accent-blue font-medium mt-1">${coupon.restrictionLabel}</p>` : ''}
          <p class="text-sm text-on-surface-variant mt-1">Minimum purchase: ₹${coupon.minimumPurchase}</p>
          <p class="text-xs text-on-surface-variant mt-1">Expires ${coupon.expiryLabel}</p>
          ${coupon.eligible
            ? `<div class="flex items-center gap-1.5 mt-2 text-xs font-semibold text-green-700">
                <span class="material-symbols-outlined text-[15px]">check_circle</span>
                <span>Available for this order</span>
              </div>`
            : `<div class="flex items-center gap-1.5 mt-2 text-xs font-medium text-amber-700">
                <span class="material-symbols-outlined text-[15px]">info</span>
                <span>${coupon.reason}</span>
              </div>`
          }
        </div>
      </article>
    `).join('');
  };

  window.recalculateCouponsEligibility = recalculateCouponsEligibility;

  viewOffersButton?.addEventListener('click', () => {
    recalculateCouponsEligibility();
    couponOffersDialog?.showModal();
  });
  document.getElementById('closeCouponOffers')?.addEventListener('click', () => couponOffersDialog?.close());
  couponApplyButton?.addEventListener('click', () => applyCoupon(couponInput.value));
  couponOffersDialog?.addEventListener('click', (event) => {
    const offerButton = event.target.closest('[data-apply-coupon]');
    if (offerButton) applyCoupon(offerButton.dataset.applyCoupon);
  });
  couponOffersDialog?.addEventListener('click', (event) => {
    if (event.target === couponOffersDialog) couponOffersDialog.close();
  });

  placeOrderButton?.addEventListener('click', async () => {
    const addressId = document.getElementById('selectedAddressId')?.value;
    const paymentMethod = document.querySelector('input[name="payment"]:checked')?.value;

    if (!addressId) {
      showNotification('error', 'Please select a delivery address.');
      return;
    }

    if (!paymentMethod) {
      showNotification('error', 'Please select a payment option.');
      return;
    }

    const originalContent = placeOrderButton.innerHTML;
    placeOrderButton.disabled = true;
    placeOrderButton.textContent = 'Processing...';

    if (paymentMethod === 'wallet') {
      const currentFinalAmt = getCurrentFinalAmount();
      if (rawWalletBalance < currentFinalAmt) {
        showNotification('error', `Insufficient wallet balance. You have ₹${rawWalletBalance.toFixed(2)}, but order total is ₹${currentFinalAmt.toFixed(2)}. Please choose another payment method or add funds.`);
        placeOrderButton.disabled = false;
        placeOrderButton.innerHTML = originalContent;
        return;
      }
    }

    try {
      if (paymentMethod === 'upi') {
        const RazorpayClass = await ensureRazorpay();
        if (!RazorpayClass) throw new Error('Payment checkout did not load. Please try again.');

        const orderResponse = await fetch('/payment/checkout/create-order', {
          method: 'POST',
          headers: {
            Accept: 'application/json',
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ addressId, couponCode: appliedCouponCode }),
        });
        const paymentOrder = await orderResponse.json();

        if (!orderResponse.ok || !paymentOrder.success) {
          throw new Error(paymentOrder.message || 'Unable to start payment.');
        }

        let checkoutFailed = false;

        const checkout = new RazorpayClass({
          key: paymentOrder.key,
          amount: paymentOrder.order.amount,
          currency: paymentOrder.order.currency,
          name: 'Nutri Burfi',
          description: 'Order payment',
          order_id: paymentOrder.order.id,
          retry: { enabled: false },
          prefill: paymentOrder.prefill,
          theme: { color: '#7b5900' },
          modal: {
            confirm_close: false,
            ondismiss: async function () {
              placeOrderButton.disabled = false;
              placeOrderButton.innerHTML = originalContent;
              if (checkoutFailed) {
                return;
              }
              try {
                const failRes = await fetch('/order/place', {
                  method: 'POST',
                  headers: {
                    Accept: 'application/json',
                    'Content-Type': 'application/json',
                  },
                  body: JSON.stringify({
                    addressId,
                    paymentMethod: 'upi',
                    couponCode: appliedCouponCode,
                    paymentStatus: 'failed',
                    failureReason: 'Payment cancelled or dismissed by user',
                    razorpay_order_id: paymentOrder.order.id,
                    retryOrderId,
                  }),
                });
                const failData = await failRes.json();
                if (failData.success && failData.orderId) {
                  window.location.href = `/payment/failed?orderId=${encodeURIComponent(failData.orderId)}`;
                  return;
                }
              } catch (e) {
                console.error('Dismiss order fail error:', e);
              }
              showNotification('info', 'Payment checkout closed. You can retry payment.');
            },
          },
          handler: async (payment) => {
            try {
              const response = await fetch('/order/place', {
                method: 'POST',
                headers: {
                  Accept: 'application/json',
                  'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                  addressId,
                  paymentMethod: 'upi',
                  couponCode: appliedCouponCode,
                  retryOrderId,
                  ...payment,
                }),
              });
              const data = await response.json();

              if (!response.ok || !data.success || !data.orderId) {
                throw new Error(data.message || 'Payment completed, but the order could not be placed.');
              }

              localStorage.removeItem('checkout_coupon_code');
              window.location.href = `/order/order-success/${encodeURIComponent(data.orderId)}`;
            } catch (error) {
              showNotification('error', error.message);
              placeOrderButton.disabled = false;
              placeOrderButton.innerHTML = originalContent;
            }
          },
        });

        checkout.on('payment.failed', async (paymentEvent) => {
          checkoutFailed = true;
          try { checkout.close(); } catch (e) {}
          document.querySelectorAll('.razorpay-container').forEach(el => el.remove());

          const failReason = paymentEvent.error?.description || 'Online payment failed';
          let createdOrderId = null;

          try {
            localStorage.removeItem('checkout_coupon_code');
            const failRes = await fetch('/order/place', {
              method: 'POST',
              headers: {
                Accept: 'application/json',
                'Content-Type': 'application/json',
              },
              body: JSON.stringify({
                addressId,
                paymentMethod: 'upi',
                couponCode: appliedCouponCode,
                paymentStatus: 'failed',
                failureReason: failReason,
                razorpay_order_id: paymentEvent.error?.metadata?.order_id || paymentOrder.order.id,
                retryOrderId,
              }),
            });
            const failData = await failRes.json();
            if (failData.success && failData.orderId) {
              createdOrderId = failData.orderId;
            }
          } catch (e) {
            console.error('Record failed order error:', e);
          }

          if (createdOrderId) {
            window.location.href = `/payment/failed?orderId=${encodeURIComponent(createdOrderId)}`;
          } else {
            window.location.href = '/payment/failed';
          }
        });

        checkout.open();
        return;
      }

      const response = await fetch('/order/place', {
        method: 'POST',
        headers: {
          Accept: 'application/json',
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ addressId, paymentMethod, couponCode: appliedCouponCode, retryOrderId }),
      });
      const data = await response.json();

      if (!response.ok || !data.success || !data.orderId) {
        showNotification('error', data.message || 'Unable to place order.');
        return;
      }

      localStorage.removeItem('checkout_coupon_code');
      window.location.href = `/order/order-success/${encodeURIComponent(data.orderId)}`;
    } catch (error) {
      console.error('Place order request failed:', error);
      showNotification('error', 'Unable to place order. Please try again.');

    } finally {
      if (placeOrderButton.isConnected) {
        placeOrderButton.disabled = false;
        placeOrderButton.innerHTML = originalContent;
      }
    }
  });

  document.addEventListener('click', async (event) => {
    const button = event.target.closest('[data-cart-action]');

    if (!button || button.disabled) return;

    const cartItem = button.closest('[data-cart-item]');
    const variantId = cartItem?.dataset.variantId;
    const action = button.dataset.cartAction;

    if (!variantId) {
      showNotification('error', 'Unable to identify this cart item.');
      return;
    }

    if (action === 'decrease' && Number(cartItem.querySelector('[data-cart-quantity]').textContent) <= 1) {
      showNotification('error', 'Minimum quantity is 1');
      return;
    }

    const method = action === 'remove' ? 'DELETE' : 'PATCH';
    const endpoint = action === 'remove'
      ? `/cart/${encodeURIComponent(variantId)}`
      : `/cart/${encodeURIComponent(variantId)}/${action}`;

    button.disabled = true;

    try {
      const response = await fetch(endpoint, {
        method,
        headers: { Accept: 'application/json' },
      });
      const data = await response.json();

      if (!response.ok || !data.success) {
        showNotification('error', data.message || 'Unable to update cart.');
        return;
      }

      window.location.reload();
    } catch (error) {
      console.error('Checkout cart update error:', error);
      showNotification('error', 'Unable to update cart.');
    } finally {
      if (button.isConnected) button.disabled = false;
    }
  });

  document.addEventListener('change', async (event) => {
    const select = event.target.closest('[data-change-variant]');
    if (!select) return;

    const cartItem = select.closest('[data-cart-item]');
    const oldVariantId = select.dataset.currentVariantId || cartItem?.dataset.variantId;
    const newVariantId = select.value;

    if (!oldVariantId || !newVariantId) return;
    if (oldVariantId === newVariantId) return;

    select.disabled = true;

    try {
      const response = await fetch(`/cart/${encodeURIComponent(oldVariantId)}/change-variant`, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json',
        },
        body: JSON.stringify({ oldVariantId, newVariantId }),
      });
      const data = await response.json();

      if (!response.ok || !data.success) {
        showNotification('error', data.message || 'Unable to change variant.');
        select.value = oldVariantId;
        return;
      }

      window.location.reload();
    } catch (error) {
      console.error('Checkout change variant error:', error);
      showNotification('error', 'Unable to change variant.');
      select.value = oldVariantId;
    } finally {
      if (select.isConnected) select.disabled = false;
    }
  });

  const addressModal = document.getElementById('addressModal');
  const addressModalContent = document.getElementById('addressModalContent');
  const openAddressModalBtn = document.getElementById('openAddressModalBtn');
  const selectAddressEmptyBtn = document.getElementById('selectAddressEmptyBtn');
  const closeAddressModalBtn = document.getElementById('closeAddressModalBtn');
  const cancelAddressModalBtn = document.getElementById('cancelAddressModalBtn');
  const confirmAddressSelectionBtn = document.getElementById('confirmAddressSelectionBtn');

  // Address card DOM elements on the checkout page
  const selectedAddressContent = document.getElementById('selectedAddressContent');
  const noAddressContent = document.getElementById('noAddressContent');
  const selectedAddressIdInput = document.getElementById('selectedAddressId');
  const displayFullName = document.getElementById('displayFullName');
  const displayLabel = document.getElementById('displayLabel');
  const displayDefaultBadge = document.getElementById('displayDefaultBadge');
  const displayAddress = document.getElementById('displayAddress');
  const displayPhone = document.getElementById('displayPhone');
  const deliveryAddressSection = document.getElementById('deliveryAddressSection');

  let activeCard = document.querySelector('.address-option-card.is-active') || document.querySelector('.address-option-card');

  function openModal() {
    if (!addressModal) return;
    addressModal.classList.remove('opacity-0', 'pointer-events-none');
    addressModal.classList.add('opacity-100', 'pointer-events-auto');
    addressModalContent.classList.remove('scale-95');
    addressModalContent.classList.add('scale-100');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    if (!addressModal) return;
    addressModal.classList.remove('opacity-100', 'pointer-events-auto');
    addressModal.classList.add('opacity-0', 'pointer-events-none');
    addressModalContent.classList.remove('scale-100');
    addressModalContent.classList.add('scale-95');
    document.body.style.overflow = '';
  }

  if (openAddressModalBtn) {
    openAddressModalBtn.addEventListener('click', openModal);
  }
  if (selectAddressEmptyBtn) {
    selectAddressEmptyBtn.addEventListener('click', openModal);
  }
  if (closeAddressModalBtn) {
    closeAddressModalBtn.addEventListener('click', closeModal);
  }
  if (cancelAddressModalBtn) {
    cancelAddressModalBtn.addEventListener('click', closeModal);
  }

  // Close modal when clicking backdrop
  if (addressModal) {
    addressModal.addEventListener('click', (e) => {
      if (e.target === addressModal) {
        closeModal();
      }
    });
  }

  // Close modal on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && addressModal && !addressModal.classList.contains('pointer-events-none')) {
      closeModal();
    }
  });

  // Card selection in modal
  const addressCards = document.querySelectorAll('.address-option-card');

  function selectCard(card) {
    addressCards.forEach(c => {
      c.classList.remove('border-primary', 'bg-primary-fixed/15', 'ring-2', 'ring-primary/20', 'is-active');
      c.classList.add('border-outline-variant/30', 'bg-white');
      
      const radio = c.querySelector('.radio-circle');
      if (radio) {
        radio.classList.remove('border-primary', 'bg-primary', 'text-white');
        radio.classList.add('border-outline-variant/60', 'text-transparent');
      }

      const check = c.querySelector('.check-icon');
      if (check) check.classList.add('hidden');

      const badge = c.querySelector('.selected-badge');
      if (badge) badge.classList.add('hidden');
    });

    card.classList.add('border-primary', 'bg-primary-fixed/15', 'ring-2', 'ring-primary/20', 'is-active');
    card.classList.remove('border-outline-variant/30', 'bg-white');

    const radio = card.querySelector('.radio-circle');
    if (radio) {
      radio.classList.add('border-primary', 'bg-primary', 'text-white');
      radio.classList.remove('border-outline-variant/60', 'text-transparent');
    }

    const check = card.querySelector('.check-icon');
    if (check) check.classList.remove('hidden');

    const badge = card.querySelector('.selected-badge');
    if (badge) badge.classList.remove('hidden');

    activeCard = card;
  }

  addressCards.forEach(card => {
    card.addEventListener('click', () => {
      selectCard(card);
    });

    card.addEventListener('dblclick', () => {
      selectCard(card);
      applySelectedAddress();
    });
  });

  function applySelectedAddress() {
    if (!activeCard) {
      closeModal();
      return;
    }

    const { id, fullname, label, isdefault, street, suite, city, state, zip, country, phone } = activeCard.dataset;

    if (selectedAddressIdInput) selectedAddressIdInput.value = id || '';
    if (displayFullName) displayFullName.textContent = fullname || '';
    if (displayLabel) displayLabel.textContent = label || 'HOME';
    if (displayPhone) displayPhone.textContent = phone || '';

    // Format address string
    let formatted = street || '';
    if (suite && suite.trim() !== '') {
      formatted += `, ${suite}`;
    }
    if (city) formatted += `, ${city}`;
    if (state || zip) formatted += `, ${state || ''} ${zip || ''}`.trim();
    if (country) formatted += `, ${country}`;

    if (displayAddress) displayAddress.textContent = formatted;

    if (displayDefaultBadge) {
      if (isdefault === 'true') {
        displayDefaultBadge.classList.remove('hidden');
      } else {
        displayDefaultBadge.classList.add('hidden');
      }
    }

    if (selectedAddressContent) selectedAddressContent.classList.remove('hidden');
    if (noAddressContent) noAddressContent.classList.add('hidden');

    // Subtle highlight feedback on address card
    if (deliveryAddressSection) {
      deliveryAddressSection.classList.add('ring-2', 'ring-primary', 'transition-all');
      setTimeout(() => {
        deliveryAddressSection.classList.remove('ring-2', 'ring-primary');
      }, 900);
    }

    closeModal();
  }

  if (confirmAddressSelectionBtn) {
    confirmAddressSelectionBtn.addEventListener('click', applySelectedAddress);
  }
});
</script>

