<!-- Address Selection Modal Popup -->
<div id="addressModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-ink-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-300">
  <div id="addressModalContent" class="relative w-full max-w-2xl bg-surface-container-lowest rounded-3xl shadow-[0_20px_60px_rgba(0,0,0,0.2)] border border-outline-variant/30 flex flex-col max-h-[88vh] transform scale-95 transition-all duration-300 overflow-hidden">
    
    <!-- Modal Header -->
    <div class="flex items-center justify-between px-6 py-5 border-b border-outline-variant/20 bg-surface-container-lowest sticky top-0 z-10">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-secondary-container/50 flex items-center justify-center text-primary">
          <span class="material-symbols-outlined text-[22px]" style="font-variation-settings: 'FILL' 1;">location_on</span>
        </div>
        <div>
          <h3 class="font-headline-lg text-[18px] md:text-[20px] font-bold text-ink-black tracking-tight">Select Delivery Address</h3>
          <p class="text-xs text-on-surface-variant">Choose the destination for this order or add a new address</p>
        </div>
      </div>
      <button type="button" id="closeAddressModalBtn" class="w-9 h-9 rounded-full bg-surface-gray hover:bg-surface-variant text-on-surface-variant hover:text-ink-black flex items-center justify-center transition-colors cursor-pointer" aria-label="Close modal">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>

    <!-- Modal Body (Scrollable address list) -->
    <div class="overflow-y-auto p-6 space-y-3.5 flex-1" id="modalAddressList">
      {{#if addresses.length}}
        <div class="space-y-3" id="addressListCardsContainer">
          {{#each addresses}}
          <div class="address-option-card relative p-4 md:p-5 rounded-2xl border-2 transition-all cursor-pointer group flex flex-col justify-between
                      {{#if (eq this._id ../selectedAddress._id)}}border-primary bg-primary-fixed/15 ring-2 ring-primary/20 is-active{{else}}border-outline-variant/30 hover:border-outline-variant/70 bg-white hover:bg-surface-gray/30{{/if}}"
               data-id="{{this._id}}"
               data-fullname="{{this.fullName}}"
               data-label="{{this.addressLabel}}"
               data-isdefault="{{#if this.isDefault}}true{{else}}false{{/if}}"
               data-street="{{this.street}}"
               data-suite="{{this.suite}}"
               data-city="{{this.city}}"
               data-state="{{this.state}}"
               data-zip="{{this.zip}}"
               data-country="{{this.country}}"
               data-phone="{{this.phone}}">
            
            <div class="flex items-start justify-between gap-3">
              <div class="flex items-start gap-3.5">
                <!-- Custom Radio Indicator -->
                <div class="mt-0.5">
                  <div class="w-5 h-5 rounded-full border-2 flex items-center justify-center transition-colors radio-circle
                              {{#if (eq this._id ../selectedAddress._id)}}border-primary bg-primary text-white{{else}}border-outline-variant/60 group-hover:border-primary text-transparent{{/if}}">
                    <span class="material-symbols-outlined text-[13px] check-icon {{#unless (eq this._id ../selectedAddress._id)}}hidden{{/unless}}">check</span>
                  </div>
                </div>

                <!-- Address Information -->
                <div class="space-y-1">
                  <div class="flex items-center flex-wrap gap-2">
                    <span class="font-headline-lg text-[15px] font-bold text-ink-black">{{this.fullName}}</span>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold tracking-wider uppercase bg-secondary-container text-on-secondary-container">
                      {{this.addressLabel}}
                    </span>
                    {{#if this.isDefault}}
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold tracking-wider uppercase bg-[#EBF3FE] text-accent-blue border border-accent-blue/20">
                      Default
                    </span>
                    {{/if}}
                  </div>

                  <p class="text-xs md:text-sm text-on-surface-variant leading-relaxed pt-0.5">
                    {{this.street}}{{#if this.suite}}, {{this.suite}}{{/if}}, {{this.city}}, {{this.state}} {{this.zip}}, {{this.country}}
                  </p>

                  <div class="flex items-center gap-1.5 text-xs font-medium text-ink-black pt-1">
                    <span class="material-symbols-outlined text-[15px] text-on-surface-variant">call</span>
                    <span>{{this.phone}}</span>
                  </div>
                </div>
              </div>

              <!-- Quick action / badge -->
              <div class="flex flex-col items-end gap-2 shrink-0">
                <span class="selected-badge text-[11px] font-bold text-primary {{#unless (eq this._id ../selectedAddress._id)}}hidden{{/unless}} flex items-center gap-1">
                  <span class="material-symbols-outlined text-[14px]">done</span> Selected
                </span>
                <a href="/profile/address/edit/{{this._id}}" target="_blank" onclick="event.stopPropagation();" class="text-[11px] font-semibold text-on-surface-variant hover:text-accent-blue transition-colors flex items-center gap-0.5 py-1 px-2 rounded-md hover:bg-surface-gray">
                  <span class="material-symbols-outlined text-[13px]">edit</span> Edit
                </a>
              </div>
            </div>
          </div>
          {{/each}}
        </div>
      {{else}}
        <!-- Empty State in Modal -->
        <div class="py-12 px-4 flex flex-col items-center justify-center text-center">
          <div class="w-16 h-16 rounded-full bg-secondary-container/40 flex items-center justify-center mb-4 text-primary">
            <span class="material-symbols-outlined text-[32px]">location_off</span>
          </div>
          <h4 class="font-headline-lg text-lg font-bold text-ink-black mb-1">No Saved Addresses</h4>
          <p class="text-sm text-on-surface-variant max-w-sm mb-6">You don't have any saved shipping addresses yet. Add one to complete your order.</p>
          <a href="/profile/address/add" class="inline-flex items-center gap-2 px-6 py-3 bg-ink-black text-white rounded-full font-label-md text-sm font-semibold hover:bg-ink-black/90 active:scale-95 transition-all shadow-md">
            <span class="material-symbols-outlined text-[18px]">add</span>
            Add New Address
          </a>
        </div>
      {{/if}}
    </div>

    <!-- Modal Footer -->
    <div class="px-6 py-4 border-t border-outline-variant/20 bg-surface-gray/50 flex flex-col sm:flex-row items-center justify-between gap-3 sticky bottom-0 z-10">
      <a href="/profile/address/add" class="inline-flex items-center gap-1.5 text-xs md:text-sm font-semibold text-accent-blue hover:underline py-1.5 transition-colors">
        <span class="material-symbols-outlined text-[18px]">add_circle</span>
        Add New Address
      </a>
      
      <div class="flex items-center gap-2.5 w-full sm:w-auto">
        <button type="button" id="cancelAddressModalBtn" class="flex-1 sm:flex-none px-5 py-2.5 rounded-xl border border-outline-variant/40 text-on-surface font-label-md text-xs md:text-sm font-semibold hover:bg-surface-variant transition-colors cursor-pointer">
          Cancel
        </button>
        {{#if addresses.length}}
        <button type="button" id="confirmAddressSelectionBtn" class="flex-1 sm:flex-none px-6 py-2.5 rounded-xl bg-ink-black text-white font-label-md text-xs md:text-sm font-semibold hover:bg-ink-black/90 active:scale-95 transition-all shadow-sm flex items-center justify-center gap-1.5 cursor-pointer">
          <span class="material-symbols-outlined text-[18px]">check</span>
          Deliver to this Address
        </button>
        {{/if}}
      </div>
    </div>

  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const placeOrderButton = document.getElementById('placeOrderBtn');

  placeOrderButton?.addEventListener('click', async () => {
    const addressId = document.getElementById('selectedAddressId')?.value;
    const paymentMethod = document.querySelector('input[name="payment"]:checked')?.value;

    if (!addressId) {
      showNotification('error', 'Please select a delivery address.');
      return;
    }

    if (!paymentMethod) {
      showNotification('error', 'Please select payment option');
      return;
    }

    const originalContent = placeOrderButton.innerHTML;
    placeOrderButton.disabled = true;
    placeOrderButton.textContent = 'Processing...';

    try {
      const response = await fetch('/order/place', {
        method: 'POST',
        headers: {
          Accept: 'application/json',
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ addressId, paymentMethod }),
      });
      const data = await response.json();

      if (!response.ok || !data.success || !data.orderId) {
        showNotification('error', data.message || 'Unable to place order.');
        return;
      }

      window.location.href = `/order/order-success/${encodeURIComponent(data.orderId)}`;
    } catch (error) {
      console.error('Place order request failed:', error);
      showNotification('error', 'Unable to place order. Please try again.');
    } finally {
      if (placeOrderButton.isConnected) {
        placeOrderButton.disabled = false;
        placeOrderButton.innerHTML = originalContent;
      }
    }
  });

  document.addEventListener('click', async (event) => {
    const button = event.target.closest('[data-cart-action]');

    if (!button || button.disabled) return;

    const cartItem = button.closest('[data-cart-item]');
    const variantId = cartItem?.dataset.variantId;
    const action = button.dataset.cartAction;

    if (!variantId) {
      showNotification('error', 'Unable to identify this cart item.');
      return;
    }

    if (action === 'decrease' && Number(cartItem.querySelector('[data-cart-quantity]').textContent) <= 1) {
      showNotification('error', 'Minimum quantity is 1');
      return;
    }

    const method = action === 'remove' ? 'DELETE' : 'PATCH';
    const endpoint = action === 'remove'
      ? `/cart/${encodeURIComponent(variantId)}`
      : `/cart/${encodeURIComponent(variantId)}/${action}`;

    button.disabled = true;

    try {
      const response = await fetch(endpoint, {
        method,
        headers: { Accept: 'application/json' },
      });
      const data = await response.json();

      if (!response.ok || !data.success) {
        showNotification('error', data.message || 'Unable to update cart.');
        return;
      }

      window.location.reload();
    } catch (error) {
      console.error('Checkout cart update error:', error);
      showNotification('error', 'Unable to update cart.');
    } finally {
      if (button.isConnected) button.disabled = false;
    }
  });

  const addressModal = document.getElementById('addressModal');
  const addressModalContent = document.getElementById('addressModalContent');
  const openAddressModalBtn = document.getElementById('openAddressModalBtn');
  const selectAddressEmptyBtn = document.getElementById('selectAddressEmptyBtn');
  const closeAddressModalBtn = document.getElementById('closeAddressModalBtn');
  const cancelAddressModalBtn = document.getElementById('cancelAddressModalBtn');
  const confirmAddressSelectionBtn = document.getElementById('confirmAddressSelectionBtn');

  // Address card DOM elements on the checkout page
  const selectedAddressContent = document.getElementById('selectedAddressContent');
  const noAddressContent = document.getElementById('noAddressContent');
  const selectedAddressIdInput = document.getElementById('selectedAddressId');
  const displayFullName = document.getElementById('displayFullName');
  const displayLabel = document.getElementById('displayLabel');
  const displayDefaultBadge = document.getElementById('displayDefaultBadge');
  const displayAddress = document.getElementById('displayAddress');
  const displayPhone = document.getElementById('displayPhone');
  const deliveryAddressSection = document.getElementById('deliveryAddressSection');

  let activeCard = document.querySelector('.address-option-card.is-active') || document.querySelector('.address-option-card');

  function openModal() {
    if (!addressModal) return;
    addressModal.classList.remove('opacity-0', 'pointer-events-none');
    addressModal.classList.add('opacity-100', 'pointer-events-auto');
    addressModalContent.classList.remove('scale-95');
    addressModalContent.classList.add('scale-100');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    if (!addressModal) return;
    addressModal.classList.remove('opacity-100', 'pointer-events-auto');
    addressModal.classList.add('opacity-0', 'pointer-events-none');
    addressModalContent.classList.remove('scale-100');
    addressModalContent.classList.add('scale-95');
    document.body.style.overflow = '';
  }

  if (openAddressModalBtn) {
    openAddressModalBtn.addEventListener('click', openModal);
  }
  if (selectAddressEmptyBtn) {
    selectAddressEmptyBtn.addEventListener('click', openModal);
  }
  if (closeAddressModalBtn) {
    closeAddressModalBtn.addEventListener('click', closeModal);
  }
  if (cancelAddressModalBtn) {
    cancelAddressModalBtn.addEventListener('click', closeModal);
  }

  // Close modal when clicking backdrop
  if (addressModal) {
    addressModal.addEventListener('click', (e) => {
      if (e.target === addressModal) {
        closeModal();
      }
    });
  }

  // Close modal on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && addressModal && !addressModal.classList.contains('pointer-events-none')) {
      closeModal();
    }
  });

  // Card selection in modal
  const addressCards = document.querySelectorAll('.address-option-card');

  function selectCard(card) {
    addressCards.forEach(c => {
      c.classList.remove('border-primary', 'bg-primary-fixed/15', 'ring-2', 'ring-primary/20', 'is-active');
      c.classList.add('border-outline-variant/30', 'bg-white');
      
      const radio = c.querySelector('.radio-circle');
      if (radio) {
        radio.classList.remove('border-primary', 'bg-primary', 'text-white');
        radio.classList.add('border-outline-variant/60', 'text-transparent');
      }

      const check = c.querySelector('.check-icon');
      if (check) check.classList.add('hidden');

      const badge = c.querySelector('.selected-badge');
      if (badge) badge.classList.add('hidden');
    });

    card.classList.add('border-primary', 'bg-primary-fixed/15', 'ring-2', 'ring-primary/20', 'is-active');
    card.classList.remove('border-outline-variant/30', 'bg-white');

    const radio = card.querySelector('.radio-circle');
    if (radio) {
      radio.classList.add('border-primary', 'bg-primary', 'text-white');
      radio.classList.remove('border-outline-variant/60', 'text-transparent');
    }

    const check = card.querySelector('.check-icon');
    if (check) check.classList.remove('hidden');

    const badge = card.querySelector('.selected-badge');
    if (badge) badge.classList.remove('hidden');

    activeCard = card;
  }

  addressCards.forEach(card => {
    card.addEventListener('click', () => {
      selectCard(card);
    });

    card.addEventListener('dblclick', () => {
      selectCard(card);
      applySelectedAddress();
    });
  });

  function applySelectedAddress() {
    if (!activeCard) {
      closeModal();
      return;
    }

    const { id, fullname, label, isdefault, street, suite, city, state, zip, country, phone } = activeCard.dataset;

    if (selectedAddressIdInput) selectedAddressIdInput.value = id || '';
    if (displayFullName) displayFullName.textContent = fullname || '';
    if (displayLabel) displayLabel.textContent = label || 'HOME';
    if (displayPhone) displayPhone.textContent = phone || '';

    // Format address string
    let formatted = street || '';
    if (suite && suite.trim() !== '') {
      formatted += `, ${suite}`;
    }
    if (city) formatted += `, ${city}`;
    if (state || zip) formatted += `, ${state || ''} ${zip || ''}`.trim();
    if (country) formatted += `, ${country}`;

    if (displayAddress) displayAddress.textContent = formatted;

    if (displayDefaultBadge) {
      if (isdefault === 'true') {
        displayDefaultBadge.classList.remove('hidden');
      } else {
        displayDefaultBadge.classList.add('hidden');
      }
    }

    if (selectedAddressContent) selectedAddressContent.classList.remove('hidden');
    if (noAddressContent) noAddressContent.classList.add('hidden');

    // Subtle highlight feedback on address card
    if (deliveryAddressSection) {
      deliveryAddressSection.classList.add('ring-2', 'ring-primary', 'transition-all');
      setTimeout(() => {
        deliveryAddressSection.classList.remove('ring-2', 'ring-primary');
      }, 900);
    }

    closeModal();
  }

  if (confirmAddressSelectionBtn) {
    confirmAddressSelectionBtn.addEventListener('click', applySelectedAddress);
  }
});
</script>

