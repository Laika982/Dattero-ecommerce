{{>user/header}}
<main
    class="pt-24 min-h-screen max-w-max-width mx-auto px-container-padding pb-section-gap flex flex-col md:flex-row gap-grid-gutter">
    <section class="flex-grow w-full">
        <div class="mb-stack-lg">
            <nav class="flex items-center space-x-2 text-on-surface-variant mb-4">
                <a href="/profile/address"
                    class="text-label-md font-label-md hover:text-on-surface transition-colors">Address Book</a>
                <span class="material-symbols-outlined text-sm">chevron_right</span>
                <span class="text-label-md font-label-md text-on-surface">Edit Address</span>
            </nav>
            <h1 class="font-headline-lg text-headline-lg text-on-surface">Edit Address</h1>
            <p class="text-on-surface-variant mt-2 font-body-md text-body-md">Update the delivery destination details
                for your Nutri Luxe shipments.</p>
        </div>
        <div class="bg-surface-container-lowest rounded-xl p-8 border border-black/5 shadow-sm">
            {{#if error}}
            <div class="bg-red-100 border border-red-300 text-red-700 px-4 py-3 rounded-xl mb-6">
                {{error}}
            </div>
            {{/if}}

            <form id="addressForm" action="/profile/address/edit/{{address._id}}" method="POST" class="space-y-6">
                <input type="hidden" name="isDefault" id="isDefault"
                    value="{{#if address.isDefault}}true{{else}}false{{/if}}">
                <!-- Name & Phone -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-grid-gutter">
                    <div class="space-y-2">
                        <label for="fullName" class="block font-label-md text-label-md text-on-surface-variant">Full
                            Name</label>
                        <input type="text" id="fullName" name="fullName" value="{{address.fullName}}"
                            placeholder="John Doe"
                            class="w-full bg-surface-container-low border-none rounded-lg px-4 py-3 text-on-surface placeholder:text-on-surface-variant/40 focus:ring-1 focus:ring-primary transition-all">
                    </div>
                    <div class="space-y-2">
                        <label for="phone" class="block font-label-md text-label-md text-on-surface-variant">Phone
                            Number</label>
                        <input type="tel" id="phone" name="phone" value="{{address.phone}}"
                            placeholder="+1 (555) 000-0000"
                            class="w-full bg-surface-container-low border-none rounded-lg px-4 py-3 text-on-surface placeholder:text-on-surface-variant/40 focus:ring-1 focus:ring-primary transition-all">
                    </div>
                </div>
                <!-- Street Address -->
                <div class="space-y-2">
                    <label for="street" class="block font-label-md text-label-md text-on-surface-variant">Street
                        Address</label>
                    <input type="text" id="street" name="street" value="{{address.street}}"
                        placeholder="123 Wellness Way"
                        class="w-full bg-surface-container-low border-none rounded-lg px-4 py-3 text-on-surface placeholder:text-on-surface-variant/40 focus:ring-1 focus:ring-primary transition-all">
                </div>
                <!-- Suite / Apartment -->
                <div class="space-y-2">
                    <label for="suite" class="block font-label-md text-label-md text-on-surface-variant">Apartment,
                        suite, etc. (optional)</label>
                    <input type="text" id="suite" name="suite" value="{{address.suite}}" placeholder="Penthouse A"
                        class="w-full bg-surface-container-low border-none rounded-lg px-4 py-3 text-on-surface placeholder:text-on-surface-variant/40 focus:ring-1 focus:ring-primary transition-all">
                </div>
                <!-- City, State, Zip -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-grid-gutter">
                    <div class="space-y-2">
                        <label for="city" class="block font-label-md text-label-md text-on-surface-variant">City</label>
                        <input type="text" id="city" name="city" value="{{address.city}}" placeholder="New York"
                            class="w-full bg-surface-container-low border-none rounded-lg px-4 py-3 text-on-surface placeholder:text-on-surface-variant/40 focus:ring-1 focus:ring-primary transition-all">
                    </div>
                    <div class="space-y-2">
                        <label for="state" class="block font-label-md text-label-md text-on-surface-variant">State /
                            Province</label>
                        <input type="text" id="state" name="state" value="{{address.state}}" placeholder="NY"
                            class="w-full bg-surface-container-low border-none rounded-lg px-4 py-3 text-on-surface placeholder:text-on-surface-variant/40 focus:ring-1 focus:ring-primary transition-all">
                    </div>
                    <div class="space-y-2">
                        <label for="zip" class="block font-label-md text-label-md text-on-surface-variant">ZIP / Postal
                            Code</label>
                        <input type="text" id="zip" name="zip" value="{{address.zip}}" placeholder="10001"
                            class="w-full bg-surface-container-low border-none rounded-lg px-4 py-3 text-on-surface placeholder:text-on-surface-variant/40 focus:ring-1 focus:ring-primary transition-all">
                    </div>
                </div>
                <!-- Country -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="space-y-2">
                        <label for="country"
                            class="block font-label-md text-label-md text-on-surface-variant">Country</label>
                        <input type="text" id="country" name="country" value="{{address.country}}"
                            placeholder="United States"
                            class="w-full bg-surface-container-low border-none rounded-lg px-4 py-3 text-on-surface placeholder:text-on-surface-variant/40 focus:ring-1 focus:ring-primary transition-all">
                    </div>
                    <div class="space-y-2">
                        <label for="addressLabel"
                            class="block font-label-md text-label-md text-on-surface-variant">Address Label</label>
                        <input type="text" id="addressLabel" name="addressLabel" value="{{address.addressLabel}}"
                            placeholder="e.g., Home, Work"
                            class="w-full bg-surface-container-low border-none rounded-lg px-4 py-3 text-on-surface placeholder:text-on-surface-variant/40 focus:ring-1 focus:ring-primary transition-all">
                    </div>
                </div>
                <!-- Default Toggle -->
                <div class="flex items-center space-x-3 py-2">
                    <div class="relative inline-flex h-6 w-11 items-center cursor-pointer group"
                        onclick="toggleSwitch(this)">
                        <div id="switch-bg"
                            class="h-6 w-11 rounded-full {{#if address.isDefault}}bg-on-surface{{else}}bg-surface-container-highest{{/if}} transition-colors duration-200">
                        </div>
                        <div id="switch-dot"
                            class="absolute left-1 h-4 w-4 rounded-full bg-white shadow-sm transition-transform duration-200 transform {{#if address.isDefault}}translate-x-5{{else}}translate-x-0{{/if}}">
                        </div>
                    </div>
                    <label class="text-body-md font-body-md text-on-surface cursor-pointer"
                        onclick="toggleSwitch(this.previousElementSibling)">Set as Default Shipping Address</label>
                </div>
                <!-- Actions -->
                <div class="flex flex-col sm:flex-row gap-4 pt-4">
                    <button type="submit"
                        class="flex-1 bg-on-surface text-surface py-4 px-8 rounded-lg font-label-md text-label-md hover:opacity-90 active:scale-[0.98] transition-all">
                        Save Changes
                    </button>
                    <a href="/profile/address"
                        class="px-8 py-4 rounded-lg font-label-md text-label-md border border-outline/20 hover:bg-surface-container transition-colors text-on-surface inline-block text-center flex items-center justify-center">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
        <div class="mt-section-gap grid grid-cols-1 md:grid-cols-2 gap-grid-gutter">
            <div class="h-64 rounded-xl overflow-hidden relative group">
                <div class="absolute inset-0 bg-black/10 group-hover:bg-black/0 transition-colors z-10"></div>
                <img class="w-full h-full object-cover"
                    src="https://lh3.googleusercontent.com/aida-public/AB6AXuDC21l7HEyAk5zC6Wf-XgOUtcb3CKArUK5Y2DDRB1wWqMfBJ7QtysVETSqnSSovjE7BBQGuSDFyVljeKf50fzy2UXgnL1tmfySGScwTjso3Gh3mRNXSuWHp6QPaCT_5RHzHOGQObZVcCeRMR39-zVEogoruich311-VZJYO0P-0r068MX3xwD-xM2cmMkZFr_Mycde4PCSiSTcQRK6lWucM0BwgfVTOISW5fYWJ7_4RBS7i-dTRYyOek4-0-jWj-ok34K8Mw4gDmV0">
            </div>
            <div class="flex flex-col justify-center p-8 bg-surface-container rounded-xl">
                <h3 class="font-headline-lg text-headline-lg text-on-surface mb-2">Delivery Precision</h3>
                <p class="text-body-md text-on-surface-variant">We ensure your artisanal wellness burfis reach you in
                    pristine condition. Your precise address details help us maintain our commitment to seamless luxury
                    logistics.</p>
            </div>
        </div>
    </section>
</main>

<script>
    function toggleSwitch(container) {
        const dot = container.querySelector('#switch-dot') || container.nextElementSibling.querySelector('#switch-dot');
        const bg = container.querySelector('#switch-bg') || container.nextElementSibling.querySelector('#switch-bg');
        const hiddenInput = document.getElementById('isDefault');

        const isChecked = dot.classList.contains('translate-x-5');

        if (isChecked) {
            dot.classList.remove('translate-x-5');
            dot.classList.add('translate-x-0');
            bg.classList.remove('bg-on-surface');
            bg.classList.add('bg-surface-container-highest');
            hiddenInput.value = "false";
        } else {
            dot.classList.remove('translate-x-0');
            dot.classList.add('translate-x-5');
            bg.classList.remove('bg-surface-container-highest');
            bg.classList.add('bg-on-surface');
            hiddenInput.value = "true";
        }
    }
</script>

{{>user/footer}}