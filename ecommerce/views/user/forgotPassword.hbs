{{>user/header}}

<main class="flex-grow flex items-center justify-center px-container-padding py-section-gap relative z-10">
  <div class="w-full max-w-[480px] fade-in-up">

    <!-- Main Content Card -->
    <div class="bg-surface-container-lowest rounded-xl p-8 md:p-12 soft-shadow border border-ink-black/5">

      <!---->
      <div class="flex flex-col items-center text-center mb-stack-lg">
        <div
          class="w-16 h-16 rounded-full bg-surface-container-high flex items-center justify-center mb-stack-md text-primary">
          <span class="material-symbols-outlined text-[32px]">lock_reset</span>
        </div>
        <h2 class="font-headline-lg text-headline-lg text-on-surface mb-2">Forgot Password?</h2>
        <p class="font-body-md text-body-md text-on-surface-variant max-w-[320px]">
          Enter the email address associated with your account and we'll send you a link to reset your
          password.
        </p>
      </div>

      <!-- Form -->
      {{> user/notification}}

      <form id="resetForm" class="space-y-stack-lg" method="post" action="/forgotPassword" novalidate>
        <div class="space-y-stack-sm">
          <label for="email" class="font-label-md text-label-md text-on-surface-variant block ml-1">Email
            Address</label>
          <div class="relative">
            <input type="email" id="email" name="email" placeholder="name@example.com" autocomplete="email"
              class="w-full bg-surface-gray border border-outline-variant/30 rounded-lg px-4 py-4 font-body-md text-body-md transition-all duration-300 focus:bg-surface-container-lowest">
            <span
              class="absolute right-4 top-1/2 -translate-y-1/2 text-on-surface-variant/40 material-symbols-outlined">mail</span>
          </div>
          <p id="email-error" class="text-xs text-red-600 mt-1.5 flex items-center gap-1 font-medium hidden" role="alert">
            <span class="material-symbols-outlined text-[15px] shrink-0 leading-none">error</span>
            <span class="error-text"></span>
          </p>
        </div>

        <button type="submit"
          class="w-full py-4 rounded-lg font-label-md text-label-md uppercase tracking-widest hover:opacity-90 active:scale-[0.98] transition-all duration-300 shadow-sm bg-on-surface text-on-primary">
          Send OTP
        </button>
      </form>

      <!-- Footer Link -->
      <div class="mt-stack-lg pt-stack-lg border-t border-outline-variant/30 text-center">
        <a href="/login"
          class="inline-flex items-center gap-2 font-label-md text-label-md text-on-surface-variant hover:text-primary transition-colors duration-300">
          <span class="material-symbols-outlined text-[18px]">arrow_back</span>
          Return to Login
        </a>
      </div>
    </div>

    <!-- Supporting Brand Element -->
    <div class="mt-8 text-center">
      <p class="font-label-md text-label-md text-on-surface-variant/60 italic">
        "Health is the greatest wealth, and clarity is its companion."
      </p>
    </div>
  </div>
</main>

<style>
  .input-error {
    border-color: #ef4444 !important;
    box-shadow: 0 0 0 1px #ef4444 !important;
    background-color: rgba(254, 242, 242, 0.45) !important;
  }
  .input-error:focus {
    border-color: #ef4444 !important;
    box-shadow: 0 0 0 2px rgba(239, 68, 68, 0.35) !important;
  }
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const form = document.getElementById("resetForm");
  if (!form) return;

  const emailInput = document.getElementById("email");
  const emailError = document.getElementById("email-error");
  let touched = false;

  const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  function showError(message) {
    emailInput.classList.add("input-error");
    if (emailError) {
      const textSpan = emailError.querySelector(".error-text");
      if (textSpan) textSpan.textContent = message;
      emailError.classList.remove("hidden");
    }
  }

  function clearError() {
    emailInput.classList.remove("input-error");
    if (emailError) {
      const textSpan = emailError.querySelector(".error-text");
      if (textSpan) textSpan.textContent = "";
      emailError.classList.add("hidden");
    }
  }

  function validateEmail() {
    const val = (emailInput.value || "").trim();
    if (!val) {
      showError("Email address is required.");
      return false;
    }
    if (!emailRegex.test(val)) {
      showError("Please enter a valid email address.");
      return false;
    }
    clearError();
    return true;
  }

  emailInput.addEventListener("blur", function () {
    touched = true;
    validateEmail();
  });

  emailInput.addEventListener("input", function () {
    if (touched) validateEmail();
  });

  form.addEventListener("submit", async function (e) {
    e.preventDefault();
    touched = true;
    if (!validateEmail()) {
      emailInput.focus();
      return;
    }

    const submitBtn = form.querySelector('button[type="submit"]');
    const originalBtnHtml = submitBtn ? submitBtn.innerHTML : "";
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span class="material-symbols-outlined animate-spin" style="font-size: 18px;">progress_activity</span> Sending OTP...';
      submitBtn.style.opacity = "0.75";
    }

    try {
      const email = emailInput.value.trim();
      const res = await fetch("/forgotPassword", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "X-Requested-With": "XMLHttpRequest",
          "Accept": "application/json",
        },
        body: JSON.stringify({ email }),
      });

      const data = await res.json().catch(() => ({}));

      if (res.ok && data.success) {
        if (typeof showNotification === "function") {
          showNotification("success", data.message || "OTP sent successfully to your email.");
        }
        setTimeout(() => {
          window.location.href = data.redirectTo || "/verify-otp";
        }, 400);
      } else {
        const errorMsg = data.message || "Failed to send reset code. Please try again.";
        if (typeof showNotification === "function") {
          showNotification("error", errorMsg);
        }
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalBtnHtml;
          submitBtn.style.opacity = "";
        }
      }
    } catch (err) {
      console.error("Forgot password AJAX error:", err);
      if (typeof showNotification === "function") {
        showNotification("error", "An unexpected error occurred. Please try again.");
      }
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalBtnHtml;
        submitBtn.style.opacity = "";
      }
    }
  });
});
</script>

{{> user/footer}}