{{>user/header}}

<main class="flex-grow flex items-center justify-center px-container-padding py-section-gap relative z-10">
    <div class="w-full max-w-[480px] fade-in-up">

        <!-- Main Content Card -->
        <div class="bg-surface-container-lowest rounded-xl p-8 md:p-12 soft-shadow border border-ink-black/5">

            <!---->
            <div class="flex flex-col items-center text-center mb-stack-lg">
                <div
                    class="w-16 h-16 rounded-full bg-surface-container-high flex items-center justify-center mb-stack-md text-primary">
                    <span class="material-symbols-outlined text-[32px]">lock_reset</span>
                </div>
                <h2 class="font-headline-lg text-headline-lg text-on-surface mb-2">Forgot Password?</h2>
                <p class="font-body-md text-body-md text-on-surface-variant max-w-[320px]">
                    Enter the email address associated with your account and we'll send you a link to reset your
                    password.
                </p>
            </div>

            <!-- Form -->
            {{> user/notification}}

            <form id="resetForm" class="space-y-stack-lg" method="post" action="/forgotPassword">
                <div class="space-y-stack-sm">
                    <label for="email" class="font-label-md text-label-md text-on-surface-variant block ml-1">Email
                        Address</label>
                    <div class="relative">
                        <input type="email" id="email" name="email" required="" placeholder="name@example.com"
                            class="w-full bg-surface-gray border-none rounded-lg px-4 py-4 font-body-md text-body-md transition-all duration-300 focus:bg-surface-container-lowest">
                        <span
                            class="absolute right-4 top-1/2 -translate-y-1/2 text-on-surface-variant/40 material-symbols-outlined">mail</span>
                    </div>
                </div>

                <button type="submit"
                    class="w-full py-4 rounded-lg font-label-md text-label-md uppercase tracking-widest hover:opacity-90 active:scale-[0.98] transition-all duration-300 shadow-sm bg-on-surface text-on-primary">
                    Send OTP
                </button>
            </form>

            <!-- Footer Link -->
            <div class="mt-stack-lg pt-stack-lg border-t border-outline-variant/30 text-center">
                <a href="/login"
                    class="inline-flex items-center gap-2 font-label-md text-label-md text-on-surface-variant hover:text-primary transition-colors duration-300">
                    <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                    Return to Login
                </a>
            </div>
        </div>

        <!-- Supporting Brand Element -->
        <div class="mt-8 text-center">
            <p class="font-label-md text-label-md text-on-surface-variant/60 italic">
                "Health is the greatest wealth, and clarity is its companion."
            </p>
        </div>
    </div>
</main>

{{> user/footer}}