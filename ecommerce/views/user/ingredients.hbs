{{>user/header}}

<!-- Main Content Canvas -->
<main class="min-h-screen px-4 sm:px-6 md:px-8 pt-20 sm:pt-24 md:pt-28 pb-16 safe-bottom-padding bg-surface">
  <div class="max-w-max-width mx-auto px-2 sm:px-container-padding mt-2 sm:mt-4">
    {{> user/notification}}
  </div>

  <!-- Breadcrumb Navigation -->
  <nav class="max-w-max-width mx-auto mb-6 sm:mb-8" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-xs sm:text-sm text-on-surface-variant">
      <li>
        <a href="/" class="hover:text-on-surface transition-colors">Home</a>
      </li>
      <li class="flex items-center">
        <span class="material-symbols-outlined text-[14px] text-on-surface-variant/60">chevron_right</span>
      </li>
      <li class="text-on-surface font-semibold" aria-current="page">Ingredients</li>
    </ol>
  </nav>

  <!-- Hero Chapter: The Science of Pure Nutrition -->
  <section class="max-w-max-width mx-auto mb-12 sm:mb-20">
    <div
      class="relative rounded-3xl overflow-hidden bg-surface-container-low border border-secondary/10 shadow-sm p-6 sm:p-12 md:p-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">

        <div class="lg:col-span-7 space-y-4 sm:space-y-6">
          <div
            class="inline-flex items-center gap-2 border border-secondary/30 rounded-full px-3.5 py-1.5 w-fit bg-white/70 backdrop-blur-sm">
            <span class="w-2 h-2 rounded-full bg-accent-blue"></span>
            <span class="font-label-md text-xs sm:text-label-md text-on-surface">100% Clean Label Commitment</span>
          </div>

          <h1
            class="font-display-lg text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-on-surface tracking-tight leading-tight">
            Pure Nutrition. <br />
            <span class="italic font-light text-on-surface-variant">Rooted in Nature.</span>
          </h1>

          <p class="font-body-lg text-sm sm:text-base md:text-lg text-on-surface-variant leading-relaxed max-w-xl">
            We reject synthetic sweeteners, chemical fillers, and artificial preservatives. Every bar and burfi is
            composed exclusively of whole, nutrient-dense ingredients calibrated for sustained energy, gut wellness, and
            exceptional culinary indulgence.
          </p>

          <div class="flex flex-wrap gap-4 pt-2">
            <div
              class="flex items-center gap-2.5 px-4 py-2 rounded-2xl bg-white/80 border border-secondary/15 text-xs sm:text-sm font-semibold text-on-surface shadow-xs">
              <span class="material-symbols-outlined text-accent-blue text-[18px]">verified</span>
              Zero Added Sugar
            </div>
            <div
              class="flex items-center gap-2.5 px-4 py-2 rounded-2xl bg-white/80 border border-secondary/15 text-xs sm:text-sm font-semibold text-on-surface shadow-xs">
              <span class="material-symbols-outlined text-accent-blue text-[18px]">eco</span>
              Non-GMO & Gluten Free
            </div>
            <div
              class="flex items-center gap-2.5 px-4 py-2 rounded-2xl bg-white/80 border border-secondary/15 text-xs sm:text-sm font-semibold text-on-surface shadow-xs">
              <span class="material-symbols-outlined text-accent-blue text-[18px]">fitness_center</span>
              15g–20g Bioavailable Protein
            </div>
          </div>
        </div>

        <div
          class="lg:col-span-5 relative h-72 sm:h-96 rounded-2xl overflow-hidden shadow-lg border border-secondary/10">
          <img src="/images/about-ingredients.png" alt="Artisanal Whole Ingredients"
            class="w-full h-full object-cover transform hover:scale-105 transition-transform duration-700" />
        </div>

      </div>
    </div>
  </section>

  <!-- Core Ingredients Grid -->
  <section class="max-w-max-width mx-auto mb-16 sm:mb-24">
    <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-16">
      <span class="font-label-md text-xs uppercase tracking-widest text-primary font-bold">What Goes Inside</span>
      <h2 class="font-display-lg text-2xl sm:text-3xl md:text-4xl text-on-surface mt-2 font-bold tracking-tight">Our Six
        Pillars of Purity</h2>
      <p class="font-body-md text-xs sm:text-sm md:text-base text-on-surface-variant mt-3">Selected by clinical food
        scientists and master confectioners for optimal bioavailability and unparalleled taste.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">

      <!-- Ingredient 1: Whey Isolate -->
      <div
        class="group bg-surface-container-lowest rounded-3xl p-6 sm:p-8 border border-outline-variant/30 shadow-xs hover:shadow-md transition-all duration-300 flex flex-col justify-between hover:-translate-y-1">
        <div>
          <div class="flex items-center justify-between mb-5">
            <div class="w-12 h-12 rounded-2xl bg-accent-blue/10 flex items-center justify-center text-accent-blue">
              <span class="material-symbols-outlined text-[24px]">science</span>
            </div>
            <span
              class="px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-surface-container-high text-on-surface">Protein
              Matrix</span>
          </div>
          <h3 class="font-headline-lg text-lg sm:text-xl font-bold text-on-surface mb-2">Micro-Filtered Whey Isolate
          </h3>
          <p class="font-body-md text-xs sm:text-sm text-on-surface-variant leading-relaxed mb-4">
            Cross-flow micro-filtered (CFM) whey protein isolate delivers 90%+ pure protein with virtually all lactose,
            carbohydrates, and fats removed for rapid cellular absorption.
          </p>
        </div>
        <div
          class="pt-4 border-t border-outline-variant/20 flex items-center justify-between text-xs text-on-surface-variant font-medium">
          <span>Bioavailability Score</span>
          <span class="text-emerald-700 font-bold">104 (Highest Grade)</span>
        </div>
      </div>

      <!-- Ingredient 2: Medjool Dates -->
      <div
        class="group bg-surface-container-lowest rounded-3xl p-6 sm:p-8 border border-outline-variant/30 shadow-xs hover:shadow-md transition-all duration-300 flex flex-col justify-between hover:-translate-y-1">
        <div>
          <div class="flex items-center justify-between mb-5">
            <div class="w-12 h-12 rounded-2xl bg-amber-500/10 flex items-center justify-center text-amber-600">
              <span class="material-symbols-outlined text-[24px]">nutrition</span>
            </div>
            <span
              class="px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-surface-container-high text-on-surface">Whole-Food
              Sweetener</span>
          </div>
          <h3 class="font-headline-lg text-lg sm:text-xl font-bold text-on-surface mb-2">Medjool & Arabian Dates</h3>
          <p class="font-body-md text-xs sm:text-sm text-on-surface-variant leading-relaxed mb-4">
            Unrefined whole dates provide a velvety caramel sweetness packed with natural potassium, magnesium, and
            dietary fiber without triggering erratic insulin spikes.
          </p>
        </div>
        <div
          class="pt-4 border-t border-outline-variant/20 flex items-center justify-between text-xs text-on-surface-variant font-medium">
          <span>Glycemic Index</span>
          <span class="text-emerald-700 font-bold">Low (Natural Fiber Buffer)</span>
        </div>
      </div>

      <!-- Ingredient 3: California Almonds & Macadamia -->
      <div
        class="group bg-surface-container-lowest rounded-3xl p-6 sm:p-8 border border-outline-variant/30 shadow-xs hover:shadow-md transition-all duration-300 flex flex-col justify-between hover:-translate-y-1">
        <div>
          <div class="flex items-center justify-between mb-5">
            <div class="w-12 h-12 rounded-2xl bg-amber-700/10 flex items-center justify-center text-amber-800">
              <span class="material-symbols-outlined text-[24px]">energy_savings_leaf</span>
            </div>
            <span
              class="px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-surface-container-high text-on-surface">Cardio
              Vitality</span>
          </div>
          <h3 class="font-headline-lg text-lg sm:text-xl font-bold text-on-surface mb-2">Slow-Roasted Almonds</h3>
          <p class="font-body-md text-xs sm:text-sm text-on-surface-variant leading-relaxed mb-4">
            Whole California Mamra almonds dry-roasted to golden perfection. Abundant in heart-healthy monounsaturated
            oleic acid and potent antioxidant Vitamin E.
          </p>
        </div>
        <div
          class="pt-4 border-t border-outline-variant/20 flex items-center justify-between text-xs text-on-surface-variant font-medium">
          <span>Key Micronutrient</span>
          <span class="text-on-surface font-bold">Vitamin E + Oleic Acid</span>
