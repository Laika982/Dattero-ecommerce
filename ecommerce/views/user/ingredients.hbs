        class="group bg-surface-container-lowest rounded-3xl p-6 sm:p-8 border border-outline-variant/30 shadow-xs hover:shadow-md transition-all duration-300 flex flex-col justify-between hover:-translate-y-1">
        <div>
          <div class="flex items-center justify-between mb-5">
            <div class="w-12 h-12 rounded-2xl bg-stone-700/10 flex items-center justify-center text-stone-800">
              <span class="material-symbols-outlined text-[24px]">cookie</span>
            </div>
            <span
              class="px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-surface-container-high text-on-surface">Antioxidant
              Power</span>
          </div>
          <h3 class="font-headline-lg text-lg sm:text-xl font-bold text-on-surface mb-2">Raw Cacao & Cocoa Butter</h3>
          <p class="font-body-md text-xs sm:text-sm text-on-surface-variant leading-relaxed mb-4">
            Cold-pressed raw cacao liquor and pure unrefined cocoa butter. Rich in mood-boosting theobromine and
            cardiovascular-protective flavanols.
          </p>
        </div>
        <div
          class="pt-4 border-t border-outline-variant/20 flex items-center justify-between text-xs text-on-surface-variant font-medium">
          <span>ORAC Antioxidant Level</span>
          <span class="text-emerald-700 font-bold">Superfood Grade</span>
        </div>
      </div>

      <!-- Ingredient 5: Himalayan Pink Salt -->
      <div
        class="group bg-surface-container-lowest rounded-3xl p-6 sm:p-8 border border-outline-variant/30 shadow-xs hover:shadow-md transition-all duration-300 flex flex-col justify-between hover:-translate-y-1">
