{{>user/header}}
<div class="flex min-h-screen">
  {{> user/profileSidebar activeTab="orders"}}

  <!-- Main Content Area -->
  <main class="flex-1 w-full min-w-0 px-4 sm:px-6 md:px-8 pt-20 sm:pt-24 md:pt-28 md:ml-64 pb-16 safe-bottom-padding">

<div class="max-w-max-width mx-auto">
    <div class="mt-2 sm:mt-4 mb-4">
      {{> user/notification}}
    </div>

    <!-- Mobile Account Navigation Tabs with Scroll Option -->
    <div class="md:hidden mb-6">
      <div id="account-nav-tabs"
        class="flex items-center gap-2 overflow-x-auto pb-2 -mx-4 px-4 sm:-mx-6 sm:px-6 scroll-smooth select-none cursor-grab active:cursor-grabbing custom-nav-scrollbar">
        <a href="/profile" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-surface-container-high text-on-surface-variant text-xs font-semibold whitespace-nowrap hover:bg-surface-variant transition-colors touch-target flex-shrink-0">
          <span class="material-symbols-outlined text-[16px]">person</span>
          Profile
        </a>
        <a href="/order/orders" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-on-surface text-surface text-xs font-semibold whitespace-nowrap shadow-sm touch-target flex-shrink-0">
          <span class="material-symbols-outlined text-[16px]">shopping_bag</span>
          My Orders
        </a>
        <a href="/wallet" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-surface-container-high text-on-surface-variant text-xs font-semibold whitespace-nowrap hover:bg-surface-variant transition-colors touch-target flex-shrink-0">
          <span class="material-symbols-outlined text-[16px]">account_balance_wallet</span>
          Wallet
        </a>
        <a href="/wishlist" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-surface-container-high text-on-surface-variant text-xs font-semibold whitespace-nowrap hover:bg-surface-variant transition-colors touch-target flex-shrink-0">
          <span class="material-symbols-outlined text-[16px]">favorite</span>
          Wishlist
        </a>
        <a href="/profile/address" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-surface-container-high text-on-surface-variant text-xs font-semibold whitespace-nowrap hover:bg-surface-variant transition-colors touch-target flex-shrink-0">
          <span class="material-symbols-outlined text-[16px]">location_on</span>
          Address Book
        </a>
      </div>
    </div>

    <!-- Page Header -->
    <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl md:text-3xl font-bold text-on-surface tracking-tight">My Orders</h1>
            <p class="text-sm text-on-surface-variant mt-1">Review your past purchases and track your deliveries</p>
        </div>
    </div>

    <!-- Search Bar -->
    <div class="mb-6">
        <form id="orderSearchForm" action="/order/orders" method="GET" class="relative flex items-center gap-2">
            {{#unless isAll}}
            <input type="hidden" name="status" value="{{currentStatus}}">
            {{/unless}}
            <div class="relative flex-1 flex items-center">
                <!-- Search Icon -->
                <span class="material-symbols-outlined absolute left-3.5 text-on-surface-variant/70 text-[20px] pointer-events-none select-none">
                    search
                </span>

                <!-- Search Input -->
                <input 
                    type="text" 
                    id="orderSearchInput" 
                    name="search" 
                    value="{{search}}"
                    placeholder="Search by order ID or product name..." 
                    autocomplete="off"
                    class="w-full bg-surface border border-outline/20 rounded-xl pl-10 pr-10 py-2.5 text-body-md text-on-surface placeholder:text-on-surface-variant/60 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/40 transition-all shadow-sm"
                >

                <!-- Clear Button -->
                <button 
                    type="button" 
                    id="orderSearchClearBtn" 
                    onclick="clearOrderSearch()" 
                    class="{{#if search}}flex{{else}}hidden{{/if}} absolute right-3 w-6 h-6 rounded-full items-center justify-center text-on-surface-variant/70 hover:text-on-surface hover:bg-surface-container-high transition-all active:scale-90 cursor-pointer"
                    title="Clear search text"
                    aria-label="Clear search input"
                >
                    <span class="material-symbols-outlined text-[18px]">close</span>
                </button>
            </div>

            <!-- Search Button -->
            <button 
                type="submit" 
                id="orderSearchBtn"
                class="px-5 py-2.5 bg-on-surface text-surface rounded-xl font-label-md text-sm hover:bg-primary transition-all active:scale-95 flex items-center gap-1.5 shrink-0 shadow-sm font-medium cursor-pointer"
            >
                <span class="material-symbols-outlined text-[18px]">search</span>
                <span>Search</span>
            </button>
        </form>
    </div>

    <!-- Filter Chips -->
    <div class="flex gap-2 sm:gap-3 mb-8 overflow-x-auto pb-2 scrollbar-hide">
        <a 
            href="/order/orders{{#if search}}?search={{search}}{{/if}}" 
            class="px-5 py-2 rounded-full text-label-md transition-all shrink-0 font-medium {{#if isAll}}bg-on-surface text-surface shadow-sm{{else}}border border-outline/20 text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface{{/if}}"
        >
            All Orders
        </a>
        <a 
            href="/order/orders?status=pending{{#if search}}&search={{search}}{{/if}}" 
            class="px-5 py-2 rounded-full text-label-md transition-all shrink-0 font-medium {{#if isPending}}bg-on-surface text-surface shadow-sm{{else}}border border-outline/20 text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface{{/if}}"
        >
            Pending
        </a>
        <a 
            href="/order/orders?status=failed{{#if search}}&search={{search}}{{/if}}" 
            class="px-5 py-2 rounded-full text-label-md transition-all shrink-0 font-medium {{#if isFailed}}bg-on-surface text-surface shadow-sm{{else}}border border-outline/20 text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface{{/if}}"
        >
            Failed
        </a>
        <a 
            href="/order/orders?status=in_transit{{#if search}}&search={{search}}{{/if}}" 
            class="px-5 py-2 rounded-full text-label-md transition-all shrink-0 font-medium {{#if isInTransit}}bg-on-surface text-surface shadow-sm{{else}}border border-outline/20 text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface{{/if}}"
        >
            In Transit
        </a>
        <a 
            href="/order/orders?status=delivered{{#if search}}&search={{search}}{{/if}}" 
            class="px-5 py-2 rounded-full text-label-md transition-all shrink-0 font-medium {{#if isDelivered}}bg-on-surface text-surface shadow-sm{{else}}border border-outline/20 text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface{{/if}}"
        >
            Delivered
        </a>
        <a 
            href="/order/orders?status=cancelled{{#if search}}&search={{search}}{{/if}}" 
            class="px-5 py-2 rounded-full text-label-md transition-all shrink-0 font-medium {{#if isCancelled}}bg-on-surface text-surface shadow-sm{{else}}border border-outline/20 text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface{{/if}}"
        >
            Cancelled
        </a>
        <a 
            href="/order/orders?status=returned{{#if search}}&search={{search}}{{/if}}" 
            class="px-5 py-2 rounded-full text-label-md transition-all shrink-0 font-medium {{#if isReturned}}bg-on-surface text-surface shadow-sm{{else}}border border-outline/20 text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface{{/if}}"
        >
            Returned
        </a>
    </div>

<!-- Orders List -->
<div class="space-y-6">

    {{#if orders.length}}

        {{#each orders}}
        <div class="order-card-item bg-surface rounded-xl p-6 order-card-shadow border border-on-surface/5 group hover:border-primary/20 transition-all duration-300">

            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6">

                <div class="flex items-center gap-4">

                    <div class="w-16 h-16 rounded-lg bg-surface-container overflow-hidden">

                        {{#if this.items.[0].product_image}}
                        <img
                            class="w-full h-full object-cover"
                            src="{{this.items.[0].product_image}}"
                            alt="{{this.items.[0].product_name}}"
                        >
                        {{else}}
                        <div class="w-full h-full flex items-center justify-center">
                            <span class="material-symbols-outlined text-on-surface-variant">image</span>
                        </div>
                        {{/if}}

                    </div>

                    <div>
                        <h3 class="font-label-md text-on-surface text-lg">
                            {{this.items.[0].product_name}}
                            {{#if this.items.length}}
                                {{#if (gt this.items.length 1)}}
                                    <span class="text-sm text-on-surface-variant font-normal">
                                        +{{subtract this.items.length 1}} more
                                    </span>
                                {{/if}}
                            {{/if}}
                        </h3>

                        <p class="text-sm text-on-surface-variant font-medium">
                            Order #{{this.order_id}} • {{formatDate this.createdAt}}
                        </p>
                    </div>

                </div>

                <div class="w-full md:w-auto flex flex-row md:flex-col justify-between md:justify-center items-center md:items-end mt-2 md:mt-0">

                    {{#if (eq this.payment_status "failed")}}
                    <span class="px-3 py-1 rounded-full bg-red-100 text-red-700 text-[11px] font-bold tracking-widest uppercase mb-0 md:mb-2 flex items-center gap-1.5 shadow-xs">
                        <span class="w-1.5 h-1.5 rounded-full bg-red-600"></span>
                        Payment Failed
                    </span>
                    {{else}}
                    <span class="px-3 py-1 rounded-full bg-secondary-container text-on-surface text-[11px] font-bold tracking-widest uppercase mb-0 md:mb-2">
                        {{formatStatus this.order_status}}
                    </span>
                    {{/if}}

                    <span class="font-headline-lg text-on-surface text-xl sm:text-2xl">
                        ₹{{this.final_amount}}
                    </span>

                </div>

            </div>

            <div class="h-px bg-on-surface/5 w-full mb-6"></div>

            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">

                <div class="flex items-center gap-2 text-on-surface-variant text-sm">

                    {{#if (eq this.payment_status "failed")}}

                        <span class="material-symbols-outlined text-red-600 scale-90">error</span>
                        <span class="text-red-600 font-medium">Payment was unsuccessful</span>

                    {{else if (eq this.order_status "return_requested")}}

                        <span class="material-symbols-outlined text-primary scale-90">assignment_return</span>
                        <span>Return requested</span>

                    {{else if (eq this.order_status "delivered")}}

                        <span
                            class="material-symbols-outlined text-green-600 scale-90"
                            style="font-variation-settings: 'FILL' 1;"
                        >
                            check_circle
                        </span>

                        <span>
                            Delivered
                        </span>

                    {{else if (eq this.order_status "cancelled")}}

                        <span class="material-symbols-outlined text-red-600 scale-90">cancel</span>
                        <span class="text-red-600 font-medium">Order cancelled</span>

                    {{else}}

                        <span class="material-symbols-outlined text-primary scale-90">
                            local_shipping
                        </span>

                        <span>
                            Order placed successfully
                        </span>

                    {{/if}}

                </div>

                <div class="flex gap-3">

                    <a
                        href="/order/orders/{{this.order_id}}"
                        class="px-5 py-2 rounded-lg border border-outline text-label-md hover:bg-surface-container-high transition-colors"
                    >
                        View Details
                    </a>

                    {{#if (eq this.payment_status "failed")}}

                        <a
                            href="/checkout?orderId={{this.order_id}}&fresh=1"
                            class="px-5 py-2 rounded-lg bg-on-surface text-surface text-label-md hover:bg-primary transition-colors flex items-center gap-1.5 font-medium shadow-sm active:scale-95 cursor-pointer"
                        >
                            <span class="material-symbols-outlined text-[16px]">refresh</span>
                            <span>Retry Payment</span>
                        </a>

                    {{else if (eq this.order_status "delivered")}}

                        <form action="/order/orders/{{this.order_id}}/buy-again" method="POST" class="buy-again-form">
                            <button
                                type="submit"
                                class="px-5 py-2 rounded-lg border border-outline text-label-md hover:bg-surface-container-high transition-colors"
                            >
                                Buy Again
                            </button>
                        </form>

                    {{else if (ne this.order_status "cancelled")}}

                        <a
                            href="/order/orders/{{this.order_id}}/track"
                            class="px-5 py-2 rounded-lg bg-on-surface text-surface text-label-md hover:bg-primary transition-colors"
                        >
                            Track Order
                        </a>

                    {{/if}}

                </div>

            </div>

        </div>
        {{/each}}

    {{else}}

        <div class="py-16 px-4 text-center bg-surface rounded-xl border border-dashed border-outline/30">

            <div class="w-14 h-14 mx-auto mb-3 rounded-full bg-surface-container flex items-center justify-center text-on-surface-variant">
                <span class="material-symbols-outlined text-2xl">receipt_long</span>
            </div>

            <h3 class="font-headline-md text-lg font-semibold text-on-surface">
                {{#if hasFilter}}
                    No orders found
                {{else}}
                    No orders yet
                {{/if}}
            </h3>

            <p class="text-sm text-on-surface-variant mt-1">
                {{#if search}}
                    We couldn't find any orders matching "{{search}}"{{#unless isAll}} with status "{{currentStatusLabel}}"{{/unless}}.
                {{else}}
                    {{#unless isAll}}
                        You don't have any orders with status "{{currentStatusLabel}}".
                    {{else}}
                        Your orders will appear here after you place an order.
                    {{/unless}}
                {{/if}}
            </p>

            {{#if hasFilter}}
            <a href="/order/orders" class="mt-4 px-4 py-2 rounded-lg bg-surface-container-high text-on-surface text-sm font-medium hover:bg-surface-container transition-colors inline-flex items-center gap-1.5 active:scale-95 cursor-pointer">
                <span class="material-symbols-outlined text-[18px]">clear_all</span>
                Clear filter
            </a>
            {{/if}}

        </div>

    {{/if}}

</div>

<!-- Pagination/Load More -->

<div class="mt-12 flex flex-col sm:flex-row items-center justify-between gap-4 pt-6 border-t border-on-surface/5">

    <p class="text-xs text-on-surface-variant font-medium order-2 sm:order-1">
        Showing
        <span id="visibleOrdersCount" class="text-on-surface font-semibold">
            {{orders.length}}
        </span>
        of
        <span id="totalOrdersCount" class="text-on-surface font-semibold">
            {{totalOrders}}
        </span>
        orders
    </p>

    {{#if totalPages}}
    <nav class="flex items-center gap-1.5 order-1 sm:order-2" aria-label="Orders pagination">

        {{#if (gt currentPage 1)}}
        <a
            href="/order/orders?page={{subtract currentPage 1}}{{#if search}}&search={{search}}{{/if}}{{#unless isAll}}&status={{currentStatus}}{{/unless}}"
            class="px-3 py-1.5 rounded-lg border border-outline/20 text-on-surface-variant text-label-md hover:bg-surface-container-high hover:text-on-surface transition-colors flex items-center gap-1"
            aria-label="Previous page"
        >
            <span class="material-symbols-outlined text-sm">chevron_left</span>
            <span class="hidden sm:inline">Prev</span>
        </a>
        {{else}}
        <button
            class="px-3 py-1.5 rounded-lg border border-outline/20 text-on-surface-variant text-label-md hover:bg-surface-container-high hover:text-on-surface transition-colors flex items-center gap-1 opacity-50 cursor-not-allowed"
            disabled
            aria-label="Previous page"
        >
            <span class="material-symbols-outlined text-sm">chevron_left</span>
            <span class="hidden sm:inline">Prev</span>
        </button>
        {{/if}}

        {{#each (range 1 totalPages)}}
            {{#if (eq this ../currentPage)}}
            <a
                href="/order/orders?page={{this}}{{#if ../search}}&search={{../search}}{{/if}}{{#unless ../isAll}}&status={{../currentStatus}}{{/unless}}"
                class="w-8 h-8 rounded-lg bg-on-surface text-surface text-label-md font-semibold flex items-center justify-center shadow-sm"
                aria-current="page"
            >
                {{this}}
            </a>
            {{else}}
            <a
                href="/order/orders?page={{this}}{{#if ../search}}&search={{../search}}{{/if}}{{#unless ../isAll}}&status={{../currentStatus}}{{/unless}}"
                class="w-8 h-8 rounded-lg border border-outline/20 text-on-surface-variant text-label-md hover:bg-surface-container-high hover:text-on-surface transition-colors flex items-center justify-center"
            >
                {{this}}
            </a>
            {{/if}}
        {{/each}}

        {{#if (lt currentPage totalPages)}}
        <a
            href="/order/orders?page={{add currentPage 1}}{{#if search}}&search={{search}}{{/if}}{{#unless isAll}}&status={{currentStatus}}{{/unless}}"
            class="px-3 py-1.5 rounded-lg border border-outline/20 text-on-surface text-label-md hover:bg-surface-container-high transition-colors flex items-center gap-1"
            aria-label="Next page"
        >
            <span class="hidden sm:inline">Next</span>
            <span class="material-symbols-outlined text-sm">chevron_right</span>
        </a>
        {{else}}
        <button
            class="px-3 py-1.5 rounded-lg border border-outline/20 text-on-surface text-label-md hover:bg-surface-container-high transition-colors flex items-center gap-1 opacity-50 cursor-not-allowed"
            disabled
            aria-label="Next page"
        >
            <span class="hidden sm:inline">Next</span>
            <span class="material-symbols-outlined text-sm">chevron_right</span>
        </button>
        {{/if}}

    </nav>
    {{/if}}

    </div>
  </div>
  </main>
</div>

<script>
    // Search elements
    const searchInput = document.getElementById('orderSearchInput');
    const clearBtn = document.getElementById('orderSearchClearBtn');

    // Toggle clear button visibility dynamically based on text content
    function updateClearButtonState() {
        if (!searchInput || !clearBtn) return;
        if (searchInput.value.trim().length > 0) {
            clearBtn.classList.remove('hidden');
            clearBtn.classList.add('flex');
        } else {
            clearBtn.classList.add('hidden');
            clearBtn.classList.remove('flex');
        }
    }

    // Clear search input text and reset URL
    function clearOrderSearch() {
        if (!searchInput) return;
        searchInput.value = '';
        updateClearButtonState();

        const url = new URL(window.location.href);
        url.searchParams.delete('search');
        url.searchParams.delete('page');
        window.location.href = url.pathname + (url.searchParams.toString() ? '?' + url.searchParams.toString() : '');
    }

    if (searchInput) {
        searchInput.addEventListener('input', () => {
            updateClearButtonState();
        });

        searchInput.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                clearOrderSearch();
            }
        });
    }





    // Micro-interaction: Smooth hover effect for cards

    document.querySelectorAll('.order-card-shadow').forEach(card => {

        card.addEventListener('mouseenter', () => {

            card.style.transform = 'translateY(-4px)';

        });

        card.addEventListener('mouseleave', () => {

            card.style.transform = 'translateY(0)';

        });

    });



    // Add active: scale effect to buttons

    document.querySelectorAll('button').forEach(btn => {

        btn.addEventListener('mousedown', () => {

            btn.style.transform = 'scale(0.97)';

        });

        btn.addEventListener('mouseup', () => {

            btn.style.transform = 'scale(1)';

        });

    });

    // Handle Buy Again forms via AJAX
    document.addEventListener('submit', async (e) => {
        const form = e.target.closest('.buy-again-form');
        if (!form) return;
        e.preventDefault();

        const btn = form.querySelector('button[type="submit"]');
        const originalText = btn ? btn.innerHTML : '';
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<span class="material-symbols-outlined animate-spin text-[16px] inline-block align-middle mr-1">sync</span> Adding...';
        }

        try {
            const response = await fetch(form.action, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Accept': 'application/json'
                }
            });
            const data = await response.json().catch(() => ({}));
            if (response.ok && data.success) {
                if (window.showNotification) {
                    window.showNotification('success', data.message || 'Products added to cart');
                }
                setTimeout(() => {
                    window.location.href = data.redirectTo || '/cart';
                }, 600);
            } else {
                const errMsg = data.message || 'Failed to add items to cart.';
                if (window.showNotification) {
                    window.showNotification('error', errMsg);
                } else {
                    alert(errMsg);
                }
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = originalText;
                }
            }
        } catch (err) {
            console.error('Buy again error:', err);
            if (window.showNotification) {
                window.showNotification('error', 'Network error. Please try again.');
            }
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = originalText;
            }
        }
    });

    // Account navigation tabs scrolling & drag interactions
    const navTabs = document.getElementById('account-nav-tabs');
    if (navTabs) {
        // Auto-center active tab
        const activeTab = navTabs.querySelector('.bg-on-surface');
        if (activeTab) {
            activeTab.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
        }

        // Mouse wheel horizontal scroll support
        navTabs.addEventListener('wheel', (e) => {
            if (e.deltaY !== 0) {
                e.preventDefault();
                navTabs.scrollLeft += e.deltaY;
            }
        }, { passive: false });

        // Click and drag to scroll support
        let isDown = false;
        let startX;
        let scrollLeftStart;

        navTabs.addEventListener('mousedown', (e) => {
            isDown = true;
            startX = e.pageX - navTabs.offsetLeft;
            scrollLeftStart = navTabs.scrollLeft;
        });

        window.addEventListener('mouseup', () => {
            isDown = false;
        });

        navTabs.addEventListener('mousemove', (e) => {
            if (!isDown) return;
            e.preventDefault();
            const x = e.pageX - navTabs.offsetLeft;
            const walk = (x - startX) * 1.5;
            navTabs.scrollLeft = scrollLeftStart - walk;
        });
    }
</script>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
    async function handleRetryPayment(orderId) {
        if (!orderId) return;
        try {
            if (window.showNotification) {
                window.showNotification('info', 'Initiating payment...');
            }

            const response = await fetch(`/order/orders/${encodeURIComponent(orderId)}/retry-payment`, {
                method: 'POST',
                headers: {
                    'Accept': 'application/json',
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest',
                },
            });
            const data = await response.json();

            if (!response.ok || !data.success) {
                throw new Error(data.message || 'Unable to initiate payment retry.');
            }

            if (!window.Razorpay) {
                throw new Error('Payment gateway failed to load. Please check your internet connection.');
            }

            const checkout = new window.Razorpay({
                key: data.key,
                amount: data.order.amount,
                currency: data.order.currency,
                name: 'Nutri Burfi',
                description: `Payment for Order #${orderId}`,
                order_id: data.order.id,
                prefill: data.prefill,
                theme: { color: '#7b5900' },
                modal: {
                    ondismiss: function () {
                        if (window.showNotification) {
                            window.showNotification('info', 'Payment checkout closed. You can retry anytime.');
                        }
                    },
                },
                handler: async function (paymentResult) {
                    try {
                        const verifyRes = await fetch(`/order/orders/${encodeURIComponent(orderId)}/verify-retry-payment`, {
                            method: 'POST',
                            headers: {
                                'Accept': 'application/json',
                                'Content-Type': 'application/json',
                                'X-Requested-With': 'XMLHttpRequest',
                            },
                            body: JSON.stringify(paymentResult),
                        });
                        const verifyData = await verifyRes.json();

                        if (verifyRes.ok && verifyData.success) {
                            if (window.showNotification) {
                                window.showNotification('success', 'Payment successful! Order updated.');
                            }
                            setTimeout(() => {
                                window.location.href = `/order/order-success/${encodeURIComponent(orderId)}`;
                            }, 500);
                        } else {
                            throw new Error(verifyData.message || 'Payment verification failed.');
                        }
                    } catch (verifyErr) {
                        if (window.showNotification) {
                            window.showNotification('error', verifyErr.message || 'Payment verification failed.');
                        } else {
                            alert(verifyErr.message || 'Payment verification failed.');
                        }
                    }
                },
            });

            checkout.on('payment.failed', function (paymentEvent) {
                if (window.showNotification) {
                    window.showNotification('error', paymentEvent.error?.description || 'Payment failed. You can try again.');
                }
            });

            checkout.open();
        } catch (err) {
            console.error('Retry payment error:', err);
            if (window.showNotification) {
                window.showNotification('error', err.message || 'Unable to retry payment.');
            } else {
                alert(err.message || 'Unable to retry payment.');
            }
        }
    }
</script>

