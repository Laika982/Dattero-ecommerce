{{>user/header}}
<!-- Main Content Canvas -->
<main class="pt-32 pb-section-gap px-container-padding max-w-max-width mx-auto">
    <div class="max-w-max-width mx-auto px-container-padding mt-6">
    {{> user/notification}}
</div>
<!-- Hero Success Header -->
<section class="flex flex-col items-center text-center mb-section-gap fade-in-up" style="animation-delay: 0s;">
<div class="w-20 h-20 mb-stack-lg rounded-full bg-primary-container flex items-center justify-center text-on-primary-container shadow-lg">
<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
<path class="success-checkmark" d="M5 13l4 4L19 7" stroke-dasharray="100" stroke-dashoffset="100" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"></path>
</svg>
</div>
<h1 class="font-display-lg text-display-lg md:text-display-lg text-on-surface mb-stack-sm fade-in-up" style="animation-delay: 0.15s;">Thank You for Your Order.</h1>
<p class="font-body-xl text-body-xl text-on-surface-variant max-w-2xl">Your journey to handcrafted luxury wellness begins now. We've received your order and our artisans are preparing your selection.</p>
</section>
<!-- Order Summary Grid -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-grid-gutter fade-in-up" style="animation-delay: 0.3s;">
<!-- Details Column -->
<div class="lg:col-span-8 space-y-stack-lg">
<!-- Confirmation Details Card -->
<div class="bg-surface-container-lowest p-stack-lg rounded-xl shadow-[0_40px_40px_-15px_rgba(45,27,14,0.04)] border border-on-surface/5">
<div class="grid grid-cols-2 md:grid-cols-4 gap-stack-lg">
<div>
<p class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider mb-1">Order Number</p>
<p class="font-body-lg text-body-lg font-semibold text-primary">#{{order.order_id}}</p>
</div>
<div>
<p class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider mb-1">Date</p>
<p class="font-body-lg text-body-lg text-on-surface">{{orderDate}}</p>
</div>
<div>
<p class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider mb-1">Delivery Estimate</p>
<p class="font-body-lg text-body-lg text-on-surface">Pending</p>
</div>
<div>
<p class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider mb-1">Method</p>
<p class="font-body-lg text-body-lg text-on-surface">{{paymentMethodLabel}}</p>
</div>
</div>
</div>
<!-- Product List Card -->
<div class="bg-surface-container-lowest p-stack-lg rounded-xl shadow-[0_40px_40px_-15px_rgba(45,27,14,0.04)] border border-on-surface/5">
<h2 class="font-headline-lg text-headline-lg mb-stack-lg border-b border-surface-variant pb-stack-md">Order Summary</h2>
<div class="space-y-stack-lg">
{{#each order.items}}
<div class="flex items-center gap-stack-lg group">
<div class="w-24 h-24 rounded-lg bg-surface-gray overflow-hidden flex-shrink-0">
<img class="w-full h-full object-cover" src="{{this.product_image}}" alt="{{this.product_name}}">
</div>
<div class="flex-grow min-w-0">
<div class="flex justify-between items-start gap-4">
<div>
<h3 class="font-body-xl text-body-xl font-semibold text-on-surface">{{this.product_name}}</h3>
<p class="font-body-md text-body-md text-on-surface-variant">{{this.weight}} | SKU: {{this.sku}}</p>
</div>
<p class="font-body-lg text-body-lg font-bold whitespace-nowrap">₹{{this.item_total}}</p>
</div>
<p class="mt-2 text-sm text-on-surface-variant">Quantity: {{this.quantity}}</p>
</div>
</div>
{{/each}}
</div>
</div>
</div>
<!-- Totals Column -->
<div class="lg:col-span-4 space-y-stack-lg">
<!-- Billing Summary -->
<div class="bg-surface-container-high p-stack-lg rounded-xl shadow-[0_40px_40px_-15px_rgba(45,27,14,0.04)] sticky top-24">
<h3 class="font-headline-lg text-headline-lg mb-stack-lg">Total Amount</h3>
<div class="space-y-stack-md">
<div class="flex justify-between items-center pb-2 mb-2 border-b border-on-surface/5"></div><div class="flex justify-between font-body-md text-body-md text-on-surface-variant">
<span class="">Subtotal</span>
<span class="">₹{{order.subtotal}}</span>
</div>
<div class="flex justify-between font-body-md text-body-md text-on-surface-variant">
<span class="">Shipping</span>
<span class="text-primary font-semibold">₹{{order.shipping_charge}}</span>
</div>
<div class="flex justify-between font-body-md text-body-md text-on-surface-variant">
<span class="">Tax</span>
<span class="">₹{{order.tax}}</span>
</div>
<div class="pt-stack-md border-t border-on-surface/10 flex justify-between font-body-xl text-body-xl font-bold text-on-surface">
<span class="">Total</span>
<span class="">₹{{order.final_amount}}</span>
</div>
</div>
<!-- Action Buttons -->
<div class="mt-stack-lg space-y-stack-md">
<a href="/products" class="w-full py-4 px-6 font-semibold rounded-lg shadow-sm hover:opacity-90 transition-all active:scale-[0.98] cursor-pointer bg-ink-black text-on-primary inline-flex items-center justify-center">Continue Shopping</a>
<a href="/order/orders" class="w-full py-4 px-6 border border-primary text-primary font-semibold rounded-lg hover:bg-primary/5 transition-all active:scale-[0.98] cursor-pointer inline-flex items-center justify-center">View Orders</a>
</div>
<div class="mt-stack-lg p-stack-md bg-white/40 rounded-lg border border-on-surface/5">
<div class="flex gap-stack-md items-start">
<span class="material-symbols-outlined text-primary">local_shipping</span>
<div>
<p class="font-label-md text-label-md font-bold">Shipping Updates</p>
<p class="font-body-md text-body-md text-on-surface-variant mt-1">We'll text you when your order is out for delivery.</p>
</div>
</div>
</div>
</div>
</div>
</div>
<!-- Secondary CTA/Support Section -->
<section class="mt-section-gap grid grid-cols-1 md:grid-cols-3 gap-grid-gutter fade-in-up" style="animation-delay: 0.45s;">
<div class="p-stack-lg bg-surface-container rounded-xl text-center">
<span class="material-symbols-outlined text-primary text-3xl mb-stack-sm">help</span>
<h4 class="font-headline-lg text-[20px] mb-2">Need Help?</h4>
<p class="text-on-surface-variant">Our concierge is available 24/7 to assist with your order.</p>
<a class="mt-4 inline-block text-primary font-semibold hover:underline" href="#">Contact Support</a>
</div>
<div class="p-stack-lg bg-surface-container rounded-xl text-center">
<span class="material-symbols-outlined text-primary text-3xl mb-stack-sm">redeem</span>
<h4 class="font-headline-lg text-[20px] mb-2">Gift Luxe</h4>
<p class="text-on-surface-variant">Refer a friend and you both receive a wellness gift set.</p>
<a class="mt-4 inline-block text-primary font-semibold hover:underline" href="#">Refer Now</a>
</div>
<div class="p-stack-lg bg-surface-container rounded-xl text-center">
<span class="material-symbols-outlined text-primary text-3xl mb-stack-sm">verified_user</span>
<h4 class="font-headline-lg text-[20px] mb-2">Purity Guard</h4>
<p class="text-on-surface-variant">Our 100-day wellness guarantee ensures your satisfaction.</p>
<a class="mt-4 inline-block text-primary font-semibold hover:underline" href="#">Learn More</a>
</div>
</section>
</main>
<!-- Footer -->
<footer class="bg-surface-container-high w-full pt-section-gap pb-stack-lg border-t border-secondary/10">
<div class="grid grid-cols-1 md:grid-cols-4 gap-grid-gutter px-container-padding max-w-max-width mx-auto">
<!-- Brand Column -->
<div class="flex flex-col gap-6 col-span-1 md:col-span-1">
<span class="font-headline-lg text-headline-lg font-bold text-on-surface tracking-tight">Nutri Burfi</span>
<p class="font-body-md text-body-md text-on-surface-variant max-w-xs">
                    Elevating functional nutrition through the art of traditional craftsmanship. Premium protein sweets for the modern lifestyle.
                </p>
<div class="flex gap-4 mt-2">
<!-- Social Icons placeholders -->
<a class="text-on-surface-variant hover:text-accent-blue transition-colors" href="#">
<span class="material-symbols-outlined" data-icon="share">share</span>
</a>
</div>
</div>
<!-- Links Column 1 -->
<div class="flex flex-col gap-4">
<h4 class="font-label-md text-label-md text-on-surface mb-2">Shop</h4>
<a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface hover:translate-x-1 transition-transform duration-200" href="#">Shop All</a>
<a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface hover:translate-x-1 transition-transform duration-200" href="#">Protein Burfi</a>
<a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface hover:translate-x-1 transition-transform duration-200" href="#">Performance Bars</a>
<a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface hover:translate-x-1 transition-transform duration-200" href="#">Wholesale</a>
</div>
<!-- Links Column 2 -->
<div class="flex flex-col gap-4">
<h4 class="font-label-md text-label-md text-on-surface mb-2">About</h4>
<a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface hover:translate-x-1 transition-transform duration-200" href="#">Our Story</a>
<a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface hover:translate-x-1 transition-transform duration-200" href="#">Ingredients</a>
<a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface hover:translate-x-1 transition-transform duration-200" href="#">Nutritional Science</a>
<a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface hover:translate-x-1 transition-transform duration-200" href="#">Contact Us</a>
</div>
<!-- Links Column 3 -->
<div class="flex flex-col gap-4">
<h4 class="font-label-md text-label-md text-on-surface mb-2">Support</h4>
<a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface hover:translate-x-1 transition-transform duration-200" href="#">FAQ</a>
<a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface hover:translate-x-1 transition-transform duration-200" href="#">Shipping Info</a>
<a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface hover:translate-x-1 transition-transform duration-200" href="#">Returns</a>
<a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface hover:translate-x-1 transition-transform duration-200" href="#">Privacy Policy</a>
</div>
<!-- Bottom Copyright -->
<div class="col-span-1 md:col-span-4 mt-12 pt-8 border-t border-secondary/10 flex flex-col md:flex-row justify-between items-center gap-4">
<p class="font-label-md text-[10px] text-on-surface-variant font-normal">© 2024 Nutri Burfi. Handcrafted Protein Excellence.</p>
<div class="flex gap-4 p-8 min-h-[300px]">
<!-- Payment icons placeholder -->
<span class="font-label-md text-[10px] text-on-surface-variant font-normal">Secure Checkout</span>
</div>
</div>
</div>
</footer>
<script>
        // Simple entrance animations handler
        document.addEventListener('DOMContentLoaded', () => {
            const faders = document.querySelectorAll('.fade-in-up');
            faders.forEach((fader, index) => {
                fader.style.animationDelay = `${index * 0.15}s`;
            });
        });

        // Hover micro-interaction for primary button
        const mainBtn = document.querySelector('button.bg-primary-container');
        if(mainBtn) {
            mainBtn.addEventListener('mousemove', (e) => {
                const rect = mainBtn.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                mainBtn.style.setProperty('--x', `${x}px`);
                mainBtn.style.setProperty('--y', `${y}px`);
            });
        }
    </script>
<div id="snapdom-sandbox" data-snapdom-sandbox="true" aria-hidden="true" style="position: absolute; left: -9999px; top: -9999px; width: 0px; height: 0px; overflow: hidden;"></div>







</body></html>