<script>

    async function toggleProductWishlist(button, event) {
        event.preventDefault();
        event.stopPropagation();
        if (button.disabled) return;

        const isAuthenticated = {{#if user}}true{{else}}false{{/if}};
    if (!isAuthenticated) {
        showNotification("error", "Please log in to add items to wishlist.");
        setTimeout(() => {
            window.location.href = "/login";
        }, 1200);
        return;
    }

    const wasWishlisted = button.dataset.wishlisted === "true";
    button.disabled = true;
    try {
        const response = await fetch(`/wishlist/${wasWishlisted ? "remove" : "add"}/${button.dataset.productId}`, {
            method: wasWishlisted ? "DELETE" : "POST",
            headers: { "Accept": "application/json" }
        });
        const result = await response.json();

        if (response.status === 401 || result.redirectTo) {
            showNotification("error", result.message || "Please log in to add items to wishlist.");
            setTimeout(() => {
                window.location.href = result.redirectTo || "/login";
            }, 1200);
            return;
        }

        if (!response.ok) {
            throw new Error(result.message || "Unable to update your wishlist.");
        }

        const isWishlisted = !wasWishlisted;
        button.dataset.wishlisted = String(isWishlisted);
        button.setAttribute("aria-pressed", String(isWishlisted));
        button.classList.toggle("bg-red-500", isWishlisted);
        button.classList.toggle("bg-white/90", !isWishlisted);
        button.classList.toggle("hover:bg-red-600", isWishlisted);
        button.classList.toggle("hover:bg-white", !isWishlisted);
        button.querySelector(".material-symbols-outlined").classList.toggle("text-white", isWishlisted);
        button.querySelector(".material-symbols-outlined").classList.toggle("text-ink-black", !isWishlisted);
    } catch (error) {
        window.alert(error.message);
    } finally {
        button.disabled = false;
    }
    }

    // -------------------------------
    // Change main product image
    // -------------------------------

    function changeProductImage(url) {

        const mainImage =
            document.getElementById("mainProductImage");

        if (!mainImage) return;

        mainImage.src = url;
    }


    // -------------------------------
    // Quantity
    // -------------------------------

    function increaseQuantity() {

        const quantity =
            document.getElementById("quantity");

        if (!quantity) return;

        quantity.value =
            Number(quantity.value) + 1;
    }


    function decreaseQuantity() {

        const quantity =
            document.getElementById("quantity");

        if (!quantity) return;

        const current =
            Number(quantity.value);

        if (current > 1) {

            quantity.value = current - 1;

        }
    }


    // -------------------------------
    // Variant selection
    // -------------------------------

    let selectedVariantId = null;


    function selectVariant(button) {

        const buttons =
            document.querySelectorAll(
                ".variant-button"
            );


        buttons.forEach(item => {

            item.classList.remove(
                "border-2",
                "border-ink-black"
            );

            item.classList.add(
                "border",
                "border-outline-variant/40"
            );

        });


        button.classList.remove(
            "border",
            "border-outline-variant/40"
        );

        button.classList.add(
            "border-2",
            "border-ink-black"
        );

        if (typeof button.scrollIntoView === "function") {
            button.scrollIntoView({ behavior: "smooth", inline: "nearest", block: "nearest" });
        }


        selectedVariantId =
            button.dataset.variantId;

        const priceDisplay = document.getElementById("productPriceDisplay");
        const offerLabel = document.getElementById("productOfferLabel");
        const price = Number(button.dataset.price || 0);
        const originalPrice = Number(button.dataset.originalPrice);
        const offerText = button.dataset.offerLabel || "";
        const offerDiscount = Number(button.dataset.offerDiscount || 0);

        if (priceDisplay && Number.isFinite(price)) {
            priceDisplay.replaceChildren();
            const currentPrice = document.createTextNode(`\u20B9${price.toFixed(2)}`);
            priceDisplay.append(currentPrice);
            if (Number.isFinite(originalPrice) && originalPrice > price) {
                const original = document.createElement("span");
                original.className = "text-base sm:text-lg font-normal text-outline line-through ml-2";
                original.textContent = `\u20B9${originalPrice.toFixed(2)}`;
                priceDisplay.append(original);
            }
        }

        if (offerLabel) {
            offerLabel.classList.toggle("hidden", !offerText);
            offerLabel.replaceChildren();
            if (offerText) {
                offerLabel.append(document.createTextNode(offerText));
                const savings = document.createElement("span");
                savings.id = "productOfferSavings";
                savings.textContent = ` You save \u20B9${offerDiscount.toFixed(2)}`;
                offerLabel.append(savings);
            }
        }


        const stock =
            Number(button.dataset.stock);


        const addToCartButton =
            document.getElementById(
                "addToCartButton"
            );


        if (!addToCartButton) return;


        if (stock <= 0) {

            addToCartButton.disabled = true;

            addToCartButton.classList.add(
                "opacity-50",
                "cursor-not-allowed"
            );

        } else {

            addToCartButton.disabled = false;

            addToCartButton.classList.remove(
                "opacity-50",
                "cursor-not-allowed"
            );

        }

    }

    function slideVariants(direction) {
        const slider = document.getElementById("variantsSlider");
        if (!slider) return;
        const scrollAmount = 140 * direction;
        slider.scrollBy({ left: scrollAmount, behavior: "smooth" });
    }

    function initVariantsSlider() {
        const slider = document.getElementById("variantsSlider");
        const leftBtn = document.getElementById("slideVariantLeft");
        const rightBtn = document.getElementById("slideVariantRight");
        const controls = document.getElementById("variantSlideControls");
        if (!slider) return;

        function updateSliderControls() {
            if (!controls || !leftBtn || !rightBtn) return;
            const canScroll = slider.scrollWidth > slider.clientWidth + 4;
            controls.style.display = canScroll ? "flex" : "none";
            leftBtn.disabled = slider.scrollLeft <= 4;
            rightBtn.disabled = slider.scrollLeft + slider.clientWidth >= slider.scrollWidth - 4;
            leftBtn.classList.toggle("opacity-30", leftBtn.disabled);
            leftBtn.classList.toggle("cursor-not-allowed", leftBtn.disabled);
            rightBtn.classList.toggle("opacity-30", rightBtn.disabled);
            rightBtn.classList.toggle("cursor-not-allowed", rightBtn.disabled);
        }

        slider.addEventListener("scroll", updateSliderControls, { passive: true });
        window.addEventListener("resize", updateSliderControls);
        setTimeout(updateSliderControls, 60);

        // Mouse wheel horizontal scroll support
        slider.addEventListener("wheel", (e) => {
            if (e.deltaY !== 0) {
                e.preventDefault();
                slider.scrollLeft += e.deltaY;
            }
        }, { passive: false });

        // Click and drag to slide support
        let isDown = false;
        let startX;
        let scrollLeftStart;
        let hasDragged = false;

        slider.addEventListener("mousedown", (e) => {
            isDown = true;
            hasDragged = false;
            startX = e.pageX - slider.offsetLeft;
            scrollLeftStart = slider.scrollLeft;
        });

        window.addEventListener("mouseup", () => {
            if (isDown) {
                isDown = false;
                setTimeout(() => { hasDragged = false; }, 50);
            }
        });

        slider.addEventListener("mousemove", (e) => {
            if (!isDown) return;
            const x = e.pageX - slider.offsetLeft;
            const walk = (x - startX);
            if (Math.abs(walk) > 4) {
                hasDragged = true;
                slider.scrollLeft = scrollLeftStart - (walk * 1.2);
            }
        });

        slider.addEventListener("click", (e) => {
            if (hasDragged) {
                e.preventDefault();
                e.stopPropagation();
            }
        }, true);
    }

    function slideReviews(direction) {
        const slider = document.getElementById("reviewsSlider");
        if (!slider) return;
        const card = slider.querySelector('.shrink-0');
        const scrollAmount = (card ? card.clientWidth + 24 : 420) * direction;
        slider.scrollBy({ left: scrollAmount, behavior: "smooth" });
    }

    function initReviewsSlider() {
        const slider = document.getElementById("reviewsSlider");
        const leftBtn = document.getElementById("slideReviewLeft");
        const rightBtn = document.getElementById("slideReviewRight");
        const controls = document.getElementById("reviewSlideControls");
        if (!slider) return;

        function updateSliderControls() {
            if (!controls || !leftBtn || !rightBtn) return;
            const canScroll = slider.scrollWidth > slider.clientWidth + 4;
            controls.style.display = canScroll ? "flex" : "none";
            leftBtn.disabled = slider.scrollLeft <= 4;
            rightBtn.disabled = slider.scrollLeft + slider.clientWidth >= slider.scrollWidth - 4;
            leftBtn.classList.toggle("opacity-30", leftBtn.disabled);
            leftBtn.classList.toggle("cursor-not-allowed", leftBtn.disabled);
            rightBtn.classList.toggle("opacity-30", rightBtn.disabled);
            rightBtn.classList.toggle("cursor-not-allowed", rightBtn.disabled);
        }

        slider.addEventListener("scroll", updateSliderControls, { passive: true });
        window.addEventListener("resize", updateSliderControls);
        setTimeout(updateSliderControls, 60);

        // Mouse wheel horizontal scroll support
        slider.addEventListener("wheel", (e) => {
            if (e.deltaY !== 0 && slider.scrollWidth > slider.clientWidth) {
                e.preventDefault();
                slider.scrollLeft += e.deltaY;
            }
        }, { passive: false });

        // Click and drag to slide support
        let isDown = false;
        let startX;
        let scrollLeftStart;
        let hasDragged = false;

        slider.addEventListener("mousedown", (e) => {
            isDown = true;
            hasDragged = false;
            startX = e.pageX - slider.offsetLeft;
            scrollLeftStart = slider.scrollLeft;
        });

        window.addEventListener("mouseup", () => {
            if (isDown) {
                isDown = false;
                setTimeout(() => { hasDragged = false; }, 50);
            }
        });

        slider.addEventListener("mousemove", (e) => {
            if (!isDown) return;
            const x = e.pageX - slider.offsetLeft;
            const walk = (x - startX);
            if (Math.abs(walk) > 4) {
                hasDragged = true;
                slider.scrollLeft = scrollLeftStart - (walk * 1.2);
            }
        });

        slider.addEventListener("click", (e) => {
            if (hasDragged) {
                e.preventDefault();
                e.stopPropagation();
            }
        }, true);
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", () => {
            initVariantsSlider();
            initReviewsSlider();
            const firstVariant = document.querySelector(".variant-button");
            if (firstVariant && !selectedVariantId) {
                selectVariant(firstVariant);
            }
        });
    } else {
        initVariantsSlider();
        initReviewsSlider();
        const firstVariant = document.querySelector(".variant-button");
        if (firstVariant && !selectedVariantId) {
            selectVariant(firstVariant);
        }
    }


    // -------------------------------
    // Image zoom
    // -------------------------------

    const zoomContainer =
        document.getElementById(
            "zoomContainer"
        );

    const mainProductImage =
        document.getElementById(
            "mainProductImage"
        );


    if (
        zoomContainer &&
        mainProductImage
    ) {

        zoomContainer.addEventListener(
            "mousemove",
            function (event) {

                const rect =
                    zoomContainer.getBoundingClientRect();

                const x =
                    ((event.clientX - rect.left) /
                        rect.width) *
                    100;

                const y =
                    ((event.clientY - rect.top) /
                        rect.height) *
                    100;


                mainProductImage.style.transform =
                    "scale(1.5)";

                mainProductImage.style.transformOrigin =
                    `${x}% ${y}%`;

            }
        );


        zoomContainer.addEventListener(
            "mouseleave",
            function () {

                mainProductImage.style.transform =
                    "scale(1)";

                mainProductImage.style.transformOrigin =
                    "center";

            }
        );

    }

    document.querySelectorAll("[data-image-url]").forEach((thumbnail) => {
        thumbnail.addEventListener("click", () => {
            changeProductImage(thumbnail.dataset.imageUrl, thumbnail);
        });
    });

    document.querySelectorAll("[data-wishlist-button]").forEach((button) => {
        button.addEventListener("click", (event) => toggleProductWishlist(button, event));
    });

    document.querySelectorAll(".variant-button").forEach((button) => {
        button.addEventListener("click", () => selectVariant(button));
    });

    document.getElementById("slideVariantLeft")?.addEventListener("click", () => slideVariants(-1));
    document.getElementById("slideVariantRight")?.addEventListener("click", () => slideVariants(1));
    document.getElementById("slideReviewLeft")?.addEventListener("click", () => slideReviews(-1));
    document.getElementById("slideReviewRight")?.addEventListener("click", () => slideReviews(1));
    document.getElementById("decreaseQuantityButton")?.addEventListener("click", decreaseQuantity);
    document.getElementById("increaseQuantityButton")?.addEventListener("click", increaseQuantity);

</script>

<script>

