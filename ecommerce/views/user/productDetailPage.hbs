{{>user/header}}

<!-- Main Content Canvas -->
<main
    class="w-full max-w-max-width mx-auto px-3 sm:px-6 md:px-container-padding pt-20 sm:pt-24 md:pt-28 pb-12 sm:pb-16">

    <div class="max-w-max-width mx-auto px-2 sm:px-4 mt-2 mb-4">

        {{> user/notification}}

    </div>


    <!-- =========================
         Breadcrumb
    ========================== -->

    <nav aria-label="Breadcrumb"
        class="flex text-xs sm:text-sm text-outline mb-4 sm:mb-stack-md overflow-x-auto no-scrollbar py-1">

        <ol class="inline-flex items-center space-x-1 md:space-x-3 whitespace-nowrap">

            <li class="inline-flex items-center">

                <a class="font-label-md text-xs sm:text-label-md hover:text-ink-black transition-colors" href="/">
                    Home
                </a>

            </li>

            <li>

                <div class="flex items-center">

                    <span class="material-symbols-outlined text-[16px] mx-1">
                        chevron_right
                    </span>

                    <a class="font-label-md text-xs sm:text-label-md hover:text-ink-black transition-colors"
                        href="/products">
                        Products
                    </a>

                </div>

            </li>

            {{#if product.category_id}}

            <li>

                <div class="flex items-center">

                    <span class="material-symbols-outlined text-[16px] mx-1">
                        chevron_right
                    </span>

                    <a class="font-label-md text-xs sm:text-label-md hover:text-ink-black transition-colors"
                        href="/products?category={{product.category_id._id}}">
                        {{product.category_id.category_name}}
                    </a>

                </div>

            </li>

            {{/if}}

            <li aria-current="page">

                <div class="flex items-center">

                    <span class="material-symbols-outlined text-[16px] mx-1">
                        chevron_right
                    </span>

                    <span
                        class="font-label-md text-xs sm:text-label-md text-ink-black truncate max-w-[150px] sm:max-w-none">
                        {{product.productName}}
                    </span>

                </div>

            </li>

        </ol>

    </nav>


    <!-- =========================
         Product Hero Section
    ========================== -->

    <section class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-grid-gutter mb-8 md:mb-section-gap">


        <!-- =========================
             Gallery Left
        ========================== -->

        <div class="lg:col-span-7 flex flex-col-reverse md:flex-row gap-3 sm:gap-stack-md h-full">


            <!-- Thumbnails -->

            <div class="flex md:flex-col gap-2 overflow-x-auto md:overflow-y-auto md:w-24 shrink-0 no-scrollbar py-1">

                {{#each product.images}}

                <button type="button" onclick="changeProductImage('{{this.url}}')"
                    class="w-16 h-20 sm:w-20 sm:h-24 md:w-full md:h-24 bg-surface-gray rounded-xl border {{#if @first}}border-2 border-ink-black{{else}}border-transparent hover:border-ink-black/30{{/if}} overflow-hidden shrink-0 opacity-80 hover:opacity-100 transition-all active:scale-95">

                    <img class="w-full h-full object-cover" src="{{this.url}}" alt="{{../product.productName}}">

                </button>

                {{/each}}

            </div>


            <!-- Main Image -->

            <div id="zoomContainer"
                class="flex-grow bg-surface-gray rounded-2xl md:rounded-3xl overflow-hidden relative aspect-square sm:aspect-[4/3] md:aspect-auto md:min-h-[580px]">

                <!-- Product Highlights -->

                <div class="absolute top-3 left-3 sm:top-6 sm:left-6 flex flex-col gap-1.5 sm:gap-2 z-10">

                    {{#if product.highlights}}

                    {{#each product.highlights}}

                    <span
                        class="bg-white/95 backdrop-blur-md px-3 sm:px-4 py-1 sm:py-1.5 rounded-full border border-outline-variant/30 text-ink-black font-label-md text-xs sm:text-label-md shadow-sm">
                        {{this}}
                    </span>

                    {{/each}}

                    {{else}}

                    <span
                        class="bg-white/95 backdrop-blur-md px-3 sm:px-4 py-1 sm:py-1.5 rounded-full border border-outline-variant/30 text-ink-black font-label-md text-xs sm:text-label-md shadow-sm">
                        Premium Quality
                    </span>

                    {{/if}}

                </div>


                <!-- Wishlist -->

                <button type="button" data-product-id="{{product._id}}"
                    data-wishlisted="{{#if isWishlisted}}true{{else}}false{{/if}}"
                    aria-pressed="{{#if isWishlisted}}true{{else}}false{{/if}}"
                    onclick="toggleProductWishlist(this, event)"
                    class="absolute top-3 right-3 sm:top-6 sm:right-6 {{#if isWishlisted}}bg-red-500 hover:bg-red-600{{else}}bg-white/90 hover:bg-white{{/if}} backdrop-blur-md p-2.5 sm:p-3 rounded-full border border-outline-variant/30 transition-all active:scale-95 z-10 shadow-sm">

                    <span
                        class="material-symbols-outlined text-[18px] sm:text-[22px] {{#if isWishlisted}}text-white{{else}}text-ink-black{{/if}}">
                        favorite
                    </span>

                </button>


                <!-- Main Product Image -->

                {{#if product.images.length}}

                <img id="mainProductImage"
                    class="w-full h-full object-cover absolute inset-0 transition-transform duration-300"
                    src="{{product.images.[0].url}}" alt="{{product.productName}}">

                {{else}}

                <div class="w-full h-full absolute inset-0 flex items-center justify-center">

                    <span class="text-outline">
                        No image available
                    </span>

                </div>

                {{/if}}

            </div>

        </div>


        <!-- =========================
             Product Info Right
        ========================== -->

        <div class="lg:col-span-5 flex flex-col pt-stack-md lg:pt-0 pl-0 lg:pl-stack-lg justify-center">


            <!-- Product Heading -->

            <div class="mb-4 sm:mb-stack-lg">

                <h1
                    class="font-display-lg text-2xl sm:text-3xl md:text-headline-xl lg:text-display-lg text-ink-black mb-2 tracking-tight leading-tight">
                    {{product.productName}}
                </h1>


                <!-- Rating -->

                <div class="flex items-center gap-stack-sm mb-3 sm:mb-stack-md">

                    <div class="flex text-accent-blue">

                        <span class="material-symbols-outlined text-[18px]" data-weight="fill">
                            star
                        </span>

                        <span class="material-symbols-outlined text-[18px]" data-weight="fill">
                            star
                        </span>

                        <span class="material-symbols-outlined text-[18px]" data-weight="fill">
                            star
                        </span>

                        <span class="material-symbols-outlined text-[18px]" data-weight="fill">
                            star
                        </span>

                        <span class="material-symbols-outlined text-[18px]" data-weight="fill">
                            star_half
                        </span>

                    </div>

                    <a class="text-on-surface-variant text-xs sm:text-sm underline hover:text-ink-black transition-colors"
                        href="#reviews">
                        {{averageRating}}
                        ({{totalReviews}} Reviews)
                    </a>

                </div>


                <!-- Price -->

                <p
                    class="font-headline-xl text-2xl sm:text-3xl md:text-headline-xl text-ink-black mb-2 sm:mb-stack-md tracking-tight font-bold">

                    ₹{{listingPrice}}

                    {{#if regularPrice}}

                    {{#if discountPercentage}}

                    <span class="text-base sm:text-lg font-normal text-outline line-through ml-2">
                        ₹{{regularPrice}}
                    </span>

                    {{/if}}

                    {{/if}}

                </p>


                <!-- Discount -->

                {{#if discountPercentage}}

                <p class="text-xs sm:text-sm text-green-700 font-semibold mb-3 sm:mb-stack-md">

                    {{discountPercentage}}% OFF

                </p>

                {{/if}}


                <!-- Description -->

                <p
                    class="font-body-lg text-xs sm:text-sm md:text-body-lg text-on-surface-variant mb-4 sm:mb-stack-lg leading-relaxed">
                    {{product.productDescription}}
                </p>

            </div>


            <hr class="border-outline-variant/30 mb-4 sm:mb-stack-lg">


            <!-- =========================
                 Variant Selection
            ========================== -->

            <div class="mb-4 sm:mb-stack-lg space-y-4 sm:space-y-6">

                <div class="space-y-2 sm:space-y-3">

                    <div class="flex items-center justify-between">

                        <label class="font-label-md text-xs sm:text-label-md text-ink-black font-semibold">
                            Select Size
                        </label>

                        <span class="text-[11px] sm:text-xs text-on-surface-variant font-medium">
                            Choose your variant
                        </span>

                    </div>


                    <div class="grid grid-cols-3 gap-2 sm:gap-3">

                        {{#each variants}}

                        <button type="button"
                            class="variant-button relative flex flex-col items-center justify-center p-2 sm:p-3 rounded-xl sm:rounded-2xl border border-outline-variant/40 bg-surface hover:border-ink-black/40 transition-all text-center group min-w-0"
                            data-variant-id="{{this._id}}" data-price="{{this.effectivePrice}}"
                            data-stock="{{this.stock_quantity}}" onclick="selectVariant(this)">

                            <span class="font-label-md text-xs text-ink-black truncate w-full">
                                {{this.weight}}
                            </span>

                            <span class="text-[10px] sm:text-[11px] text-on-surface-variant mt-0.5 truncate w-full">
                                {{this.sku}}
                            </span>

                            <span class="text-xs font-semibold text-ink-black mt-1">
                                ₹{{this.effectivePrice}}
                            </span>

                        </button>

                        {{/each}}

                    </div>

                </div>

            </div>


            <!-- =========================
                 Stock
            ========================== -->

            <div class="mb-4 sm:mb-stack-lg">

                {{#if isOutOfStock}}

                <div class="flex items-center gap-2 text-red-600 text-sm">

                    <span class="material-symbols-outlined text-[18px]">
                        error
                    </span>

                    <span class="font-label-md">
                        Out of Stock
                    </span>

                </div>

                {{else}}

                <div class="flex items-center gap-2 text-green-700 text-sm">

                    <span class="material-symbols-outlined text-[18px]">
                        check_circle
                    </span>

                    <span class="font-label-md">
                        In Stock
                    </span>

                    {{#if totalStock}}

                    <span class="text-xs sm:text-sm text-on-surface-variant">
                        ({{totalStock}} available)
                    </span>

                    {{/if}}

                </div>

                {{/if}}

            </div>


            <!-- =========================
                 Quantity
            ========================== -->

            <div class="space-y-stack-md mb-4 sm:mb-stack-lg">

                <div class="flex items-center justify-between">

                    <label class="font-label-md text-xs sm:text-label-md text-ink-black font-semibold">
                        Quantity
                    </label>

                    <div
                        class="flex items-center border border-outline-variant/50 rounded-xl bg-surface h-10 sm:h-12 w-28 sm:w-32 shadow-sm">

                        <button type="button" onclick="decreaseQuantity()"
                            class="px-3 text-ink-black hover:bg-surface-gray transition-colors h-full rounded-l-xl text-lg font-bold">
                            -
                        </button>

                        <input id="quantity"
                            class="flex-grow w-full text-center bg-transparent border-none text-ink-black font-label-md focus:ring-0 p-0 m-0 h-full text-sm sm:text-base font-semibold"
                            type="number" value="1" min="1">

                        <button type="button" onclick="increaseQuantity()"
                            class="px-3 text-ink-black hover:bg-surface-gray transition-colors h-full rounded-r-xl text-lg font-bold">
                            +
                        </button>

                    </div>

                </div>

            </div>


            <!-- =========================
                 Buttons
            ========================== -->

            <div class="flex flex-col gap-2.5 sm:gap-stack-md mb-6 sm:mb-stack-lg">

                {{#if isOutOfStock}}

                <button type="button" disabled
                    class="w-full bg-surface-gray text-outline font-label-md text-sm sm:text-label-md py-3.5 sm:py-4 rounded-xl sm:rounded-2xl cursor-not-allowed">
                    Out of Stock
                </button>

                {{else}}

                <button type="button" id="addToCartButton"
                    class="w-full bg-ink-black text-white font-label-md text-sm sm:text-label-md py-3.5 sm:py-4 rounded-xl sm:rounded-2xl hover:bg-ink-black/90 active:scale-98 transition-all flex items-center justify-center gap-2 shadow-sm font-semibold">

                    <span class="material-symbols-outlined text-[20px]">
                        shopping_bag
                    </span>

                    Add to Cart

                </button>


                <button type="button" id="buyNowButton"
                    class="w-full bg-surface border border-outline-variant/50 text-ink-black font-label-md text-sm sm:text-label-md py-3.5 sm:py-4 rounded-xl sm:rounded-2xl hover:bg-surface-gray active:scale-98 transition-all font-semibold">
                    Buy It Now
                </button>

                {{/if}}

            </div>


            <!-- =========================
                 Trust Badges
            ========================== -->

            <div class="grid grid-cols-3 gap-unit pt-stack-md border-t border-outline-variant/30 mt-stack-lg">

                <div class="flex flex-col items-center text-center gap-2">

                    <span class="material-symbols-outlined text-ink-black text-2xl">
                        verified
                    </span>

                    <span class="text-sm text-on-surface-variant font-label-md">
                        Premium Quality
                    </span>

                </div>


                <div class="flex flex-col items-center text-center gap-2">

                    <span class="material-symbols-outlined text-ink-black text-2xl">
                        local_shipping
                    </span>

                    <span class="text-sm text-on-surface-variant font-label-md">
                        Fast Delivery
                    </span>

                </div>


                <div class="flex flex-col items-center text-center gap-2">

                    <span class="material-symbols-outlined text-ink-black text-2xl">
                        eco
                    </span>

                    <span class="text-sm text-on-surface-variant font-label-md">
                        Quality Ingredients
                    </span>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================
         Product Details Tabs
    ========================== -->

    <section class="mb-section-gap">

        <div class="border-b border-outline-variant/30 flex space-x-8 mb-stack-lg overflow-x-auto no-scrollbar">

            <button
                class="pb-3 border-b-2 border-ink-black font-label-md text-label-md text-ink-black whitespace-nowrap">
                Product Details
            </button>

            <button
                class="pb-3 border-b-2 border-transparent hover:border-outline-variant font-label-md text-label-md text-on-surface-variant hover:text-ink-black transition-all whitespace-nowrap">
                Nutritional Facts
            </button>

            <button
                class="pb-3 border-b-2 border-transparent hover:border-outline-variant font-label-md text-label-md text-on-surface-variant hover:text-ink-black transition-all whitespace-nowrap">
                Reviews
            </button>

        </div>


        <div class="grid grid-cols-1 md:grid-cols-2 gap-grid-gutter">


            <!-- =========================
                 Product Highlights
            ========================== -->

            <div class="font-body-lg text-body-lg text-on-surface-variant space-y-6 pt-4">

                <p>
                    {{product.productDescription}}
                </p>


                {{#if product.highlights}}

                <ul class="list-none space-y-4">

                    {{#each product.highlights}}

                    <li class="flex items-start gap-3">

                        <span class="material-symbols-outlined text-ink-black text-[20px] mt-0.5">
                            check_circle
                        </span>

                        <span>
                            {{this}}
                        </span>

                    </li>

                    {{/each}}

                </ul>

                {{/if}}

            </div>


            <!-- =========================
                 Nutrition Table
            ========================== -->

            <div class="bg-surface-gray rounded-3xl p-8 border border-outline-variant/20">

                <h3
                    class="font-headline-lg text-xl font-semibold text-ink-black mb-6 border-b border-outline-variant/20 pb-4 tracking-tight">
                    Product Information
                </h3>


                <div class="space-y-4">

                    <div class="flex justify-between border-b border-outline-variant/20 pb-3">

                        <span class="font-body-lg text-on-surface-variant">
                            Brand
                        </span>

                        <span class="font-label-md text-ink-black">
                            {{product.brand}}
                        </span>

                    </div>


                    <div class="flex justify-between border-b border-outline-variant/20 pb-3">

                        <span class="font-body-lg text-on-surface-variant">
                            Category
                        </span>

                        <span class="font-label-md text-ink-black">

                            {{product.category_id.category_name}}

                        </span>

                    </div>


                    <div class="flex justify-between border-b border-outline-variant/20 pb-3">

                        <span class="font-body-lg text-on-surface-variant">
                            Available Variants
                        </span>

                        <span class="font-label-md text-ink-black">
                            {{variants.length}}
                        </span>

                    </div>


                    <div class="flex justify-between pt-2">

                        <span class="font-body-lg text-on-surface-variant">
                            Stock
                        </span>

                        <span class="font-label-md text-ink-black">

                            {{#if isOutOfStock}}
                            Out of Stock
                            {{else}}
                            In Stock
                            {{/if}}

                        </span>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================
         Reviews
    ========================== -->

    <section id="reviews" class="mb-section-gap">

        <div class="mb-stack-lg">

            <h2 class="font-headline-lg text-2xl font-semibold text-ink-black">
                Customer Reviews
            </h2>

            <p class="text-on-surface-variant text-sm mt-2">
                {{averageRating}} out of 5
                ·
                {{totalReviews}} Reviews
            </p>

        </div>


        {{#if reviews.length}}

        <div class="space-y-6">

            {{#each reviews}}

            <div class="border-b border-outline-variant/30 pb-6">

                <div class="flex items-center justify-between mb-2">

                    <div>

                        <p class="font-label-md text-ink-black">
                            {{this.user_id.name}}
                        </p>

                        <div class="flex text-accent-blue mt-1">

                            <span class="material-symbols-outlined text-[16px]">
                                star
                            </span>

                            <span class="material-symbols-outlined text-[16px]">
                                star
                            </span>

                            <span class="material-symbols-outlined text-[16px]">
                                star
                            </span>

                            <span class="material-symbols-outlined text-[16px]">
                                star
                            </span>

                            <span class="material-symbols-outlined text-[16px]">
                                star
                            </span>

                        </div>

                    </div>

                </div>

                <p class="text-on-surface-variant text-sm">
                    {{this.review}}
                </p>

            </div>

            {{/each}}

        </div>

        {{else}}

        <div class="py-10 text-center">

            <p class="text-on-surface-variant">
                No reviews yet.
            </p>

        </div>

        {{/if}}

    </section>


    <!-- =========================
         Related Products
    ========================== -->

    {{#if relatedProducts.length}}

    <section class="mb-section-gap">

        <div class="mb-stack-lg">

            <h2 class="font-headline-lg text-2xl font-semibold text-ink-black">
                You May Also Like
            </h2>

        </div>


        <div class="grid grid-cols-2 md:grid-cols-4 gap-grid-gutter">

            {{#each relatedProducts}}

            <a href="/products/{{this._id}}" class="group">

                <div class="bg-surface-gray rounded-2xl overflow-hidden aspect-square mb-3">

                    {{#if this.images.length}}

                    <img src="{{this.images.[0].url}}" alt="{{this.productName}}"
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">

                    {{/if}}

                </div>


                <h3 class="font-label-md text-ink-black">
                    {{this.productName}}
                </h3>

            </a>

            {{/each}}

        </div>

    </section>

    {{/if}}

</main>


<!-- =========================
     Product Page JavaScript
========================== -->

<script>

    async function toggleProductWishlist(button, event) {
        event.preventDefault();
        event.stopPropagation();
        if (button.disabled) return;

        const isAuthenticated = {{#if user}}true{{else}}false{{/if}};
        if (!isAuthenticated) {
            showNotification("error", "Please log in to add items to wishlist.");
            setTimeout(() => {
                window.location.href = "/login";
            }, 1200);
            return;
        }

        const wasWishlisted = button.dataset.wishlisted === "true";
        button.disabled = true;
        try {
            const response = await fetch(`/wishlist/${wasWishlisted ? "remove" : "add"}/${button.dataset.productId}`, {
                method: wasWishlisted ? "DELETE" : "POST",
                headers: { "Accept": "application/json" }
            });
            const result = await response.json();

            if (response.status === 401 || result.redirectTo) {
                showNotification("error", result.message || "Please log in to add items to wishlist.");
                setTimeout(() => {
                    window.location.href = result.redirectTo || "/login";
                }, 1200);
                return;
            }

            if (!response.ok) {
                throw new Error(result.message || "Unable to update your wishlist.");
            }

            const isWishlisted = !wasWishlisted;
            button.dataset.wishlisted = String(isWishlisted);
            button.setAttribute("aria-pressed", String(isWishlisted));
            button.classList.toggle("bg-red-500", isWishlisted);
            button.classList.toggle("bg-white/90", !isWishlisted);
            button.classList.toggle("hover:bg-red-600", isWishlisted);
            button.classList.toggle("hover:bg-white", !isWishlisted);
            button.querySelector(".material-symbols-outlined").classList.toggle("text-white", isWishlisted);
            button.querySelector(".material-symbols-outlined").classList.toggle("text-ink-black", !isWishlisted);
        } catch (error) {
            window.alert(error.message);
        } finally {
            button.disabled = false;
        }
    }

    // -------------------------------
    // Change main product image
    // -------------------------------

    function changeProductImage(url) {

        const mainImage =
            document.getElementById("mainProductImage");

        if (!mainImage) return;

        mainImage.src = url;
    }


    // -------------------------------
    // Quantity
    // -------------------------------

    function increaseQuantity() {

        const quantity =
            document.getElementById("quantity");

        if (!quantity) return;

        quantity.value =
            Number(quantity.value) + 1;
    }


    function decreaseQuantity() {

        const quantity =
            document.getElementById("quantity");

        if (!quantity) return;

        const current =
            Number(quantity.value);

        if (current > 1) {

            quantity.value = current - 1;

        }
    }


    // -------------------------------
    // Variant selection
    // -------------------------------

    let selectedVariantId = null;


    function selectVariant(button) {

        const buttons =
            document.querySelectorAll(
                ".variant-button"
            );


        buttons.forEach(item => {

            item.classList.remove(
                "border-2",
                "border-ink-black"
            );

            item.classList.add(
                "border",
                "border-outline-variant/40"
            );

        });


        button.classList.remove(
            "border",
            "border-outline-variant/40"
        );

        button.classList.add(
            "border-2",
            "border-ink-black"
        );


        selectedVariantId =
            button.dataset.variantId;


        const stock =
            Number(button.dataset.stock);


        const addToCartButton =
            document.getElementById(
                "addToCartButton"
            );


        if (!addToCartButton) return;


        if (stock <= 0) {

            addToCartButton.disabled = true;

            addToCartButton.classList.add(
                "opacity-50",
                "cursor-not-allowed"
            );

        } else {

            addToCartButton.disabled = false;

            addToCartButton.classList.remove(
                "opacity-50",
                "cursor-not-allowed"
            );

        }

    }


    // -------------------------------
    // Image zoom
    // -------------------------------

    const zoomContainer =
        document.getElementById(
            "zoomContainer"
        );

    const mainProductImage =
        document.getElementById(
            "mainProductImage"
        );


    if (
        zoomContainer &&
        mainProductImage
    ) {

        zoomContainer.addEventListener(
            "mousemove",
            function (event) {

                const rect =
                    zoomContainer.getBoundingClientRect();

                const x =
                    ((event.clientX - rect.left) /
                        rect.width) *
                    100;

                const y =
                    ((event.clientY - rect.top) /
                        rect.height) *
                    100;


                mainProductImage.style.transform =
                    "scale(1.5)";

                mainProductImage.style.transformOrigin =
                    `${x}% ${y}%`;

            }
        );


        zoomContainer.addEventListener(
            "mouseleave",
            function () {

                mainProductImage.style.transform =
                    "scale(1)";

                mainProductImage.style.transformOrigin =
                    "center";

            }
        );

    }

</script>

<script>

    // =====================================================
    // PRODUCT DETAIL - ADD TO CART
    // =====================================================

    const addToCartButton =
        document.getElementById(
            "addToCartButton"
        );


    if (addToCartButton) {

        addToCartButton.addEventListener(
            "click",
            addProductDetailToCart
        );

    }


    async function addProductDetailToCart() {

        const isAuthenticated = {{#if user}}true{{else}}false{{/if}};
        if (!isAuthenticated) {
            showNotification("error", "Please log in to add items to cart.");
            setTimeout(() => {
                window.location.href = "/login";
            }, 1200);
            return;
        }

        // -----------------------------------------
        // Check variant selection
        // -----------------------------------------

        if (!selectedVariantId) {

            showNotification("error", "Please select a variant first.");

            return;
        }


        // -----------------------------------------
        // Get product ID
        // -----------------------------------------

        const productId =
            "{{product._id}}";


        // -----------------------------------------
        // Get quantity
        // -----------------------------------------

        const quantityInput =
            document.getElementById(
                "quantity"
            );


        const quantity =
            Number(
                quantityInput?.value || 1
            );


        // -----------------------------------------
        // Validate quantity
        // -----------------------------------------

        if (
            !Number.isInteger(quantity) ||
            quantity <= 0
        ) {

            showNotification("error", "Please enter a valid quantity.");

            return;
        }


        // -----------------------------------------
        // Prevent multiple clicks
        // -----------------------------------------

        if (
            addToCartButton.dataset.loading ===
            "true"
        ) {
            return;
        }


        addToCartButton.dataset.loading =
            "true";


        addToCartButton.disabled = true;


        // -----------------------------------------
        // Save original button
        // -----------------------------------------

        const originalHTML =
            addToCartButton.innerHTML;


        try {

            // -----------------------------------------
            // API CALL
            // -----------------------------------------

            const response =
                await fetch(
                    `/cart/add?productId=${encodeURIComponent(productId)}&variantId=${encodeURIComponent(selectedVariantId)}&quantity=${quantity}`,
                    {
                        method: "POST",
                        headers: {
                            "Content-Type":
                                "application/json",
                            "Accept":
                                "application/json"
                        }
                    }
                );


            const data =
                await response.json();


            // -----------------------------------------
            // REDIRECT GUEST TO LOGIN
            // -----------------------------------------

            if (response.status === 401 || data.redirectTo) {
                showNotification("error", data.message || "Please log in to add items to cart.");
                addToCartButton.innerHTML = originalHTML;
                setTimeout(() => {
                    window.location.href = data.redirectTo || "/login";
                }, 1200);
                return;
            }


            // -----------------------------------------
            // ERROR
            // -----------------------------------------

            if (
                !response.ok ||
                !data.success
            ) {

                showNotification("error", data.message || "Unable to add product to cart");

                addToCartButton.innerHTML =
                    originalHTML;

                return;
            }

            showNotification("success", data.message || "Product added to cart");

            if (typeof window.updateCartBadge === "function" && (data.cartCount !== undefined || data.cart)) {
                const totalCartCount = data.cartCount !== undefined
                    ? data.cartCount
                    : (data.cart?.items || []).reduce((sum, item) => sum + (Number(item.quantity) || 0), 0);
                window.updateCartBadge(totalCartCount);
            }


            // -----------------------------------------
            // GET ACTUAL CART QUANTITY
            // -----------------------------------------

            let currentQuantity =
                quantity;


            if (
                data.cart &&
                data.cart.items
            ) {

                const cartItem =
                    data.cart.items.find(
                        item =>
                            item.variant_id
                                .toString() ===
                            selectedVariantId
                                .toString()
                    );


                if (cartItem) {

                    currentQuantity =
                        cartItem.quantity;

                }

            }


            // -----------------------------------------
            // CHANGE BUTTON
            // -----------------------------------------

            addToCartButton.innerHTML = `
                <span
                    class="material-symbols-outlined text-[20px]"
                >
                    shopping_bag
                </span>

                Added (${currentQuantity})
            `;


            // -----------------------------------------
            // Store quantity
            // -----------------------------------------

            addToCartButton.dataset.quantity =
                currentQuantity;


        } catch (error) {

            console.error(
                "Product detail add cart error:",
                error
            );


            showNotification("error", "Unable to add product to cart");


        } finally {

            addToCartButton.disabled =
                false;

            addToCartButton.dataset.loading =
                "false";

        }

    }

</script>


{{>user/footer}}