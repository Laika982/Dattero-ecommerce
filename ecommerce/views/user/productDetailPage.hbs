    async function addProductDetailToCart() {

        const isAuthenticated = {{#if user}}true{{else}}false{{/if}};
    if (!isAuthenticated) {
        showNotification("error", "Please log in to add items to cart.");
        setTimeout(() => {
            window.location.href = "/login";
        }, 1200);
        return;
    }

    // -----------------------------------------
    // Check variant selection
    // -----------------------------------------

    if (!selectedVariantId) {

        showNotification("error", "Please select a variant first.");

        return;
    }


    // -----------------------------------------
    // Get product ID
    // -----------------------------------------

    const productId =
        "{{product._id}}";


    // -----------------------------------------
    // Get quantity
    // -----------------------------------------

    const quantityInput =
        document.getElementById(
            "quantity"
        );


    const quantity =
        Number(
            quantityInput?.value || 1
        );


    // -----------------------------------------
    // Validate quantity
    // -----------------------------------------

    if (
        !Number.isInteger(quantity) ||
        quantity <= 0
    ) {

        showNotification("error", "Please enter a valid quantity.");

        return;
    }


    // -----------------------------------------
    // Prevent multiple clicks
    // -----------------------------------------

    if (
        addToCartButton.dataset.loading ===
        "true"
    ) {
        return;
    }


    addToCartButton.dataset.loading =
        "true";


    addToCartButton.disabled = true;


    // -----------------------------------------
    // Save original button
    // -----------------------------------------

    const originalHTML =
        addToCartButton.innerHTML;


    try {

        // -----------------------------------------
        // API CALL
        // -----------------------------------------

        const response =
            await fetch(
                `/cart/add?productId=${encodeURIComponent(productId)}&variantId=${encodeURIComponent(selectedVariantId)}&quantity=${quantity}`,
                {
                    method: "POST",
                    headers: {
                        "Content-Type":
                            "application/json",
                        "Accept":
                            "application/json"
                    }
                }
            );


        const data =
            await response.json();


        // -----------------------------------------
        // REDIRECT GUEST TO LOGIN
        // -----------------------------------------

        if (response.status === 401 || data.redirectTo) {
            showNotification("error", data.message || "Please log in to add items to cart.");
            addToCartButton.innerHTML = originalHTML;
            setTimeout(() => {
                window.location.href = data.redirectTo || "/login";
            }, 1200);
            return;
        }


        // -----------------------------------------
        // ERROR
        // -----------------------------------------

        if (
            !response.ok ||
            !data.success
        ) {

            showNotification("error", data.message || "Unable to add product to cart");

            addToCartButton.innerHTML =
                originalHTML;

            return;
        }

        showNotification("success", data.message || "Product added to cart");

        if (typeof window.updateCartBadge === "function" && (data.cartCount !== undefined || data.cart)) {
            const totalCartCount = data.cartCount !== undefined
                ? data.cartCount
                : (data.cart?.items || []).reduce((sum, item) => sum + (Number(item.quantity) || 0), 0);
            window.updateCartBadge(totalCartCount);
        }


        // -----------------------------------------
        // GET ACTUAL CART QUANTITY
        // -----------------------------------------

        let currentQuantity =
            quantity;


        if (
            data.cart &&
            data.cart.items
        ) {

            const cartItem =
                data.cart.items.find(
                    item =>
                        item.variant_id
                            .toString() ===
                        selectedVariantId
                            .toString()
                );


            if (cartItem) {

                currentQuantity =
                    cartItem.quantity;

            }

        }


        // -----------------------------------------
        // CHANGE BUTTON
        // -----------------------------------------

        addToCartButton.innerHTML = `
                <span
                    class="material-symbols-outlined text-[20px]"
                >
                    shopping_bag
                </span>

                Added (${currentQuantity})
            `;


        // -----------------------------------------
        // Store quantity
        // -----------------------------------------

        addToCartButton.dataset.quantity =
            currentQuantity;


    } catch (error) {

        console.error(
            "Product detail add cart error:",
            error
        );


        showNotification("error", "Unable to add product to cart");


    } finally {

        addToCartButton.disabled =
            false;

        addToCartButton.dataset.loading =
            "false";

    }

    }

    async function buyProductDetailNow() {
        const isAuthenticated = {{#if user}}true{{else}}false{{/if}};
        if (!isAuthenticated) {
            showNotification("error", "Please log in to buy this product.");
            setTimeout(() => {
                window.location.href = "/login";
            }, 1200);
            return;
        }

        if (!selectedVariantId) {
            showNotification("error", "Please select a variant first.");
            return;
        }

        const productId = "{{product._id}}";
        const quantity = Number(document.getElementById("quantity")?.value || 1);

        if (!Number.isInteger(quantity) || quantity <= 0) {
            showNotification("error", "Please enter a valid quantity.");
            return;
        }

        if (buyNowButton.dataset.loading === "true") return;

        const originalHTML = buyNowButton.innerHTML;
        buyNowButton.dataset.loading = "true";
        buyNowButton.disabled = true;
        buyNowButton.textContent = "Preparing checkout...";

        try {
            const response = await fetch(
                `/cart/add?productId=${encodeURIComponent(productId)}&variantId=${encodeURIComponent(selectedVariantId)}&quantity=${quantity}`,
                {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "Accept": "application/json",
                    },
                },
            );
            const data = await response.json();

            if (response.status === 401 || data.redirectTo) {
                showNotification("error", data.message || "Please log in to buy this product.");
                setTimeout(() => {
                    window.location.href = data.redirectTo || "/login";
                }, 1200);
                return;
            }

            if (!response.ok || !data.success) {
                throw new Error(data.message || "Unable to start checkout.");
            }

            if (typeof window.updateCartBadge === "function" && data.cartCount !== undefined) {
                window.updateCartBadge(data.cartCount);
            }

            window.location.href = "/checkout";
        } catch (error) {
            showNotification("error", error.message || "Unable to start checkout.");
            buyNowButton.innerHTML = originalHTML;
        } finally {
            buyNowButton.disabled = false;
            buyNowButton.dataset.loading = "false";
        }
    }
</script>


