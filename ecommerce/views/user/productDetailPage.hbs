{{>user/header}}

<!-- Main Content Canvas -->
<main
    class="w-full max-w-max-width mx-auto px-3 sm:px-6 md:px-container-padding pt-20 sm:pt-24 md:pt-28 pb-12 sm:pb-16">

    <div class="max-w-max-width mx-auto px-2 sm:px-4 mt-2 mb-4">

        {{> user/notification}}

    </div>


    <!-- =========================
         Breadcrumb
    ========================== -->

    <nav aria-label="Breadcrumb"
        class="flex text-xs sm:text-sm text-outline mb-4 sm:mb-stack-md overflow-x-auto no-scrollbar py-1">

        <ol class="inline-flex items-center space-x-1 md:space-x-3 whitespace-nowrap">

            <li class="inline-flex items-center">

                <a class="font-label-md text-xs sm:text-label-md hover:text-ink-black transition-colors" href="/">
                    Home
                </a>

            </li>

            <li>

                <div class="flex items-center">

                    <span class="material-symbols-outlined text-[16px] mx-1">
                        chevron_right
                    </span>

                    <a class="font-label-md text-xs sm:text-label-md hover:text-ink-black transition-colors"
                        href="/products">
                        Products
                    </a>

                </div>

            </li>

            {{#if product.category_id}}

            <li>

                <div class="flex items-center">

                    <span class="material-symbols-outlined text-[16px] mx-1">
                        chevron_right
                    </span>

                    <a class="font-label-md text-xs sm:text-label-md hover:text-ink-black transition-colors"
                        href="/products?category={{product.category_id._id}}">
                        {{product.category_id.category_name}}
                    </a>

                </div>

            </li>

            {{/if}}

            <li aria-current="page">

                <div class="flex items-center">

                    <span class="material-symbols-outlined text-[16px] mx-1">
                        chevron_right
                    </span>

                    <span
                        class="font-label-md text-xs sm:text-label-md text-ink-black truncate max-w-[150px] sm:max-w-none">
                        {{product.productName}}
                    </span>

                </div>

            </li>

        </ol>

    </nav>


    <!-- =========================
         Product Hero Section
    ========================== -->

    <section class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-grid-gutter mb-8 md:mb-section-gap">


        <!-- =========================
             Gallery Left
        ========================== -->

        <div class="lg:col-span-7 flex flex-col-reverse md:flex-row gap-3 sm:gap-stack-md h-full">


            <!-- Thumbnails -->

            <div class="flex md:flex-col gap-2 overflow-x-auto md:overflow-y-auto md:w-24 shrink-0 no-scrollbar py-1">

                {{#each product.images}}

                <button type="button" data-image-url="{{this.url}}"
                    class="w-16 h-20 sm:w-20 sm:h-24 md:w-full md:h-24 bg-surface-gray rounded-xl border {{#if @first}}border-2 border-ink-black{{else}}border-transparent hover:border-ink-black/30{{/if}} overflow-hidden shrink-0 opacity-80 hover:opacity-100 transition-all active:scale-95">

                    <img class="w-full h-full object-cover" src="{{this.url}}" alt="{{../product.productName}}">

                </button>

                {{/each}}

            </div>


            <!-- Main Image -->

            <div id="zoomContainer"
                class="flex-grow bg-surface-gray rounded-2xl md:rounded-3xl overflow-hidden relative aspect-square sm:aspect-[4/3] md:aspect-auto md:min-h-[580px]">

                <!-- Product Highlights -->

                <div class="absolute top-3 left-3 sm:top-6 sm:left-6 flex flex-col gap-1.5 sm:gap-2 z-10">

                    {{#if product.highlights}}

                    {{#each product.highlights}}

                    <span
                        class="bg-white/95 backdrop-blur-md px-3 sm:px-4 py-1 sm:py-1.5 rounded-full border border-outline-variant/30 text-ink-black font-label-md text-xs sm:text-label-md shadow-sm">
                        {{this}}
                    </span>

                    {{/each}}

                    {{else}}

                    <span
                        class="bg-white/95 backdrop-blur-md px-3 sm:px-4 py-1 sm:py-1.5 rounded-full border border-outline-variant/30 text-ink-black font-label-md text-xs sm:text-label-md shadow-sm">
                        Premium Quality
                    </span>

                    {{/if}}

                </div>


                <!-- Wishlist -->

                <button type="button" data-product-id="{{product._id}}"
                    data-wishlisted="{{#if isWishlisted}}true{{else}}false{{/if}}"
                    aria-pressed="{{#if isWishlisted}}true{{else}}false{{/if}}"
                    data-wishlist-button
                    class="absolute top-3 right-3 sm:top-6 sm:right-6 {{#if isWishlisted}}bg-red-500 hover:bg-red-600{{else}}bg-white/90 hover:bg-white{{/if}} backdrop-blur-md p-2.5 sm:p-3 rounded-full border border-outline-variant/30 transition-all active:scale-95 z-10 shadow-sm">

                    <span
                        class="material-symbols-outlined text-[18px] sm:text-[22px] {{#if isWishlisted}}text-white{{else}}text-ink-black{{/if}}">
                        favorite
                    </span>

                </button>


                <!-- Main Product Image -->

                {{#if product.images.length}}

                <img id="mainProductImage"
                    class="w-full h-full object-cover absolute inset-0 transition-transform duration-300"
                    src="{{product.images.[0].url}}" alt="{{product.productName}}">

                {{else}}

                <div class="w-full h-full absolute inset-0 flex items-center justify-center">

                    <span class="text-outline">
                        No image available
                    </span>

                </div>

                {{/if}}

            </div>

        </div>


        <!-- =========================
             Product Info Right
        ========================== -->

        <div class="lg:col-span-5 flex flex-col pt-stack-md lg:pt-0 pl-0 lg:pl-stack-lg justify-center">


            <!-- Product Heading -->

            <div class="mb-4 sm:mb-stack-lg">

                <h1
                    class="font-display-lg text-2xl sm:text-3xl md:text-headline-xl lg:text-display-lg text-ink-black mb-2 tracking-tight leading-tight">
                    {{product.productName}}
                </h1>


                <!-- Rating -->

                <div class="flex items-center gap-2 mb-3 sm:mb-stack-md flex-wrap">

                    <div class="flex text-amber-500" title="{{averageRating}} out of 5 stars">
                        {{#each ratingStars}}
                        <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' {{#if this.filled}}1{{else}}0{{/if}};">
                            {{#if this.half}}star_half{{else}}star{{/if}}
                        </span>
                        {{/each}}
                    </div>

                    <a class="text-on-surface-variant text-xs sm:text-sm underline hover:text-ink-black transition-colors"
                        href="#reviews">
                        {{averageRating}}
                        ({{totalReviews}} Review{{#unless (eq totalReviews 1)}}s{{/unless}})
                    </a>

                </div>


                <!-- Price -->

                <p
                    id="productPriceDisplay"
                    class="font-headline-xl text-2xl sm:text-3xl md:text-headline-xl text-ink-black mb-2 sm:mb-stack-md tracking-tight font-bold">

                    ₹{{listingPrice}}

                    <span id="productOriginalPrice" class="text-base sm:text-lg font-normal text-outline line-through ml-2{{#unless regularPrice}} hidden{{/unless}}">
                        ₹{{regularPrice}}
                    </span>

                </p>


                <!-- Discount -->

                <p id="productOfferLabel" class="text-xs sm:text-sm text-green-700 font-semibold mb-3 sm:mb-stack-md{{#unless offerLabel}} hidden{{/unless}}">

                    {{offerLabel}} <span id="productOfferSavings">You save {{offerDiscount}}</span>

                </p>


                <!-- Description -->

                <p
                    class="font-body-lg text-xs sm:text-sm md:text-body-lg text-on-surface-variant mb-4 sm:mb-stack-lg leading-relaxed">
                    {{product.productDescription}}
                </p>

            </div>


            <hr class="border-outline-variant/30 mb-4 sm:mb-stack-lg">


            <!-- =========================
                 Variant Selection
            ========================== -->

            <div class="mb-4 sm:mb-stack-lg space-y-4 sm:space-y-6">

                <div class="space-y-2 sm:space-y-3">

                    <div class="flex items-center justify-between">

                        <label class="font-label-md text-xs sm:text-label-md text-ink-black font-semibold">
                            Select Size
                        </label>

                        <div class="flex items-center gap-2">
                            <span class="text-[11px] sm:text-xs text-on-surface-variant font-medium">
                                Choose your variant
                            </span>

                            <div id="variantSlideControls" class="hidden items-center gap-1">
                                <button type="button" id="slideVariantLeft"
                                    class="w-6 h-6 rounded-full flex items-center justify-center bg-surface border border-outline-variant/40 hover:border-ink-black text-ink-black transition-all cursor-pointer"
                                    aria-label="Slide left">
                                    <span class="material-symbols-outlined text-[15px]">chevron_left</span>
                                </button>
                                <button type="button" id="slideVariantRight"
                                    class="w-6 h-6 rounded-full flex items-center justify-center bg-surface border border-outline-variant/40 hover:border-ink-black text-ink-black transition-all cursor-pointer"
                                    aria-label="Slide right">
                                    <span class="material-symbols-outlined text-[15px]">chevron_right</span>
                                </button>
                            </div>
                        </div>

                    </div>


                    <div id="variantsSlider" class="flex items-center gap-2 sm:gap-3 overflow-x-auto pb-1.5 pt-0.5 px-0.5 no-scrollbar flex-nowrap scroll-smooth cursor-grab active:cursor-grabbing select-none">

                        {{#each variants}}

                        <button type="button"
                            class="variant-button relative flex flex-col items-center justify-center p-2 sm:p-3 rounded-xl sm:rounded-2xl border border-outline-variant/40 bg-surface hover:border-ink-black/40 transition-all text-center group min-w-[95px] sm:min-w-[115px] flex-shrink-0 cursor-pointer snap-start"
                            data-variant-id="{{this._id}}" data-price="{{this.effectivePrice}}"
                            data-original-price="{{this.displayOriginalPrice}}"
                            data-offer-label="{{this.offerLabel}}" data-offer-discount="{{this.offerDiscount}}"
                            data-stock="{{this.stock_quantity}}">

                            <span class="font-label-md text-xs sm:text-sm font-semibold text-ink-black truncate w-full">
                                {{this.weight}}
                            </span>

                            <span class="text-[10px] sm:text-[11px] text-on-surface-variant mt-0.5 truncate w-full">
                                {{this.sku}}
                            </span>

                            <span class="text-xs sm:text-sm font-bold text-ink-black mt-1">
                                ₹{{this.effectivePrice}}
                            </span>

                        </button>

                        {{/each}}

                    </div>

                </div>

            </div>


            <!-- =========================
                 Stock
            ========================== -->

            <div class="mb-4 sm:mb-stack-lg">

                {{#if isOutOfStock}}

                <div class="flex items-center gap-2 text-red-600 text-sm">

                    <span class="material-symbols-outlined text-[18px]">
                        error
                    </span>

                    <span class="font-label-md">
                        Out of Stock
                    </span>

                </div>

                {{else}}

                <div class="flex items-center gap-2 text-green-700 text-sm">

                    <span class="material-symbols-outlined text-[18px]">
                        check_circle
                    </span>

                    <span class="font-label-md">
                        In Stock
                    </span>

                    {{#if totalStock}}

                    <span class="text-xs sm:text-sm text-on-surface-variant">
                        ({{totalStock}} available)
                    </span>

                    {{/if}}

                </div>

                {{/if}}

            </div>


            <!-- =========================
                 Quantity
            ========================== -->

            <div class="space-y-stack-md mb-4 sm:mb-stack-lg">

                <div class="flex items-center justify-between">

                    <label class="font-label-md text-xs sm:text-label-md text-ink-black font-semibold">
                        Quantity
                    </label>

                    <div
                        class="flex items-center border border-outline-variant/50 rounded-xl bg-surface h-10 sm:h-12 w-28 sm:w-32 shadow-sm">

                        <button type="button" id="decreaseQuantityButton"
                            class="px-3 text-ink-black hover:bg-surface-gray transition-colors h-full rounded-l-xl text-lg font-bold">
                            -
                        </button>

                        <input id="quantity"
                            class="flex-grow w-full text-center bg-transparent border-none text-ink-black font-label-md focus:ring-0 p-0 m-0 h-full text-sm sm:text-base font-semibold"
                            type="number" value="1" min="1">

                        <button type="button" id="increaseQuantityButton"
                            class="px-3 text-ink-black hover:bg-surface-gray transition-colors h-full rounded-r-xl text-lg font-bold">
                            +
                        </button>

                    </div>

                </div>

            </div>


            <!-- =========================
                 Buttons
            ========================== -->

            <div class="flex flex-col gap-2.5 sm:gap-stack-md mb-6 sm:mb-stack-lg">

                {{#if isOutOfStock}}

                <button type="button" disabled
                    class="w-full bg-surface-gray text-outline font-label-md text-sm sm:text-label-md py-3.5 sm:py-4 rounded-xl sm:rounded-2xl cursor-not-allowed">
                    Out of Stock
                </button>

                {{else}}

                <button type="button" id="addToCartButton"
                    class="w-full bg-ink-black text-white font-label-md text-sm sm:text-label-md py-3.5 sm:py-4 rounded-xl sm:rounded-2xl hover:bg-ink-black/90 active:scale-98 transition-all flex items-center justify-center gap-2 shadow-sm font-semibold">

                    <span class="material-symbols-outlined text-[20px]">
                        shopping_bag
                    </span>

                    Add to Cart

                </button>


                <button type="button" id="buyNowButton"
                    class="w-full bg-surface border border-outline-variant/50 text-ink-black font-label-md text-sm sm:text-label-md py-3.5 sm:py-4 rounded-xl sm:rounded-2xl hover:bg-surface-gray active:scale-98 transition-all font-semibold">
                    Buy It Now
                </button>

                {{/if}}

            </div>


            <!-- =========================
                 Trust Badges
            ========================== -->

            <div class="grid grid-cols-3 gap-unit pt-stack-md border-t border-outline-variant/30 mt-stack-lg">

                <div class="flex flex-col items-center text-center gap-2">

                    <span class="material-symbols-outlined text-ink-black text-2xl">
                        verified
                    </span>

                    <span class="text-sm text-on-surface-variant font-label-md">
                        Premium Quality
                    </span>

                </div>


                <div class="flex flex-col items-center text-center gap-2">

                    <span class="material-symbols-outlined text-ink-black text-2xl">
                        local_shipping
                    </span>

                    <span class="text-sm text-on-surface-variant font-label-md">
                        Fast Delivery
                    </span>

                </div>


                <div class="flex flex-col items-center text-center gap-2">

                    <span class="material-symbols-outlined text-ink-black text-2xl">
                        eco
                    </span>

                    <span class="text-sm text-on-surface-variant font-label-md">
                        Quality Ingredients
                    </span>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================
         Product Details Tabs
    ========================== -->

    <section class="mb-section-gap">

        <div class="border-b border-outline-variant/30 flex space-x-8 mb-stack-lg overflow-x-auto no-scrollbar">

            <button
                class="pb-3 border-b-2 border-ink-black font-label-md text-label-md text-ink-black whitespace-nowrap">
                Product Details
            </button>

        </div>


        <div class="grid grid-cols-1 md:grid-cols-2 gap-grid-gutter">


            <!-- =========================
                 Product Highlights
            ========================== -->

            <div class="font-body-lg text-body-lg text-on-surface-variant space-y-6 pt-4">

                <p>
                    {{product.productDescription}}
                </p>


                {{#if product.highlights}}

                <ul class="list-none space-y-4">

                    {{#each product.highlights}}

                    <li class="flex items-start gap-3">

                        <span class="material-symbols-outlined text-ink-black text-[20px] mt-0.5">
                            check_circle
                        </span>

                        <span>
                            {{this}}
                        </span>

                    </li>

                    {{/each}}

                </ul>

                {{/if}}

            </div>


            <!-- =========================
                 Nutrition Table
            ========================== -->

            <div class="bg-surface-gray rounded-3xl p-8 border border-outline-variant/20">

                <h3
                    class="font-headline-lg text-xl font-semibold text-ink-black mb-6 border-b border-outline-variant/20 pb-4 tracking-tight">
                    Product Information
                </h3>


                <div class="space-y-4">

                    <div class="flex justify-between border-b border-outline-variant/20 pb-3">

                        <span class="font-body-lg text-on-surface-variant">
                            Brand
                        </span>

                        <span class="font-label-md text-ink-black">
                            {{product.brand}}
                        </span>

                    </div>


                    <div class="flex justify-between border-b border-outline-variant/20 pb-3">

                        <span class="font-body-lg text-on-surface-variant">
                            Category
                        </span>

                        <span class="font-label-md text-ink-black">

                            {{product.category_id.category_name}}

                        </span>

                    </div>


                    <div class="flex justify-between border-b border-outline-variant/20 pb-3">

                        <span class="font-body-lg text-on-surface-variant">
                            Available Variants
                        </span>

                        <span class="font-label-md text-ink-black">
                            {{variants.length}}
                        </span>

                    </div>


                    <div class="flex justify-between pt-2">

                        <span class="font-body-lg text-on-surface-variant">
                            Stock
                        </span>

                        <span class="font-label-md text-ink-black">

                            {{#if isOutOfStock}}
                            Out of Stock
                            {{else}}
                            In Stock
                            {{/if}}

                        </span>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================
         Reviews
    ========================== -->

    <section id="reviews" class="mb-section-gap pt-6 border-t border-outline-variant/20">

        <!-- Header + Summary -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
            <div>
                <span class="font-label-md text-[11px] text-amber-600 tracking-widest font-semibold uppercase block mb-1">
                    Verified Customer Feedback
                </span>
                <h2 class="font-headline-lg text-2xl sm:text-3xl font-bold text-ink-black tracking-tight">
                    Customer Reviews
                </h2>
                <div class="flex items-center gap-3 mt-2 flex-wrap">
                    <div class="flex items-center text-amber-500">
                        {{#each ratingStars}}
                            <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' {{#if this.filled}}1{{else}}0{{/if}};">
                                {{#if this.half}}star_half{{else}}star{{/if}}
                            </span>
                        {{/each}}
                    </div>
                    <span class="font-headline-lg text-lg font-bold text-ink-black">{{averageRating}}</span>
                    <span class="text-on-surface-variant text-sm">based on {{totalReviews}} review{{#unless (eq totalReviews 1)}}s{{/unless}}</span>
                </div>
            </div>

            <div class="flex items-center gap-3 flex-wrap">
                <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200/80 text-xs font-semibold shadow-xs">
                    <span class="material-symbols-outlined text-[16px] text-emerald-600" style="font-variation-settings: 'FILL' 1;">verified</span>
                    <span>Verified Purchases Only</span>
                </div>

                <div id="reviewSlideControls" class="hidden items-center gap-1.5">
                    <button type="button" id="slideReviewLeft"
                        class="w-9 h-9 rounded-full flex items-center justify-center bg-white border border-outline-variant/40 hover:border-ink-black text-ink-black transition-all cursor-pointer shadow-xs active:scale-95 disabled:opacity-30 disabled:cursor-not-allowed"
                        aria-label="Slide reviews left">
                        <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                    </button>
                    <button type="button" id="slideReviewRight"
                        class="w-9 h-9 rounded-full flex items-center justify-center bg-white border border-outline-variant/40 hover:border-ink-black text-ink-black transition-all cursor-pointer shadow-xs active:scale-95 disabled:opacity-30 disabled:cursor-not-allowed"
                        aria-label="Slide reviews right">
                        <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                    </button>
                </div>
            </div>
        </div>

        {{#if totalReviews}}
        <!-- Rating Breakdown Bento -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-6 bg-surface-container-low/70 border border-secondary/10 rounded-2xl sm:rounded-3xl p-6 sm:p-8 mb-8 shadow-xs">
            <div class="md:col-span-4 flex flex-col justify-center items-center text-center border-b md:border-b-0 md:border-r border-outline-variant/20 pb-4 md:pb-0 md:pr-6">
                <span class="font-display-lg text-5xl font-bold text-ink-black">{{averageRating}}</span>
                <div class="flex text-amber-500 my-2">
                    {{#each ratingStars}}
                        <span class="material-symbols-outlined text-[22px]" style="font-variation-settings: 'FILL' {{#if this.filled}}1{{else}}0{{/if}};">
                            {{#if this.half}}star_half{{else}}star{{/if}}
                        </span>
                    {{/each}}
                </div>
                <p class="text-xs text-on-surface-variant font-medium">Average Customer Rating</p>
                <p class="text-[11px] text-on-surface-variant/70 mt-0.5">({{totalReviews}} verified review{{#unless (eq totalReviews 1)}}s{{/unless}})</p>
            </div>

            <div class="md:col-span-8 flex flex-col justify-center gap-2 pl-0 md:pl-2">
                {{#each ratingBreakdown}}
                <div class="flex items-center gap-3 text-xs">
                    <span class="w-12 text-ink-black font-semibold flex items-center gap-1 shrink-0">
                        {{this.star}} <span class="material-symbols-outlined text-[14px] text-amber-500" style="font-variation-settings: 'FILL' 1;">star</span>
                    </span>
                    <div class="flex-grow h-2 rounded-full bg-outline-variant/20 overflow-hidden">
                        <div class="h-full bg-amber-500 rounded-full transition-all duration-500" style="width: {{this.percentage}}%;"></div>
                    </div>
                    <span class="w-10 text-right text-on-surface-variant shrink-0 font-medium">{{this.percentage}}%</span>
                    <span class="w-8 text-right text-on-surface-variant/70 shrink-0 text-[11px]">({{this.count}})</span>
                </div>
                {{/each}}
            </div>
        </div>
        {{/if}}

        {{#if reviews.length}}
        <!-- Luxury Review Cards Horizontal Slider -->
        <div class="relative">
            <div id="reviewsSlider" class="flex items-stretch gap-4 sm:gap-6 overflow-x-auto pb-4 pt-1 px-1 no-scrollbar flex-nowrap scroll-smooth cursor-grab active:cursor-grabbing select-none snap-x snap-mandatory">
                {{#each reviews}}
                <div class="relative bg-white rounded-2xl sm:rounded-3xl p-5 sm:p-7 border border-secondary/10 shadow-[0_12px_32px_rgba(0,0,0,0.02)] hover:shadow-[0_20px_40px_rgba(0,0,0,0.06)] hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between group w-[85vw] sm:w-[420px] md:w-[460px] shrink-0 snap-start">
                    <!-- Watermark Quote Icon -->
                    <div class="w-9 h-9 rounded-full bg-surface-container-low flex items-center justify-center text-on-surface-variant/30 group-hover:bg-amber-50 group-hover:text-amber-600 transition-colors shrink-0 absolute top-5 right-5 sm:top-6 sm:right-6">
                        <span class="material-symbols-outlined text-[20px]">format_quote</span>
                    </div>

                    <div>
                        <!-- Reviewer Profile Header -->
                        <div class="flex items-center gap-3.5 pr-10 mb-4">
                            <div class="relative shrink-0">
                                <img src="{{this.userProfileImage}}" alt="{{this.userName}}" 
                                     class="w-11 h-11 sm:w-12 sm:h-12 rounded-full object-cover ring-2 ring-amber-500/15 border border-secondary/10 shadow-xs bg-surface-container-high"
                                     onerror="this.onerror=null; this.src='/images/avathar.jpg';">
                                {{#if this.verifiedPurchase}}
                                <span class="absolute -bottom-1 -right-1 w-4 h-4 rounded-full bg-emerald-600 text-white flex items-center justify-center ring-2 ring-white shadow-xs" title="Verified Buyer">
                                    <span class="material-symbols-outlined text-[10px]" style="font-variation-settings: 'FILL' 1;">check</span>
                                </span>
                                {{/if}}
                            </div>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <h4 class="font-headline-lg text-sm sm:text-base font-bold text-ink-black truncate">
