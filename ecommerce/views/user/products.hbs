{{>user/header}}

<main class="flex-grow pt-section-gap pb-section-gap px-container-padding max-w-max-width mx-auto w-full">

    <!-- ========================= -->
    <!-- PAGE HEADER -->
    <!-- ========================= -->
        {{> user/notification}}

    <div class="flex flex-col md:flex-row justify-between items-end mb-16 border-b border-surface-variant pb-stack-lg">

        <div>
            <h1 class="font-headline-xl text-4xl md:text-5xl text-ink-black">
                Shop All
            </h1>

            <p class="font-body-md text-on-surface-variant mt-3">
                Handcrafted protein excellence, made for your lifestyle.
            </p>
        </div>


        <!-- ========================= -->
        <!-- SEARCH -->
        <!-- ========================= -->

        <div class="mt-stack-lg md:mt-0 flex items-center bg-surface-gray pl-4 pr-1.5 h-[48px] rounded-full relative group transition-all duration-300 gap-2">

            <span class="material-symbols-outlined text-on-surface-variant font-light text-[20px] group-focus-within:text-ink-black transition-colors shrink-0">
                search
            </span>

            <input
                id="searchInput"
                class="w-full bg-transparent border-none py-2 px-1 font-body-md text-body-md text-ink-black placeholder:text-on-surface-variant/60 focus:ring-0 transition-all duration-300 outline-none"
                placeholder="Search our collections..."
                type="text"
                value="{{search}}"
            >

            <button
                type="button"
                onclick="applySearch()"
                class="px-5 py-2 bg-on-surface text-surface rounded-full font-label-md text-label-md hover:opacity-90 active:scale-95 transition-all duration-150 flex items-center shrink-0 shadow-sm"
            >
                Search
            </button>

        </div>


        <!-- ========================= -->
        <!-- DESKTOP SORT -->
        <!-- ========================= -->

        <div class="hidden md:flex items-center gap-3 mt-6 md:mt-0">

            <label
                for="sort"
                class="font-body-md text-sm text-on-surface-variant"
            >
                Sort By:
            </label>

            <select
                id="sort"
                onchange="changeSort(this.value)"
                class="border border-surface-variant rounded-lg px-4 py-2 bg-white focus:outline-none"
            >

                <option
                    value=""
                    {{#if (eq sort "")}}selected{{/if}}
                >
                    Featured
                </option>

                <option
                    value="priceAcc"
                    {{#if (eq sort "priceAcc")}}selected{{/if}}
                >
                    Price: Low to High
                </option>

                <option
                    value="priceDesc"
                    {{#if (eq sort "priceDesc")}}selected{{/if}}
                >
                    Price: High to Low
                </option>

                <option
                    value="az"
                    {{#if (eq sort "az")}}selected{{/if}}
                >
                    A-Z
                </option>

                <option
                    value="za"
                    {{#if (eq sort "za")}}selected{{/if}}
                >
                    Z-A
                </option>

            </select>

        </div>

    </div>


    <!-- ========================= -->
    <!-- MOBILE FILTER + SORT -->
    <!-- ========================= -->

    <div class="md:hidden flex gap-3 mb-8">

        <!-- FILTER BUTTON -->

        <button
            type="button"
            onclick="openFilters()"
            class="flex-1 h-11 flex items-center justify-center gap-2 border border-surface-variant rounded-lg bg-white text-ink-black"
        >

            <span class="material-symbols-outlined text-[18px]">
                tune
            </span>

            <span class="font-body-md text-sm">
                Filter
            </span>

        </button>


        <!-- SORT BUTTON -->

        <button
            type="button"
            onclick="toggleMobileSort()"
            class="flex-1 h-11 flex items-center justify-center gap-2 border border-surface-variant rounded-lg bg-white text-ink-black"
        >

            <span class="material-symbols-outlined text-[18px]">
                swap_vert
            </span>

            <span class="font-body-md text-sm">
                Sort
            </span>

        </button>

    </div>


    <!-- ========================= -->
    <!-- MOBILE SORT OPTIONS -->
    <!-- ========================= -->

    <div
        id="mobileSort"
        class="hidden md:hidden mb-8 border border-surface-variant rounded-xl bg-white p-4"
    >

        <p class="font-body-md text-sm text-on-surface-variant mb-3">
            Sort By
        </p>

        <div class="space-y-2">

            <button
                type="button"
                onclick="changeSort('')"
                class="w-full text-left px-3 py-2 rounded-lg hover:bg-surface-gray text-sm"
            >
                Featured
            </button>

            <button
                type="button"
                onclick="changeSort('priceAcc')"
                class="w-full text-left px-3 py-2 rounded-lg hover:bg-surface-gray text-sm"
            >
                Price: Low to High
            </button>

            <button
                type="button"
                onclick="changeSort('priceDesc')"
                class="w-full text-left px-3 py-2 rounded-lg hover:bg-surface-gray text-sm"
            >
                Price: High to Low
            </button>

            <button
                type="button"
                onclick="changeSort('az')"
                class="w-full text-left px-3 py-2 rounded-lg hover:bg-surface-gray text-sm"
            >
                A-Z
            </button>

            <button
                type="button"
                onclick="changeSort('za')"
                class="w-full text-left px-3 py-2 rounded-lg hover:bg-surface-gray text-sm"
            >
                Z-A
            </button>

        </div>

    </div>


    <!-- ========================= -->
    <!-- MAIN CONTENT -->
    <!-- ========================= -->

    <div class="flex flex-col md:flex-row gap-12">


        <!-- ========================= -->
        <!-- FILTER SIDEBAR -->
        <!-- ========================= -->

        <aside
            id="filterSidebar"
            class="hidden md:block md:w-64 flex-shrink-0"
        >

            <!-- MOBILE HEADER -->

            <div class="md:hidden flex items-center justify-between mb-8">

                <h2 class="font-headline-lg text-xl text-ink-black">
                    Filters
                </h2>

                <button
                    type="button"
                    onclick="closeFilters()"
                    class="text-on-surface-variant"
                >

                    <span class="material-symbols-outlined">
                        close
                    </span>

                </button>

            </div>


            <!-- ========================= -->
            <!-- CATEGORY -->
            <!-- ========================= -->

            <div class="mb-10">

                <div class="flex items-center justify-between mb-5">

                    <h3 class="font-headline-md text-lg text-ink-black">
                        Category
                    </h3>


                    <!-- CLEAR CATEGORY -->

                    {{#if category}}

                        <button
                            type="button"
                            onclick="clearCategory()"
                            class="text-sm text-on-surface-variant hover:text-ink-black underline transition"
                        >
                            Clear
                        </button>

                    {{/if}}

                </div>


                <!-- CATEGORY LIST -->

                <div class="space-y-3">

                    {{#if categories.length}}

                        {{#each categories}}

                            <label class="flex items-center gap-3 cursor-pointer">

                                <input
                                    type="checkbox"
                                    name="category"
                                    value="{{_id}}"
                                    class="categoryFilter w-4 h-4"
                                    {{#if (includes ../category _id)}}checked{{/if}}
                                >

                                <span class="font-body-md text-sm text-on-surface-variant">
                                    {{category_name}}
                                </span>

                            </label>

                        {{/each}}

                    {{else}}

                        <p class="text-sm text-on-surface-variant">
                            No categories available.
                        </p>

                    {{/if}}

                </div>

            </div>


            <!-- ========================= -->
            <!-- PRICE -->
            <!-- ========================= -->

            <div class="mb-10">

                <h3 class="font-headline-md text-lg text-ink-black mb-5">
                    Price
                </h3>

                <div class="flex items-center gap-3">

                    <!-- MIN PRICE -->

                    <input
                        type="number"
                        id="minPrice"
                        name="minPrice"
                        min="0"
                        placeholder="Min"
                        value="{{minPrice}}"
                        class="w-full border border-surface-variant rounded-lg px-3 py-2 text-sm bg-white focus:outline-none"
                    >

                    <span class="text-on-surface-variant flex-shrink-0">
                        —
                    </span>


                    <!-- MAX PRICE -->

                    <input
                        type="number"
                        id="maxPrice"
                        name="maxPrice"
                        min="0"
                        placeholder="Max"
                        value="{{maxPrice}}"
                        class="w-full border border-surface-variant rounded-lg px-3 py-2 text-sm bg-white focus:outline-none"
                    >

                </div>

            </div>


            <!-- ========================= -->
            <!-- APPLY FILTER -->
            <!-- ========================= -->

            <button
                type="button"
                onclick="applyFilters()"
                class="w-full border border-ink-black rounded-lg px-4 py-3 text-sm text-ink-black hover:bg-ink-black hover:text-white transition"
            >
                Apply Filter
            </button>

        </aside>


        <!-- ========================= -->
        <!-- PRODUCTS -->
        <!-- ========================= -->

        <div class="flex-grow grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">

            {{#if products.length}}

                {{#each products}}


                    <!-- ========================= -->
                    <!-- PRODUCT CARD -->
                    <!-- ========================= -->

                    <a
                        href="/products/{{_id}}"
                        class="group flex flex-col cursor-pointer"
                    >


                        <!-- ========================= -->
                        <!-- PRODUCT IMAGE -->
                        <!-- ========================= -->

                        <div class="relative">


                            <!-- WISHLIST -->

                            <div class="absolute top-6 right-6 z-10">

                                <button
                                    type="button"
                                    onclick="event.preventDefault(); event.stopPropagation();"
                                    class="w-10 h-10 rounded-full bg-white/90 flex items-center justify-center"
                                >

                                    <span class="material-symbols-outlined text-[18px]">
                                        favorite
                                    </span>

                                </button>

                            </div>


                            <!-- IMAGE -->

                            <div class="h-64 overflow-hidden rounded-xl bg-surface-gray mb-4">

                                {{#if images.length}}

                                    <img
                                        src="{{images.[0].url}}"
                                        alt="{{productName}}"
                                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                                    >

                                {{else}}

                                    <div class="w-full h-full flex items-center justify-center text-on-surface-variant">
                                        No Image
                                    </div>

                                {{/if}}

                            </div>

                        </div>


                        <!-- ========================= -->
                        <!-- PRODUCT INFO -->
                        <!-- ========================= -->

                        <div class="flex flex-col flex-grow px-2 pb-2">


                            <!-- PRODUCT NAME -->

                            <div class="flex justify-between items-start mb-2">

                                <h3 class="font-headline-md text-lg text-ink-black">
                                    {{productName}}
                                </h3>

                            </div>


                            <!-- PRODUCT DESCRIPTION -->

                            <div class="flex justify-between items-start mb-2">

                                <p class="font-headline-md text-s text-ink-black">
                                    {{productDescription}}
                                </p>

                            </div>


                            <!-- ========================= -->
                            <!-- CATEGORY NAME -->
                            <!-- ========================= -->

                            {{#if category_id}}

                                <p class="text-sm text-on-surface-variant mb-2">
                                    {{category_id.category_name}}
                                </p>

                            {{/if}}


                            <!-- ========================= -->
                            <!-- RATING -->
                            <!-- ========================= -->

                            <div class="flex items-center mb-4 text-ink-black">

                                <span
                                    class="material-symbols-outlined text-[16px]"
                                    style="font-variation-settings: 'FILL' 1;"
                                >
                                    star
                                </span>

                                <span class="font-body-md text-sm ml-2 text-on-surface-variant">

                                    {{#if average_rating}}

                                        {{average_rating}}

                                    {{else}}

                                        No rating

                                    {{/if}}


                                    {{#if review_count}}

                                        ({{review_count}})

                                    {{/if}}

                                </span>

                            </div>


                            <!-- ========================= -->
                            <!-- PRICE -->
                            <!-- ========================= -->

                            <div class="mt-auto pt-4 border-t border-surface-variant/50 flex items-center justify-between">

                                <p class="font-headline-lg text-xl text-ink-black">
                                    ₹{{listPrice}}
                                </p>


                                <!-- ADD BUTTON -->

                                <button
                                    type="button"
                                    onclick="event.preventDefault(); event.stopPropagation();"
                                    class="flex items-center gap-1 text-sm"
                                >

                                    Add

                                    <span class="material-symbols-outlined text-[18px]">
                                        add
                                    </span>

                                </button>

                            </div>

                        </div>

                    </a>

                {{/each}}


            {{else}}


                <!-- ========================= -->
                <!-- NO PRODUCTS -->
                <!-- ========================= -->

                <div class="col-span-full flex flex-col items-center justify-center py-20">

                    <span class="material-symbols-outlined text-5xl text-on-surface-variant">
                        inventory_2
                    </span>

                    <h2 class="font-headline-lg text-2xl text-ink-black mt-4">
                        No products found
                    </h2>

                    <p class="font-body-md text-on-surface-variant mt-2">
                        Try changing your search or filters.
                    </p>

                </div>

            {{/if}}

        </div>

    </div>


    <!-- ========================= -->
    <!-- PAGINATION -->
    <!-- ========================= -->

    {{#if totalPage}}

        {{#if (gt totalPage 1)}}

            <div class="mt-16 mb-12 flex flex-col md:flex-row items-center justify-between gap-6 border-t border-surface-variant/50 pt-8 w-full">


                <!-- SHOWING -->

                <p class="font-body-md text-sm text-on-surface-variant">

                    Showing

                    {{#if totalProduct}}

                        {{add (multiply (subtract page 1) 10) 1}}

                    {{else}}

                        0

                    {{/if}}

                    -

                    {{#if (lt (multiply page 10) totalProduct)}}

                        {{multiply page 10}}

                    {{else}}

                        {{totalProduct}}

                    {{/if}}

                    of {{totalProduct}} products

                </p>


                <!-- PAGINATION -->

                <div class="flex items-center gap-2">


                    <!-- PREVIOUS -->

                    {{#if (gt page 1)}}

                        <button
                            type="button"
                            onclick="goToPage({{subtract page 1}})"
                            class="w-10 h-10 flex items-center justify-center border border-surface-variant rounded-lg hover:bg-surface-gray transition"
                        >

                            <span class="material-symbols-outlined text-[18px]">
                                chevron_left
                            </span>

                        </button>

                    {{else}}

                        <button
                            type="button"
                            disabled
                            class="w-10 h-10 flex items-center justify-center border border-surface-variant rounded-lg opacity-40 cursor-not-allowed"
                        >

                            <span class="material-symbols-outlined text-[18px]">
                                chevron_left
                            </span>

                        </button>

                    {{/if}}


                    <!-- PAGE NUMBERS -->

                    {{#each (range 1 totalPage)}}

                        <button
                            type="button"
                            onclick="goToPage({{this}})"
                            class="w-10 h-10 flex items-center justify-center border border-surface-variant rounded-lg text-sm

                            {{#if (eq this ../page)}}
                                bg-ink-black text-white
                            {{else}}
                                hover:bg-surface-gray text-ink-black
                            {{/if}}

                            transition"
                        >
                            {{this}}
                        </button>

                    {{/each}}


                    <!-- NEXT -->

                    {{#if (lt page totalPage)}}

                        <button
                            type="button"
                            onclick="goToPage({{add page 1}})"
                            class="w-10 h-10 flex items-center justify-center border border-surface-variant rounded-lg hover:bg-surface-gray transition"
                        >

                            <span class="material-symbols-outlined text-[18px]">
                                chevron_right
                            </span>

                        </button>

                    {{else}}

                        <button
                            type="button"
                            disabled
                            class="w-10 h-10 flex items-center justify-center border border-surface-variant rounded-lg opacity-40 cursor-not-allowed"
                        >

                            <span class="material-symbols-outlined text-[18px]">
                                chevron_right
                            </span>

                        </button>

                    {{/if}}

                </div>

            </div>

        {{/if}}

    {{/if}}

</main>


<script>


    // =========================================
    // SEARCH
    // =========================================

    function applySearch() {

        const searchInput =
            document.getElementById("searchInput");

        const search =
            searchInput.value.trim();

        const url =
            new URL(window.location.href);


        if (search) {

            url.searchParams.set(
                "search",
                search
            );

        } else {

            url.searchParams.delete(
                "search"
            );

        }


        // Reset pagination

        url.searchParams.set(
            "page",
            "1"
        );


        window.location.href =
            url.toString();

    }


    // =========================================
    // SEARCH USING ENTER KEY
    // =========================================

    document
        .getElementById("searchInput")
        .addEventListener(
            "keydown",
            function (event) {

                if (event.key === "Enter") {

                    applySearch();

                }

            }
        );


    // =========================================
    // SORT
    // =========================================

    function changeSort(value) {

        const url =
            new URL(window.location.href);


        if (value) {

            url.searchParams.set(
                "sort",
                value
            );

        } else {

            url.searchParams.delete(
                "sort"
            );

        }


        // Reset pagination

        url.searchParams.set(
            "page",
            "1"
        );


        window.location.href =
            url.toString();

    }


    // =========================================
    // MOBILE SORT
    // =========================================

    function toggleMobileSort() {

        const mobileSort =
            document.getElementById(
                "mobileSort"
            );


        mobileSort.classList.toggle(
            "hidden"
        );

    }


    // =========================================
    // APPLY FILTERS
    // =========================================

    function applyFilters() {


        const minPrice =
            document.getElementById(
                "minPrice"
            ).value;


        const maxPrice =
            document.getElementById(
                "maxPrice"
            ).value;


        // Get ALL selected categories

        const selectedCategories =
            document.querySelectorAll(
                'input[name="category"]:checked'
            );


        const url =
            new URL(window.location.href);


        // =========================================
        // CATEGORY
        // =========================================

        // Delete all old category parameters

        url.searchParams.delete(
            "category"
        );


        // Add every selected category

        selectedCategories.forEach(
            function (checkbox) {

                url.searchParams.append(
                    "category",
                    checkbox.value
                );

            }
        );


        // =========================================
        // MIN PRICE
        // =========================================

        if (minPrice) {

            url.searchParams.set(
                "minPrice",
                minPrice
            );

        } else {

            url.searchParams.delete(
                "minPrice"
            );

        }


        // =========================================
        // MAX PRICE
        // =========================================

        if (maxPrice) {

            url.searchParams.set(
                "maxPrice",
                maxPrice
            );

        } else {

            url.searchParams.delete(
                "maxPrice"
            );

        }


        // =========================================
        // RESET PAGE
        // =========================================

        url.searchParams.set(
            "page",
            "1"
        );


        // =========================================
        // REDIRECT
        // =========================================

        window.location.href =
            url.toString();

    }


    // =========================================
    // CLEAR CATEGORY
    // =========================================

    function clearCategory() {

        const url =
            new URL(window.location.href);


        // Remove ALL category parameters

        url.searchParams.delete(
            "category"
        );


        // Reset pagination

        url.searchParams.set(
            "page",
            "1"
        );


        window.location.href =
            url.toString();

    }


    // =========================================
    // PAGINATION
    // =========================================

    function goToPage(pageNumber) {

        const url =
            new URL(window.location.href);


        // Only change page.
        // Existing search, category,
        // price and sort parameters remain.

        url.searchParams.set(
            "page",
            pageNumber
        );


        window.location.href =
            url.toString();

    }


    // =========================================
    // OPEN MOBILE FILTER
    // =========================================

    function openFilters() {

        const sidebar =
            document.getElementById(
                "filterSidebar"
            );


        sidebar.classList.remove(
            "hidden"
        );


        sidebar.classList.add(
            "fixed",
            "inset-0",
            "z-50",
            "bg-white",
            "p-6",
            "overflow-y-auto"
        );

    }


    // =========================================
    // CLOSE MOBILE FILTER
    // =========================================

    function closeFilters() {

        const sidebar =
            document.getElementById(
                "filterSidebar"
            );


        sidebar.classList.add(
            "hidden"
        );


        sidebar.classList.remove(
            "fixed",
            "inset-0",
            "z-50",
            "bg-white",
            "p-6",
            "overflow-y-auto"
        );

    }

</script>


{{>user/footer}}