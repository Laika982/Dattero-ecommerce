{{>user/header}}

<main
    class="flex-grow pt-20 sm:pt-24 md:pt-28 pb-12 md:pb-section-gap px-3 sm:px-6 md:px-container-padding max-w-max-width mx-auto w-full">

    <!-- ========================= -->
    <!-- PAGE HEADER -->
    <!-- ========================= -->
    {{> user/notification}}

    <div
        class="flex flex-col md:flex-row justify-between items-start md:items-end mb-6 md:mb-12 border-b border-surface-variant pb-4 sm:pb-stack-lg gap-4">

        <div>
            <h1 class="font-headline-xl text-3xl sm:text-4xl md:text-5xl text-ink-black font-bold">
                Shop All
            </h1>

            <p class="font-body-md text-sm sm:text-base text-on-surface-variant mt-1 sm:mt-2">
                Handcrafted protein excellence, made for your lifestyle.
            </p>
        </div>


        <!-- ========================= -->
        <!-- SEARCH -->
        <!-- ========================= -->

        <div
            class="w-full md:w-auto mt-2 md:mt-0 flex items-center bg-surface-gray pl-4 pr-1.5 h-[44px] sm:h-[48px] rounded-full relative group transition-all duration-300 gap-2">

            <span
                class="material-symbols-outlined text-on-surface-variant font-light text-[20px] group-focus-within:text-ink-black transition-colors shrink-0">
                search
            </span>

            <input id="searchInput"
                class="w-full bg-transparent border-none py-2 px-1 font-body-md text-sm sm:text-body-md text-ink-black placeholder:text-on-surface-variant/60 focus:ring-0 transition-all duration-300 outline-none"
                placeholder="Search our collections..." type="text" value="{{search}}">

            <button type="button" id="clearSearchBtn" onclick="clearSearch()"
                class="{{#unless search}}hidden{{/unless}} p-1 text-on-surface-variant/60 hover:text-ink-black transition-colors rounded-full hover:bg-surface-variant/40 shrink-0 flex items-center justify-center active:scale-90"
                title="Clear search" aria-label="Clear search">
                <span class="material-symbols-outlined text-[18px]">close</span>
            </button>

            <button type="button" onclick="applySearch()"
                class="px-4 sm:px-5 py-2 bg-on-surface text-surface rounded-full font-label-md text-xs sm:text-label-md hover:opacity-90 active:scale-95 transition-all duration-150 flex items-center shrink-0 shadow-sm">
                Search
            </button>

        </div>


        <!-- ========================= -->
        <!-- DESKTOP SORT -->
        <!-- ========================= -->

        <div class="hidden md:flex items-center gap-3 mt-6 md:mt-0">

            <label for="sort" class="font-body-md text-sm text-on-surface-variant">
                Sort By:
            </label>

            <select id="sort" onchange="changeSort(this.value)"
                class="border border-surface-variant rounded-lg px-4 py-2 bg-white focus:outline-none">

                <option value="" {{#if (eq sort "" )}}selected{{/if}}>
                    Featured
                </option>

                <option value="priceAcc" {{#if (eq sort "priceAcc" )}}selected{{/if}}>
                    Price: Low to High
                </option>

                <option value="priceDesc" {{#if (eq sort "priceDesc" )}}selected{{/if}}>
                    Price: High to Low
                </option>

                <option value="az" {{#if (eq sort "az" )}}selected{{/if}}>
                    A-Z
                </option>

                <option value="za" {{#if (eq sort "za" )}}selected{{/if}}>
                    Z-A
                </option>

            </select>

        </div>

    </div>


    <!-- ========================= -->
    <!-- MOBILE FILTER + SORT -->
    <!-- ========================= -->

    <div class="md:hidden flex gap-3 mb-6">

        <!-- FILTER BUTTON -->

        <button type="button" onclick="openFilters()"
            class="flex-1 h-11 flex items-center justify-center gap-2 border border-surface-variant rounded-xl bg-white text-ink-black shadow-sm active:scale-95 transition-all">

            <span class="material-symbols-outlined text-[18px]">
                tune
            </span>

            <span class="font-body-md text-sm font-semibold">
                Filter
            </span>

        </button>


        <!-- SORT BUTTON -->

        <button type="button" onclick="toggleMobileSort()"
            class="flex-1 h-11 flex items-center justify-center gap-2 border border-surface-variant rounded-xl bg-white text-ink-black shadow-sm active:scale-95 transition-all">

            <span class="material-symbols-outlined text-[18px]">
                swap_vert
            </span>

            <span class="font-body-md text-sm font-semibold">
                Sort
            </span>

        </button>

    </div>


    <!-- ========================= -->
    <!-- MOBILE SORT OPTIONS -->
    <!-- ========================= -->

    <div id="mobileSort"
        class="hidden md:hidden mb-6 border border-surface-variant rounded-2xl bg-white p-4 shadow-md transition-all">

        <p class="font-body-md text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-3">
            Sort By
        </p>

        <div class="space-y-1">

            <button type="button" onclick="changeSort('')"
                class="w-full text-left px-3 py-2.5 rounded-lg hover:bg-surface-gray text-sm font-medium">
                Featured
            </button>

            <button type="button" onclick="changeSort('priceAcc')"
                class="w-full text-left px-3 py-2.5 rounded-lg hover:bg-surface-gray text-sm font-medium">
                Price: Low to High
            </button>

            <button type="button" onclick="changeSort('priceDesc')"
                class="w-full text-left px-3 py-2.5 rounded-lg hover:bg-surface-gray text-sm font-medium">
                Price: High to Low
            </button>

            <button type="button" onclick="changeSort('az')"
                class="w-full text-left px-3 py-2.5 rounded-lg hover:bg-surface-gray text-sm font-medium">
                A-Z
            </button>

            <button type="button" onclick="changeSort('za')"
                class="w-full text-left px-3 py-2.5 rounded-lg hover:bg-surface-gray text-sm font-medium">
                Z-A
            </button>

        </div>

    </div>


    <!-- ========================= -->
    <!-- MAIN CONTENT -->
    <!-- ========================= -->

    <div class="flex flex-col md:flex-row gap-8 lg:gap-12">

        <!-- Mobile Filter Backdrop -->
        <div id="filterBackdrop"
            class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 hidden opacity-0 transition-opacity duration-300 md:hidden"
            onclick="closeFilters()"></div>

        <!-- ========================= -->
        <!-- FILTER SIDEBAR -->
        <!-- ========================= -->

        <aside id="filterSidebar"
            class="fixed top-0 right-0 bottom-0 w-[85%] max-w-xs bg-white z-50 p-6 overflow-y-auto shadow-2xl translate-x-full transition-transform duration-300 md:static md:translate-x-0 md:w-64 md:p-0 md:shadow-none md:bg-transparent md:block flex-shrink-0">

            <!-- MOBILE HEADER -->

            <div class="md:hidden flex items-center justify-between mb-6 pb-4 border-b border-surface-variant">

                <h2 class="font-headline-lg text-lg font-bold text-ink-black">
                    Filter Products
                </h2>

                <button type="button" onclick="closeFilters()" class="p-1 text-on-surface-variant hover:text-ink-black">

                    <span class="material-symbols-outlined">
                        close
                    </span>

                </button>

            </div>


            <!-- ========================= -->
            <!-- CATEGORY -->
            <!-- ========================= -->

            <div class="mb-10">

                <div class="flex items-center justify-between mb-5">

                    <h3 class="font-headline-md text-lg text-ink-black">
                        Category
                    </h3>


                    <!-- CLEAR CATEGORY -->

                    {{#if category}}

                    <button type="button" onclick="clearCategory()"
                        class="text-sm text-on-surface-variant hover:text-ink-black underline transition">
                        Clear
                    </button>

                    {{/if}}

                </div>


                <!-- CATEGORY LIST -->

                <div class="space-y-3">

                    {{#if categories.length}}

                    {{#each categories}}

                    <label class="flex items-center gap-3 cursor-pointer">

                        <input type="checkbox" name="category" value="{{_id}}" class="categoryFilter w-4 h-4" {{#if
                            (includes ../category _id)}}checked{{/if}}>

                        <span class="font-body-md text-sm text-on-surface-variant">
                            {{category_name}}
                        </span>

                    </label>

                    {{/each}}

                    {{else}}

                    <p class="text-sm text-on-surface-variant">
                        No categories available.
                    </p>

                    {{/if}}

                </div>

            </div>


            <!-- ========================= -->
            <!-- PRICE -->
            <!-- ========================= -->

            <div class="mb-10">

                <h3 class="font-headline-md text-lg text-ink-black mb-5">
                    Price
                </h3>

                <div class="flex items-center gap-3">

                    <!-- MIN PRICE -->

                    <input type="number" id="minPrice" name="minPrice" min="0" placeholder="Min" value="{{minPrice}}"
                        class="w-full border border-surface-variant rounded-lg px-3 py-2 text-sm bg-white focus:outline-none">

                    <span class="text-on-surface-variant flex-shrink-0">
                        —
                    </span>


                    <!-- MAX PRICE -->

                    <input type="number" id="maxPrice" name="maxPrice" min="0" placeholder="Max" value="{{maxPrice}}"
                        class="w-full border border-surface-variant rounded-lg px-3 py-2 text-sm bg-white focus:outline-none">

                </div>

            </div>


            <!-- ========================= -->
            <!-- APPLY FILTER -->
            <!-- ========================= -->

            <button type="button" onclick="applyFilters(); closeFilters();"
                class="w-full bg-ink-black text-white rounded-xl px-4 py-3 text-sm font-semibold hover:opacity-90 active:scale-95 transition shadow-sm">
                Apply Filters
            </button>

        </aside>


        <!-- ========================= -->
        <!-- PRODUCTS -->
        <!-- ========================= -->

        <div class="flex-grow grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-6 items-start">

            {{#if products.length}}

            {{#each products}}


            <!-- ========================= -->
            <!-- PRODUCT CARD -->
            <!-- ========================= -->

            <a href="/products/{{_id}}"
                class="group flex flex-col cursor-pointer bg-white rounded-2xl border border-surface-variant/60 p-2 sm:p-3 hover:shadow-lg transition-all duration-300">


                <!-- ========================= -->
                <!-- PRODUCT IMAGE -->
                <!-- ========================= -->

                <div class="relative w-full aspect-square overflow-hidden rounded-xl bg-surface-gray mb-2.5 sm:mb-3">


                    <!-- WISHLIST -->

                    <div class="absolute top-2 right-2 sm:top-2.5 sm:right-2.5 z-10">

                        <button type="button" data-product-id="{{_id}}"
                            data-wishlisted="{{#if isWishlisted}}true{{else}}false{{/if}}"
                            aria-pressed="{{#if isWishlisted}}true{{else}}false{{/if}}"
                            onclick="toggleProductWishlist(this, event)"
                            class="w-7 h-7 sm:w-9 sm:h-9 rounded-full {{#if isWishlisted}}bg-red-500 hover:bg-red-600 shadow-sm{{else}}bg-white/90 hover:bg-white shadow-sm{{/if}} flex items-center justify-center transition-transform active:scale-90">

                            <span
                                class="material-symbols-outlined text-[15px] sm:text-[18px] {{#if isWishlisted}}text-white{{else}}text-ink-black{{/if}}">
                                favorite
                            </span>

                        </button>

                    </div>


                    <!-- IMAGE -->

                    {{#if images.length}}

                    <img src="{{images.[0].url}}" alt="{{productName}}"
                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105">

                    {{else}}

                    <div class="w-full h-full flex items-center justify-center text-xs text-on-surface-variant">
                        No Image
                    </div>

                    {{/if}}

                </div>


                <!-- ========================= -->
                <!-- PRODUCT INFO -->
                <!-- ========================= -->

                <div class="flex flex-col flex-grow px-1 pb-1">


                    <!-- PRODUCT NAME -->

                    <div class="mb-1">

                        <h3
                            class="font-headline-md text-xs sm:text-base font-semibold text-ink-black line-clamp-1 leading-snug">
                            {{productName}}
                        </h3>

                    </div>


                    <!-- PRODUCT DESCRIPTION -->

                    <div class="mb-1.5 hidden sm:block">

                        <p class="text-xs text-on-surface-variant line-clamp-2">
                            {{productDescription}}
                        </p>

                    </div>


                    <!-- ========================= -->
                    <!-- CATEGORY NAME -->
                    <!-- ========================= -->

                    {{#if category_id}}

                    <p class="text-[11px] sm:text-xs text-on-surface-variant/80 mb-1 truncate">
                        {{category_id.category_name}}
                    </p>

                    {{/if}}


                    <!-- ========================= -->
                    <!-- RATING -->
                    <!-- ========================= -->

                    <div class="flex items-center mb-2 sm:mb-3 text-ink-black">

                        <span class="material-symbols-outlined text-[14px] sm:text-[16px] text-amber-500"
                            style="font-variation-settings: 'FILL' 1;">
                            star
                        </span>

                        <span class="font-body-md text-[11px] sm:text-xs ml-1 text-on-surface-variant">

                            {{#if average_rating}}

                            {{average_rating}}

                            {{else}}

                            4.5

                            {{/if}}


                            {{#if review_count}}

                            ({{review_count}})

                            {{/if}}

                        </span>

                    </div>


                    <!-- ========================= -->
                    <!-- PRICE -->
                    <!-- ========================= -->

                    <div
                        class="mt-auto pt-2 sm:pt-3 border-t border-surface-variant/40 flex items-center justify-between gap-1">

                        <p class="font-headline-lg text-sm sm:text-lg font-bold text-ink-black shrink-0">
                            ₹{{listPrice}}
                        </p>

                        <!-- Stock Status & Quantity Badge -->
                        {{#if isOutOfStock}}
                        <div class="inline-flex items-center gap-1 sm:gap-1.5 px-2 sm:px-2.5 py-0.5 rounded-full text-[10px] sm:text-xs font-medium border bg-red-50 text-red-600 border-red-200/80 whitespace-nowrap shrink-0"
                            title="Status: Out of Stock, Quantity: 0">
                            <span class="w-1.5 h-1.5 rounded-full bg-red-500 shrink-0"></span>
                            <span>Out of Stock</span>
                            <span class="opacity-75 font-semibold">(0)</span>
                        </div>
                        {{else if isLowStock}}
                        <div class="inline-flex items-center gap-1 sm:gap-1.5 px-2 sm:px-2.5 py-0.5 rounded-full text-[10px] sm:text-xs font-medium border bg-yellow-50 text-yellow-700 border-yellow-200/80 whitespace-nowrap shrink-0"
                            title="Status: Low Stock, Quantity: {{totalStock}}">
                            <span class="w-1.5 h-1.5 rounded-full bg-yellow-500 shrink-0"></span>
                            <span>Low Stock</span>
                            <span class="opacity-75 font-semibold">({{totalStock}})</span>
                        </div>
                        {{else}}
                        <div class="inline-flex items-center gap-1 sm:gap-1.5 px-2 sm:px-2.5 py-0.5 rounded-full text-[10px] sm:text-xs font-medium border bg-green-50 text-green-700 border-green-200/80 whitespace-nowrap shrink-0"
                            title="Status: In Stock, Quantity: {{totalStock}}">
                            <span class="w-1.5 h-1.5 rounded-full bg-green-500 shrink-0"></span>
                            <span>In Stock</span>
                            <span class="opacity-75 font-semibold">({{totalStock}})</span>
                        </div>
                        {{/if}}

                    </div>

                </div>

            </a>

            {{/each}}


            {{else}}


            <!-- ========================= -->
            <!-- NO PRODUCTS -->
            <!-- ========================= -->

            <div class="col-span-full flex flex-col items-center justify-center py-20">

                <span class="material-symbols-outlined text-5xl text-on-surface-variant">
                    inventory_2
                </span>

                <h2 class="font-headline-lg text-2xl text-ink-black mt-4">
                    No products found
                </h2>

                <p class="font-body-md text-on-surface-variant mt-2">
                    Try changing your search or filters.
                </p>

            </div>

            {{/if}}

        </div>

    </div>


    <!-- ========================= -->
    <!-- PAGINATION -->
    <!-- ========================= -->

    {{#if totalPage}}

    {{#if (gt totalPage 1)}}

    <div
        class="mt-16 mb-12 flex flex-col md:flex-row items-center justify-between gap-6 border-t border-surface-variant/50 pt-8 w-full">


        <!-- SHOWING -->

        <p class="font-body-md text-sm text-on-surface-variant">

            Showing

            {{#if totalProduct}}

            {{add (multiply (subtract page 1) 10) 1}}

            {{else}}

            0

            {{/if}}

            -

            {{#if (lt (multiply page 10) totalProduct)}}

            {{multiply page 10}}

            {{else}}

            {{totalProduct}}

            {{/if}}

            of {{totalProduct}} products

        </p>


        <!-- PAGINATION -->

        <div class="flex items-center gap-2">


            <!-- PREVIOUS -->

            {{#if (gt page 1)}}

            <button type="button" onclick="goToPage({{subtract page 1}})"
                class="w-10 h-10 flex items-center justify-center border border-surface-variant rounded-lg hover:bg-surface-gray transition">

                <span class="material-symbols-outlined text-[18px]">
                    chevron_left
                </span>

            </button>

            {{else}}

            <button type="button" disabled
                class="w-10 h-10 flex items-center justify-center border border-surface-variant rounded-lg opacity-40 cursor-not-allowed">

                <span class="material-symbols-outlined text-[18px]">
                    chevron_left
                </span>

            </button>

            {{/if}}


            <!-- PAGE NUMBERS -->

            {{#each (range 1 totalPage)}}

            <button type="button" onclick="goToPage({{this}})" class="w-10 h-10 flex items-center justify-center border border-surface-variant rounded-lg text-sm

                            {{#if (eq this ../page)}}
                                bg-ink-black text-white
                            {{else}}
                                hover:bg-surface-gray text-ink-black
                            {{/if}}

                            transition">
                {{this}}
            </button>

            {{/each}}


            <!-- NEXT -->

            {{#if (lt page totalPage)}}

            <button type="button" onclick="goToPage({{add page 1}})"
                class="w-10 h-10 flex items-center justify-center border border-surface-variant rounded-lg hover:bg-surface-gray transition">

                <span class="material-symbols-outlined text-[18px]">
                    chevron_right
                </span>

            </button>

            {{else}}

            <button type="button" disabled
                class="w-10 h-10 flex items-center justify-center border border-surface-variant rounded-lg opacity-40 cursor-not-allowed">

                <span class="material-symbols-outlined text-[18px]">
                    chevron_right
                </span>

            </button>

            {{/if}}

        </div>

    </div>

    {{/if}}

    {{/if}}

</main>


<script>


    // =========================================
    // SEARCH
    // =========================================

    function applySearch() {

        const searchInput =
            document.getElementById("searchInput");

        const search =
            searchInput.value.trim();

        const url =
            new URL(window.location.href);


        if (search) {

            url.searchParams.set(
                "search",
                search
            );

        } else {

            url.searchParams.delete(
                "search"
            );

        }


        // Reset pagination

        url.searchParams.set(
            "page",
            "1"
        );


        window.location.href =
            url.toString();

    }


    // =========================================
    // SEARCH USING ENTER KEY
    // =========================================

    document
        .getElementById("searchInput")
        .addEventListener(
            "keydown",
            function (event) {

                if (event.key === "Enter") {

                    applySearch();

                }

            }
        );

    // =========================================
    // CLEAR SEARCH
    // =========================================

    function clearSearch() {
        const searchInput = document.getElementById("searchInput");
        const clearBtn = document.getElementById("clearSearchBtn");

        if (searchInput) {
            searchInput.value = "";
        }
        if (clearBtn) {
            clearBtn.classList.add("hidden");
        }

        const url = new URL(window.location.href);
        if (url.searchParams.has("search")) {
            url.searchParams.delete("search");
            url.searchParams.set("page", "1");
            window.location.href = url.toString();
        } else if (searchInput) {
            searchInput.focus();
        }
    }

    (function () {
        const searchInputEl = document.getElementById("searchInput");
        const clearBtnEl = document.getElementById("clearSearchBtn");

        if (searchInputEl && clearBtnEl) {
            searchInputEl.addEventListener("input", function () {
                if (this.value.trim().length > 0) {
                    clearBtnEl.classList.remove("hidden");
                } else {
                    clearBtnEl.classList.add("hidden");
                }
            });

            searchInputEl.addEventListener("keydown", function (event) {
                if (event.key === "Escape") {
                    clearSearch();
                }
            });
        }
    })();


    // =========================================
    // SORT
    // =========================================

    function changeSort(value) {

        const url =
            new URL(window.location.href);


        if (value) {

            url.searchParams.set(
                "sort",
                value
            );

        } else {

            url.searchParams.delete(
                "sort"
            );

        }


        // Reset pagination

        url.searchParams.set(
            "page",
            "1"
        );


        window.location.href =
            url.toString();

    }


    // =========================================
    // MOBILE SORT
    // =========================================

    function toggleMobileSort() {

        const mobileSort =
            document.getElementById(
                "mobileSort"
            );


        mobileSort.classList.toggle(
            "hidden"
        );

    }


    // =========================================
    // APPLY FILTERS
    // =========================================

    function applyFilters() {


        const minPrice =
            document.getElementById(
                "minPrice"
            ).value;


        const maxPrice =
            document.getElementById(
                "maxPrice"
            ).value;


        // Get ALL selected categories

        const selectedCategories =
            document.querySelectorAll(
                'input[name="category"]:checked'
            );


        const url =
            new URL(window.location.href);


        // =========================================
        // CATEGORY
        // =========================================

        // Delete all old category parameters

        url.searchParams.delete(
            "category"
        );


        // Add every selected category

        selectedCategories.forEach(
            function (checkbox) {

                url.searchParams.append(
                    "category",
                    checkbox.value
                );

            }
        );


        // =========================================
        // MIN PRICE
        // =========================================

        if (minPrice) {

            url.searchParams.set(
                "minPrice",
                minPrice
            );

        } else {

            url.searchParams.delete(
                "minPrice"
            );

        }


        // =========================================
        // MAX PRICE
        // =========================================

        if (maxPrice) {

            url.searchParams.set(
                "maxPrice",
                maxPrice
            );

        } else {

            url.searchParams.delete(
                "maxPrice"
            );

        }


        // =========================================
        // RESET PAGE
        // =========================================

        url.searchParams.set(
            "page",
            "1"
        );


        // =========================================
        // REDIRECT
        // =========================================

        window.location.href =
            url.toString();

    }


    // =========================================
    // CLEAR CATEGORY
    // =========================================

    function clearCategory() {

        const url =
            new URL(window.location.href);


        // Remove ALL category parameters

        url.searchParams.delete(
            "category"
        );


        // Reset pagination

        url.searchParams.set(
            "page",
            "1"
        );


        window.location.href =
            url.toString();

    }


    // =========================================
    // PAGINATION
    // =========================================

    function goToPage(pageNumber) {

        const url =
            new URL(window.location.href);


        // Only change page.
        // Existing search, category,
        // price and sort parameters remain.

        url.searchParams.set(
            "page",
            pageNumber
        );


        window.location.href =
            url.toString();

    }


    // =========================================
    // OPEN MOBILE FILTER
    // =========================================

    function openFilters() {

        const sidebar =
            document.getElementById(
                "filterSidebar"
            );


        sidebar.classList.remove(
            "hidden"
        );


        sidebar.classList.add(
            "fixed",
            "inset-0",
            "z-50",
            "bg-white",
            "p-6",
            "overflow-y-auto"
        );

    }


    // =========================================
    // CLOSE MOBILE FILTER
    // =========================================

    function closeFilters() {

        const sidebar =
            document.getElementById(
                "filterSidebar"
            );


        sidebar.classList.add(
            "hidden"
        );


        sidebar.classList.remove(
            "fixed",
            "inset-0",
            "z-50",
            "bg-white",
            "p-6",
            "overflow-y-auto"
        );

    }

</script>

<script>

    async function toggleProductWishlist(button, event) {
        event.preventDefault();
        event.stopPropagation();
        if (button.disabled) return;

        const isAuthenticated = {{#if user}}true{{else}}false{{/if}};
        if (!isAuthenticated) {
            showNotification("error", "Please log in to add items to wishlist.");
            setTimeout(() => {
                window.location.href = "/login";
            }, 1200);
            return;
        }

        const wasWishlisted = button.dataset.wishlisted === "true";
        button.disabled = true;
        try {
            const response = await fetch(`/wishlist/${wasWishlisted ? "remove" : "add"}/${button.dataset.productId}`, {
                method: wasWishlisted ? "DELETE" : "POST",
                headers: { "Accept": "application/json" }
            });
            const result = await response.json();

            if (response.status === 401 || result.redirectTo) {
                showNotification("error", result.message || "Please log in to add items to wishlist.");
                setTimeout(() => {
                    window.location.href = result.redirectTo || "/login";
                }, 1200);
                return;
            }

            if (!response.ok) {
                throw new Error(result.message || "Unable to update your wishlist.");
            }

            const isWishlisted = !wasWishlisted;
            button.dataset.wishlisted = String(isWishlisted);
            button.setAttribute("aria-pressed", String(isWishlisted));
            button.classList.toggle("bg-red-500", isWishlisted);
            button.classList.toggle("bg-white/90", !isWishlisted);
            button.classList.toggle("hover:bg-red-600", isWishlisted);
            button.classList.toggle("hover:bg-white", !isWishlisted);
            button.querySelector(".material-symbols-outlined").classList.toggle("text-white", isWishlisted);
            button.querySelector(".material-symbols-outlined").classList.toggle("text-ink-black", !isWishlisted);
        } catch (error) {
            window.alert(error.message);
        } finally {
            button.disabled = false;
        }
    }

    // =====================================================
    // ADD PRODUCT FROM LISTING PAGE
    // =====================================================

    async function addListingProductToCart(button, event) {

        event.preventDefault();
        event.stopPropagation();

        const isAuthenticated = {{#if user}}true{{else}}false{{/if}};
        if (!isAuthenticated) {
            showNotification("error", "Please log in to add items to cart.");
            setTimeout(() => {
                window.location.href = "/login";
            }, 1200);
            return;
        }

        const productId =
            button.dataset.productId;

        const variantId =
            button.dataset.variantId;

        const stock =
            Number(button.dataset.stock || 0);

        // -----------------------------------------
        // Validate variant
        // -----------------------------------------

        if (!variantId) {

            showNotification("error", "Please select a variant from the product page.");

            return;
        }

        // -----------------------------------------
        // Validate stock
        // -----------------------------------------

        if (stock <= 0) {

            showNotification("error", "This product is out of stock.");

            return;
        }

        // -----------------------------------------
        // Prevent multiple clicks
        // -----------------------------------------

        if (button.dataset.loading === "true") {
            return;
        }

        button.dataset.loading = "true";

        const originalHTML =
            button.innerHTML;

        button.disabled = true;

        try {

            // -----------------------------------------
            // ADD TO CART API
            // -----------------------------------------

            const response = await fetch(
                `/cart/add?productId=${encodeURIComponent(productId)}&variantId=${encodeURIComponent(variantId)}&quantity=1`,
                {
                    method: "POST",
                    headers: {
                        "Content-Type":
                            "application/json",
                        "Accept":
                            "application/json"
                    }
                }
            );

            const data =
                await response.json();

            // -----------------------------------------
            // REDIRECT GUEST TO LOGIN
            // -----------------------------------------

            if (response.status === 401 || data.redirectTo) {
                showNotification("error", data.message || "Please log in to add items to cart.");
                button.innerHTML = originalHTML;
                setTimeout(() => {
                    window.location.href = data.redirectTo || "/login";
                }, 1200);
                return;
            }

            // -----------------------------------------
            // ERROR
            // -----------------------------------------

            if (!response.ok || !data.success) {

                showNotification("error", data.message || "Unable to add product to cart");

                button.innerHTML =
                    originalHTML;

                return;
            }

            showNotification("success", data.message || "Product added to cart");

            if (typeof window.updateCartBadge === "function" && (data.cartCount !== undefined || data.cart)) {
                const totalCartCount = data.cartCount !== undefined
                    ? data.cartCount
                    : (data.cart?.items || []).reduce((sum, item) => sum + (Number(item.quantity) || 0), 0);
                window.updateCartBadge(totalCartCount);
            }

            // -----------------------------------------
            // FIND CURRENT QUANTITY
            // -----------------------------------------

            let currentQuantity = 1;

            if (data.cart && data.cart.items) {

                const cartItem =
                    data.cart.items.find(
                        item =>
                            item.variant_id
                                .toString() ===
                            variantId.toString()
                    );

                if (cartItem) {
                    currentQuantity =
                        cartItem.quantity;
                }
            }

            // -----------------------------------------
            // CHANGE ADD BUTTON
            // -----------------------------------------

            button.innerHTML = `
                <span class="listing-cart-quantity">
                    ${currentQuantity}
                </span>

                <span
                    class="material-symbols-outlined text-[18px]"
                >
                    shopping_bag
                </span>
            `;

            button.dataset.quantity =
                currentQuantity;

        } catch (error) {

            console.error(
                "Listing add cart error:",
                error
            );

            showNotification("error", "Unable to add product to cart");

        } finally {

            button.disabled = false;

            button.dataset.loading =
                "false";
        }
    }

    // =========================================
    // MOBILE FILTER DRAWER & SORT CONTROLS
    // =========================================

    function openFilters() {
        const sidebar = document.getElementById("filterSidebar");
        const backdrop = document.getElementById("filterBackdrop");
        if (!sidebar || !backdrop) return;
        backdrop.classList.remove("hidden");
        requestAnimationFrame(() => {
            backdrop.classList.remove("opacity-0");
            sidebar.classList.remove("translate-x-full");
        });
        document.body.style.overflow = "hidden";
    }

    function closeFilters() {
        const sidebar = document.getElementById("filterSidebar");
        const backdrop = document.getElementById("filterBackdrop");
        if (!sidebar || !backdrop) return;
        sidebar.classList.add("translate-x-full");
        backdrop.classList.add("opacity-0");
        setTimeout(() => {
            backdrop.classList.add("hidden");
            document.body.style.overflow = "";
        }, 300);
    }

    function toggleMobileSort() {
        const mobileSort = document.getElementById("mobileSort");
        if (mobileSort) {
            mobileSort.classList.toggle("hidden");
        }
    }

</script>


