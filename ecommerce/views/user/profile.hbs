  </div>
  <script>
    function showConfirmModal({ title, message, confirmText = 'Confirm', cancelText = 'Cancel', icon = 'logout', confirmColorClass = 'bg-primary text-on-primary', iconContainerColor = 'bg-error-container/30', iconColor = 'text-error' }) {
      return new Promise((resolve) => {
        const container = document.createElement('div');
        container.className = 'fixed inset-0 z-50 flex items-center justify-center bg-on-surface/40 backdrop-blur-md opacity-0 animate-[fadeIn_0.3s_ease-out_forwards]';
        
        if (!document.getElementById('modal-animation-style')) {
          const style = document.createElement('style');
          style.id = 'modal-animation-style';
          style.innerHTML = `
            @keyframes fadeIn {
              from { opacity: 0; }
              to { opacity: 1; }
            }
            @keyframes modalSlideUp {
              from {
                opacity: 0;
                transform: scale(0.95) translateY(20px);
              }
              to {
                opacity: 1;
                transform: scale(1) translateY(0);
              }
            }
          `;
          document.head.appendChild(style);
        }

        container.innerHTML = `
          <div class="relative w-full max-w-md mx-auto p-8 bg-surface-container-lowest rounded-3xl shadow-[0_8px_30px_rgb(0,0,0,0.08)] transform scale-95 opacity-0 animate-[modalSlideUp_0.4s_ease-out_0.1s_forwards] border border-outline-variant/10">
            <div class="flex flex-col items-center text-center">
              <div class="w-16 h-16 ${iconContainerColor} rounded-full flex items-center justify-center mb-6">
                <span class="material-symbols-outlined ${iconColor} text-[32px] font-light">${icon}</span>
              </div>
              <h2 class="font-headline-xl text-headline-xl text-on-surface mb-4 tracking-tight">${title}</h2>
              <p class="font-body-xl text-body-xl text-on-surface-variant mb-10 max-w-[280px]">
                ${message}
              </p>
              <div class="flex flex-col w-full gap-3">
                <button class="w-full py-4 ${confirmColorClass} rounded-full font-label-md text-label-md hover:-translate-y-[1px] hover:shadow-lg transition-all duration-200 flex items-center justify-center" id="modal-confirm-btn">
                  ${confirmText}
                </button>
                <button class="w-full py-4 text-on-surface-variant font-label-md text-label-md hover:text-on-surface transition-colors duration-200" id="modal-cancel-btn">
                  ${cancelText}
                </button>
              </div>
            </div>
          </div>
        `;

        document.body.appendChild(container);

        const closeModal = (result) => {
          container.style.opacity = '0';
          container.style.transition = 'opacity 0.2s ease-out';
          setTimeout(() => {
            container.remove();
            resolve(result);
          }, 200);
        };

        container.querySelector('#modal-cancel-btn').addEventListener('click', () => closeModal(false));
        
        container.addEventListener('click', (e) => {
          if (e.target === container) {
            closeModal(false);
          }
        });

        const confirmBtn = container.querySelector('#modal-confirm-btn');
        confirmBtn.addEventListener('click', () => {
          confirmBtn.innerHTML = '<span class="material-symbols-outlined animate-spin text-[20px]">progress_activity</span>';
          confirmBtn.classList.add('opacity-80', 'cursor-not-allowed');
          setTimeout(() => {
            closeModal(true);
          }, 800);
        });
      });
    }

    // Logout confirmation prompt
    document.getElementById('logout-btn')?.addEventListener('click', function(e) {
      e.preventDefault();
      const url = this.getAttribute('href');
      showConfirmModal({
        title: 'Sign Out',
        message: 'Are you sure you want to sign out of your account?',
        confirmText: 'Sign Out',
        cancelText: 'Cancel',
        icon: 'logout'
      }).then((confirmed) => {
        if (confirmed) {
          window.location.href = url;
        }
      });
    });

    // Delete Account confirmation prompt
    document.getElementById('delete-account-btn')?.addEventListener('click', function(e) {
      e.preventDefault();
      showConfirmModal({
        title: 'Delete Account',
        message: 'This will permanently delete your account and all associated data. This action cannot be undone!',
        confirmText: 'Delete Account',
        cancelText: 'Cancel',
        icon: 'delete_forever',
        iconContainerColor: 'bg-error-container/30',
        iconColor: 'text-error'
      }).then((confirmed) => {
        if (confirmed) {
          showConfirmModal({
            title: 'Final Confirmation',
            message: 'Are you absolutely sure you want to permanently delete your account?',
            confirmText: 'Permanently Delete',
            cancelText: 'Cancel',
            icon: 'warning',
            iconContainerColor: 'bg-error-container/30',
            iconColor: 'text-error'
          }).then((secondConfirmed) => {
            if (secondConfirmed) {
              fetch('/profile/delete-account', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json'
                }
              })
              .then(response => {
                if (response.ok) {
                  showConfirmModal({
                    title: 'Deleted!',
                    message: 'Your account has been successfully deleted.',
                    confirmText: 'Close',
                    icon: 'check_circle',
                    iconContainerColor: 'bg-emerald-100 dark:bg-emerald-900/30',
                    iconColor: 'text-emerald-600',
                    confirmColorClass: 'bg-emerald-600 text-white'
                  }).then(() => {
                    window.location.href = '/';
                  });
                } else {
                  showConfirmModal({
                    title: 'Error!',
                    message: 'Failed to delete account. Please try again later.',
                    confirmText: 'OK',
                    icon: 'error'
                  });
                }
              })
              .catch(err => {
                console.error(err);
                showConfirmModal({
                  title: 'Error!',
                  message: 'An unexpected error occurred.',
                  confirmText: 'OK',
                  icon: 'error'
                });
              });
            }
          });
        }
      });
    });

    function togglePasswordVisibility(id) {
      const input = document.getElementById(id);
      if (!input) return;
      const icon = input.nextElementSibling ? input.nextElementSibling.querySelector('.material-symbols-outlined') : (input.parentElement ? input.parentElement.querySelector('.material-symbols-outlined') : null);
      if (input.type === "password") {
        input.type = "text";
        if (icon) icon.textContent = "visibility_off";
      } else {
        input.type = "password";
        if (icon) icon.textContent = "visibility";
      }
    }

    // Micro-interactions for form feedback
    document.querySelectorAll('input, select').forEach(input => {
      input.addEventListener('focus', () => {
        input.parentElement.parentElement.classList.add('scale-[1.01]');
      });
      input.addEventListener('blur', () => {
        input.parentElement.parentElement.classList.remove('scale-[1.01]');
      });
    });

    // Profile Page Interactions

    // Save button click effect
    /*
    const saveBtn = document.querySelector('button.bg-on-surface');
    saveBtn.addEventListener('click', () => {
      const originalText = saveBtn.innerText;
      saveBtn.innerText = 'Saving...';
      saveBtn.classList.add('opacity-50');

      setTimeout(() => {
        saveBtn.innerText = 'Updated';
        saveBtn.classList.remove('opacity-50');
        saveBtn.classList.add('bg-emerald-600');

        setTimeout(() => {
          saveBtn.innerText = originalText;
          saveBtn.classList.remove('bg-emerald-600');
        }, 2000);
      }, 1000);
    });
    */
  </script>

