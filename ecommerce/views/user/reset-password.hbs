{{>user/header}}
<!-- Main Content Canvas -->
<main
  class="flex-grow flex items-center justify-center px-container-padding py-section-gap-mobile md:py-section-gap relative overflow-hidden">

  <!-- Subtle Ambient Background Decor -->
  <div class="absolute top-1/4 -left-20 w-96 h-96 bg-primary/5 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-1/4 -right-20 w-80 h-80 bg-secondary/5 rounded-full blur-3xl pointer-events-none"></div>

  <!-- Reset Password Card -->
  <div
    class="w-full max-w-[480px] bg-surface-container-lowest rounded-xl p-8 md:p-12 soft-shadow border border-outline-variant/10 fade-in z-10">

    <!-- Brand Mark / Icon -->
    <div class="flex justify-center mb-8">
      <div class="w-16 h-16 rounded-full bg-primary-fixed flex items-center justify-center">
        <span class="material-symbols-outlined text-primary text-3xl"
          style="font-variation-settings: 'FILL' 1;">lock_reset</span>
      </div>
    </div>

    <!-- Typography Header -->
    <div class="text-center mb-10">
      <h1 class="font-headline-xl text-headline-xl text-ink-black mb-3">Secure Your Account</h1>
      <p class="font-body-md text-on-surface-variant max-w-[320px] mx-auto">Please enter a new, strong password to
        regain access to your Nutri Luxe experience.</p>
    </div>



    <!-- Success & Error Messages -->
    {{> user/notification}}

    <!-- Form -->
    <form id="reset-form" class="space-y-6" method="post" action="/resetPassword" novalidate>
      <!-- New Password Field -->
      <div class="space-y-2">
        <label for="new-password" class="block font-label-md text-label-md text-on-surface-variant px-1">New
          Password</label>
        <div class="relative">
          <input type="password" id="new-password" name="newPassword" placeholder="Min. 8 characters"
            autocomplete="new-password"
            class="w-full px-5 py-4 bg-surface-gray border border-outline-variant/30 rounded-lg focus:border-primary/50 transition-all placeholder:text-outline">
          <button type="button" data-password-toggle="new-password"
            class="absolute right-4 top-1/2 -translate-y-1/2 text-outline hover:text-primary transition-colors" aria-label="Toggle password visibility">
            <span class="material-symbols-outlined text-xl">visibility</span>
          </button>
        </div>
        <p id="new-password-error" class="text-xs text-red-600 mt-1 flex items-center gap-1 font-medium hidden px-1" role="alert">
          <span class="material-symbols-outlined text-[15px] shrink-0 leading-none">error</span>
          <span class="error-text"></span>
        </p>
      </div>

      <!-- Confirm Password Field -->
      <div class="space-y-2">
        <label for="confirm-password" class="block font-label-md text-label-md text-on-surface-variant px-1">Confirm New
          Password</label>
        <div class="relative">
          <input type="password" id="confirm-password" name="confirmPassword" placeholder="Re-enter your password"
            autocomplete="new-password"
            class="w-full px-5 py-4 bg-surface-gray border border-outline-variant/30 rounded-lg focus:border-primary/50 transition-all placeholder:text-outline">
          <button type="button" data-password-toggle="confirm-password"
            class="absolute right-4 top-1/2 -translate-y-1/2 text-outline hover:text-primary transition-colors" aria-label="Toggle confirm password visibility">
            <span class="material-symbols-outlined text-xl">visibility</span>
          </button>
        </div>
        <p id="confirm-password-error" class="text-xs text-red-600 mt-1 flex items-center gap-1 font-medium hidden px-1" role="alert">
          <span class="material-symbols-outlined text-[15px] shrink-0 leading-none">error</span>
          <span class="error-text"></span>
        </p>
      </div>

      <!-- Password Requirements -->
      <div class="p-4 bg-surface-container-low rounded-xl border border-outline-variant/20 space-y-2">
        <div class="flex items-center justify-between mb-1">
          <p class="font-semibold text-[11px] uppercase tracking-wider text-on-surface">Password Requirements:</p>
          <span id="pwd-strength-label" class="font-medium text-[11px]"></span>
        </div>
        <ul class="text-[12px] space-y-1.5 text-on-surface-variant">
          <li id="req-length" class="flex items-center gap-2 text-on-surface-variant/70 transition-colors">
            <span class="material-symbols-outlined text-[15px] req-icon shrink-0">radio_button_unchecked</span>
            At least 8 characters long
          </li>
          <li id="req-letter" class="flex items-center gap-2 text-on-surface-variant/70 transition-colors">
            <span class="material-symbols-outlined text-[15px] req-icon shrink-0">radio_button_unchecked</span>
            Include at least 1 letter (a-z, A-Z)
          </li>
          <li id="req-number" class="flex items-center gap-2 text-on-surface-variant/70 transition-colors">
            <span class="material-symbols-outlined text-[15px] req-icon shrink-0">radio_button_unchecked</span>
            Include at least 1 number (0-9)
          </li>
          <li id="req-special" class="flex items-center gap-2 text-on-surface-variant/70 transition-colors">
            <span class="material-symbols-outlined text-[15px] req-icon shrink-0">radio_button_unchecked</span>
            Include a special symbol (@$!%*?&)
          </li>
        </ul>
      </div>

      <!-- Action Button -->
      <button type="submit"
        class="w-full py-4 font-label-md text-label-md rounded-full hover:shadow-lg active:scale-[0.98] transition-all duration-300 uppercase tracking-widest mt-4 bg-ink-black text-on-primary">
        Update Password
      </button>
    </form>

    <!-- Back to Login -->
    <div class="mt-8 text-center">
      <a href="/login"
        class="inline-flex items-center gap-2 font-label-md text-label-md text-primary hover:opacity-70 transition-opacity">
        <span class="material-symbols-outlined text-lg">arrow_back</span>
        Return to Login
      </a>
    </div>
  </div>

</main>

<style>
  .input-error {
    border-color: #ef4444 !important;
    box-shadow: 0 0 0 1px #ef4444 !important;
    background-color: rgba(254, 242, 242, 0.45) !important;
  }
  .input-error:focus {
    border-color: #ef4444 !important;
    box-shadow: 0 0 0 2px rgba(239, 68, 68, 0.35) !important;
  }
  .req-valid {
    color: #059669 !important;
    font-weight: 500 !important;
  }
  .req-valid .req-icon {
    color: #059669 !important;
  }
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const form = document.getElementById("reset-form");
  if (!form) return;

  const newPasswordInput = document.getElementById("new-password");
  const confirmPasswordInput = document.getElementById("confirm-password");

  const newPasswordError = document.getElementById("new-password-error");
  const confirmPasswordError = document.getElementById("confirm-password-error");

  const reqLength = document.getElementById("req-length");
  const reqLetter = document.getElementById("req-letter");
  const reqNumber = document.getElementById("req-number");
  const reqSpecial = document.getElementById("req-special");
  const strengthLabel = document.getElementById("pwd-strength-label");

  const touched = {
    newPassword: false,
    confirmPassword: false,
  };

  function showError(input, errorEl, message) {
    input.classList.add("input-error");
    if (errorEl) {
      const textSpan = errorEl.querySelector(".error-text");
      if (textSpan) textSpan.textContent = message;
      errorEl.classList.remove("hidden");
    }
  }

  function clearError(input, errorEl) {
    input.classList.remove("input-error");
    if (errorEl) {
      const textSpan = errorEl.querySelector(".error-text");
      if (textSpan) textSpan.textContent = "";
      errorEl.classList.add("hidden");
    }
  }

  function updateRequirement(el, isValid) {
    if (!el) return;
    const icon = el.querySelector(".req-icon");
    if (isValid) {
      el.classList.add("req-valid");
      if (icon) icon.textContent = "check_circle";
    } else {
      el.classList.remove("req-valid");
      if (icon) icon.textContent = "radio_button_unchecked";
    }
  }

  function updatePasswordRequirements(val) {
    const hasLength = val.length >= 8;
    const hasLetter = /[A-Za-z]/.test(val);
    const hasNumber = /\d/.test(val);
    const hasSpecial = /[@$!%*?&]/.test(val);

    updateRequirement(reqLength, hasLength);
    updateRequirement(reqLetter, hasLetter);
    updateRequirement(reqNumber, hasNumber);
    updateRequirement(reqSpecial, hasSpecial);

    const totalMet = [hasLength, hasLetter, hasNumber, hasSpecial].filter(Boolean).length;
    if (strengthLabel) {
      if (val.length === 0) {
        strengthLabel.textContent = "";
      } else if (totalMet <= 2) {
        strengthLabel.textContent = "Weak";
        strengthLabel.className = "font-medium text-[11px] text-red-500";
      } else if (totalMet === 3) {
        strengthLabel.textContent = "Medium";
        strengthLabel.className = "font-medium text-[11px] text-amber-600";
      } else {
        strengthLabel.textContent = "Strong";
        strengthLabel.className = "font-medium text-[11px] text-emerald-600";
      }
    }

    return hasLength && hasLetter && hasNumber && hasSpecial;
  }

  function validateNewPassword() {
    const val = newPasswordInput.value || "";
    const allMet = updatePasswordRequirements(val);

    if (!val) {
      showError(newPasswordInput, newPasswordError, "Please enter a new password.");
      return false;
    }
    if (!allMet) {
      showError(newPasswordInput, newPasswordError, "Password must be at least 8 characters with a letter, number, and special character (@$!%*?&).");
      return false;
    }
    clearError(newPasswordInput, newPasswordError);
    return true;
  }

  function validateConfirmPassword() {
    const pwd = newPasswordInput.value || "";
    const cpwd = confirmPasswordInput.value || "";

    if (!cpwd) {
      showError(confirmPasswordInput, confirmPasswordError, "Please confirm your new password.");
      return false;
    }
    if (pwd !== cpwd) {
      showError(confirmPasswordInput, confirmPasswordError, "Passwords do not match.");
      return false;
    }
    clearError(confirmPasswordInput, confirmPasswordError);
    return true;
  }

  newPasswordInput.addEventListener("input", function () {
    updatePasswordRequirements(newPasswordInput.value || "");
    if (touched.newPassword) validateNewPassword();
    if (touched.confirmPassword && confirmPasswordInput.value) {
      validateConfirmPassword();
    }
  });

  newPasswordInput.addEventListener("blur", function () {
    touched.newPassword = true;
    validateNewPassword();
  });

  confirmPasswordInput.addEventListener("input", function () {
    if (touched.confirmPassword) validateConfirmPassword();
  });

  confirmPasswordInput.addEventListener("blur", function () {
    touched.confirmPassword = true;
    validateConfirmPassword();
  });

  form.addEventListener("submit", async function (e) {
    e.preventDefault();
    touched.newPassword = true;
    touched.confirmPassword = true;

    const isNewValid = validateNewPassword();
    const isConfirmValid = validateConfirmPassword();

    if (!isNewValid || !isConfirmValid) {
      if (!isNewValid) {
        newPasswordInput.focus();
      } else {
        confirmPasswordInput.focus();
      }
      return;
    }

    const submitBtn = form.querySelector('button[type="submit"]');
    const originalBtnHtml = submitBtn ? submitBtn.innerHTML : "";
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span class="material-symbols-outlined animate-spin" style="font-size: 18px;">progress_activity</span> Updating Password...';
      submitBtn.style.opacity = "0.75";
    }

    try {
      const newPassword = newPasswordInput.value;
      const confirmPassword = confirmPasswordInput.value;

      const res = await fetch("/resetPassword", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "X-Requested-With": "XMLHttpRequest",
          "Accept": "application/json",
        },
        body: JSON.stringify({ newPassword, confirmPassword }),
      });

      const data = await res.json().catch(() => ({}));

      if (res.ok && data.success) {
        if (typeof showNotification === "function") {
          showNotification("success", data.message || "Password changed successfully! Redirecting to login...");
        }
        setTimeout(() => {
          window.location.href = data.redirectTo || "/login";
        }, 400);
      } else {
        const errorMsg = data.message || "Failed to reset password. Please try again.";
        if (typeof showNotification === "function") {
          showNotification("error", errorMsg);
        }
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalBtnHtml;
          submitBtn.style.opacity = "";
        }
      }
    } catch (err) {
      console.error("Reset password AJAX error:", err);
      if (typeof showNotification === "function") {
        showNotification("error", "An unexpected error occurred. Please try again.");
      }
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalBtnHtml;
        submitBtn.style.opacity = "";
      }
    }
  });
});
</script>

{{> user/footer}}
