<!DOCTYPE html><html lang="en" class="light"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700&amp;family=Inter:wght@400;500;600&amp;family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=block" rel="stylesheet"><script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script><script id="tailwind-config">try{
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            "colors": {
                    "ink-black": "#1D1D1F",
                    "on-secondary-fixed": "#29180b",
                    "tertiary-container": "#7ea3e3",
                    "primary-fixed-dim": "#f0bf5c",
                    "tertiary": "#385e9a",
                    "on-background": "#1b1c19",
                    "tertiary-fixed-dim": "#a9c7ff",
                    "tertiary-fixed": "#d6e3ff",
                    "on-tertiary-fixed": "#001b3d",
                    "surface-container-highest": "#e4e2de",
                    "surface-dim": "#dbdad5",
                    "on-tertiary": "#ffffff",
                    "error": "#ba1a1a",
                    "on-surface-variant": "#4e4637",
                    "secondary-fixed": "#fedcc7",
                    "outline-variant": "#d2c5b1",
                    "on-primary": "#ffffff",
                    "accent-blue": "#0071E3",
                    "surface-container-high": "#eae8e3",
                    "primary-fixed": "#ffdea4",
                    "primary": "#7b5900",
                    "background": "#fbf9f4",
                    "surface-gray": "#F5F5F7",
                    "secondary": "#725949",
                    "on-error-container": "#93000a",
                    "surface-tint": "#7b5900",
                    "inverse-primary": "#f0bf5c",
                    "on-surface": "#1b1c19",
                    "primary-container": "#c89b3c",
                    "on-primary-fixed-variant": "#5d4200",
                    "surface-container": "#efeee9",
                    "outline": "#807665",
                    "on-tertiary-container": "#033871",
                    "surface": "#fbf9f4",
                    "on-secondary-container": "#775d4d",
                    "on-primary-container": "#4b3500",
                    "error-container": "#ffdad6",
                    "on-secondary": "#ffffff",
                    "on-error": "#ffffff",
                    "surface-bright": "#fbf9f4",
                    "secondary-container": "#fbd9c4",
                    "on-tertiary-fixed-variant": "#1b4680",
                    "surface-container-low": "#f5f3ee",
                    "inverse-surface": "#30312e",
                    "on-secondary-fixed-variant": "#594233",
                    "surface-container-lowest": "#ffffff",
                    "secondary-fixed-dim": "#e1c0ac",
                    "inverse-on-surface": "#f2f1ec",
                    "on-primary-fixed": "#261900",
                    "surface-variant": "#e4e2de"
            },
            "borderRadius": {
                    "DEFAULT": "0.25rem",
                    "lg": "0.5rem",
                    "xl": "0.75rem",
                    "full": "9999px"
            },
            "spacing": {
                    "section-gap-mobile": "64px",
                    "section-gap": "120px",
                    "max-width": "1280px",
                    "container-padding": "32px",
                    "stack-sm": "8px",
                    "stack-md": "16px",
                    "stack-lg": "24px",
                    "grid-gutter": "24px"
            },
            "fontFamily": {
                    "display-lg": ["Plus Jakarta Sans"],
                    "body-xl": ["Inter"],
                    "body-md": ["Inter"],
                    "display-lg-mobile": ["Plus Jakarta Sans"],
                    "headline-xl": ["Plus Jakarta Sans"],
                    "headline-lg": ["Plus Jakarta Sans"],
                    "body-lg": ["Inter"],
                    "label-md": ["Inter"]
            },
            "fontSize": {
                    "display-lg": ["56px", {"lineHeight": "1.1", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                    "body-xl": ["20px", {"lineHeight": "1.5", "fontWeight": "400"}],
                    "body-md": ["15px", {"lineHeight": "1.5", "fontWeight": "400"}],
                    "display-lg-mobile": ["40px", {"lineHeight": "1.1", "letterSpacing": "-0.01em", "fontWeight": "700"}],
                    "headline-xl": ["40px", {"lineHeight": "1.2", "letterSpacing": "-0.01em", "fontWeight": "600"}],
                    "headline-lg": ["32px", {"lineHeight": "1.25", "fontWeight": "600"}],
                    "body-lg": ["17px", {"lineHeight": "1.5", "fontWeight": "400"}],
                    "label-md": ["14px", {"lineHeight": "1.2", "letterSpacing": "0.02em", "fontWeight": "600"}]
            }
          },
        },
      }
    }catch(_e){}</script></head><body class="bg-background text-on-background font-body-md min-h-screen flex flex-col">

    <!-- TopNavBar (Shared Component Shell) -->
    <nav class="fixed top-0 w-full z-50 bg-surface/95 dark:bg-surface/90 backdrop-blur-md border-b border-secondary/10 dark:border-secondary-fixed-dim/10 shadow-sm transition-all duration-300 shadow-md" id="main-nav">
<div class="flex justify-between items-center w-full px-container-padding max-w-max-width mx-auto h-20">
<a class="font-headline-lg text-headline-lg font-bold text-on-surface tracking-tight z-10 flex-shrink-0" href="#">
                Nutri Burfi
            </a>
<div class="hidden md:flex items-center gap-8 absolute left-1/2 -translate-x-1/2">
<a class="text-on-surface font-label-md text-label-md border-b-2 border-on-surface pb-1" href="#">Home</a>
<a class="text-on-surface-variant font-label-md text-label-md hover:text-on-surface transition-colors" href="#">Products</a>
<a class="text-on-surface-variant font-label-md text-label-md hover:text-on-surface transition-colors" href="#">About Us</a>
<a class="text-on-surface-variant font-label-md text-label-md hover:text-on-surface transition-colors" href="#">Contact</a>
</div>
<div class="flex items-center gap-4 text-on-surface z-10 flex-shrink-0">
<button class="hover:opacity-80 transition-opacity active:scale-95 duration-150 ease-in-out p-2 rounded-full hover:bg-surface-variant/50">
<span class="material-symbols-outlined" data-icon="search">search</span>
</button>
<button class="hover:opacity-80 transition-opacity active:scale-95 duration-150 ease-in-out p-2 rounded-full hover:bg-surface-variant/50">
<span class="material-symbols-outlined" data-icon="favorite">favorite</span>
</button>
<button class="hover:opacity-80 transition-opacity active:scale-95 duration-150 ease-in-out p-2 rounded-full hover:bg-surface-variant/50 relative">
<span class="material-symbols-outlined" data-icon="shopping_cart">shopping_cart</span>
<span class="absolute top-1 right-1 w-2 h-2 bg-accent-blue rounded-full"></span>
</button>
<button class="hover:opacity-80 transition-opacity active:scale-95 duration-150 ease-in-out p-2 rounded-full hover:bg-surface-variant/50 hidden md:block">
<span class="material-symbols-outlined" data-icon="person">person</span>
</button>
<button class="md:hidden hover:opacity-80 transition-opacity active:scale-95 duration-150 ease-in-out p-2 rounded-full hover:bg-surface-variant/50 ml-2" id="mobile-menu-btn">
<span class="material-symbols-outlined" data-icon="menu">menu</span>
</button>
</div>
</div>
</nav>

    <!-- Main Content Canvas -->
    <main class="flex-grow flex items-center justify-center px-container-padding py-section-gap-mobile md:py-section-gap relative overflow-hidden">
        
        <!-- Subtle Ambient Background Decor -->
        <div class="absolute top-1/4 -left-20 w-96 h-96 bg-primary/5 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute bottom-1/4 -right-20 w-80 h-80 bg-secondary/5 rounded-full blur-3xl pointer-events-none"></div>

        <!-- Reset Password Card -->
        <div class="w-full max-w-[480px] bg-surface-container-lowest rounded-xl p-8 md:p-12 soft-shadow border border-outline-variant/10 fade-in z-10">
            
            <!-- Brand Mark / Icon -->
            <div class="flex justify-center mb-8">
                <div class="w-16 h-16 rounded-full bg-primary-fixed flex items-center justify-center">
                    <span class="material-symbols-outlined text-primary text-3xl" style="font-variation-settings: 'FILL' 1;">lock_reset</span>
                </div>
            </div>

            <!-- Typography Header -->
            <div class="text-center mb-10">
                <h1 class="font-headline-xl text-headline-xl text-ink-black mb-3">Secure Your Account</h1>
                <p class="font-body-md text-on-surface-variant max-w-[320px] mx-auto">Please enter a new, strong password to regain access to your Nutri Luxe experience.</p>
            </div>



            <!-- Success & Error Messages -->
{{#if error}}
<div class="bg-red-100 border border-red-300 text-red-700 px-4 py-3 rounded-xl mb-6">
    {{error}}
</div>
{{/if}}

{{#if success}}
<div class="bg-green-100 border border-green-300 text-green-700 px-4 py-3 rounded-xl mb-6">
    {{success}}
</div>
{{/if}}

            <!-- Form -->
            <form id="reset-form" class="space-y-6" method="post" action="/resetPassword">
                <!-- New Password Field -->
                <div class="space-y-2">
                    <label for="new-password" class="block font-label-md text-label-md text-on-surface-variant px-1">New Password</label>
                    <div class="relative">
                        <input type="password" id="new-password" name="newPassword" placeholder="Min. 8 characters" class="w-full px-5 py-4 bg-surface-gray border border-transparent rounded-lg focus:border-primary/30 transition-all placeholder:text-outline" required="">
                        <button type="button" onclick="togglePassword('new-password')" class="absolute right-4 top-1/2 -translate-y-1/2 text-outline hover:text-primary transition-colors">
                            <span class="material-symbols-outlined text-xl">visibility</span>
                        </button>
                    </div>
                </div>

                <!-- Confirm Password Field -->
                <div class="space-y-2">
                    <label for="confirm-password" class="block font-label-md text-label-md text-on-surface-variant px-1">Confirm New Password</label>
                    <div class="relative">
                        <input type="password" id="confirm-password" name="confirmPassword" placeholder="Re-enter your password" class="w-full px-5 py-4 bg-surface-gray border border-transparent rounded-lg focus:border-primary/30 transition-all placeholder:text-outline" required="">
                        <button type="button" onclick="togglePassword('confirm-password')" class="absolute right-4 top-1/2 -translate-y-1/2 text-outline hover:text-primary transition-colors">
                            <span class="material-symbols-outlined text-xl">visibility</span>
                        </button>
                    </div>
                </div>

                <!-- Password Requirements -->
                <div class="p-4 bg-surface-container-low rounded-lg space-y-2">
                    <p class="font-label-md text-label-md text-on-surface mb-1">Strength requirements:</p>
                    <ul class="text-[12px] space-y-1 text-on-surface-variant">
                        <li class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-[14px] text-primary">check_circle</span>
                            At least 8 characters long
                        </li>
                        <li class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-[14px] text-outline">circle</span>
                            Include a number or symbol
                        </li>
                    </ul>
                </div>

                <!-- Action Button -->
                <button type="submit" class="w-full py-4 font-label-md text-label-md rounded-full hover:shadow-lg active:scale-[0.98] transition-all duration-300 uppercase tracking-widest mt-4 bg-ink-black text-on-primary">
                    Update Password
                </button>
            </form>

            <!-- Back to Login -->
            <div class="mt-8 text-center">
                <a href="/login" class="inline-flex items-center gap-2 font-label-md text-label-md text-primary hover:opacity-70 transition-opacity">
                    <span class="material-symbols-outlined text-lg">arrow_back</span>
                    Return to Login
                </a>
            </div>
        </div>

    </main>

    {{> user/footer}}

    <script>
        function togglePassword(id) {
            const input = document.getElementById(id);
            const icon = input.nextElementSibling.querySelector('.material-symbols-outlined');
            if (input.type === "password") {
                input.type = "text";
                icon.textContent = "visibility_off";
            } else {
                input.type = "password";
                icon.textContent = "visibility";
            }
        }

        // Form Submission Interaction
        document.getElementById('reset-form').addEventListener('submit', function(e) {
            e.preventDefault();
            const btn = this.querySelector('button[type="submit"]');
            const originalText = btn.textContent;
            
            btn.disabled = true;
            btn.innerHTML = '<span class="flex items-center justify-center gap-2"><svg class="animate-spin h-5 w-5 text-on-primary-container" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Updating...</span>';
            
            // Simulating API call
            setTimeout(() => {
                const card = btn.closest('.fade-in');
                card.style.opacity = '0';
                card.style.transform = 'translateY(-10px)';
                card.style.transition = 'all 0.5s ease';
                
                setTimeout(() => {
                    card.innerHTML = `
                        <div class="text-center py-8">
                            <div class="w-16 h-16 rounded-full bg-green-100 flex items-center justify-center mx-auto mb-6">
                                <span class="material-symbols-outlined text-green-600 text-3xl">check</span>
                            </div>
                            <h2 class="font-headline-xl text-headline-xl text-ink-black mb-3">Password Updated</h2>
                            <p</script>

</body></html>