<!DOCTYPE html>

<html lang="en" style="">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <style>
        @layer base {

            html,
            body {
                margin: 0;
                padding: 0;
            }

            body {
                overscroll-behavior: none;
            }

            main>:first-child {
                margin-top: 0 !important;
            }

            main>:last-child {
                margin-bottom: 0 !important;
            }
        }

        ::-webkit-scrollbar {
            display: none;
        }
    </style>
    <script src="https://cdn.tailwindcss.com"></script>
    <script
        id="tailwind-config">tailwind.config = { theme: { extend: { "colors": { "surface-dim": "#dbdad9", "error-container": "#ffdad6", "surface-container-low": "#f5f3f3", "secondary-container": "#e3e2e2", "inverse-surface": "#303031", "on-primary-fixed-variant": "#464747", "on-error": "#ffffff", "tertiary-fixed-dim": "#c6c6c6", "outline-variant": "#c4c7c7", "primary-fixed": "#e3e2e2", "surface-bright": "#fbf9f9", "secondary-fixed-dim": "#c7c6c6", "tertiary-container": "#747474", "surface-container-high": "#e9e8e7", "on-tertiary-container": "#fcfcfc", "error": "#ba1a1a", "on-secondary-fixed-variant": "#464747", "on-surface": "#1b1c1c", "on-primary-container": "#fefcfc", "on-primary": "#ffffff", "inverse-primary": "#c7c6c6", "surface-container-lowest": "#ffffff", "secondary-fixed": "#e3e2e2", "surface-variant": "#e3e2e2", "on-primary-fixed": "#1b1c1c", "on-surface-variant": "#444748", "tertiary-fixed": "#e2e2e2", "primary-container": "#747474", "primary-fixed-dim": "#c7c6c6", "on-secondary-fixed": "#1b1c1c", "surface": "#fbf9f9", "on-tertiary-fixed-variant": "#474747", "surface-tint": "#5e5e5e", "inverse-on-surface": "#f2f0f0", "on-tertiary-fixed": "#1b1b1b", "surface-container": "#efeded", "surface-container-highest": "#e3e2e2", "secondary": "#5e5e5e", "on-secondary": "#ffffff", "tertiary": "#5c5c5c", "primary": "#5c5c5c", "on-background": "#1b1c1c", "on-tertiary": "#ffffff", "on-secondary-container": "#646464", "outline": "#747878", "on-error-container": "#93000a", "background": "#fbf9f9" }, "borderRadius": { "DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px" }, "spacing": { "stack-md": "16px", "container-padding": "32px", "stack-sm": "8px", "section-gap-mobile": "64px", "max-width": "1280px", "section-gap": "120px", "grid-gutter": "24px", "stack-lg": "24px" }, "fontFamily": { "label-md": ["Inter"], "headline-lg": ["Plus Jakarta Sans"], "body-xl": ["Inter"], "headline-xl": ["Plus Jakarta Sans"], "display-lg-mobile": ["Plus Jakarta Sans"], "body-md": ["Inter"], "body-lg": ["Inter"], "display-lg": ["Plus Jakarta Sans"] }, "fontSize": { "label-md": ["14px", { "lineHeight": "1.2", "letterSpacing": "0.02em", "fontWeight": "600" }], "headline-lg": ["32px", { "lineHeight": "1.25", "fontWeight": "600" }], "body-xl": ["20px", { "lineHeight": "1.5", "fontWeight": "400" }], "headline-xl": ["40px", { "lineHeight": "1.2", "letterSpacing": "-0.01em", "fontWeight": "600" }], "display-lg-mobile": ["40px", { "lineHeight": "1.1", "letterSpacing": "-0.01em", "fontWeight": "700" }], "body-md": ["15px", { "lineHeight": "1.5", "fontWeight": "400" }], "body-lg": ["17px", { "lineHeight": "1.5", "fontWeight": "400" }], "display-lg": ["56px", { "lineHeight": "1.1", "letterSpacing": "-0.02em", "fontWeight": "700" }] } } } }</script>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&amp;family=Plus+Jakarta+Sans:wght@100..900&amp;display=swap"
        rel="stylesheet" />
</head>

<body class="bg-background font-body-md text-on-surface">
    <div class="w-full">
        <main class="relative min-h-screen bg-background p-container-padding flex items-center justify-center">
            <div class="flex flex-col w-full">
                <div
                    class="relative w-full max-w-5xl mx-auto flex flex-col md:flex-row items-stretch gap-grid-gutter rounded-xl bg-surface shadow-xl overflow-hidden p-container-padding group">
                    <!-- Ambient Background Glow -->
                    <div
                        class="absolute -top-32 -right-32 w-96 h-96 bg-gradient-to-br from-transparent via-brand-gold/10 to-transparent rounded-full blur-3xl opacity-50 pointer-events-none transition-opacity duration-1000 group-hover:opacity-80">
                    </div>
                    <div
                        class="absolute -bottom-32 -left-32 w-96 h-96 bg-gradient-to-tr from-transparent via-primary-fixed/30 to-transparent rounded-full blur-3xl opacity-50 pointer-events-none">
                    </div>
                    <!-- Left Accent Column -->
                    <div class="relative hidden md:flex w-16 flex-col items-center justify-center">
                        <div
                            class="[writing-mode:vertical-rl] rotate-180 font-label-sm text-label-sm text-on-surface-variant tracking-[0.2em] uppercase opacity-70">
                            Technical Maintenance
                        </div>
                        <div
                            class="absolute bottom-0 w-px h-32 bg-gradient-to-t from-transparent via-on-surface-variant/20 to-transparent">
                        </div>
                        <div
                            class="absolute top-0 w-px h-32 bg-gradient-to-b from-transparent via-on-surface-variant/20 to-transparent">
                        </div>
                    </div>
                    <!-- Main Content Area -->
                    <div class="flex-1 flex flex-col justify-center py-stack-lg relative z-10">
                        <!-- Animated Server Icon / Status Indicator -->
                        <div class="mb-stack-lg flex items-center gap-stack-sm">
                            <div
                                class="relative w-8 h-8 flex items-center justify-center rounded-full bg-error-container text-on-error-container shadow-sm">
                                <span class="material-symbols-outlined text-[16px] animate-pulse">cloud_off</span>
                                <div class="absolute inset-0 rounded-full bg-error-container animate-ping opacity-20">
                                </div>
                            </div>
                            <span
                                class="font-label-md text-label-md text-on-surface-variant uppercase tracking-widest">System
                                Status</span>
                        </div>
                        <!-- Massive 500 Graphic (Using SVG to ensure elegant serif scale without breaking token rules) -->
                        <div class="mb-stack-md w-full max-w-sm">
                            <svg class="w-full fill-on-surface drop-shadow-md" viewbox="0 0 300 120">
                                <text font-family="Georgia, serif" font-size="120" font-style="italic" font-weight="300"
                                    letter-spacing="-0.05em" x="-4" y="100">500</text>
                            </svg>
                        </div>
                        <div class="max-w-md">
                            <h1 class="font-display-lg text-display-lg text-on-surface mb-stack-sm tracking-tight">
                                Something went wrong on our end</h1>
                            <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-stack-lg">
                                We're experiencing a technical issue and are working to fix it as quickly as possible.
                                Please try refreshing the page or come back a little later.</p>
                            <div class="flex flex-col sm:flex-row items-center gap-stack-md">
                                <!-- Primary Action -->
                                <button
                                    class="w-full sm:w-auto bg-primary text-on-primary font-label-md text-label-md px-6 py-3 rounded-full shadow-md hover:-translate-y-1 hover:shadow-lg transition-all duration-300 flex items-center justify-center gap-2 group/btn"
                                    onclick="window.location.reload()">
                                    <span
                                        class="material-symbols-outlined text-[18px] group-hover/btn:rotate-180 transition-transform duration-500">refresh</span>
                                    Refresh Page
                                </button>
                                <!-- Secondary Action (Using surface-container instead of border to comply with rules) -->
                                <button
                                    class="w-full sm:w-auto bg-surface-container text-on-surface font-label-md text-label-md px-6 py-3 rounded-full hover:bg-surface-container-high hover:-translate-y-0.5 transition-all duration-300 flex items-center justify-center gap-2">
                                    <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                                    Return to Home
                                </button>
                            </div>
                        </div>
                    </div>
                    <!-- Decorative Right Column / Visual Element -->
                    <div
                        class="hidden lg:flex flex-1 relative min-h-[400px] rounded-xl overflow-hidden bg-surface-container-low shadow-inner items-center justify-center">
                        <!-- Minimalist Abstract Architecture/Geometry Graphic -->
                        <svg class="w-full h-full opacity-40 text-brand-gold" fill="none" viewbox="0 0 400 400"
                            xmlns="http://www.w3.org/2000/svg">
                            <g class="animate-[spin_60s_linear_infinite]">
                                <circle cx="200" cy="200" r="180" stroke="currentColor" stroke-dasharray="4 8"
                                    stroke-width="1"></circle>
                                <circle cx="200" cy="200" r="140" stroke="currentColor" stroke-width="0.5"></circle>
                                <circle cx="200" cy="200" r="100" stroke="currentColor" stroke-dasharray="2 4"
                                    stroke-width="1"></circle>
                                <path d="M200 20 L200 380 M20 200 L380 200" stroke="currentColor" stroke-width="0.5">
                                </path>
                            </g>
                            <circle class="opacity-10" cx="200" cy="200" fill="currentColor" r="60"></circle>
                            <circle class="opacity-20 animate-pulse" cx="200" cy="200" fill="currentColor" r="40">
                            </circle>
                        </svg>
                        <!-- Contextual Image Overlaid via Mix Blend -->
                        <div class="absolute inset-0 bg-cover bg-center mix-blend-overlay opacity-30"
                            data-alt="A highly detailed, minimalist abstract architectural interior. Polished white marble surfaces, soft dramatic natural lighting casting long elegant shadows. Brand gold accents subtle in the geometric reflections. Premium corporate aesthetic."
                            style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuBfjJ7hQ9ihSVs_qgs3paTBs3sJauBLdplP8ko9lLIhOYu6rl3n-EqPusex5AH6I8xaOTSs8TztwG5SJ8eoH8vTO-4K97OML-FKXHR6Wb33J9xtq4t2r9x_wAmVpPWJAVyVz49wLVvH8h6TcU7xqltNGy5QJv6kQDYCTw1zcbbTNbTjE-TKLs5LqJh-5e3TncdIXIAzqHEVwYPQnPdvt-vZGSlT6vZnGb3LFHotlgS0M6Kv4SxLXUhB')">
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</body>

</html>