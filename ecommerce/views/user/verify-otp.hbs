{{>user/header}}
<!-- Main Content Canvas -->
<main class="flex-grow flex items-center justify-center px-4 sm:px-6 py-8 sm:py-16 safe-bottom-padding">
    <!-- Verification Card -->
    <div
        class="w-full max-w-[480px] bg-surface-container-lowest rounded-2xl p-5 sm:p-8 md:p-12 border border-outline-variant/30 ambient-shadow relative overflow-hidden">
        <!-- Subtle Background Motif -->
        <div class="absolute -top-24 -right-24 w-48 h-48 bg-primary-fixed/20 rounded-full blur-3xl"></div>
        <!-- Content -->
        <div class="relative z-10 text-center">
            <div
                class="mb-4 sm:mb-6 inline-flex items-center justify-center w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-surface-container-high text-primary">
                <span class="material-symbols-outlined text-3xl sm:text-4xl"
                    data-icon="mark_email_unread">mark_email_unread</span>
            </div>
            <h2 class="font-headline-xl text-xl sm:text-2xl md:text-headline-xl text-on-surface mb-2 font-bold">Verify
                your email</h2>
            <p class="font-body-md text-xs sm:text-sm text-on-surface-variant mb-6 sm:mb-10 leading-relaxed">We've sent
                a 6-digit verification code to your
                inbox. Please enter it below to continue your luxury wellness journey.</p>
            <!-- OTP Input Area -->
            {{> user/notification}}

            <form class="space-y-6 sm:space-y-8" id="otp-form" action="/verify-otp" method="post">
                <input type="hidden" name="otp" id="otp-value">
                <div class="flex justify-between items-center gap-1.5 sm:gap-2.5 md:gap-3 w-full">
                    <input
                        class="otp-input flex-1 min-w-0 max-w-[48px] h-12 sm:h-14 md:h-16 text-center text-lg sm:text-2xl font-bold bg-surface-gray border border-outline-variant/30 rounded-lg sm:rounded-xl transition-all focus:bg-surface-container-lowest focus:border-primary focus:ring-2 focus:ring-primary/20"
                        maxlength="1" pattern="\d*" required="" type="text" inputmode="numeric"
                        autocomplete="one-time-code">
                    <input
                        class="otp-input flex-1 min-w-0 max-w-[48px] h-12 sm:h-14 md:h-16 text-center text-lg sm:text-2xl font-bold bg-surface-gray border border-outline-variant/30 rounded-lg sm:rounded-xl transition-all focus:bg-surface-container-lowest focus:border-primary focus:ring-2 focus:ring-primary/20"
                        maxlength="1" pattern="\d*" required="" type="text" inputmode="numeric">
                    <input
                        class="otp-input flex-1 min-w-0 max-w-[48px] h-12 sm:h-14 md:h-16 text-center text-lg sm:text-2xl font-bold bg-surface-gray border border-outline-variant/30 rounded-lg sm:rounded-xl transition-all focus:bg-surface-container-lowest focus:border-primary focus:ring-2 focus:ring-primary/20"
                        maxlength="1" pattern="\d*" required="" type="text" inputmode="numeric">
                    <input
                        class="otp-input flex-1 min-w-0 max-w-[48px] h-12 sm:h-14 md:h-16 text-center text-lg sm:text-2xl font-bold bg-surface-gray border border-outline-variant/30 rounded-lg sm:rounded-xl transition-all focus:bg-surface-container-lowest focus:border-primary focus:ring-2 focus:ring-primary/20"
                        maxlength="1" pattern="\d*" required="" type="text" inputmode="numeric">
                    <input
                        class="otp-input flex-1 min-w-0 max-w-[48px] h-12 sm:h-14 md:h-16 text-center text-lg sm:text-2xl font-bold bg-surface-gray border border-outline-variant/30 rounded-lg sm:rounded-xl transition-all focus:bg-surface-container-lowest focus:border-primary focus:ring-2 focus:ring-primary/20"
                        maxlength="1" pattern="\d*" required="" type="text" inputmode="numeric">
                    <input
                        class="otp-input flex-1 min-w-0 max-w-[48px] h-12 sm:h-14 md:h-16 text-center text-lg sm:text-2xl font-bold bg-surface-gray border border-outline-variant/30 rounded-lg sm:rounded-xl transition-all focus:bg-surface-container-lowest focus:border-primary focus:ring-2 focus:ring-primary/20"
                        maxlength="1" pattern="\d*" required="" type="text" inputmode="numeric">
                </div>
                <button
                    class="w-full py-3.5 sm:py-4 font-label-md text-xs sm:text-label-md rounded-full hover:opacity-90 active:scale-[0.98] transition-all uppercase tracking-widest shadow-lg shadow-primary-container/20 bg-ink-black text-on-primary touch-target"
                    type="submit">
                    Verify Identity
                </button>
            </form>
            <script>
                const otpForm = document.getElementById('otp-form');
                const otpInputs = Array.from(
                    otpForm.querySelectorAll('.otp-input')
                );
                const otpValueInput = document.getElementById('otp-value');


                // ==============================
                // UPDATE HIDDEN OTP VALUE
                // ==============================

                function updateOtpValue() {
                    otpValueInput.value = otpInputs
                        .map(input => input.value)
                        .join('');
                }


                // ==============================
                // OTP INPUT
                // ==============================

                otpInputs.forEach((input, index) => {

                    input.addEventListener('input', (event) => {

                        // Allow numbers only
                        input.value = input.value.replace(/\D/g, '');

                        // Only one digit when typing
                        if (input.value.length > 1) {
                            input.value = input.value.charAt(0);
                        }

                        // Move to next input
                        if (
                            input.value &&
                            index < otpInputs.length - 1
                        ) {
                            otpInputs[index + 1].focus();
                        }

                        updateOtpValue();
                    });


                    // ==============================
                    // BACKSPACE
                    // ==============================

                    input.addEventListener('keydown', (event) => {

                        if (
                            event.key === 'Backspace' &&
                            !input.value &&
                            index > 0
                        ) {
                            otpInputs[index - 1].focus();
                        }

                    });


                    // ==============================
                    // PASTE OTP
                    // ==============================

                    input.addEventListener('paste', (event) => {

                        event.preventDefault();

                        // Get copied text
                        const pastedData = event.clipboardData
                            .getData('text')
                            .replace(/\D/g, '')
                            .slice(0, otpInputs.length);

                        if (!pastedData) {
                            return;
                        }

                        // Clear all boxes first
                        otpInputs.forEach(input => {
                            input.value = '';
                        });

                        // Put each digit into each box
                        pastedData.split('').forEach((digit, i) => {
                            otpInputs[i].value = digit;
                        });

                        // Update hidden input
                        updateOtpValue();

                        // Focus last filled box
                        otpInputs[pastedData.length - 1].focus();
                    });

                });


                // ==============================
                // FORM SUBMIT
                // ==============================

                otpForm.addEventListener('submit', () => {
                    updateOtpValue();
                });

            </script>
            <!-- Resend & Timer Logic -->
            {{!-- <div class="mt-8 pt-8 border-t border-outline-variant/20">
                <p class="font-body-md text-on-surface-variant" id="timer-container">
                    Didn't receive the code?
                    <span class="text-primary font-semibold cursor-not-allowed opacity-50 transition-colors"
                        id="resend-link">Resend Code</span>
                    <span class="text-primary font-mono ml-2" id="timer">01:50</span>
                </p>
            </div> --}}
            <div class="mt-8 pt-8 border-t border-outline-variant/20">
                <p class="font-body-md text-on-surface-variant" id="timer-container">
                    Didn't receive the code?

                    <button type="button" id="resend-link"
                        class="text-primary font-semibold cursor-not-allowed opacity-50 transition-colors" disabled>
                        Resend Code
                    </button>

                    <span class="text-primary font-mono ml-2" id="timer">
                        01:00
                    </span>
                </p>
            </div>
        </div>
    </div>
</main>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const resendLink = document.getElementById("resend-link");
        const timer = document.getElementById("timer");

        const STORAGE_KEY = "otp_expiry";
        const DURATION = 60; // 60 seconds

        const serverExpiryRaw = {{#if otpExpiresAt}}{{otpExpiresAt}}{{else}}null{{/if}};
        const serverExpiry = (serverExpiryRaw && !isNaN(Number(serverExpiryRaw))) ? Number(serverExpiryRaw) : null;

        let countdown = null;

        function getExpiryTime(forceReset, customExpiry) {
            // 1. If explicit custom expiry passed (e.g. from /resend-otp JSON response)
            if (customExpiry && !isNaN(Number(customExpiry))) {
                const num = Number(customExpiry);
                sessionStorage.setItem(STORAGE_KEY, String(num));
                return num;
            }

            // 2. If forceReset explicitly requested
            if (forceReset) {
                const fresh = Date.now() + (DURATION * 1000);
                sessionStorage.setItem(STORAGE_KEY, String(fresh));
                return fresh;
            }

            // 3. If server provided a future expiration timestamp in the JWT session
            if (serverExpiry && serverExpiry > Date.now()) {
                sessionStorage.setItem(STORAGE_KEY, String(serverExpiry));
                return serverExpiry;
            }

            // 4. Check sessionStorage for a still-valid timestamp
            const stored = sessionStorage.getItem(STORAGE_KEY);
            if (stored && !isNaN(Number(stored))) {
                const storedNum = Number(stored);
                if (storedNum > Date.now()) {
                    return storedNum;
                }
            }

            // 5. Default fallback: fresh duration from now
            const fresh = Date.now() + (DURATION * 1000);
            sessionStorage.setItem(STORAGE_KEY, String(fresh));
            return fresh;
        }

        function enableResend() {
            if (countdown) {
                clearInterval(countdown);
                countdown = null;
            }
            if (timer) {
                timer.textContent = "";
            }
            if (resendLink) {
                resendLink.disabled = false;
                resendLink.classList.remove("cursor-not-allowed", "opacity-50");
                resendLink.classList.add("cursor-pointer");
            }
            sessionStorage.removeItem(STORAGE_KEY);
        }

        function disableResend() {
            if (resendLink) {
                resendLink.disabled = true;
                resendLink.classList.add("cursor-not-allowed", "opacity-50");
                resendLink.classList.remove("cursor-pointer");
            }
        }

        function updateDisplay(seconds) {
            if (!timer) return;
            const minutes = Math.floor(seconds / 60);
            const secs = seconds % 60;
            timer.textContent = `${String(minutes).padStart(2, "0")}:${String(secs).padStart(2, "0")}`;
        }

        function startTimer(forceReset = false, customExpiry = null) {
            if (countdown) {
                clearInterval(countdown);
                countdown = null;
            }

            if (!timer || !resendLink) return;

            const expiry = getExpiryTime(forceReset, customExpiry);

            function tick() {
                const remaining = Math.ceil((expiry - Date.now()) / 1000);

                if (remaining <= 0) {
                    enableResend();
                    return;
                }

                disableResend();
                updateDisplay(remaining);
            }

            tick();
            countdown = setInterval(tick, 1000);
        }

        // Initialize countdown timer immediately on page load
        startTimer();

        // ==============================
        // RESEND OTP ACTION
        // ==============================
        if (resendLink) {
            resendLink.addEventListener("click", async function () {
                if (resendLink.disabled) return;
                disableResend();

                try {
                    const response = await fetch("/resend-otp", {
                        method: "POST"
                    });

                    const contentType = response.headers.get("content-type") || "";
                    if (!contentType.includes("application/json")) {
                        throw new Error("Server returned an unexpected response.");
                    }

                    const data = await response.json();

                    if (!response.ok || !data.success) {
                        throw new Error(data.message || "Failed to resend OTP");
                    }

                    // Clear inputs and reset focus
                    const inputs = document.querySelectorAll(".otp-input");
                    inputs.forEach(input => { input.value = ""; });
                    const hiddenOtp = document.getElementById("otp-value");
                    if (hiddenOtp) hiddenOtp.value = "";
                    if (inputs.length > 0) inputs[0].focus();

                    // Start timer with returned expiration or fresh 60s
                    startTimer(true, data.otpExpiresAt || null);

                    if (typeof showNotification === "function") {
                        showNotification("success", data.message || "OTP resent successfully");
                    }
                } catch (error) {
                    console.error("Resend OTP error:", error);
                    if (typeof showNotification === "function") {
                        showNotification("error", error.message);
                    } else {
                        alert(error.message);
                    }
                    enableResend();
                }
            });
        }
    });

    window.addEventListener("pageshow", function (event) {
        if (event.persisted) {
            window.location.reload();
        }
    });
</script>

{{>user/footer}}