<body class="bg-background text-on-background min-h-screen flex flex-col font-body-md overflow-x-hidden">
  <!-- Top Navigation -->
  <nav
    class="fixed top-0 w-full z-50 bg-surface/95 dark:bg-surface/90 backdrop-blur-md border-b border-secondary/10 dark:border-secondary-fixed-dim/10 shadow-sm transition-all duration-300 shadow-md"
    id="main-nav">
    <div class="flex justify-between items-center w-full px-container-padding max-w-max-width mx-auto h-20">
      <a class="font-headline-lg text-headline-lg font-bold text-on-surface tracking-tight z-10 flex-shrink-0" href="#">
        Nutri Burfi
      </a>
      <div class="hidden md:flex items-center gap-8 absolute left-1/2 -translate-x-1/2">
        <a class="text-on-surface font-label-md text-label-md border-b-2 border-on-surface pb-1" href="/">Home</a>
        <a class="text-on-surface-variant font-label-md text-label-md hover:text-on-surface transition-colors"
          href="#">Products</a>
        <a class="text-on-surface-variant font-label-md text-label-md hover:text-on-surface transition-colors"
          href="#">About Us</a>
        <a class="text-on-surface-variant font-label-md text-label-md hover:text-on-surface transition-colors"
          href="#">Contact</a>
      </div>
      <div class="flex items-center gap-4 text-on-surface z-10 flex-shrink-0">
        <button
          class="hover:opacity-80 transition-opacity active:scale-95 duration-150 ease-in-out p-2 rounded-full hover:bg-surface-variant/50">
          <span class="material-symbols-outlined" data-icon="search">search</span>
        </button>
        <button
          class="hover:opacity-80 transition-opacity active:scale-95 duration-150 ease-in-out p-2 rounded-full hover:bg-surface-variant/50">
          <span class="material-symbols-outlined" data-icon="favorite">favorite</span>
        </button>
        <button
          class="hover:opacity-80 transition-opacity active:scale-95 duration-150 ease-in-out p-2 rounded-full hover:bg-surface-variant/50 relative">
          <span class="material-symbols-outlined" data-icon="shopping_cart">shopping_cart</span>
          <span class="absolute top-1 right-1 w-2 h-2 bg-accent-blue rounded-full"></span>
        </button>
        <button
          class="hover:opacity-80 transition-opacity active:scale-95 duration-150 ease-in-out p-2 rounded-full hover:bg-surface-variant/50 hidden md:block">
          <span class="material-symbols-outlined" data-icon="person">person</span>
        </button>
        <button
          class="md:hidden hover:opacity-80 transition-opacity active:scale-95 duration-150 ease-in-out p-2 rounded-full hover:bg-surface-variant/50 ml-2"
          id="mobile-menu-btn">
          <span class="material-symbols-outlined" data-icon="menu">menu</span>
        </button>
      </div>
    </div>
  </nav>

  <main class="flex-grow flex items-center justify-center px-container-padding py-section-gap pt-32">
    <!-- Verification Card -->
    <div
      class="w-full max-w-[480px] bg-surface-container-lowest rounded-xl p-8 md:p-12 border border-outline-variant/30 apple-shadow relative overflow-hidden">
      <!-- Subtle Background Motif -->
      <div class="absolute -top-24 -right-24 w-48 h-48 bg-primary-fixed/20 rounded-full blur-3xl"></div>
      <!-- Content -->
      <div class="relative z-10 text-center">
        <div
          class="mb-stack-lg inline-flex items-center justify-center w-16 h-16 rounded-full bg-surface-container-high text-primary">
          <span class="material-symbols-outlined text-4xl" data-icon="mark_email_unread">mark_email_unread</span>
        </div>
        <h2 class="font-headline-xl text-headline-xl text-on-surface mb-2">Verify email update</h2>
        <p class="font-body-md text-on-surface-variant mb-10">We've sent a 6-digit verification code to your new email.
          Please enter it below to confirm the change.</p>

        {{#if error}}
        <div class="mb-6 p-4 bg-error-container text-on-error-container rounded-xl text-sm border border-error/10">
          {{error}}
        </div>
        {{/if}}

        <!-- OTP Input Area -->
        <form class="space-y-8" id="otp-form" action="/profile/verify-email-otp" method="POST">
          <input type="hidden" name="otp" id="otp-value">
          <div class="flex justify-between gap-2 md:gap-4">
            <input
              class="otp-input w-12 h-16 md:w-14 md:h-20 text-center text-2xl font-semibold bg-surface-gray border border-outline-variant/30 rounded-lg transition-all focus:bg-surface-container-lowest"
              maxlength="1" pattern="\d*" required type="text" inputmode="numeric" autocomplete="one-time-code">
            <input
              class="otp-input w-12 h-16 md:w-14 md:h-20 text-center text-2xl font-semibold bg-surface-gray border border-outline-variant/30 rounded-lg transition-all focus:bg-surface-container-lowest"
              maxlength="1" pattern="\d*" required type="text" inputmode="numeric">
            <input
              class="otp-input w-12 h-16 md:w-14 md:h-20 text-center text-2xl font-semibold bg-surface-gray border border-outline-variant/30 rounded-lg transition-all focus:bg-surface-container-lowest"
              maxlength="1" pattern="\d*" required type="text" inputmode="numeric">
            <input
              class="otp-input w-12 h-16 md:w-14 md:h-20 text-center text-2xl font-semibold bg-surface-gray border border-outline-variant/30 rounded-lg transition-all focus:bg-surface-container-lowest"
              maxlength="1" pattern="\d*" required type="text" inputmode="numeric">
            <input
              class="otp-input w-12 h-16 md:w-14 md:h-20 text-center text-2xl font-semibold bg-surface-gray border border-outline-variant/30 rounded-lg transition-all focus:bg-surface-container-lowest"
              maxlength="1" pattern="\d*" required type="text" inputmode="numeric">
            <input
              class="otp-input w-12 h-16 md:w-14 md:h-20 text-center text-2xl font-semibold bg-surface-gray border border-outline-variant/30 rounded-lg transition-all focus:bg-surface-container-lowest"
              maxlength="1" pattern="\d*" required type="text" inputmode="numeric">
          </div>
          <button
            class="w-full py-4 font-label-md text-label-md rounded-full hover:opacity-90 active:scale-[0.98] transition-all uppercase tracking-widest shadow-lg shadow-primary-container/20 bg-ink-black text-on-primary"
            type="submit">
            Verify Email
          </button>
        </form>

        <!-- Resend & Timer Logic -->
        <div class="mt-8 pt-8 border-t border-outline-variant/20">
          <p class="font-body-md text-on-surface-variant" id="timer-container">
            Didn't receive the code?
            <button type="button" id="resend-link"
              class="text-primary font-semibold cursor-not-allowed opacity-50 transition-colors" disabled>
              Resend Code
            </button>
            <span class="text-primary font-mono ml-2" id="timer">01:50</span>
          </p>
        </div>
      </div>
    </div>
  </main>

  {{> user/footer}}

  <script>
    // OTP Focus Logic
    const inputs = document.querySelectorAll(".otp-input");
    const otpValueInput = document.getElementById("otp-value");
    const otpForm = document.getElementById("otp-form");

    inputs.forEach((input, index) => {
      input.addEventListener("input", (e) => {
        const value = e.target.value.replace(/\D/g, '').slice(0, 1);
        e.target.value = value;
        if (value && index < inputs.length - 1) {
          inputs[index + 1].focus();
        }
        otpValueInput.value = Array.from(inputs).map(item => item.value).join('');
      });

      input.addEventListener("keydown", (e) => {
        if (e.key === "Backspace" && !e.target.value && index > 0) {
          inputs[index - 1].focus();
        }
      });
    });

    otpForm.addEventListener("submit", () => {
      otpValueInput.value = Array.from(inputs).map(item => item.value).join('');
    });

    // Resend OTP & Timer Logic
    const resendLink = document.getElementById("resend-link");
    const timer = document.getElementById("timer");
    let timeLeft = 110;
    let countdown;

    function startTimer() {
      clearInterval(countdown);
      resendLink.disabled = true;
      resendLink.classList.add("cursor-not-allowed", "opacity-50");
      resendLink.classList.remove("cursor-pointer");
      timeLeft = 110;
      updateTimer();

      countdown = setInterval(() => {
        timeLeft--;
        updateTimer();
        if (timeLeft <= 0) {
          clearInterval(countdown);
          timer.textContent = "";
          resendLink.disabled = false;
          resendLink.classList.remove("cursor-not-allowed", "opacity-50");
          resendLink.classList.add("cursor-pointer");
        }
      }, 1000);
    }

    function updateTimer() {
      const minutes = Math.floor(timeLeft / 60);
      const seconds = timeLeft % 60;
      timer.textContent = `${String(minutes).padStart(2, "0")}:${String(seconds).padStart(2, "0")}`;
    }

    startTimer();

    resendLink.addEventListener("click", async () => {
      try {
        if (resendLink.disabled) return;
        resendLink.disabled = true;

        const response = await fetch("/profile/resend-email-otp", {
          method: "POST"
        });

        if (!response.ok) {
          throw new Error("Failed to resend OTP");
        }

        startTimer();
        inputs.forEach(input => input.value = "");
        inputs[0].focus();
      } catch (error) {
        console.error("Resend OTP error:", error);
        resendLink.disabled = false;
        resendLink.classList.remove("cursor-not-allowed", "opacity-50");
        resendLink.classList.add("cursor-pointer");
      }
    });
  </script>
</body>

</html>
