  <style>
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
      display: inline-block;
      line-height: 1;
    }

    .otp-input:focus {
      outline: none;
      border-color: #C89B3C;
      box-shadow: 0 0 0 1px #C89B3C;
    }

    /* Ambient Shadow from Design System */
    .apple-shadow {
      box-shadow: 0 40px 40px -20px rgba(45, 27, 14, 0.04);
    }
  </style>
