<div><h2 class="text-headline-lg font-headline-lg text-on-surface">Add wallet credits</h2><p class="text-sm text-on-surface-variant mt-1">Choose an amount to add securely.</p></div>
<button type="button" id="close-topup-dialog" class="p-2 text-on-surface-variant hover:text-on-surface" aria-label="Close"><span class="material-symbols-outlined">close</span></button>
</div>
<label for="topup-amount" class="block text-sm font-semibold text-on-surface mb-2">Amount (INR)</label>
<div class="flex items-center border border-outline-variant rounded-lg bg-surface-container-low px-4"><span class="text-on-surface-variant">₹</span><input id="topup-amount" name="amount" type="number" min="1" max="50000" step="0.01" required class="w-full bg-transparent border-0 py-3 px-2 text-on-surface focus:ring-0" placeholder="Enter amount"></div>
<p id="topup-message" class="min-h-6 mt-3 text-sm text-error" role="status" aria-live="polite"></p>
<div class="flex justify-end gap-3 mt-4"><button type="button" id="cancel-topup" class="px-4 py-2 rounded-lg border border-outline-variant text-on-surface">Cancel</button><button id="submit-topup" type="submit" class="px-5 py-2 rounded-lg bg-primary text-on-primary font-semibold disabled:opacity-50">Continue to payment</button></div>
</form>
</dialog>
<!-- Micro-interaction Scripts -->
<script>
        document.addEventListener('DOMContentLoaded', () => {
            const tableRows = document.querySelectorAll('tbody tr');
            tableRows.forEach(row => {
                row.addEventListener('mouseenter', () => {
                    row.style.transform = 'translateX(4px)';
                });
                row.addEventListener('mouseleave', () => {
                    row.style.transform = 'translateX(0)';
                });
            });

            // Smooth reveal effect
            const observerOptions = {
                threshold: 0.1
            };
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('opacity-100', 'translate-y-0');
                        entry.target.classList.remove('opacity-0', 'translate-y-10');
                    }
                });
            }, observerOptions);

            document.querySelectorAll('.glass-card').forEach(card => {
                card.classList.add('transition-all', 'duration-700', 'opacity-0', 'translate-y-10');
                observer.observe(card);
            });
        });
    </script>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
    const topupDialog = document.getElementById("topup-dialog");
    const topupForm = document.getElementById("wallet-topup-form");
    const topupMessage = document.getElementById("topup-message");
    const topupSubmit = document.getElementById("submit-topup");

    document.getElementById("open-topup-dialog").addEventListener("click", () => {
        topupMessage.textContent = "";
        topupDialog.showModal();
        document.getElementById("topup-amount").focus();
    });
    document.getElementById("close-topup-dialog").addEventListener("click", () => topupDialog.close());
    document.getElementById("cancel-topup").addEventListener("click", () => topupDialog.close());

    topupForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        topupMessage.textContent = "";
        topupSubmit.disabled = true;

        try {
            if (!window.Razorpay) throw new Error("Payment checkout did not load. Please try again.");

            const orderResponse = await fetch("/wallet/top-up/create-order", {
                method: "POST",
                headers: { "Content-Type": "application/json", "Accept": "application/json" },
                body: JSON.stringify({ amount: document.getElementById("topup-amount").value })
            });
            const orderResult = await orderResponse.json();
            if (!orderResponse.ok) throw new Error(orderResult.message || "Unable to start payment.");

            const checkout = new Razorpay({
                key: orderResult.key,
                amount: orderResult.order.amount,
                currency: orderResult.order.currency,
                name: "Nutri Burfi",
                description: "Wallet credits",
                order_id: orderResult.order.id,
                config: {
                    display: {
                        blocks: {
                            upi: {
                                name: "Pay using UPI",
                                instruments: [{ method: "upi" }]
                            }
                        },
                        sequence: ["block.upi"],
                        preferences: { show_default_blocks: true }
                    }
                },
                handler: async (payment) => {
                    topupMessage.textContent = "Verifying payment...";
                    try {
                        const verifyResponse = await fetch("/wallet/top-up/verify", {
                            method: "POST",
                            headers: { "Content-Type": "application/json", "Accept": "application/json" },
                            body: JSON.stringify(payment)
                        });
                        const verifyResult = await verifyResponse.json();
                        if (!verifyResponse.ok) throw new Error(verifyResult.message || "Payment verification failed.");
                        window.location.reload();
                    } catch (error) {
                        topupMessage.textContent = error.message;
                        topupSubmit.disabled = false;
                        topupDialog.showModal();
                    }
                },
                modal: {
                    ondismiss: () => { topupSubmit.disabled = false; }
                }
            });
            checkout.on("payment.failed", (event) => {
                topupMessage.textContent = event.error?.description || "Payment failed. Please try again.";
                topupDialog.showModal();
                topupSubmit.disabled = false;
            });
            topupDialog.close();
            checkout.open();
        } catch (error) {
            topupMessage.textContent = error.message;
            topupSubmit.disabled = false;
        }
    });

    // Account navigation tabs scrolling & drag interactions
    const navTabs = document.getElementById('account-nav-tabs');
    if (navTabs) {
        // Auto-center active tab
        const activeTab = navTabs.querySelector('.bg-on-surface');
        if (activeTab) {
            activeTab.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
        }

        // Mouse wheel horizontal scroll support
        navTabs.addEventListener('wheel', (e) => {
            if (e.deltaY !== 0) {
                e.preventDefault();
                navTabs.scrollLeft += e.deltaY;
            }
        }, { passive: false });

        // Click and drag to scroll support
        let isDown = false;
        let startX;
        let scrollLeftStart;

        navTabs.addEventListener('mousedown', (e) => {
            isDown = true;
            startX = e.pageX - navTabs.offsetLeft;
            scrollLeftStart = navTabs.scrollLeft;
        });

        window.addEventListener('mouseup', () => {
            isDown = false;
        });

        navTabs.addEventListener('mousemove', (e) => {
            if (!isDown) return;
            e.preventDefault();
            const x = e.pageX - navTabs.offsetLeft;
            const walk = (x - startX) * 1.5;
            navTabs.scrollLeft = scrollLeftStart - walk;
        });
    }
</script>

