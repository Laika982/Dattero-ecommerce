          <span class="material-symbols-outlined text-[16px]">favorite</span>
          Wishlist
        </a>
        <a href="/profile/address"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-surface-container-high text-on-surface-variant text-xs font-semibold whitespace-nowrap hover:bg-surface-variant transition-colors touch-target flex-shrink-0">
          <span class="material-symbols-outlined text-[16px]">location_on</span>
          Address Book
        </a>
      </div>
    </div>

    <!-- Header Section -->
    <header
      class="max-w-max-width mx-auto flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4 mb-8 sm:mb-16 pt-2 sm:pt-4">
      <div>
        <h2 class="text-2xl md:text-3xl font-bold text-on-surface tracking-tight">My Wallet</h2>
        <p class="text-on-surface-variant font-body-lg text-sm sm:text-base mt-1 sm:mt-2">Manage your premium credits
          and transaction history.</p>
      </div>
      <button id="open-topup-dialog" type="button"
        class="bg-primary text-on-primary px-6 sm:px-8 py-3 sm:py-4 rounded-full font-label-md text-xs sm:text-sm hover:opacity-90 active:scale-95 transition-all flex items-center gap-2 shadow-lg shadow-primary/10 touch-target">
        <span class="material-symbols-outlined text-[18px] sm:text-[20px]">add_card</span>
        Add Credits
      </button>
    </header>
    <!-- Bento Grid Layout -->
    <div class="max-w-max-width mx-auto grid grid-cols-12 gap-4 sm:gap-grid-gutter">
      <!-- Premium Balance Card -->
      <div
        class="col-span-12 lg:col-span-5 relative overflow-hidden rounded-3xl p-6 sm:p-10 flex flex-col justify-between min-h-[280px] sm:min-h-[380px] group shadow-2xl">
        <!-- Background Decoration -->
        <div class="absolute inset-0 bg-[#303031]"></div>

        <div class="relative z-10 flex justify-between items-start">
          <div>
            <p class="text-white/60 font-label-md uppercase tracking-[0.2em] mb-1">Available Balance</p>
            <h3 class="text-white font-display-lg text-display-lg-mobile md:text-display-lg">₹{{wallet.balance}}</h3>
          </div>
          <div class="bg-white/10 backdrop-blur-md p-3 rounded-2xl">
            <span class="material-symbols-outlined text-white text-3xl">token</span>
          </div>
        </div>
        <div class="relative z-10">
          <div class="flex gap-4 mb-8">
            <div class="flex flex-col">
              <span class="text-white/40 text-xs uppercase tracking-widest font-bold">Luxe Tier</span>
              <span class="text-white font-label-md">Gold Member</span>
            </div>
            <div class="w-px h-10 bg-white/20"></div>
            <div class="flex flex-col">
              <span class="text-white/40 text-xs uppercase tracking-widest font-bold">Expires</span>
              <span class="text-white font-label-md">12/25</span>
            </div>
          </div>
          <div class="flex justify-between items-center">
            <p class="text-white/80 font-mono tracking-widest text-lg">**** **** **** 8820</p>
            <img class="h-8 opacity-60"
              data-alt="A sleek minimalist payment provider logo, high-end white monochrome aesthetic, vector style, set against a dark premium background."
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuCI6XMucMGqhHPeRSE1Pz3qvlI6ofPiOqDRN5NQhetcaEVmAGzyM59-UP-6bTnkKjT1haeyOYx_I9gEkObUErnUbzsvnSHfEYuvgYn9yjUpGWPx6LCQzyK1YmXAPPOWcYxVytMapASlmK1nHW7RPCznJjtpU82gBmYPA2NtqlAJwrv2Nz3TKFRHaAOrFf_asOcfYaUFMZ_qBHXSJEzS3SiBFwKH5X8GqW5-LZIJ3UypIBu8U_vyIzmGrWuMpEcP8fFo9YAXyr85okg">
          </div>
        </div>
      </div>
      <!-- Quick Actions / Analytics -->
      <div class="col-span-12 lg:col-span-7 grid gap-grid-gutter grid-cols-1">


        <div
          class="glass-card rounded-3xl p-8 flex items-center justify-between transition-all duration-700 opacity-100 translate-y-0">
          <div class="flex flex-col gap-6 w-full">
            <div class="flex justify-between items-start">
              <div>
                <h4 class="font-label-md text-on-surface uppercase tracking-widest text-xs mb-2">Monthly Spending</h4>
                <div class="flex items-baseline gap-2">
                  <span class="text-headline-lg font-bold text-on-surface">₹{{monthlySpending.total}}</span>
                  <span class="{{monthlySpending.trendColor}} font-bold text-sm flex items-center gap-1">
                    <span
                      class="material-symbols-outlined text-sm">{{monthlySpending.trendIcon}}</span>{{monthlySpending.percentageChange}}
                  </span>
                </div>
                <p class="text-on-surface-variant text-sm mt-1">Invested in wellness this month</p>
              </div>
              <div class="w-12 h-12 bg-surface-container-highest rounded-2xl flex items-center justify-center">
                <span class="material-symbols-outlined text-primary">analytics</span>
              </div>
            </div>
            <div class="flex items-end gap-1.5 h-16 w-full mt-4">
              {{#each monthlySpending.bars}}
              <div
                class="flex-1 rounded-t-sm transition-all duration-300 {{#if this.isCurrent}}bg-primary{{else}}bg-primary/20 hover:bg-primary/40{{/if}}"
                style="height: {{this.height}};" title="{{this.title}}"></div>
              {{/each}}
            </div>
            <div class="flex justify-between text-[10px] text-on-surface-variant uppercase tracking-tighter font-bold">
              <span>Week 1</span>
              <span>Week 2</span>
              <span>Week 3</span>
              <span>Week 4</span>
            </div>
          </div>
        </div>
      </div>
      <!-- Transaction History Section -->
      <div class="col-span-12 mt-8">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
          <h3 class="font-headline-lg text-on-surface">Transaction History</h3>
          <div class="flex w-full sm:w-auto overflow-x-auto gap-stack-sm pb-2 sm:pb-0 scrollbar-hide">
            <a href="/wallet?filter=all"
              class="px-stack-md py-stack-sm rounded-full {{#if isAll}}bg-primary text-on-primary{{else}}bg-surface text-on-surface hover:bg-surface-container-highest{{/if}} transition-colors text-label-md font-label-md whitespace-nowrap shadow-sm">All
              Transactions</a>
            <a href="/wallet?filter=orders"
              class="px-stack-md py-stack-sm rounded-full {{#if isOrders}}bg-primary text-on-primary{{else}}bg-surface text-on-surface hover:bg-surface-container-highest{{/if}} transition-colors text-label-md font-label-md whitespace-nowrap">Orders</a>
            <a href="/wallet?filter=wallet"
              class="px-stack-md py-stack-sm rounded-full {{#if isWallet}}bg-primary text-on-primary{{else}}bg-surface text-on-surface hover:bg-surface-container-highest{{/if}} transition-colors text-label-md font-label-md whitespace-nowrap">Wallet</a>
            <a href="/wallet?filter=refunds"
              class="px-stack-md py-stack-sm rounded-full {{#if isRefunds}}bg-primary text-on-primary{{else}}bg-surface text-on-surface hover:bg-surface-container-highest{{/if}} transition-colors text-label-md font-label-md whitespace-nowrap">Refunds</a>
            <a href="/wallet?filter=referrals"
              class="px-stack-md py-stack-sm rounded-full {{#if isReferrals}}bg-primary text-on-primary{{else}}bg-surface text-on-surface hover:bg-surface-container-highest{{/if}} transition-colors text-label-md font-label-md whitespace-nowrap">Referrals</a>
            <a href="/wallet?filter=failed"
              class="px-stack-md py-stack-sm rounded-full {{#if isFailed}}bg-primary text-on-primary{{else}}bg-surface text-on-surface hover:bg-surface-container-highest{{/if}} transition-colors text-label-md font-label-md whitespace-nowrap">Failed</a>
          </div>
        </div>
        <div
          class="glass-card rounded-[24px] sm:rounded-[32px] overflow-hidden transition-all duration-700 opacity-100 translate-y-0">
          <div class="overflow-x-auto w-full custom-scrollbar">
            <table class="w-full text-left min-w-[600px]">
              <thead>
                <tr
                  class="bg-surface-container-low border-b border-outline-variant/20 text-xs sm:text-label-md font-label-md text-on-surface-variant uppercase tracking-widest">
                  <th class="px-4 sm:px-8 py-3.5 sm:py-5 font-bold">Transaction</th>
                  <th class="px-4 sm:px-8 py-3.5 sm:py-5 font-bold">Date &amp; Time</th>
                  <th class="px-4 sm:px-8 py-3.5 sm:py-5 font-bold">Payment Method</th>
                  <th class="px-4 sm:px-8 py-3.5 sm:py-5 text-right font-bold">Amount</th>
                  <th class="px-4 sm:px-8 py-3.5 sm:py-5 text-center font-bold">Status</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-on-surface/5">
                {{#each transactions}}
                <tr
                  class="hover:bg-surface-container-low/50 transition-colors {{#if this.isFailed}}bg-red-50/20{{/if}}">
                  <td class="px-4 sm:px-8 py-4 sm:py-6">
                    <div class="flex flex-col gap-0.5">
                      <span class="text-sm sm:text-body-md font-semibold text-on-surface flex items-center gap-2">
                        {{this.description}}
                        {{#if this.isFailed}}
                        <span
                          class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-red-100 text-red-700">Failed</span>
                        {{/if}}
                      </span>
                      <span class="text-xs text-on-surface-variant font-mono">#{{this._id}}</span>
                      {{#if this.failureReason}}
                      <span class="text-xs text-red-600 font-medium mt-0.5 flex items-center gap-1">
                        <span class="material-symbols-outlined text-[13px]">info</span>
                        {{this.failureReason}}
                      </span>
                      {{/if}}
                    </div>
                  </td>
                  <td class="px-4 sm:px-8 py-4 sm:py-6 text-xs sm:text-body-md text-on-surface whitespace-nowrap">
                    {{this.displayDate}}</td>
                  <td class="px-4 sm:px-8 py-4 sm:py-6 text-xs sm:text-body-md text-on-surface whitespace-nowrap">
                    {{#if (eq this.reason "WALLET_TOP_UP")}}Razorpay{{else if (eq this.reason
                    "REFERRAL_REWARD")}}Referral Reward{{else}}Wallet Balance{{/if}}
                  </td>
                  <td
                    class="px-4 sm:px-8 py-4 sm:py-6 text-right text-sm sm:text-body-lg font-semibold whitespace-nowrap {{#if this.isFailed}}text-red-600 line-through opacity-80{{else if (eq this.type "
                    CREDIT")}}text-green-700{{else}}text-on-surface{{/if}}">
                    {{this.displayAmount}}
                  </td>
                  <td class="px-4 sm:px-8 py-4 sm:py-6 text-center whitespace-nowrap">
                    {{#if this.isFailed}}
                    <span
                      class="px-2.5 py-0.5 sm:py-1 rounded-full bg-red-100 text-red-700 text-[11px] sm:text-[12px] font-label-md tracking-wider uppercase inline-flex items-center gap-1">
                      <span class="w-1.5 h-1.5 rounded-full bg-red-600"></span>Failed
                    </span>
                    {{else if this.isPending}}
                    <span
                      class="px-2.5 py-0.5 sm:py-1 rounded-full bg-amber-100 text-amber-700 text-[11px] sm:text-[12px] font-label-md tracking-wider uppercase inline-flex items-center gap-1">
                      <span class="w-1.5 h-1.5 rounded-full bg-amber-600 animate-pulse"></span>Pending
                    </span>
                    {{else}}
                    <span
                      class="px-2.5 py-0.5 sm:py-1 rounded-full bg-green-100 text-green-700 text-[11px] sm:text-[12px] font-label-md tracking-wider uppercase">Completed</span>
                    {{/if}}
                  </td>
                </tr>
                {{else}}
                <tr>
                  <td colspan="5" class="px-4 sm:px-8 py-8 sm:py-10 text-center text-on-surface-variant text-sm">No
                    transactions found for this filter.</td>
                </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
          {{#if (gt totalPages 1)}}
          <div
            class="p-4 sm:p-6 border-t border-on-surface/5 flex flex-col sm:flex-row items-center justify-between gap-4">
            <p class="text-xs text-on-surface-variant font-medium order-2 sm:order-1">
              Showing <span class="text-on-surface font-semibold">{{startIndex}}</span> - <span
                class="text-on-surface font-semibold">{{endIndex}}</span> of <span
                class="text-on-surface font-semibold">{{totalTransactions}}</span> transactions
            </p>
            <nav class="flex items-center gap-1.5 order-1 sm:order-2" aria-label="Wallet transactions pagination">
              {{#if (gt currentPage 1)}}
              <a href="/wallet?page={{subtract currentPage 1}}{{#unless isAll}}&filter={{currentFilter}}{{/unless}}"
                class="px-3 py-1.5 rounded-lg border border-outline-variant/40 text-on-surface-variant text-xs font-semibold hover:bg-surface-container-high hover:text-on-surface transition-colors flex items-center gap-1"
                aria-label="Previous page">
                <span class="material-symbols-outlined text-sm">chevron_left</span>
                <span class="hidden sm:inline">Prev</span>
              </a>
              {{else}}
              <button
                class="px-3 py-1.5 rounded-lg border border-outline-variant/20 text-on-surface-variant/40 text-xs font-semibold flex items-center gap-1 opacity-50 cursor-not-allowed"
                disabled aria-label="Previous page">
                <span class="material-symbols-outlined text-sm">chevron_left</span>
                <span class="hidden sm:inline">Prev</span>
              </button>
              {{/if}}

              {{#each (range 1 totalPages)}}
              {{#if (eq this ../currentPage)}}
              <a href="/wallet?page={{this}}{{#unless ../isAll}}&filter={{../currentFilter}}{{/unless}}"
                class="w-8 h-8 rounded-lg bg-primary text-on-primary text-xs font-bold flex items-center justify-center shadow-sm"
                aria-current="page">
                {{this}}
              </a>
              {{else}}
              <a href="/wallet?page={{this}}{{#unless ../isAll}}&filter={{../currentFilter}}{{/unless}}"
                class="w-8 h-8 rounded-lg border border-outline-variant/40 text-on-surface-variant text-xs font-semibold hover:bg-surface-container-high hover:text-on-surface transition-colors flex items-center justify-center">
                {{this}}
              </a>
              {{/if}}
              {{/each}}

              {{#if (lt currentPage totalPages)}}
              <a href="/wallet?page={{add currentPage 1}}{{#unless isAll}}&filter={{currentFilter}}{{/unless}}"
                class="px-3 py-1.5 rounded-lg border border-outline-variant/40 text-on-surface text-xs font-semibold hover:bg-surface-container-high transition-colors flex items-center gap-1"
                aria-label="Next page">
                <span class="hidden sm:inline">Next</span>
                <span class="material-symbols-outlined text-sm">chevron_right</span>
              </a>
              {{else}}
              <button
                class="px-3 py-1.5 rounded-lg border border-outline-variant/20 text-on-surface-variant/40 text-xs font-semibold flex items-center gap-1 opacity-50 cursor-not-allowed"
                disabled aria-label="Next page">
                <span class="hidden sm:inline">Next</span>
                <span class="material-symbols-outlined text-sm">chevron_right</span>
              </button>
              {{/if}}
            </nav>
          </div>
          {{/if}}
        </div>
      </div>
    </div>

  </main>
</div>
<dialog id="topup-dialog" class="w-full max-w-md rounded-2xl border-0 p-0 shadow-2xl backdrop:bg-black/50">
  <form id="wallet-topup-form" class="bg-surface p-6 sm:p-8 rounded-2xl">
    <div class="flex items-start justify-between gap-4 mb-5">
      <div>
        <h2 class="text-headline-lg font-headline-lg text-on-surface">Add wallet credits</h2>
        <p class="text-sm text-on-surface-variant mt-1">Choose an amount to add securely.</p>
      </div>
      <button type="button" id="close-topup-dialog" class="p-2 text-on-surface-variant hover:text-on-surface"
        aria-label="Close"><span class="material-symbols-outlined">close</span></button>
    </div>
    <label for="topup-amount" class="block text-sm font-semibold text-on-surface mb-2">Amount (INR)</label>
    <div class="flex items-center border border-outline-variant rounded-lg bg-surface-container-low px-4"><span
        class="text-on-surface-variant">₹</span><input id="topup-amount" name="amount" type="number" min="1" max="50000"
        step="0.01" required class="w-full bg-transparent border-0 py-3 px-2 text-on-surface focus:ring-0"
        placeholder="Enter amount"></div>

    <!-- Quick Preset Chips -->
    <div class="flex flex-wrap items-center gap-2 mt-3">
      <span class="text-xs text-on-surface-variant">Quick Add:</span>
      <button type="button"
        class="preset-amount-btn px-2.5 py-1 text-xs rounded-full border border-outline-variant/60 hover:border-primary hover:text-primary transition-colors bg-surface-container-lowest"
        data-amount="100">₹100</button>
      <button type="button"
        class="preset-amount-btn px-2.5 py-1 text-xs rounded-full border border-outline-variant/60 hover:border-primary hover:text-primary transition-colors bg-surface-container-lowest"
        data-amount="500">₹500</button>
      <button type="button"
        class="preset-amount-btn px-2.5 py-1 text-xs rounded-full border border-outline-variant/60 hover:border-primary hover:text-primary transition-colors bg-surface-container-lowest"
        data-amount="1000">₹1,000</button>
      <button type="button"
        class="preset-amount-btn px-2.5 py-1 text-xs rounded-full border border-outline-variant/60 hover:border-primary hover:text-primary transition-colors bg-surface-container-lowest"
        data-amount="2000">₹2,000</button>
    </div>

    <div id="topup-message" class="text-xs text-error mt-2 hidden"></div>

    <div class="flex justify-end gap-2.5 mt-5">
      <button type="button" id="cancel-topup"
        class="px-4 py-2.5 rounded-lg border border-outline-variant text-on-surface text-sm hover:bg-surface-container transition-colors">Cancel</button>
      <button id="submit-topup" type="submit"
        class="px-5 py-2.5 rounded-lg bg-primary text-on-primary font-semibold text-sm disabled:opacity-50 hover:opacity-90 transition-all flex items-center justify-center gap-1.5 shadow-sm">
        Proceed
      </button>
    </div>

  </form>
</dialog>
<!-- Micro-interaction Scripts -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tableRows = document.querySelectorAll('tbody tr');
    tableRows.forEach(row => {
      row.addEventListener('mouseenter', () => {
        row.style.transform = 'translateX(4px)';
      });
      row.addEventListener('mouseleave', () => {
        row.style.transform = 'translateX(0)';
      });
    });

    // Smooth reveal effect
    const observerOptions = {
      threshold: 0.1
    };
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('opacity-100', 'translate-y-0');
          entry.target.classList.remove('opacity-0', 'translate-y-10');
        }
      });
    }, observerOptions);

    document.querySelectorAll('.glass-card').forEach(card => {
      card.classList.add('transition-all', 'duration-700', 'opacity-0', 'translate-y-10');
      observer.observe(card);
    });
  });
</script>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
  const topupDialog = document.getElementById("topup-dialog");
  const topupForm = document.getElementById("wallet-topup-form");
  const topupMessage = document.getElementById("topup-message");
  const topupSubmit = document.getElementById("submit-topup");

  document.getElementById("open-topup-dialog").addEventListener("click", () => {
    if (topupMessage) {
      topupMessage.textContent = "";
      topupMessage.classList.add("hidden");
    }
    topupDialog.showModal();
    document.getElementById("topup-amount").focus();
  });
  document.getElementById("close-topup-dialog").addEventListener("click", () => topupDialog.close());
  document.getElementById("cancel-topup").addEventListener("click", () => topupDialog.close());

  // Preset amount buttons
  document.querySelectorAll('.preset-amount-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const amt = btn.getAttribute('data-amount');
      const inp = document.getElementById('topup-amount');
      if (inp) inp.value = amt;
    });
  });



  const ensureRazorpay = () => new Promise((resolve, reject) => {
    if (window.Razorpay) return resolve(window.Razorpay);
    const existingScript = document.querySelector('script[src*="checkout.razorpay.com"]');
    if (existingScript) {
      existingScript.addEventListener('load', () => resolve(window.Razorpay));
      existingScript.addEventListener('error', () => reject(new Error('Failed to load Razorpay payment gateway.')));
      return;
    }
    const script = document.createElement('script');
    script.src = 'https://checkout.razorpay.com/v1/checkout.js';
    script.async = true;
    script.onload = () => resolve(window.Razorpay);
    script.onerror = () => reject(new Error('Failed to load Razorpay payment gateway. Please check your connection.'));
    document.head.appendChild(script);
  });

  topupForm.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (topupMessage) {
      topupMessage.textContent = "";
      topupMessage.classList.add("hidden");
    }
    topupSubmit.disabled = true;

    try {
      const RazorpayClass = await ensureRazorpay();
      if (!RazorpayClass) throw new Error("Payment checkout did not load. Please try again.");

      const amountInput = document.getElementById("topup-amount");
      const requestedAmount = Number(amountInput?.value);
      if (!Number.isFinite(requestedAmount) || requestedAmount < 1) {
        throw new Error("Please enter a valid amount (minimum ₹1).");
      }

      const orderResponse = await fetch("/wallet/top-up/create-order", {
        method: "POST",
        headers: { "Content-Type": "application/json", "Accept": "application/json" },
        body: JSON.stringify({ amount: requestedAmount })
      });
      const orderResult = await orderResponse.json();
      if (!orderResponse.ok || !orderResult.success) {
        throw new Error(orderResult.message || "Unable to start payment.");
      }

      let paymentSuccessful = false;
      let paymentFailed = false;
      let lastFailReason = "Wallet top-up payment failed";
      let failureRedirectStarted = false;

      const recordFailureAndRedirect = async (reason, razorpayOrderId) => {
        if (failureRedirectStarted) return;
        failureRedirectStarted = true;
        try {
          await fetch("/wallet/failed", {
            method: "POST",
            headers: { "Content-Type": "application/json", "Accept": "application/json" },
            body: JSON.stringify({
              razorpay_order_id: razorpayOrderId,
              reason,
            })
          });
        } catch (error) {
          console.warn("Unable to record wallet payment failure before redirect.", error);
        } finally {
          window.location.href = `/wallet/failed?orderId=${encodeURIComponent(razorpayOrderId || "")}&reason=${encodeURIComponent(reason)}`;
        }
      };

      const checkout = new RazorpayClass({
        key: orderResult.key,
        amount: orderResult.order.amount,
        currency: orderResult.order.currency,
        name: "Nutri Burfi",
        description: "Wallet credits",
        order_id: orderResult.order.id,
        retry: { enabled: false },
        prefill: orderResult.prefill || {
          name: "{{user.name}}",
          email: "{{user.email}}",
          contact: "{{user.phone}}"
        },
        theme: { color: "#7b5900" },
        handler: async (payment) => {
          paymentSuccessful = true;
          try {
            const verifyResponse = await fetch("/wallet/top-up/verify", {
              method: "POST",
              headers: { "Content-Type": "application/json", "Accept": "application/json" },
              body: JSON.stringify(payment)
            });
            const verifyResult = await verifyResponse.json();
            if (!verifyResponse.ok || !verifyResult.success) {
              throw new Error(verifyResult.message || "Payment verification failed.");
            }
            window.location.reload();
          } catch (error) {
            paymentFailed = true;
            await recordFailureAndRedirect(
              error.message || "Payment verification failed",
              orderResult.order.id
            );
          }
        },
        modal: {
          confirm_close: false,
          ondismiss: () => {
            topupSubmit.disabled = false;
            if (paymentFailed) recordFailureAndRedirect(lastFailReason, orderResult.order.id);
          }
        }
      });

      checkout.on("payment.failed", async (event) => {
        paymentFailed = true;
        const failReason = event.error?.description || event.error?.reason || "Wallet top-up payment failed";
        lastFailReason = failReason;
        await recordFailureAndRedirect(
          failReason,
          event.error?.metadata?.order_id || orderResult.order.id
        );
      });

      topupDialog.close();
      checkout.open();
    } catch (error) {
      topupSubmit.disabled = false;
      try { topupDialog.close(); } catch (e) { }
      window.location.href = `/wallet/failed?reason=${encodeURIComponent(error.message || "Unable to start wallet payment")}`;
    }
  });

  // Account navigation tabs scrolling & drag interactions
  const navTabs = document.getElementById('account-nav-tabs');
  if (navTabs) {
    // Auto-center active tab
    const activeTab = navTabs.querySelector('.bg-on-surface');
    if (activeTab) {
      activeTab.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
    }

    // Mouse wheel horizontal scroll support
    navTabs.addEventListener('wheel', (e) => {
      if (e.deltaY !== 0) {
        e.preventDefault();
        navTabs.scrollLeft += e.deltaY;
      }
    }, { passive: false });

    // Click and drag to scroll support
    let isDown = false;
    let startX;
    let scrollLeftStart;

    navTabs.addEventListener('mousedown', (e) => {
      isDown = true;
      startX = e.pageX - navTabs.offsetLeft;
      scrollLeftStart = navTabs.scrollLeft;
    });

    window.addEventListener('mouseup', () => {
      isDown = false;
    });

    navTabs.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - navTabs.offsetLeft;
      const walk = (x - startX) * 1.5;
      navTabs.scrollLeft = scrollLeftStart - walk;
    });
  }
</script>

<style>
  @media (min-width: 768px) {
    footer {
      margin-left: 16rem;
      width: calc(100% - 16rem);
    }
  }
</style>

