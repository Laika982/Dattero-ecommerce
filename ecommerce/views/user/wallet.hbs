{{> user/header}}
<div class="flex min-h-screen">
  {{> user/profileSidebar activeTab="wallet"}}

  <!-- Main Content Canvas -->
  <main class="flex-1 w-full min-w-0 px-4 sm:px-6 md:px-8 pt-20 sm:pt-24 md:pt-28 md:ml-64 pb-16 safe-bottom-padding">
    <div class="max-w-max-width mx-auto px-2 sm:px-container-padding mt-2 sm:mt-6">
