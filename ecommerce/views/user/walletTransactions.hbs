</div></main>

<script>
  document.getElementById('export-csv-btn')?.addEventListener('click', () => {
    const rows = [
      ["Transaction ID", "Description", "Date", "Payment Method", "Amount", "Status"]
    ];
    document.querySelectorAll('.grid.grid-cols-1.md\\:grid-cols-12').forEach(row => {
      const id = row.querySelector('.font-mono')?.textContent?.replace('#', '').trim() || '';
      const desc = row.querySelector('.font-semibold.text-on-surface')?.textContent?.trim() || '';
      const date = row.children[1]?.querySelector('span')?.textContent?.trim() || '';
      const method = row.children[2]?.querySelector('.text-sm')?.textContent?.trim() || '';
      const amount = row.children[3]?.querySelector('.text-body-lg')?.textContent?.trim() || '';
      const status = row.children[4]?.querySelector('span')?.textContent?.trim() || 'Completed';
      if (id && desc) {
        rows.push([`"${id}"`, `"${desc.replace(/"/g, '""')}"`, `"${date}"`, `"${method}"`, `"${amount}"`, `"${status}"`]);
      }
    });
    if (rows.length <= 1) {
      alert('No transactions to export.');
      return;
    }
    const csvContent = "data:text/csv;charset=utf-8," + rows.map(e => e.join(",")).join("\n");
    const encodedUri = encodeURI(csvContent);
    const link = document.createElement("a");
    link.setAttribute("href", encodedUri);
    link.setAttribute("download", `wallet_transactions_${new Date().toISOString().slice(0, 10)}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  });
</script>

