{{> user/header}}
<main class="min-h-screen px-4 sm:px-6 md:px-8 pt-20 sm:pt-24 md:pt-28 pb-16 safe-bottom-padding bg-surface">
    <div class="max-w-max-width mx-auto px-2 sm:px-container-padding mt-2 sm:mt-6">
        {{> user/notification}}
    </div>

    <!-- Mobile Account Navigation Tabs with Scroll Option -->
    <div class="max-w-max-width mx-auto md:hidden mb-6">
      <div id="account-nav-tabs"
        class="flex items-center gap-2 overflow-x-auto pb-2 -mx-4 px-4 sm:-mx-6 sm:px-6 scroll-smooth select-none cursor-grab active:cursor-grabbing custom-nav-scrollbar">
        <a href="/profile" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-surface-container-high text-on-surface-variant text-xs font-semibold whitespace-nowrap hover:bg-surface-variant transition-colors touch-target flex-shrink-0">
          <span class="material-symbols-outlined text-[16px]">person</span>
          Profile
        </a>
        <a href="/order/orders" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-surface-container-high text-on-surface-variant text-xs font-semibold whitespace-nowrap hover:bg-surface-variant transition-colors touch-target flex-shrink-0">
          <span class="material-symbols-outlined text-[16px]">shopping_bag</span>
          My Orders
        </a>
        <a href="/wallet" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-surface-container-high text-on-surface-variant text-xs font-semibold whitespace-nowrap hover:bg-surface-variant transition-colors touch-target flex-shrink-0">
          <span class="material-symbols-outlined text-[16px]">account_balance_wallet</span>
          Wallet
        </a>
        <a href="/wishlist" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-on-surface text-surface text-xs font-semibold whitespace-nowrap shadow-sm touch-target flex-shrink-0">
          <span class="material-symbols-outlined text-[16px]">favorite</span>
          Wishlist
        </a>
        <a href="/profile/address" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-surface-container-high text-on-surface-variant text-xs font-semibold whitespace-nowrap hover:bg-surface-variant transition-colors touch-target flex-shrink-0">
          <span class="material-symbols-outlined text-[16px]">location_on</span>
          Address Book
        </a>
      </div>
    </div>

    <div class="max-w-max-width mx-auto">
        <!-- Hero Header -->
        <div
            class="flex flex-col md:flex-row md:items-end justify-between mb-8 sm:mb-12 border-b border-outline-variant/20 pb-4 sm:pb-6">
            <div>
                <h1 class="font-display-lg text-2xl sm:text-3xl md:text-display-lg text-ink-black mb-1.5">My Favorites
                </h1>
                <p class="font-body-xl text-sm sm:text-base md:text-body-xl text-on-surface-variant">A curated
                    collection of your wellness essentials.</p>
            </div>
            <div class="mt-3 md:mt-0">
                <span id="wishlist-count"
                    class="font-label-md text-xs sm:text-label-md uppercase tracking-[0.15em] text-primary bg-primary-container/10 px-3 sm:px-4 py-1.5 sm:py-2 rounded-full">{{products.length}}
                    Items</span>
            </div>
        </div>
        {{#if products.length}}
        <div class="grid grid-cols-2 md:grid-cols-3 gap-3 sm:gap-6" id="wishlist-grid">
            {{#each products}}
            <div class="wishlist-card group relative bg-surface-container-lowest rounded-2xl overflow-hidden border border-outline-variant/20 shadow-sm flex flex-col justify-between"
                data-product-id="{{this._id}}">
                <button type="button"
                    class="remove-btn absolute top-2.5 right-2.5 z-10 w-7 h-7 sm:w-8 sm:h-8 flex items-center justify-center bg-ink-black/70 hover:bg-red-600 text-white rounded-full opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-all duration-300 shadow-md touch-target"
                    data-product-id="{{this._id}}" aria-label="Remove {{this.productName}} from wishlist">
                    <span class="material-symbols-outlined text-[16px] sm:text-[18px]">close</span>
                </button>
                <a href="/products/{{this._id}}" class="aspect-square w-full overflow-hidden bg-surface-gray block">
                    {{#if this.images.length}}
                    <img class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                        src="{{this.images.[0].url}}" alt="{{this.productName}}">
                    {{else}}
                    <div class="w-full h-full flex items-center justify-center text-xs text-on-surface-variant">No image
                        available</div>
                    {{/if}}
                </a>
                <div class="p-3 sm:p-5 flex flex-col flex-1 justify-between">
                    <div>
                        <h3 class="font-headline-lg text-sm sm:text-base font-bold text-ink-black mb-1 line-clamp-1"><a
                                href="/products/{{this._id}}"
                                class="hover:text-primary transition-colors">{{this.productName}}</a></h3>
                        <p
                            class="font-body-md text-xs sm:text-sm text-on-surface-variant mb-3 sm:mb-4 line-clamp-2 leading-relaxed">
                            {{this.productDescription}}</p>
                    </div>
                    <div class="flex flex-col gap-2 mt-auto">
                        {{#if this.defaultVariantId}}
                        <button type="button" data-wishlist-cart data-product-id="{{this._id}}"
                            data-variant-id="{{this.defaultVariantId}}"
                            class="w-full py-2.5 sm:py-3.5 bg-primary text-on-primary font-label-md text-xs sm:text-label-md uppercase tracking-wider rounded-xl transition-all hover:bg-surface-tint active:scale-95 disabled:opacity-60 flex items-center justify-center gap-1.5 touch-target">
                            <span class="material-symbols-outlined text-[16px] sm:text-[18px]">shopping_cart</span>
                            <span>Add to cart</span>
                        </button>
                        {{else}}
                        <p class="text-xs text-center py-2 text-on-surface-variant font-medium">Out of stock</p>
                        {{/if}}
                        <a href="/products/{{this._id}}"
                            class="text-center text-xs font-semibold text-primary hover:underline py-1">View details</a>
                    </div>
                </div>
            </div>
            {{/each}}
        </div>
        {{/if}}
        <div class="{{#if products.length}}hidden{{/if}} py-24 flex flex-col items-center text-center" id="empty-state">
            <div class="w-24 h-24 bg-surface-container-high rounded-full flex items-center justify-center mb-8">
                <span class="material-symbols-outlined text-on-surface-variant text-[40px]"
                    data-icon="favorite_border">favorite_border</span>
            </div>
            <h2 class="font-headline-xl text-headline-xl text-ink-black mb-4">Your heart is open.</h2>
            <p class="font-body-lg text-body-lg text-on-surface-variant mb-10 max-w-md">Your wishlist is currently
                empty. Explore our artisanal collections to find your new favorites.</p>
            <a class="font-label-md text-label-md uppercase tracking-widest text-primary border-b-2 border-primary pb-2 hover:opacity-70 transition-opacity"
                href="/products">Continue Shopping</a>
        </div>
    </div>
</main>

<script>
    document.querySelectorAll("[data-wishlist-cart]").forEach((button) => {
        button.addEventListener("click", async () => {
            if (button.disabled) return;
            button.disabled = true;

            try {
                const query = new URLSearchParams({
                    productId: button.dataset.productId,
                    variantId: button.dataset.variantId,
                    quantity: "1",
                });
                const response = await fetch(`/cart/add?${query}`, {
                    method: "POST",
                    headers: { "Accept": "application/json" },
                });
                const result = await response.json();
                if (response.status === 401 || result.redirectTo) {
                    showNotification("error", result.message || "Please log in to add items to cart.");
                    setTimeout(() => {
                        window.location.href = result.redirectTo || "/login";
                    }, 1200);
                    return;
                }
                if (!response.ok || !result.success) {
                    throw new Error(result.message || "Unable to add this product to the cart.");
                }

                if (typeof window.updateCartBadge === "function" && (result.cartCount !== undefined || result.cart)) {
                    const totalCartCount = result.cartCount !== undefined
                        ? result.cartCount
                        : (result.cart?.items || []).reduce((sum, item) => sum + (Number(item.quantity) || 0), 0);
                    window.updateCartBadge(totalCartCount);
                }

                button.closest(".wishlist-card").remove();
                const count = document.querySelectorAll(".wishlist-card").length;
                document.getElementById("wishlist-count").textContent = `${count} Items`;
                if (count === 0) {
                    document.getElementById("wishlist-grid").classList.add("hidden");
                    document.getElementById("empty-state").classList.remove("hidden");
                }
            } catch (error) {
                button.disabled = false;
                window.alert(error.message);
            }
        });
    });

    document.querySelectorAll(".remove-btn").forEach((button) => {
        button.addEventListener("click", async () => {
            button.disabled = true;
            try {
                const response = await fetch(`/wishlist/remove/${button.dataset.productId}`, {
                    method: "DELETE",
                    headers: { "Accept": "application/json" }
                });
                const result = await response.json();
                if (!response.ok) throw new Error(result.message || "Unable to remove this product.");

                button.closest(".wishlist-card").remove();
                const count = document.querySelectorAll(".wishlist-card").length;
                document.getElementById("wishlist-count").textContent = `${count} Items`;
                if (count === 0) {
                    document.getElementById("wishlist-grid").classList.add("hidden");
                    document.getElementById("empty-state").classList.remove("hidden");
                }
            } catch (error) {
                button.disabled = false;
                window.alert(error.message);
            }
        });
    });

    // Account navigation tabs scrolling & drag interactions
    const navTabs = document.getElementById('account-nav-tabs');
    if (navTabs) {
        // Auto-center active tab
        const activeTab = navTabs.querySelector('.bg-on-surface');
        if (activeTab) {
            activeTab.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
        }

        // Mouse wheel horizontal scroll support
        navTabs.addEventListener('wheel', (e) => {
            if (e.deltaY !== 0) {
                e.preventDefault();
                navTabs.scrollLeft += e.deltaY;
            }
        }, { passive: false });

        // Click and drag to scroll support
        let isDown = false;
        let startX;
        let scrollLeftStart;

        navTabs.addEventListener('mousedown', (e) => {
            isDown = true;
            startX = e.pageX - navTabs.offsetLeft;
            scrollLeftStart = navTabs.scrollLeft;
        });

        window.addEventListener('mouseup', () => {
            isDown = false;
        });

        navTabs.addEventListener('mousemove', (e) => {
            if (!isDown) return;
            e.preventDefault();
            const x = e.pageX - navTabs.offsetLeft;
            const walk = (x - startX) * 1.5;
            navTabs.scrollLeft = scrollLeftStart - walk;
        });
    }
</script>

{{> user/footer}}